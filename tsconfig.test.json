{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "src/core/day.ts", "src/core/state.ts", "src/core/curate.ts", "src/core/daily.ts",
    "src/core/review.ts", "src/core/events.ts", "src/core/combat.ts", "src/core/progress.ts",
    "src/data/*.ts", "src/theme/palette.ts"
  ]
}
