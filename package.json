{
  "name": "newbie-quest",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "build:game": "node tools/native/build.mjs",
    "prestart": "npm run build:game",
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "lint": "tsc --noEmit",
    "eas-build-pre-install": "node tools/native/build.mjs",
    "preandroid": "npm run build:game",
    "pretypecheck": "npm run build:game",
    "prelint": "npm run build:game",
    "export:android": "npm run build:game && expo export --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.25",
    "expo-build-properties": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-google-mobile-ads": "17.2.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "playwright": "1.56.1",
    "typescript": "~5.9.2"
  }
}
