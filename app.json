{
  "expo": {
    "name": "뉴비 퀘스트",
    "slug": "newbie-quest",
    "scheme": "newbiequest",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF8EC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ksy93.newbiequest",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "캐릭터를 사진과 비슷하게 맞추기 위해 사진을 한 장 읽습니다. 사진은 기기 안에서만 분석되고 서버로 전송되지 않습니다."
      }
    },
    "android": {
      "package": "com.ksy93.newbiequest",
      "adaptiveIcon": {
        "backgroundColor": "#FFC53C"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-updates",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8EC",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "캐릭터 프리셋을 맞추기 위해 사진 한 장을 읽습니다. 기기 안에서만 분석합니다."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFC53C"
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}