[
{"id": "T3912", "t": "감사히 받고 근처에 산다"},
{"id": "T3913", "t": "집 걱정은 덜었다. 주말마다 저녁을 같이 먹었다. 좋은 날도, 숨 막히는 날도 있었다."},
{"id": "T3914", "t": "그 조건이면 받지 말자"},
{"id": "T3915", "t": "{c.은} 한참 있다가 \"부모님은 서운하시겠다\" 했다. 둘이 모은 돈으로 작게 시작하기로 했다."},
{"id": "T3921", "t": "{c.은} \"천천히도 좋아요\" 했다."},
{"id": "T3935", "t": "환불 기준과 소개 횟수를 계약서에 적어 받고, 신고한 업체인지 본다"},
{"id": "T3936", "t": "국내 결혼중개업체는 시·군·구에 신고하고 계약서를 줘야 한다(결혼중개업법, 여성가족부). 중도 해지 환불은 공정거래위원회 표준약관을 보고, 다툼은 한국소비자원 1372에 묻는다(세부 기준 확인 필요)."},
{"id": "T3937", "t": "오늘만 혜택이라니 바로 가입한다"},
{"id": "T3938", "t": "\"오늘만\"은 조건이 아니라 재촉이다. 환불 조항을 못 본 채 서명했다."},
{"id": "T3939", "t": "가입은 안 하고 상담만 받고 나온다"},
{"id": "T3940", "t": "조건표를 들고 나왔다. 내가 뭘 바라는지 적어 본 것만은 남았다."},
{"id": "T3947", "t": "각자 + 공동 하나"},
{"id": "T3954", "t": "예물은 둘이 정한 예산 안에서. 어머니께는 같이 말씀드리자"},
{"id": "T3955", "t": "{c.은} \"같이 가 주면 든든하죠\" 했다. 둘의 예산표에 줄이 하나 늘었다."},
{"id": "T3956", "t": "어머니 뜻대로 해 드리자"},
{"id": "T3957", "t": "{c.은} 고마워하면서도 \"그럼 집 예산에서 빠져요\" 하고 숫자를 바로 고쳤다."},
{"id": "T3958", "t": "예물은 없어도 된다고 본다"},
{"id": "T3959", "t": "{c.은} \"저도요. 엄마 설득이 문제죠\" 하고 웃었다."},
{"id": "T3963", "t": "한 번 더 만나 보고 정한다"},
{"id": "T3964", "t": "{c.은} 다음 약속을 달력에 적었다."},
{"id": "T3967", "t": "아는 얼굴을 봤다."},
{"id": "T3977", "t": "이제 낮 근무만 해."},
{"id": "T3982", "t": "다시 만나 보자고 말한다"},
{"id": "T3983", "t": "연락하며 지내자고 한다"},
{"id": "T3984", "t": "단톡방 대신 둘만의 대화방이 하나 생겼다. 생일마다 커피 쿠폰이 오갔다."},
{"id": "T3993", "t": "아이가 하나 있어요."},
{"id": "T3995", "t": "아이 얘기를 더 듣고 싶다고 한다"},
{"id": "T3996", "t": "{c.은} 아이 학교 얘기를 한참 했다. 커피가 식는 줄 몰랐다."},
{"id": "T3997", "t": "저는 혼자가 편한 사람이라고 먼저 말한다"},
{"id": "T3998", "t": "{c.은} \"저도 그래서 뛰어요\" 했다. 좋은 러닝 친구가 생겼다."},
{"id": "T3999", "t": "다음 주에 또 뛰자고 한다"},
{"id": "T4000", "t": "토요일 아침 일곱 시. 둘 다 늦지 않았다."},
{"id": "T4016", "t": "혼인신고를 하면 법률상 배우자가 된다. 아이와 같이 얘기하고 정하자"},
{"id": "T4017", "t": "혼인신고를 해야 법률상 배우자로 상속과 세금 공제를 받는다. 신고 없이 함께 살면 보호가 일부에 그친다(민법, 찾기쉬운 생활법령정보, 확인 권장). {c.은} 아이에게 먼저 묻겠다고 했다."},
{"id": "T4018", "t": "각자 집에 살며 지금처럼 만난다"},
{"id": "T4019", "t": "열쇠는 두 개, 주말은 함께. 보험 수익자와 비상 연락처에는 서로의 이름을 적었다."},
{"id": "T4020", "t": "좋은 친구로 남자고 한다"},
{"id": "T4021", "t": "토요일 러닝은 그대로 했다. 둘 다 그게 좋았다."},
{"id": "T4023", "t": "작은 결혼식과 혼인신고"},
{"id": "T4035", "t": "취소 조항과 별도 항목 값을 먼저 묻는다"},
{"id": "T4036", "t": "예식업은 공정거래위원회 소비자분쟁해결기준이 있어 해제 시기에 따라 환급 기준이 다르다. 계약 전에 조항과 \"별도\" 값을 다 받아 적는다(한국소비자원)."},
{"id": "T4037", "t": "작은 식이니 바로 쓴다"},
{"id": "T4038", "t": "작은 식도 계약은 계약이다. 취소 조항은 식 크기와 상관없이 읽는다."},
{"id": "T4040", "t": "시·구·읍·면 사무소"},
{"id": "T4041", "t": "둘 + 증인 두 명"},
{"id": "T4048", "t": "제도마다 날짜 기준을 보고 날을 정한다"},
{"id": "T4049", "t": "혼인신고서에는 성년 증인 두 사람이 서명한다(민법). 신혼부부 특별공급과 신혼 대출은 혼인신고일부터 햇수를 센다. 결혼 세액공제는 대상 연도가 정해져 있으니 국세청에서 확인한다."},
{"id": "T4050", "t": "식 끝나고 생각나면 한다"},
{"id": "T4051", "t": "신고일이 기준인 제도가 많다. 미루는 게 득인지 손해인지 먼저 따져 본다."},
{"id": "T4060", "t": "아이가 오면 (요약)"},
{"id": "T4062", "t": "국민행복카드 바우처"},
{"id": "T4064", "t": "첫만남이용권·부모급여"},
{"id": "T4071", "t": "곧 낳자. 육아휴직은 둘이 나눠 쓰자"},
{"id": "T4072", "t": "둘이 휴직 순서를 달력에 적었다. 부모가 같이 쓰면 늘어나는 지원이 있다(고용노동부, 기준 확인 필요)."},
{"id": "T4073", "t": "몇 해 뒤에. 그 전에 집과 통장부터"},
{"id": "T4074", "t": "아이 통장 대신 우리 통장 이름을 \"언젠가\"로 바꿨다."},
{"id": "T4075", "t": "아이 없이 둘이 살자"},
{"id": "T4076", "t": "둘이 사는 삶도 가족이다. 그날 둘의 노후 표를 처음 같이 썼다."},
{"id": "T4081", "t": "서류도 같이 태어난다"},
{"id": "T4085", "t": "출생 뒤 신청 (요약)"},
{"id": "T4094", "t": "출생신고 때 여러 지원을 한 번에 신청한다"},
{"id": "T4095", "t": "출생신고는 한 달 안에 한다(가족관계등록법). 이때 주민센터나 정부24에서 출산 지원 여러 가지를 한꺼번에 신청할 수 있다(행정안전부·보건복지부, 서비스 이름과 대상 확인 필요)."},
{"id": "T4096", "t": "정신없으니 나중에 하나씩"},
{"id": "T4097", "t": "신청해야 나오는 돈이 많다. 늦게 내면 지난달 몫을 못 받는 것도 있다(복지로에서 확인)."},
{"id": "T4101", "t": "미리 말하고 신청서를 낸다. 휴직했다고 불이익을 주면 안 된다"},
{"id": "T4102", "t": "육아휴직은 법에 있는 권리이고, 이를 이유로 해고나 불리한 처우를 하면 안 된다(남녀고용평등법, 고용노동부). 급여는 고용24에서 신청한다. 기간과 금액은 해마다 확인한다."},
{"id": "T4103", "t": "눈치 보여서 연차로 버틴다"},
{"id": "T4104", "t": "연차는 금방 바닥난다. 쓸 수 있는 제도를 안 쓰면 몸과 마음이 먼저 닳는다. 고용노동부 1350에 물을 수 있다."},
{"id": "T4123", "t": "둘이 정한 만큼만 해 보자. 지원은 보건소에서 알아본다"},
{"id": "T4124", "t": "난임 시술비 지원은 보건소와 정부24에서 신청한다(보건복지부, 대상·횟수 확인 필요). 회사에는 난임치료휴가가 있다(고용노동부). 지칠 때 멈출 날도 같이 정했다."},
{"id": "T4126", "t": "달력에서 병원 일정을 지웠다. 그 주말엔 오랜만에 바다를 보러 갔다."},
{"id": "T4127", "t": "둘이서 사는 삶을 고른다"},
{"id": "T4128", "t": "오래 이야기했다. 둘이 사는 삶도 가족이라는 데서 대화가 끝났다."},
{"id": "T4133", "t": "한 번 더, 또는 둘이서"},
{"id": "T4136", "t": "한 번 더 해 보자. 이번에도 멈출 날을 같이 정하고"},
{"id": "T4137", "t": "둘이 정한 만큼만. 그 약속이 서로를 지켰다."},
{"id": "T4139", "t": "그날 저녁, 둘이 가고 싶던 곳 목록을 다시 썼다."},
{"id": "T4142", "t": "둘째가 오면 (요약)"},
{"id": "T4151", "t": "둘째를 낳자. 대신 노후 저축 금액은 지킨다"},
{"id": "T4152", "t": "아이 둘 몫의 표 아래에 노후 저축 줄을 먼저 적었다."},
{"id": "T4153", "t": "우리는 하나로 충분하다"},
{"id": "T4154", "t": "셋이 사는 집. 주말마다 셋이 같이 걸었다."},
{"id": "T4158", "t": "자네 몫도 남기게."},
{"id": "T4159", "t": "익숙해도 기한은 같다"},
{"id": "T4175", "t": "첫째 때 쓴 목록대로 한 번에 신청한다"},
{"id": "T4176", "t": "출생 지원은 아이마다 따로 신청한다. 자녀 세액공제와 출산·입양 공제는 국세청 안내로 확인한다."},
{"id": "T4177", "t": "둘째는 익숙하니 천천히"},
{"id": "T4178", "t": "익숙해도 기한은 같다. 출생신고는 한 달 안이다."},
{"id": "T4203", "t": "혼인신고서 한 장."},
{"id": "T4205", "t": "연금 통장부터 비상 연락처까지"},
{"id": "T4206", "t": "국세청 연금계좌 세액공제"},
{"id": "T4209", "t": "국민건강보험공단 간호·간병통합서비스"},
{"id": "T4210", "t": "찾기쉬운 생활법령정보"},
{"id": "T4214", "t": "종이는 내 몫이야."},
{"id": "T4220", "t": "합쳐서 연 900만 원"},
{"id": "T4227", "t": "다시 내셔야 해요."},
{"id": "T4228", "t": "한도와 해지 조건부터 본다"},
{"id": "T4229", "t": "연금저축과 IRP를 합쳐 연 900만 원까지 세액공제 대상이다. 연금으로 받기 전에 깨면 공제받은 몫에 기타소득세가 붙는다(국세청, 한도 확인 필요)."},
{"id": "T4230", "t": "공제 많이 받게 다 넣는다"},
{"id": "T4231", "t": "급한 돈까지 묶으면 중도 해지 때 세금을 다시 낸다. 비상금을 따로 남기고 넣는다."},
{"id": "T4236", "t": "실손은 겹쳐도 한 번만 나온다"},
{"id": "T4237", "t": "실손보험은 여러 개 들어도 실제 낸 병원비 안에서 나눠 보상한다. 내 가입 내역은 \"내보험 찾아줌\"에서 본다."},
{"id": "T4238", "t": "두 번이라니 하나 더 든다"},
{"id": "T4239", "t": "보험료는 두 번 내고 보상은 병원비 안에서 나뉜다. 겹친 실손은 해지를 생각해 본다."},
{"id": "T4252", "t": "차용증을 쓰고 계좌로 보낸다"},
{"id": "T4253", "t": "금액, 갚을 날, 이자, 두 사람 서명을 적는다. 돈은 계좌로 보내야 기록이 남는다(찾기쉬운 생활법령정보)."},
{"id": "T4254", "t": "친구 사이에 무슨 종이야"},
{"id": "T4255", "t": "말로 한 약속도 계약이지만 다투면 증명할 길이 없다. 종이 한 장이 친구를 지킨다."},
{"id": "T4266", "t": "아플 때 연락할 사람을 정해 둔다"},
{"id": "T4267", "t": "혼자 사는 사람일수록 비상 연락처 한 명을 정해 휴대폰 긴급 정보와 서류함에 적어 둔다."},
{"id": "T4268", "t": "아직 젊으니 나중에"},
{"id": "T4269", "t": "응급실은 나이를 묻지 않는다. 연락할 사람이 없으면 병원이 가족을 찾느라 시간을 쓴다."},
{"id": "T4273", "t": "둘이서도 잘 서네."},
{"id": "T4274", "t": "연금, 보험, 차용증."},
{"id": "T4275", "t": "내 종이를 다 챙겼다."},
{"id": "T4279", "t": "나중에 한꺼번에 왔다."},
{"id": "T4281", "t": "허허, 혼자 사는 길을 골랐다지. 좋은 길이야."},
{"id": "T4282", "t": "대신 자네 이름 종이는 자네가 챙겨야 하네. 같이 보세."},
{"id": "T4283", "t": "5장 클리어! 혼자 사는 설계"},
{"id": "T4284", "t": "내 이름 종이를 다 챙겼다."},
{"id": "T4286", "t": "허허, 친구들 청첩장이 쌓이는구먼."},
{"id": "T4287", "t": "짝이 있든 없든 자네 이름 종이부터 챙기세."},
{"id": "T4288", "t": "5장 클리어! 나 하나의 설계"},
{"id": "T4289", "t": "내 이름 종이를 다 챙겼다."},
{"id": "T4291", "t": "혼자 일찍 나왔다."},
{"id": "T4295", "t": "처음 두드려 봤다."},
{"id": "T4297", "t": "허허, 혼자 사는 건"},
{"id": "T4308", "t": "허허, 둘이든 하나든"},
{"id": "T4314", "t": "모델하우스 사람 봐."},
{"id": "T4315", "t": "모델하우스 사람 봐."},
{"id": "T4316", "t": "나도 넣을 수 있을까?"},
{"id": "T4317", "t": "두 분이면 신혼부부나"},
{"id": "T4335", "t": "내 이름이 올랐다."},
{"id": "T4336", "t": "관리비 고지서 왔어."},
{"id": "T4337", "t": "관리비 고지서 왔다."},
{"id": "T4357", "t": "\"혼자 골라도 안 틀리네.\""},
{"id": "T4372", "t": "혼자 사는 삶을 설계"},
{"id": "T4375", "t": "얘기가 궁금해서요."},
{"id": "T4380", "t": "혼자 · 열려 있음"},
{"id": "T4390", "t": "서랍 좀 열어 봐."},
{"id": "T4391", "t": "종이가 한가득이네."},
{"id": "T4396", "t": " (혼인신고 없이)"},
{"id": "T4397", "t": "혼자, 내 방식으로"},
{"id": "T4399", "t": "오늘 광고 보상은 다 받았어요"},
{"id": "T4400", "t": "새 퀘스트가 열렸어요 · "},
{"id": "T4401", "t": "열 퀘스트가 더 없어요"},
{"id": "T4403", "t": "<div class=\"il\"><i>◆</i>오늘 열린 새 퀘스트는 여기까지예요. 매일 "},
{"id": "T4404", "t": "개씩 새로 열려요.</div>"},
{"id": "T4405", "t": "광고 보고 이 퀘스트 열기 · 오늘 "},
{"id": "T4410", "t": "오늘의 복습 퀴즈야. 푼 문제 중에서 세 개만 다시 풀어 보자."},
{"id": "T4413", "t": "<div class=\"ih\"><div><span class=\"inm\">오늘 할 일</span><span class=\"isub\">연속 "},
{"id": "T4417", "t": "일 한정 보상 · ￦"},
{"id": "T4423", "t": "새 퀘스트를 전부 풀었어요"},
{"id": "T4425", "t": "더 할 일은 없어요. 내일 만나요"},
{"id": "T4426", "t": "<div class=\"il\"><i>◆</i>풀 수 있는 새 퀘스트 "},
{"id": "T4429", "t": " · 새 퀘스트는 전부 열렸어요"},
{"id": "T4430", "t": "오늘의 복습 퀴즈 · 3문항 · ￦30"},
{"id": "T4431", "t": "오늘의 복습 퀴즈를 마쳤어요"},
{"id": "T4432", "t": "복습 퀴즈는 새 퀘스트를 다 풀거나 오늘 퀘스트를 완주하면 열려요"},
{"id": "T4433", "t": "퀘스트를 하나 풀면 복습 퀴즈가 열려요"},
{"id": "T4434", "t": "광고 보고 하나 더 열기 · 오늘 "},
{"id": "T4438", "t": " · 광고 보너스도 받았어요"},
{"id": "T4439", "t": "광고 보고 출석 보너스 +￦"},
{"id": "T4440", "t": "<div class=\"il warn\"><i>◆</i>어제 하루를 걸렀어요. 연속 "},
{"id": "T4441", "t": "일이 끊겼어요.</div>"},
{"id": "T4442", "t": "광고 보고 연속 출석 지키기 · 연속 "},
{"id": "T4443", "t": "다음 퀘스트로 가기 · "},
{"id": "T4446", "t": "복습 · 지난번 틀린 "},
{"id": "T4449", "t": "전에 틀렸던 문항이야. 이번엔 맞힐 수 있겠지?"},
{"id": "T4450", "t": "지금 어떤 상황인가요?"},
{"id": "T4451", "t": "신분에 따라 급한 정보가 완전히 달라요."},
{"id": "T4455", "t": "건강보험·연금·면접비"},
{"id": "T4458", "t": "나이가 어떻게 되세요?"},
{"id": "T4459", "t": "청년 정책 대부분이 만 19~34세를 기준으로 갈려요."},
{"id": "T4461", "t": "청년 정책 대부분 해당"},
{"id": "T4463", "t": "청약·주거 지원 핵심"},
{"id": "T4469", "t": "주거 형태에 따라 챙길 것이 달라요."},
{"id": "T4470", "t": "비용은 적고 제약은 많다"},
{"id": "T4471", "t": "계약과 공과금이 생긴다"},
{"id": "T4473", "t": "이동 시간이 비용이다"},
{"id": "T4474", "t": "준비한 지 얼마나 됐어요?"},
{"id": "T4475", "t": "기간에 따라 챙겨야 할 제도가 달라요."},
{"id": "T4482", "t": "지금 몇 년차인가요?"},
{"id": "T4483", "t": "연차에 따라 급한 것이 달라져요."},
{"id": "T4490", "t": "회사는 어떤 곳인가요?"},
{"id": "T4491", "t": "사내 제도와 챙겨야 할 것이 달라요."},
{"id": "T4504", "t": "어느 권역에 사세요?"},
{"id": "T4505", "t": "전월세 시세와 지원 제도가 권역마다 달라요."},
{"id": "T4507", "t": "부산·대구·대전 등"},
{"id": "T4510", "t": "이제 막 독립한 사회 초년생"},
{"id": "T4511", "t": "영수증은 하나도 안 버리는 알뜰파"},
{"id": "T4512", "t": "오늘도 막차 타는 3년차"},
{"id": "T4513", "t": "원룸 꾸미기에 진심인 자취러"},
{"id": "T4514", "t": "자격증만 일곱 개인 취준생"},
{"id": "T4515", "t": "동네 맛집 지도가 머릿속에 있다"},
{"id": "T4516", "t": "월세 탈출이 인생 목표"},
{"id": "T4517", "t": "여섯 시 정각에 퇴근한다"},
{"id": "T4518", "t": "<div class=\"ob-q\">화면을 불러오지 못했어요</div><div class=\"micro\">저장된 시작 정보가 깨졌을 수 있어요. 아래를 누르면 처음부터 다시 시작해요.</div>"},
{"id": "T4521", "t": "<div class=\"ob-q\">누구로 시작할까요?</div>"},
{"id": "T4522", "t": "<div class=\"micro\">겉모습만 달라요. 나중에 캐릭터 화면에서 언제든 바꿀 수 있어요.</div>"},
{"id": "T4533", "t": "퀘스트에서 목숨 하나를 되살린다. 다섯 번 쓴다."},
{"id": "T4535", "t": "바닥에서 자도 등이 덜 아프다."},
{"id": "T4536", "t": "여름에 잠은 자야 한다."},
{"id": "T4538", "t": "밥상에서 공부하지 않아도 된다."},
{"id": "T4540", "t": "식비가 눈에 띄게 줄어든다."},
{"id": "T4542", "t": "바닥에서 안 자도 되는 날이 왔다."},
{"id": "T4543", "t": "코인 세탁소에 안 가도 된다."},
{"id": "T4545", "t": "누워서 보는 화면. 사치의 시작."},
{"id": "T4547", "t": "정장을 매번 맡기지 않아도 된다."},
{"id": "T4549", "t": "앉을 자리가 생기면 사람이 온다."},
{"id": "T4551", "t": "선풍기로 버티던 여름은 끝났다."},
{"id": "T4552", "t": "장마철에도 빨래가 마른다."},
{"id": "T4554", "t": "출근한 사이에 바닥을 민다."},
{"id": "T4556", "t": "설거지로 싸울 일이 줄었다."},
{"id": "T4558", "t": "퇴근하고 앉으면 일어나기 싫다."},
{"id": "T4560", "t": "거실 벽 하나가 전부 화면이다."},
{"id": "T4562", "t": "장 본 걸 한 번에 넣는다. 배달 앱을 덜 연다."},
{"id": "T4564", "t": "미세먼지 많은 날에도 창문 대신 이걸 켠다."},
{"id": "T4566", "t": "둘이 누워도 팔이 안 부딪힌다."},
{"id": "T4568", "t": "밥을 식탁에서 먹으니 배달이 줄었다."},
{"id": "T4570", "t": "이사 걱정 없이 책을 꽂는다. 벽에 못도 박을 수 있다."},
{"id": "T4572", "t": "2년마다 옮길 일이 없으니 큰 걸 들였다."},
{"id": "T4574", "t": "매트 위에서 잠깐 눈을 붙였다. 체력 +30"},
{"id": "T4575", "t": "푹 잤다. 체력 +60"},
{"id": "T4576", "t": "광고 보고 푹 자기"},
{"id": "T4577", "t": "광고를 보는 동안 꿀잠을 잤다. 체력이 가득 찼다."},
{"id": "T4579", "t": "실내 온도 31도 → 26도. 살 것 같다. 기분 +15 · 켜 둔 동안 기분이 천천히 떨어진다"},
{"id": "T4581", "t": "어제 사 둔 반찬을 꺼내 먹었다. 포만감 +25"},
{"id": "T4583", "t": "오늘 배운 걸 노트에 정리했다. 경험치 +20"},
{"id": "T4585", "t": "뽀송뽀송해졌다. 청결 +60"},
{"id": "T4587", "t": "예능 한 편을 봤다. 기분 +35"},
{"id": "T4589", "t": "정장 구김이 싹 펴졌다. 청결 +30 · 기분 +10"},
{"id": "T4591", "t": "아무것도 안 하는 시간도 필요하다. 기분 +20 · 체력 +10"},
{"id": "T4593", "t": "실내 온도 24도. 기분 +30"},
{"id": "T4595", "t": "수건이 호텔처럼 보송하다. 청결 +40"},
{"id": "T4597", "t": "로봇청소기가 방을 한 바퀴 돌았다. 청결 +30"},
{"id": "T4599", "t": "그릇이 반짝인다. 청결 +20 · 기분 +10"},
{"id": "T4601", "t": "어깨가 풀렸다. 체력 +40 · 기분 +10"},
{"id": "T4602", "t": "광고 보고 전신 안마"},
{"id": "T4603", "t": "광고를 보는 동안 전신 안마를 받았다. 체력이 가득 찼다."},
{"id": "T4605", "t": "거실이 극장이 됐다. 기분 +45"},
{"id": "T4607", "t": "장 봐 둔 재료로 한 끼를 차렸다. 포만감 +35"},
{"id": "T4609", "t": "초록불이 켜졌다. 숨쉬기가 편하다. 기분 +15"},
{"id": "T4611", "t": "식탁에 앉아 천천히 먹었다. 포만감 +20 · 기분 +10"},
{"id": "T4613", "t": "오랜만에 끝까지 읽었다. 경험치 +25"},
{"id": "T4615", "t": "잎이 한 뼘 자랐다. 기분 +10"},
{"id": "T4617", "t": "밥을 해 두면 라면 먹는 날이 줄어든다."},
{"id": "T4618", "t": "생수 묶음을 계단으로 나르던 날은 끝났다."},
{"id": "T4620", "t": "재택 날에도 회사 자리와 같은 화면이다."},
{"id": "T4622", "t": "싸운 날에도 눈에 들어오는 자리에 걸었다."},
{"id": "T4624", "t": "난간 높이를 두 번 바꿨다. 이제 혼자 일어선다."},
{"id": "T4626", "t": "출근 전 한 잔. 카페값이 석 달이면 빠진다."},
{"id": "T4628", "t": "해열제, 소화제, 혈압계. 밤에 약국 찾아 헤매지 않는다."},
{"id": "T4630", "t": "높이를 올리는 손잡이가 있다. 해마다 한 칸씩."},
{"id": "T4632", "t": "김장 김치가 봄까지 간다."},
{"id": "T4634", "t": "헤드폰을 끼면 밤에도 친다. 아랫집은 모른다."},
{"id": "T4636", "t": "건강검진 결과지를 받은 다음 날 샀다."},
{"id": "T4638", "t": "텐트, 랜턴, 아이스박스. 차가 생기니 짐도 생겼다."},
{"id": "T4640", "t": "상추는 사는 것보다 비싸게 먹힌다. 그래도 키운다."},
{"id": "T4642", "t": "명절에 양가가 한 상에 앉는다."},
{"id": "T4643", "t": "한 수 물러 달라는 사람이 꼭 있다."},
{"id": "T4645", "t": "버튼 하나로 다리가 올라온다. 주말이 짧아진다."},
{"id": "T4647", "t": "해마다 한 장씩 늘었다. 맨 왼쪽은 첫 원룸 앞."},
{"id": "T4649", "t": "갓 지은 밥 냄새가 난다. 포만감 +30"},
{"id": "T4651", "t": "시원한 물 한 잔. 체력 +10 · 기분 +5"},
{"id": "T4653", "t": "출퇴근 두 시간을 아꼈다. 경험치 +30"},
{"id": "T4655", "t": "그날은 둘 다 긴장해서 웃는 얼굴이 어색하다. 기분 +20"},
{"id": "T4657", "t": "자장가 세 곡 만에 잠들었다. 기분 +20"},
{"id": "T4659", "t": "원두 가는 소리에 잠이 깬다. 체력 +20 · 기분 +10"},
{"id": "T4661", "t": "숫자를 수첩에 적었다. 건강검진 때 보여 준다. 경험치 +10"},
{"id": "T4663", "t": "분수 나눗셈을 다시 배웠다. 경험치 +20 · 기분 +10"},
{"id": "T4665", "t": "잘 익은 김치에 밥 한 공기. 포만감 +30"},
{"id": "T4667", "t": "어릴 때 배운 곡이 손에서 나온다. 기분 +30"},
{"id": "T4669", "t": "땀이 나니 머리가 맑다. 기분 +20 · 경험치 +5"},
{"id": "T4671", "t": "다음 주말 일기예보부터 봤다. 기분 +25"},
{"id": "T4673", "t": "오늘 저녁은 쌈이다. 포만감 +15 · 기분 +15"},
{"id": "T4675", "t": "반찬 그릇이 식탁을 다 채웠다. 포만감 +40 · 기분 +20"},
{"id": "T4677", "t": "한 수 앞이 아니라 세 수 앞을 봤다. 경험치 +30"},
{"id": "T4679", "t": "다리가 올라오니 하루가 내려간다. 체력 +30 · 기분 +20"},
{"id": "T4681", "t": "첫 원룸 앞 사진의 나는 지금보다 말랐다. 기분 +25"},
{"id": "T4682", "t": "내일 다시 할 수 있다."},
{"id": "T4683", "t": "아직은 못 한다 · "},
{"id": "T4686", "t": " · 무엇을 할까?"},
{"id": "T4688", "t": "<div class=\"adbox\"><span>광고 자리</span><span class=\"micro\" style=\"color:#C8C8CC\">시연용 · 실제 앱에서는 여기에 보상형 광고가 나와요</span><span class=\"adsec\" id=\"adsec\">5</span></div>"},
{"id": "T4689", "t": "벤치에 앉아 잠깐 쉬었다. 체력 +12"},
{"id": "T4693", "t": "아직 놓을 방이 없어요."},
{"id": "T4694", "t": "부터 놓을 수 있어요. 창고에 둬요."},
{"id": "T4695", "t": "방에 빈 자리가 없어요."},
{"id": "T4697", "t": " · 눌러서 자리를 고르세요"},
{"id": "T4705", "t": ". 자리는 캐릭터 탭 세간에서 옮길 수 있어요."},
{"id": "T4708", "t": "부터 놓을 수 있어요."},
{"id": "T4710", "t": "봉지를 넣어 뒀어요."},
{"id": "T4711", "t": "아직 놓을 방이 없어요."},
{"id": "T4717", "t": "창고에 있음 · 눌러서 놓기"},
{"id": "T4718", "t": "놓여 있음 · 눌러서 옮기기"},
{"id": "T4721", "t": " · 목숨 하나 회복 ("},
{"id": "T4722", "t": "광고 보고 목숨 1개 · 이어 풀기 (오늘 "},
{"id": "T4724", "t": "광고 보상 · 목숨 1개"},
{"id": "T4725", "t": "라면 한 봉지 · 목숨 하나 회복"},
{"id": "T4736", "t": "주택가 방향 안내판"},
{"id": "T4737", "t": "풀숲에서 누가 흘린 동전을 주웠다."},
{"id": "T4738", "t": "네잎클로버를 찾았다. 오늘은 운이 좋을지도."},
{"id": "T4740", "t": "2 · 알바와 학자금"},
{"id": "T4744", "t": "운동장 구석에서 천 원짜리 한 장을 주웠다."},
{"id": "T4745", "t": "누가 버린 필기 노트를 훑어봤다. 은근히 도움이 된다."},
{"id": "T4751", "t": "벤치 밑에서 동전을 주웠다."},
{"id": "T4752", "t": "연못에 비친 얼굴이 제법 어른스럽다. 괜히 뿌듯하다."},
{"id": "T4754", "t": "4 · 첫 출근 이후"},
{"id": "T4757", "t": "푸드트럭 앞에서 거스름돈을 주웠다. 사장님이 가지래."},
{"id": "T4761", "t": "벼룩시장 좌판 밑에서 동전을 주웠다."},
{"id": "T4762", "t": "골목 끝 낙서: \"보증금은 등기부부터\". 누군가 크게 당했나 보다."},
{"id": "T4766", "t": "냉장고 밑에 굴러간 동전을 꺼냈다."},
{"id": "T4773", "t": "전입 신고 창구 직원"},
{"id": "T4774", "t": "대기석 틈에서 동전이 나왔다."},
{"id": "T4778", "t": "매물 전단지 사이에서 동전을 주웠다."},
{"id": "T4781", "t": "먼지 쌓인 \"사회초년생 생존기\"를 끝까지 읽었다."},
{"id": "T4786", "t": "게시판 전단을 읽었다. \"근로장학생 모집 · 도서관 · 학과 사무실\""},
{"id": "T4791", "t": "테이블 밑에서 도장이 다 찍힌 쿠폰을 주웠다."},
{"id": "T4793", "t": "3 · 고용센터 앞 안"},
{"id": "T4800", "t": "누가 두고 간 이력서 첨삭 메모를 읽었다. 배울 게 많다."},
{"id": "T4801", "t": "3 · 고용센터 앞 안"},
{"id": "T4804", "t": "\"지역가입자 보험료 조정 신청\" 안내문을 읽었다."},
{"id": "T4809", "t": "탕비실에서 컵라면 하나를 챙겼다. (라면 +1)"},
{"id": "T4810", "t": "5 · 은행 골목 안"},
{"id": "T4814", "t": "대기석 아래에서 동전을 주웠다."},
{"id": "T4815", "t": "5 · 은행 골목 안"},
{"id": "T4818", "t": "코인 세탁을 했다. 청결 +50"},
{"id": "T4820", "t": "건조기 옆 바닥에서 동전을 주웠다."},
{"id": "T4827", "t": "모래밭에서 동전을 찾았다. 아이들이 흘렸나 보다."},
{"id": "T4828", "t": "\"전세사기 예방 체크리스트\" 전단을 주웠다. 등기부·실거래가·보증보험, 세 줄이다."},
{"id": "T4833", "t": "새 가구에 붙은 가격표를 봤다. 집값보다 옵션 자랑이 먼저인 집이다."},
{"id": "T4836", "t": "구축 아파트 집주인"},
{"id": "T4838", "t": "장판 틈에서 오래된 동전이 나왔다."},
{"id": "T4840", "t": "3 · 고용센터 남쪽"},
{"id": "T4845", "t": "좌판 밑으로 굴러간 동전을 주웠다."},
{"id": "T4846", "t": "떡집 사장님이 갓 나온 떡을 한 조각 줬다. 따뜻하다."},
{"id": "T4848", "t": "3 · 전통시장 안"},
{"id": "T4851", "t": "얼음 위 조개를 구경했다. 원산지 팻말이 꽂혀 있다."},
{"id": "T4853", "t": "3 · 전통시장 안"},
{"id": "T4856", "t": "의자 밑에서 동전을 주웠다."},
{"id": "T4862", "t": "바닥에 떨어진 교통카드를 역무원에게 맡겼다. 착한 일을 했다."},
{"id": "T4863", "t": "화단 옆에서 동전을 주웠다."},
{"id": "T4868", "t": "의자 밑에서 동전을 주웠다."},
{"id": "T4869", "t": "고속도로 · 쉬어 가는 곳"},
{"id": "T4873", "t": "주차선 옆에서 동전을 주웠다."},
{"id": "T4874", "t": "구겨진 전국 도로 지도를 펴 봤다. 어디든 갈 수 있을 것 같다."},
{"id": "T4876", "t": "고속도로 · 휴게소 안"},
{"id": "T4879", "t": "자판기 밑에서 동전을 꺼냈다."},
{"id": "T4881", "t": "고속도로 · 어디로 갈까"},
{"id": "T4883", "t": "고갯길에서 보는 경치가 좋다. 창문을 열었다."},
{"id": "T4893", "t": "예쁜 조개껍데기를 주웠다. 주머니에 넣었다."},
{"id": "T4894", "t": "모래 속에서 동전이 반짝였다."},
{"id": "T4899", "t": "붓글씨 체험장에서 이름을 써 봤다. 삐뚤빼뚤하다."},
{"id": "T4900", "t": "담장 아래에서 동전을 주웠다."},
{"id": "T4902", "t": "여행지 · 강릉 안"},
{"id": "T4905", "t": "바닥에 떨어진 원두 한 알. 향이 진하다."},
{"id": "T4913", "t": "기와 담장 아래 은행잎을 주웠다. 가을이다."},
{"id": "T4914", "t": "돌담 틈에서 동전을 찾았다."},
{"id": "T4921", "t": "판매대 아래서 동전을 주웠다."},
{"id": "T4922", "t": "시장 지붕 아래 불빛이 예쁘다. 사진을 한 장 찍었다."},
{"id": "T4929", "t": "모래사장에서 동전을 주웠다."},
{"id": "T4930", "t": "파도 소리를 들으며 한참 앉아 있었다. 마음이 좀 가벼워졌다."},
{"id": "T4933", "t": "주민 생활 공간 안내"},
{"id": "T4936", "t": "골목 스탬프를 하나 찍었다. 지도 한 칸이 찼다."},
{"id": "T4937", "t": "계단참에서 동전을 주웠다."},
{"id": "T4945", "t": "갈매기가 새우깡을 노린다. 주머니를 여몄다."},
{"id": "T4946", "t": "부두 난간 아래 동전을 주웠다."},
{"id": "T4952", "t": "불국사 가는 버스 안내"},
{"id": "T4954", "t": "깨진 기와 조각을 봤다. 천 년 전 것일까? 제자리에 두었다."},
{"id": "T4955", "t": "골목 모퉁이에서 동전을 주웠다."},
{"id": "T4959", "t": "동궁과 월지 안내판"},
{"id": "T4961", "t": "밤하늘에 별이 보인다. 첨성대에서 별을 보던 사람들을 떠올렸다."},
{"id": "T4962", "t": "연못가 벤치 옆에서 동전을 주웠다."},
{"id": "T4964", "t": "여행지 · 경주 안"},
{"id": "T4966", "t": "주인이 내준 차를 마셨다. 몸이 따뜻해졌다."},
{"id": "T4973", "t": "가게 앞 화분 옆에서 동전을 주웠다."},
{"id": "T4974", "t": "버스킹 공연 전단을 받았다. 오늘 저녁이다."},
{"id": "T4981", "t": "판매대 아래서 동전을 주웠다."},
{"id": "T4982", "t": "원단 가게 앞에서 천 조각을 구경했다. 서문시장은 원래 옷감 시장으로 유명했다."},
{"id": "T4983", "t": "김광석 다시그리기길"},
{"id": "T4986", "t": "누가 떨어뜨린 기타 피크를 주웠다."},
{"id": "T4987", "t": "벽화 아래에서 동전을 주웠다."},
{"id": "T4989", "t": "여행지 · 전주 안"},
{"id": "T4991", "t": "침대 밑에서 전 손님이 흘린 동전을 찾았다."}
]
