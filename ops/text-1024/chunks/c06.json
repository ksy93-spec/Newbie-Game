{"id":"T3372","line":5404,"t":"전세 만기 알림이"},
{"id":"T3373","line":5404,"t":"더는 오지 않는다."},
{"id":"T3374","line":5404,"t":"\"허허, 문패 한번 좋구먼.\""},
{"id":"T3375","line":5405,"t":"티끌 태산"},
{"id":"T3376","line":5405,"t":"모은 돈 상위"},
{"id":"T3377","line":5406,"t":"커피 한 잔을 아껴"},
{"id":"T3378","line":5406,"t":"예순 해를 쌓았다."},
{"id":"T3379","line":5406,"t":"\"작은 돈이 큰 돈 지키네.\""},
{"id":"T3380","line":5407,"t":"살림 박사"},
{"id":"T3381","line":5407,"t":"스탯 다섯 합 상위"},
{"id":"T3382","line":5408,"t":"집, 밥, 옷, 돈, 일."},
{"id":"T3383","line":5408,"t":"모르는 서류가 없다."},
{"id":"T3384","line":5408,"t":"\"이제 자네가 가르치게.\""},
{"id":"T3385","line":5409,"t":"사기 불패"},
{"id":"T3386","line":5409,"t":"보스 전부 처음에 이김"},
