{"id":"T3501","line":5552,"t":"주 15시간 이상"},
{"id":"T3502","line":5552,"t":"주휴수당"},
{"id":"T3503","line":5552,"t":"적혀 있지 않음"},
{"id":"T3504","line":5553,"t":"근데 사장님이"},
{"id":"T3505","line":5553,"t":"우린 주휴수당"},
{"id":"T3506","line":5553,"t":"없다더라?"},
{"id":"T3507","line":5555,"t":"주 15시간 넘으면 주휴수당이 붙는대. 같이 물어보자"},
{"id":"T3508","line":5556,"t":"한 주 정해진 근로가 15시간 이상이고 다 나오면 주휴수당이 붙는다(근로기준법, 고용노동부). 계약서에 적어 달라고 둘이 같이 말했다."},
{"id":"T3509","line":5557,"t":"괜히 말했다가 잘리면 어떡해"},
{"id":"T3510","line":5558,"t":"모르고 넘기면 받을 돈을 못 받는다. 말하기 어려우면 고용노동부 상담센터 1350에 먼저 묻는다."},
{"id":"T3511","line":5559,"t":"{c.이} 말해 줘. 나는 뒤에 있을게"},
{"id":"T3512","line":5560,"t":"{c.이} 혼자 사장님 앞에 섰다. 받긴 했지만 그날 {c.은} 조금 서운해 보였다."},
{"id":"T3513","line":5562,"t":"마감하고"},
{"id":"T3514","line":5562,"t":"떡볶이 먹을래?"},
{"id":"T3515","line":5562,"t":"오늘은 내가 살게."},
{"id":"T3516","line":5564,"t":"좋아. 다음엔 내가 살게"},
{"id":"T3517","line":5565,"t":"번갈아 사기로 했다. {c.은} 다음 약속을 그 자리에서 잡았다."},
{"id":"T3518","line":5566,"t":"오늘은 피곤해서 다음에"},
{"id":"T3519","line":5567,"t":"{c.은} \"그래, 다음에!\" 하고 웃었다. 다음은 생각보다 늦게 왔다."},
{"id":"T3520","line":5569,"t":"축제 사진전"},
{"id":"T3521","line":5569,"t":"그날 밤의 말"},
{"id":"T3522","line":5573,"t":"{ageKo}, 가을."},
{"id":"T3523","line":5573,"t":"축제 사진전"},
{"id":"T3524","line":5573,"t":"준비로 밤을 샜다."},
{"id":"T3525","line":5575,"t":"전시 끝나면"},
{"id":"T3526","line":5575,"t":"나 휴학하고"},
{"id":"T3527","line":5575,"t":"시험 준비해."},
{"id":"T3528","line":5577,"t":"공무원 시험."},
{"id":"T3529","line":5577,"t":"알바하면서"},
{"id":"T3530","line":5577,"t":"두 해만 해 보려고."},
{"id":"T3531","line":5579,"t":"그럼 전시 사진은 내가 끝까지 같이 걸게"},
{"id":"T3532","line":5580,"t":"새벽 세 시, 마지막 액자를 둘이 같이 걸었다."},
{"id":"T3533","line":5581,"t":"두 해면 금방이야. 학원비는 알아봤어?"},
{"id":"T3534","line":5582,"t":"{c.은} 인강과 학원 값을 적은 메모를 보여 줬다. 생각보다 꼼꼼했다."},
