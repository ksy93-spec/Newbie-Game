{"id":"T3552","line":5599,"t":"골라 뒀다."},
{"id":"T3553","line":5601,"t":"할부로 하면"},
{"id":"T3554","line":5601,"t":"한 달에 얼마"},
{"id":"T3555","line":5601,"t":"안 돼!"},
{"id":"T3556","line":5603,"t":"모은 만큼만 가자. 여행 통장을 같이 붓자"},
{"id":"T3557","line":5604,"t":"할부는 다음 달 알바비를 당겨 쓰는 일이다. 무이자가 아니면 수수료도 붙는다(금융감독원 파인). {c.은} 아쉬워하다가 통장 이름을 \"제주\"로 지었다."},
{"id":"T3558","line":5605,"t":"좋아, 할부로 가자"},
{"id":"T3559","line":5606,"t":"여행은 좋았다. 석 달 동안 알바비가 카드값으로 나갔다. {c.이} 먼저 \"다음엔 모아서 가자\" 했다."},
{"id":"T3560","line":5607,"t":"나는 이번엔 빠질게"},
{"id":"T3561","line":5608,"t":"{c.은} 친구들과 다녀와서 귤 한 상자를 건넸다."},
{"id":"T3562","line":5610,"t":"마감 뒤"},
{"id":"T3563","line":5610,"t":"셔터를 내리다"},
{"id":"T3564","line":5610,"t":"눈이 마주쳤다."},
{"id":"T3565","line":5612,"t":"사귀자고 말한다"},
{"id":"T3566","line":5613,"t":"그냥 웃고 만다"},
{"id":"T3567","line":5614,"t":"그 겨울, {c.은} 다른 동네 카페로 옮겼다. 연락은 가끔 했다."},
{"id":"T3568","line":5616,"t":"졸업 앞에서"},
{"id":"T3569","line":5616,"t":"둘의 계획"},
{"id":"T3570","line":5620,"t":"{ageKo}, 겨울."},
{"id":"T3571","line":5620,"t":"졸업 사진을"},
{"id":"T3572","line":5620,"t":"찍었다."},
{"id":"T3573","line":5622,"t":"시험 한 번"},
{"id":"T3574","line":5622,"t":"더 보려고."},
{"id":"T3575","line":5622,"t":"독서실 끊었어."},
{"id":"T3576","line":5622,"t":"나 바리스타"},
{"id":"T3577","line":5622,"t":"자격증 땄어."},
{"id":"T3578","line":5622,"t":"언젠간 내 가게."},
{"id":"T3579","line":5623,"t":"나 다른 도시로"},
{"id":"T3580","line":5623,"t":"갈 것 같아."},
{"id":"T3581","line":5625,"t":"어떡할까?"},
{"id":"T3582","line":5627,"t":"멀어도 만나자. 데이트 통장은 반씩 붓자"},
{"id":"T3583","line":5628,"t":"주말마다 버스를 탔다. 차비는 데이트 통장에서 나갔다. 둘 다 그 통장을 아꼈다."},
{"id":"T3584","line":5629,"t":"네 일이 먼저야. 바쁜 철엔 연락을 줄이자"},
{"id":"T3585","line":5630,"t":"연락은 줄었고 믿음은 그대로였다. 시험 날 아침엔 문자 한 줄을 보냈다."},
{"id":"T3586","line":5631,"t":"각자 자리 잡을 때까지 멈추자"},
{"id":"T3587","line":5632,"t":"울지 않으려고 커피만 마셨다. 사진첩 폴더는 지우지 않았다."},
{"id":"T3588","line":5635,"t":"데이트 통장"},
{"id":"T3589","line":5635,"t":"누가 낼까"},
{"id":"T3590","line":5639,"t":"우리 데이트비,"},
{"id":"T3591","line":5639,"t":"이번 달에"},
{"id":"T3592","line":5639,"t":"꽤 나왔더라."},
{"id":"T3593","line":5641,"t":"이번 달 데이트 (예시)"},
{"id":"T3594","line":5641,"t":"밥·카페"},
{"id":"T3595","line":5641,"t":"거의 한 사람"},
{"id":"T3596","line":5641,"t":"생각보다 큼"},
{"id":"T3597","line":5642,"t":"나눌까?"},
{"id":"T3598","line":5644,"t":"모임통장을 만들어 달마다 같이 넣자"},
{"id":"T3599","line":5645,"t":"한 통장에 넣고 거기서 쓴다. 누가 더 냈는지 셈이 사라졌다. 버는 돈 차이가 크면 비율로 넣어도 된다."},
{"id":"T3600","line":5646,"t":"지금 더 버는 내가 더 낼게"},
{"id":"T3601","line":5647,"t":"{c.은} 고마워하면서도 \"나도 낼 수 있어\" 했다. 둘이 비율을 다시 적었다."},
{"id":"T3602","line":5648,"t":"그때그때 번갈아 내자"},
{"id":"T3603","line":5649,"t":"편했다. 다만 누가 마지막에 냈는지 가끔 헷갈렸다."},
{"id":"T3604","line":5651,"t":"선물과 할부"},
{"id":"T3605","line":5655,"t":"{c.과} 만난 지"},
{"id":"T3606","line":5655,"t":"{yrs}년째."},
{"id":"T3607","line":5657,"t":"기념일 선물,"},
{"id":"T3608","line":5657,"t":"명품 지갑을"},
{"id":"T3609","line":5657,"t":"할부로 살까?"},
{"id":"T3610","line":5659,"t":"할부 대신 둘이 가고 싶던 곳에 갈 여행 적금을 든다"},
{"id":"T3611","line":5660,"t":"{c.은} 적금 통장 첫 장을 사진으로 찍어 뒀다."},
{"id":"T3612","line":5661,"t":"무이자 할부로 지갑을 산다"},
{"id":"T3613","line":5662,"t":"{c.은} 좋아했다. 할부 문자는 열두 달 동안 왔다."},
{"id":"T3614","line":5663,"t":"손편지와 저녁 한 끼"},
{"id":"T3615","line":5664,"t":"{c.은} 편지를 다 읽고 한참 말이 없었다. 좋은 쪽으로."},
{"id":"T3616","line":5666,"t":"내년에도"},
{"id":"T3617","line":5666,"t":"이렇게 하자."},
{"id":"T3618","line":5669,"t":"입사 동기"},
{"id":"T3619","line":5669,"t":"첫 회식"},
{"id":"T3620","line":5673,"t":"입사 동기"},
{"id":"T3621","line":5673,"t":"단톡방이 생겼다."},
{"id":"T3622","line":5675,"t":"다른 팀"},
{"id":"T3623","line":5675,"t":"{c.예}."},
{"id":"T3624","line":5675,"t":"2차 가요?"},
{"id":"T3625","line":5677,"t":"저는 회사 대출로"},
{"id":"T3626","line":5677,"t":"오피스텔 들어가요."},
{"id":"T3627","line":5677,"t":"월세 아까워서."},
{"id":"T3628","line":5679,"t":"다음 달에"},
{"id":"T3629","line":5679,"t":"청약 공부"},
{"id":"T3630","line":5679,"t":"같이 할래요?"},
{"id":"T3631","line":5681,"t":"좋아요. 청약통장부터 확인해 봐요"},
{"id":"T3632","line":5682,"t":"{c.은} 말이 빨랐고 숫자는 더 빨랐다. 다음 주 점심, 둘이 청약홈 화면을 같이 봤다."},
{"id":"T3633","line":5683,"t":"저는 아직 집 생각은 없어요"},
{"id":"T3634","line":5684,"t":"{c.은} \"그럴 수 있죠\" 했다. 그래도 회식마다 옆자리였다."},
{"id":"T3635","line":5685,"t":"사내 연애는 안 하는 걸로"},
{"id":"T3636","line":5686,"t":"좋은 동기 하나가 생겼다. 회사 생활엔 그것도 크다."},
{"id":"T3637","line":5688,"t":"지금 아니면 끝?"},
{"id":"T3638","line":5691,"t":"[톡] {c}"},
{"id":"T3639","line":5692,"t":"이번 분양 봤어?"},
{"id":"T3640","line":5692,"t":"지금 아니면"},
{"id":"T3641","line":5692,"t":"끝이래."},
{"id":"T3642","line":5694,"t":"{c}의 계산"},
{"id":"T3643","line":5694,"t":"신용대출"},
{"id":"T3644","line":5694,"t":"집단대출"},
{"id":"T3645","line":5694,"t":"그때 가서"},
{"id":"T3646","line":5694,"t":"달마다 갚을 돈"},
{"id":"T3647","line":5695,"t":"신용대출까지"},
{"id":"T3648","line":5695,"t":"끌어오면"},
{"id":"T3649","line":5695,"t":"계약금은 돼."},
{"id":"T3650","line":5697,"t":"음..."},
{"id":"T3651","line":5699,"t":"달마다 갚을 돈부터 같이 셈해 보자. DSR에는 신용대출도 들어가."},
{"id":"T3652","line":5700,"t":"DSR은 모든 대출의 한 해 원리금을 소득과 견준다. 신용대출도 들어간다(금융위원회). {c.은} 계산기를 두드리다 \"좀 더 모으자\" 했다."},
{"id":"T3653","line":5701,"t":"너라면 잘할 거야. 응원해"},
{"id":"T3654","line":5702,"t":"{c.은} 계약했다. 그해 금리가 올랐고 {c.은} 점심을 편의점에서 먹기 시작했다."},
{"id":"T3655","line":5703,"t":"나는 그렇게까지는 못 해"},
{"id":"T3656","line":5704,"t":"{c.은} \"너는 너무 조심해\" 했다. 서로 다른 걸 처음 알았다."},
{"id":"T3657","line":5706,"t":"회식이 끝나고"},
{"id":"T3658","line":5706,"t":"둘만 남았다."},
{"id":"T3659","line":5708,"t":"사귀자고 말한다"},
{"id":"T3660","line":5709,"t":"좋은 동기로 남는다"},
{"id":"T3661","line":5710,"t":"다음 날도 웃으며 인사했다. 그걸로 됐다."},
{"id":"T3662","line":5712,"t":"가게 자리"},
{"id":"T3663","line":5716,"t":"자리 찾았어!"},
{"id":"T3664","line":5716,"t":"역 앞 2층."},
{"id":"T3665","line":5716,"t":"권리금이 좀 있어."},
{"id":"T3666","line":5718,"t":"대출 서류 (예시)"},
{"id":"T3667","line":5718,"t":"창업 자금"},
{"id":"T3668","line":5718,"t":"보증 범위"},
{"id":"T3669","line":5718,"t":"대출 전액"},
{"id":"T3670","line":5718,"t":"못 갚으면"},
{"id":"T3671","line":5718,"t":"보증인이 갚음"},
{"id":"T3672","line":5719,"t":"대출 받으려면"},
{"id":"T3673","line":5719,"t":"보증인이 하나"},
{"id":"T3674","line":5719,"t":"필요하대."},
{"id":"T3675","line":5721,"t":"너 이름만"},
{"id":"T3676","line":5721,"t":"빌려주면 돼."},
{"id":"T3677","line":5723,"t":"보증은 못 서. 대신 정책자금과 상권부터 같이 보자"},
{"id":"T3678","line":5724,"t":"보증을 서면 빌린 사람이 못 갚을 때 내가 갚는다(금융감독원). 소상공인 정책자금과 상권정보는 소상공인시장진흥공단에서 본다. {c.은} 서운해하다가 일주일 뒤 상권 지도를 들고 왔다."},
{"id":"T3679","line":5725,"t":"너니까 서 줄게"},
{"id":"T3680","line":5726,"t":"가게는 열었다. 두 해 뒤 문을 닫던 날, 독촉장이 내 이름으로도 왔다."},
{"id":"T3681","line":5727,"t":"우리 사이에 돈 얘기는 하지 말자"},
{"id":"T3682","line":5728,"t":"말하지 않은 돈은 사라지지 않는다. {c.은} 다른 보증인을 찾았고, 둘 사이에 말 못 한 게 하나 생겼다."},
{"id":"T3683","line":5731,"t":"선배의 소개"},
{"id":"T3684","line":5731,"t":"첫 만남과 계산서"},
{"id":"T3685","line":5735,"t":"주말에 시간 돼?"},
{"id":"T3686","line":5735,"t":"좋은 사람 있어."},
{"id":"T3687","line":5735,"t":"병원에서 일해."},
{"id":"T3688","line":5737,"t":"3교대라"},
{"id":"T3689","line":5737,"t":"약속 잡기가"},
{"id":"T3690","line":5737,"t":"늘 어려워요."},
{"id":"T3691","line":5739,"t":"두 시간이"},
{"id":"T3692","line":5739,"t":"금방 갔다."},
{"id":"T3693","line":5739,"t":"계산서가 왔다."},
{"id":"T3694","line":5741,"t":"오늘은 제가 낼게요"},
{"id":"T3695","line":5742,"t":"{c.은} \"그럼 다음은 제가요\" 하고 날짜를 먼저 잡았다."},
{"id":"T3696","line":5743,"t":"반씩 내요"},
{"id":"T3697","line":5744,"t":"{c.은} 웃으며 송금 버튼을 눌렀다. \"이게 편해요.\""},
{"id":"T3698","line":5746,"t":"저는 가계부를"},
{"id":"T3699","line":5746,"t":"십 년째 써요."},
{"id":"T3700","line":5746,"t":"이상해요?"},
{"id":"T3701","line":5748,"t":"저도 써 볼까요. 비상금은 얼마나 둬요?"},
{"id":"T3702","line":5749,"t":"{c.은} 석 달 치 생활비를 비상금으로 둔다고 했다. 그날 처음으로 내 통장을 열어 봤다."},
{"id":"T3703","line":5750,"t":"저는 남는 걸 저축해요"},
{"id":"T3704","line":5751,"t":"{c.은} 잠깐 말이 없다가 \"써 보면 달라요\" 했다. 다음 약속은 잡혔다."},
{"id":"T3705","line":5753,"t":"어머니께 보내는 돈"},
{"id":"T3706","line":5753,"t":"숨기지 않는 사람"},
{"id":"T3707","line":5757,"t":"나 매달"},
{"id":"T3708","line":5757,"t":"어머니께"},
{"id":"T3709","line":5757,"t":"생활비 보내."},
{"id":"T3710","line":5759,"t":"혼자 사시거든."},
{"id":"T3711","line":5759,"t":"결혼해도"},
{"id":"T3712","line":5759,"t":"이건 계속할 거야."},
{"id":"T3713","line":5761,"t":"그건 네 몫이야. 결혼하면 금액은 같이 정하자"},
{"id":"T3714","line":5762,"t":"부모님께 드리는 돈은 숨기지 않고 둘의 예산에 한 줄로 올린다. 금액과 기간을 같이 정하면 서운함이 준다."},
{"id":"T3715","line":5763,"t":"나중에 우리 돈이 모자라면?"},
{"id":"T3716","line":5764,"t":"{c.은} \"그때 같이 고민하자\" 했다. 걱정을 말한 건 잘했다. 말투가 조금 차가웠을 뿐."},
{"id":"T3717","line":5765,"t":"그건 좀 부담된다"},
{"id":"T3718","line":5766,"t":"{c.은} \"말해 줘서 고마워\" 했다. 그 뒤로 연락이 조금씩 줄었다."},
{"id":"T3719","line":5768,"t":"병원 앞에서"},
{"id":"T3720","line":5768,"t":"퇴근을 기다렸다."},
{"id":"T3721","line":5770,"t":"사귀자고 말한다"},
{"id":"T3722","line":5771,"t":"조금 더 천천히 만난다"},
{"id":"T3723","line":5772,"t":"{c.은} 근무표를 보내 왔다. 쉬는 날에 동그라미가 쳐 있었다."},
{"id":"T3724","line":5774,"t":"동기 결혼식"},
{"id":"T3725","line":5774,"t":"다시 만난 사람"},
{"id":"T3726","line":5778,"t":"동기 결혼식"},
{"id":"T3727","line":5778,"t":"뒷줄에 앉았다."},
{"id":"T3728","line":5780,"t":"오랜만이야."},
{"id":"T3729","line":5780,"t":"나 그 시험"},
{"id":"T3730","line":5780,"t":"붙었어."},
{"id":"T3731","line":5780,"t":"오랜만!"},
{"id":"T3732","line":5780,"t":"나 이제"},
{"id":"T3733","line":5780,"t":"가게 준비해."},
{"id":"T3734","line":5781,"t":"오랜만이야."},
{"id":"T3735","line":5783,"t":"그때 우리"},
{"id":"T3736","line":5783,"t":"참 어렸지."},
{"id":"T3737","line":5785,"t":"그때 못 한 말이 있다고 말한다"},
{"id":"T3738","line":5786,"t":"잘 지내서 다행이라고 말한다"},
{"id":"T3739","line":5787,"t":"커피를 다 마시고 각자 지하철을 탔다. 마음이 조금 가벼워졌다."},
{"id":"T3740","line":5790,"t":"우리 얘기"},
{"id":"T3741","line":5790,"t":"빚·연봉·부모님"},
{"id":"T3742","line":5794,"t":"{c.과} 만난 지"},
{"id":"T3743","line":5794,"t":"{yrs}년."},
{"id":"T3744","line":5796,"t":"결혼 얘기"},
{"id":"T3745","line":5796,"t":"하기 전에"},
{"id":"T3746","line":5796,"t":"돈 얘기부터 하자."},
{"id":"T3747","line":5798,"t":"둘이 쓴 표"},
{"id":"T3748","line":5798,"t":"모은 돈"},
{"id":"T3749","line":5798,"t":"각자 적기"},
{"id":"T3750","line":5798,"t":"학자금·할부 다"},
{"id":"T3751","line":5798,"t":"숫자 그대로"},
{"id":"T3752","line":5798,"t":"도움·부양 여부"},
{"id":"T3753","line":5799,"t":"적어야 해?"},
{"id":"T3754","line":5801,"t":"빚까지 다 적는다"},
{"id":"T3755","line":5802,"t":"결혼 뒤에 알게 된 빚은 액수보다 믿음을 더 깎는다. 내 신용정보는 신용평가회사 누리집이나 앱에서 직접 뽑아 보여 줄 수 있다(조회 방법 확인 필요)."},
{"id":"T3756","line":5803,"t":"모은 돈만 적고, 빚은 갚고 나서 말한다"},
{"id":"T3757","line":5804,"t":"숨긴 빚은 언젠가 나온다. 갚고 나서 말하면 \"왜 그때 말 안 했어\"가 남는다."},
{"id":"T3758","line":5806,"t":"우리 부모님이"},
{"id":"T3759","line":5806,"t":"전세금 조금"},
{"id":"T3760","line":5806,"t":"보태 주신대."},
{"id":"T3761","line":5806,"t":"우리 집에서"},
{"id":"T3762","line":5806,"t":"집 살 때"},
{"id":"T3763","line":5806,"t":"보태 준대."},
{"id":"T3764","line":5807,"t":"어머니 생활비는"},
{"id":"T3765","line":5807,"t":"계속 보낼 거야."},
{"id":"T3766","line":5807,"t":"금액 정하자."},
{"id":"T3767","line":5807,"t":"부모님이 집을"},
{"id":"T3768","line":5807,"t":"보태 주신대."},
{"id":"T3769","line":5807,"t":"근처 살면."},
{"id":"T3770","line":5808,"t":"우리 엄마가"},
{"id":"T3771","line":5808,"t":"예단은 꼭"},
{"id":"T3772","line":5808,"t":"나 가게 대출이"},
{"id":"T3773","line":5808,"t":"조금 남았어."},
{"id":"T3774","line":5809,"t":"부모님 얘기도"},
{"id":"T3775","line":5809,"t":"해야겠지?"},
{"id":"T3776","line":5811,"t":"부모님 돈은 받는 건지 빌리는 건지 정하고 종이로 남기자"},
{"id":"T3777","line":5812,"t":"부모님께 받은 돈은 증여면 신고하고, 빌린 거면 차용증과 이자 기록을 남긴다(국세청). 혼인할 때 부모님 증여에는 따로 공제가 있다(국세청, 한도 확인 필요)."},
{"id":"T3778","line":5813,"t":"부모님 일은 각자 알아서 하자"},
{"id":"T3779","line":5814,"t":"편해 보였지만 큰돈은 결국 둘의 돈이 된다. {c.은} \"그래도 같이 알고는 있자\" 했다."},
{"id":"T3780","line":5815,"t":"양가 똑같이 맞추자"},
{"id":"T3781","line":5816,"t":"똑같이는 쉽지 않다. 형편이 다르면 숫자보다 마음을 맞춘다. 그래도 표에 적은 건 잘했다."},
{"id":"T3782","line":5818,"t":"말인데..."},
{"id":"T3783","line":5820,"t":"결혼하자고 말한다"},
{"id":"T3784","line":5821,"t":"아직은 아니라고 말한다"},
{"id":"T3785","line":5822,"t":"{c.은} \"그래, 우리 속도대로\" 했다. 표는 서랍에 넣었다."},
{"id":"T3786","line":5824,"t":"한 해 뒤"},
{"id":"T3787","line":5824,"t":"다시 꺼낸 표"},
{"id":"T3788","line":5828,"t":"{c.과} 다시"},
{"id":"T3789","line":5828,"t":"마주 앉았다."},
{"id":"T3790","line":5830,"t":"작년 그 표,"},
{"id":"T3791","line":5830,"t":"나 다시 봤어."},
{"id":"T3792","line":5832,"t":"이번엔 둘이 처음부터 다시 쓰자"},
{"id":"T3793","line":5833,"t":"우리 여기까지 하자"},
{"id":"T3794","line":5834,"t":"오래 걸었다. 헤어지는 말도 둘이 같이 정했다."},
{"id":"T3795","line":5836,"t":"예단·예물·축의금"},
{"id":"T3796","line":5840,"t":"언제 인사 오니?"},
{"id":"T3797","line":5842,"t":"할 거냐?"},
{"id":"T3798","line":5844,"t":"예단·예물 (집마다 다름)"},
{"id":"T3799","line":5844,"t":"생략·간소·관례"},
{"id":"T3800","line":5844,"t":"반지 하나"},
{"id":"T3801","line":5844,"t":"생략 가능"},
{"id":"T3802","line":5844,"t":"정하는 사람"},
{"id":"T3803","line":5844,"t":"우리 둘"},
{"id":"T3804","line":5845,"t":"우리 둘이"},
{"id":"T3805","line":5845,"t":"먼저 정해서"},
{"id":"T3806","line":5845,"t":"말씀드리자."},
{"id":"T3807","line":5847,"t":"둘이 정한 예산을 먼저 말씀드리고 양가에 같은 말로 전한다"},
{"id":"T3808","line":5848,"t":"예단·예물은 법으로 정한 것도, 정해진 금액도 없다. 둘이 기준을 먼저 정해 같은 말로 전하면 오해가 준다."},
{"id":"T3809","line":5849,"t":"부모님 뜻대로 하시게 둔다"},
{"id":"T3810","line":5850,"t":"양가 뜻이 다르면 둘이 말을 나르는 통로가 된다. 오가는 말이 커질수록 둘의 예산이 흔들린다."},
{"id":"T3811","line":5851,"t":"다 생략하자고 통보한다"},
{"id":"T3812","line":5852,"t":"생략도 방법이다. 다만 통보는 상처가 된다. 이유를 같이 말씀드리는 쪽이 낫다."},
{"id":"T3813","line":5854,"t":"축의금 장부를"},
{"id":"T3814","line":5854,"t":"누가 맡을지도"},
{"id":"T3815","line":5854,"t":"정했다."},
{"id":"T3816","line":5856,"t":"부모님 손님 몫은 부모님께, 우리 손님 몫은 우리 통장에"},
{"id":"T3817","line":5857,"t":"집마다 다르다. 미리 정해 두면 식 끝나고 봉투 앞에서 다투지 않는다."},
{"id":"T3818","line":5858,"t":"다 합쳐서 식비부터 낸다"},
{"id":"T3819","line":5859,"t":"그것도 방법이다. 장부는 꼭 적어 둔다. 답례하거나 남의 경조사에 갈 때 쓴다."},
{"id":"T3820","line":5861,"t":"전세·매매·대출"},
{"id":"T3821","line":5865,"t":"신혼집 앱을"},
{"id":"T3822","line":5865,"t":"밤마다 연다."},
{"id":"T3823","line":5866,"t":"은행 창구 직원"},
{"id":"T3824","line":5867,"t":"신혼 집 돈 (요약)"},
{"id":"T3825","line":5867,"t":"신혼 전세자금"},
{"id":"T3826","line":5867,"t":"주택도시기금"},
{"id":"T3827","line":5867,"t":"혼인 7년·예정 3개월"},
{"id":"T3828","line":5867,"t":"소득·자산"},
{"id":"T3829","line":5867,"t":"기준 확인 필요"},
{"id":"T3830","line":5867,"t":"신혼 특공"},
{"id":"T3831","line":5867,"t":"청약홈 공고별"},
{"id":"T3832","line":5868,"t":"신혼부부 전용"},
{"id":"T3833","line":5868,"t":"전세자금 대출도"},
{"id":"T3834","line":5868,"t":"있어요."},
{"id":"T3835","line":5870,"t":"처음부터"},
{"id":"T3836","line":5870,"t":"사는 게"},
{"id":"T3837","line":5870,"t":"낫지 않아?"},
{"id":"T3838","line":5870,"t":"처음부터"},
{"id":"T3839","line":5870,"t":"사는 게"},
{"id":"T3840","line":5870,"t":"낫지 않아?"},
{"id":"T3841","line":5871,"t":"전세로 시작해서"},
{"id":"T3842","line":5871,"t":"같이 모으자."},
{"id":"T3843","line":5873,"t":"달마다 갚을 돈과 소득 기준부터 셈하고 정책 대출을 먼저 본다"},
{"id":"T3844","line":5874,"t":"신혼부부 전세자금·구입자금 대출은 주택도시기금이 소득·자산 기준을 본다. 기준은 자주 바뀌니 기금 누리집과 은행에서 확인한다."},
{"id":"T3845","line":5875,"t":"둘 연봉이면 은행이 알아서 한도를 주겠지"},
{"id":"T3846","line":5876,"t":"한도는 갚을 수 있는 돈이 아니다. 금리가 오르면 한도 끝까지 빌린 집이 먼저 흔들린다."},
{"id":"T3847","line":5878,"t":"계약 전날,"},
{"id":"T3848","line":5878,"t":"등기부를"},
{"id":"T3849","line":5878,"t":"둘이 같이 뗐다."},
{"id":"T3850","line":5880,"t":"계약하고 이삿날 바로 전입신고와 확정일자를 한다"},
{"id":"T3851","line":5881,"t":"전세 보증금은 계약서, 전입신고, 확정일자가 지켜 준다(주택임대차보호법). 둘이 낸 돈 비율은 따로 적어 둔다."},
{"id":"T3852","line":5882,"t":"바쁘니 전입은 결혼식 끝나고"},
{"id":"T3853","line":5883,"t":"전입이 늦으면 그사이 생긴 담보에 밀릴 수 있다. 이삿날 바로 한다."},
{"id":"T3854","line":5886,"t":"서른의 식탁"},
{"id":"T3855","line":5886,"t":"나는 어떻게 살까"},
{"id":"T3856","line":5890,"t":"청첩장이 한 달에"},
{"id":"T3857","line":5890,"t":"두 장씩 온다."},
{"id":"T3858","line":5891,"t":"동기 {f}"},
{"id":"T3859","line":5892,"t":"결혼 생각 있어?"},
{"id":"T3860","line":5892,"t":"나는 반반."},
{"id":"T3861","line":5894,"t":"나는 어떻게"},
{"id":"T3862","line":5894,"t":"살고 싶더라?"},
{"id":"T3863","line":5895,"t":"귀인 할배"},
{"id":"T3864","line":5896,"t":"허허, 결혼은"},
{"id":"T3865","line":5896,"t":"숙제가 아니라"},
{"id":"T3866","line":5896,"t":"고르는 거야."},
{"id":"T3867","line":5898,"t":"혼자 사는 삶을 내 방식으로 설계한다"},
{"id":"T3868","line":5899,"t":"혼자여도 빈칸 없는 삶. 연금, 보험, 비상 연락처를 내 이름으로 챙기기로 했다."},
{"id":"T3869","line":5900,"t":"열어 둔다. 좋은 사람이 오면 만난다"},
{"id":"T3870","line":5901,"t":"서두르지 않기로 했다. 만나는 일도 혼자 사는 일도 똑같이 여기기로 했다."},
{"id":"T3871","line":5902,"t":"결혼정보회사 상담을 받아 본다"},
{"id":"T3872","line":5903,"t":"다음 주 토요일, 상담 예약 문자가 왔다."},
{"id":"T3873","line":5904,"t":"귀인 할배"},
{"id":"T3874","line":5905,"t":"어느 쪽이든"},
{"id":"T3875","line":5905,"t":"돈 얘기는"},
{"id":"T3876","line":5905,"t":"똑같이 해야 하네."},
{"id":"T3877","line":5907,"t":"서른의 소개팅"},
{"id":"T3878","line":5907,"t":"연봉을 묻는 사람"},
{"id":"T3879","line":5910,"t":"[톡] {f}"},
{"id":"T3880","line":5911,"t":"내 회사 동료"},
{"id":"T3881","line":5911,"t":"소개해 줄까?"},
{"id":"T3882","line":5911,"t":"착한데 직진이야."},
{"id":"T3883","line":5913,"t":"개발 일 해요."},
{"id":"T3884","line":5913,"t":"돌려 말하는 걸"},
{"id":"T3885","line":5913,"t":"잘 못해요."},
{"id":"T3886","line":5915,"t":"솔직히 연봉"},
{"id":"T3887","line":5915,"t":"물어봐도"},
{"id":"T3888","line":5917,"t":"아직 이르다고 말하고, 돈 쓰는 습관부터 얘기한다"},
{"id":"T3889","line":5918,"t":"{c.은} \"그게 더 중요하죠\" 했다. 둘 다 적금 하나, 취미에 쓰는 돈 하나가 있었다."},
{"id":"T3890","line":5919,"t":"숫자 그대로 말한다"},
{"id":"T3891","line":5920,"t":"{c.도} 자기 연봉을 말했다. 솔직해서 편했다. 조금 빨랐다는 생각도 들었다."},
{"id":"T3892","line":5921,"t":"그런 질문은 불편하다고 말한다"},
{"id":"T3893","line":5922,"t":"{c.은} 바로 사과했다. \"제가 서둘렀네요.\" 그 말이 오히려 좋았다."},
{"id":"T3894","line":5924,"t":"다음 주에"},
{"id":"T3895","line":5924,"t":"또 볼래요?"},
{"id":"T3896","line":5926,"t":"{c.은} 그 자리에서 식당을 예약했다."},
{"id":"T3897","line":5927,"t":"조금 생각해 볼게요"},
{"id":"T3898","line":5927,"t":"{c.은} \"편할 때 연락 주세요\" 했다."},
{"id":"T3899","line":5929,"t":"부모님의 조건"},
{"id":"T3900","line":5929,"t":"집을 보태 주신대"},
{"id":"T3901","line":5933,"t":"우리 부모님이"},
{"id":"T3902","line":5933,"t":"집값을 보태"},
{"id":"T3903","line":5933,"t":"주신대."},
{"id":"T3904","line":5935,"t":"부모님 제안"},
{"id":"T3905","line":5935,"t":"집값 일부"},
{"id":"T3906","line":5935,"t":"부모님 집 근처"},
{"id":"T3907","line":5936,"t":"대신 근처에"},
{"id":"T3908","line":5936,"t":"살라고 하시고,"},
{"id":"T3909","line":5936,"t":"명의는 부모님."},
{"id":"T3910","line":5938,"t":"고맙지만 조건은 둘이 정하자. 받는 건지 빌리는 건지 종이로 남기자"},
{"id":"T3911","line":5939,"t":"명의가 부모님이면 그 집은 부모님 것이다. 받으면 증여로 신고하고, 빌리면 차용증과 이자를 남긴다(국세청). {c.은} \"부모님께 같이 가서 말하자\" 했다."},
{"id":"T3912","line":5940,"t":"감사히 받고 근처에 산다"},
{"id":"T3913","line":5941,"t":"집 걱정은 덜었다. 주말마다 저녁을 같이 먹었다. 좋은 날도, 숨 막히는 날도 있었다."},
{"id":"T3914","line":5942,"t":"그 조건이면 받지 말자"},
{"id":"T3915","line":5943,"t":"{c.은} 한참 있다가 \"부모님은 서운하시겠다\" 했다. 둘이 모은 돈으로 작게 시작하기로 했다."},
{"id":"T3916","line":5945,"t":"헤어지는 길,"},
{"id":"T3917","line":5945,"t":"{c.이}"},
{"id":"T3918","line":5945,"t":"뒤를 돌아봤다."},
{"id":"T3919","line":5947,"t":"사귀자고 말한다"},
{"id":"T3920","line":5948,"t":"천천히 더 만난다"},
{"id":"T3921","line":5948,"t":"{c.은} \"천천히도 좋아요\" 했다."},
{"id":"T3922","line":5950,"t":"결혼정보회사"},
{"id":"T3923","line":5950,"t":"가입 계약서"},
{"id":"T3924","line":5954,"t":"회원님 조건이면"},
{"id":"T3925","line":5954,"t":"이번 달에"},
{"id":"T3926","line":5954,"t":"세 분 소개돼요."},
{"id":"T3927","line":5956,"t":"회원 가입 계약서"},
{"id":"T3928","line":5956,"t":"소개 횟수"},
{"id":"T3929","line":5956,"t":"중도 해지"},
{"id":"T3930","line":5956,"t":"환불 기준 ?"},
{"id":"T3931","line":5956,"t":"신고 번호"},
{"id":"T3932","line":5957,"t":"오늘 가입하시면"},
{"id":"T3933","line":5957,"t":"한 번 더"},
{"id":"T3934","line":5957,"t":"소개해 드려요."},
{"id":"T3935","line":5959,"t":"환불 기준과 소개 횟수를 계약서에 적어 받고, 신고한 업체인지 본다"},
{"id":"T3936","line":5960,"t":"국내 결혼중개업체는 시·군·구에 신고하고 계약서를 줘야 한다(결혼중개업법, 여성가족부). 중도 해지 환불은 공정거래위원회 표준약관을 보고, 다툼은 한국소비자원 1372에 묻는다(세부 기준 확인 필요)."},
{"id":"T3937","line":5961,"t":"오늘만 혜택이라니 바로 가입한다"},
{"id":"T3938","line":5962,"t":"\"오늘만\"은 조건이 아니라 재촉이다. 환불 조항을 못 본 채 서명했다."},
{"id":"T3939","line":5963,"t":"가입은 안 하고 상담만 받고 나온다"},
{"id":"T3940","line":5964,"t":"조건표를 들고 나왔다. 내가 뭘 바라는지 적어 본 것만은 남았다."},
{"id":"T3941","line":5966,"t":"예물과 청약"},
{"id":"T3942","line":5966,"t":"숫자에 밝은 사람"},
{"id":"T3943","line":5970,"t":"청약 가점"},
{"id":"T3944","line":5970,"t":"계산해 봤어요."},
{"id":"T3945","line":5970,"t":"혼자면 낮아요."},
{"id":"T3946","line":5972,"t":"{c}의 메모"},
{"id":"T3947","line":5972,"t":"각자 + 공동 하나"},
{"id":"T3948","line":5972,"t":"신혼 특공 검토"},
{"id":"T3949","line":5972,"t":"어머니는 세트"},
{"id":"T3950","line":5972,"t":"둘이 같이?"},
{"id":"T3951","line":5973,"t":"우리 엄마가"},
{"id":"T3952","line":5973,"t":"예물은 세트로"},
{"id":"T3953","line":5973,"t":"하재요."},
{"id":"T3954","line":5975,"t":"예물은 둘이 정한 예산 안에서. 어머니께는 같이 말씀드리자"},
{"id":"T3955","line":5976,"t":"{c.은} \"같이 가 주면 든든하죠\" 했다. 둘의 예산표에 줄이 하나 늘었다."},
{"id":"T3956","line":5977,"t":"어머니 뜻대로 해 드리자"},
{"id":"T3957","line":5978,"t":"{c.은} 고마워하면서도 \"그럼 집 예산에서 빠져요\" 하고 숫자를 바로 고쳤다."},
{"id":"T3958","line":5979,"t":"예물은 없어도 된다고 본다"},
{"id":"T3959","line":5980,"t":"{c.은} \"저도요. 엄마 설득이 문제죠\" 하고 웃었다."},
{"id":"T3960","line":5982,"t":"조건표에 없는"},
{"id":"T3961","line":5982,"t":"세 시간 했다."},
{"id":"T3962","line":5984,"t":"사귀자고 말한다"},
