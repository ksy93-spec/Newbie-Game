{"id":"T7084","line":14581,"t":"모두 마침"},
{"id":"T7085","line":14586,"t":"급한 건 아직 없지."},
{"id":"T7086","line":14586,"t":" 있을 때"},
{"id":"T7087","line":14586,"t":"집 공부를 해 두게."},
{"id":"T7088","line":14597,"t":"다시 보기"},
{"id":"T7089","line":14598,"t":"다시 보기"},
{"id":"T7090","line":14598,"t":"수집 노트"},
{"id":"T7091","line":14610,"t":"첫 퀘스트를 끝내면"},
{"id":"T7092","line":14610,"t":"원룸 월세로 이사하면"},
{"id":"T7093","line":14610,"t":"보스를 처음 이기면"},
{"id":"T7094","line":14610,"t":"메인 3장을 마친 다음 날"},
{"id":"T7095","line":14610,"t":"사흘 넘게 쉬다 돌아오면"},
{"id":"T7096","line":14614,"t":"이야기 조각 "},
{"id":"T7097","line":14618,"t":"<span class=\"idesc\">다시 보기</span>"},
{"id":"T7098","line":14618,"t":"<span class=\"idesc\">잠김</span>"},
{"id":"T7099","line":14627,"t":"[택배] 주소지 불일치로 배송이 보류되었습니다. 주소 확인: http://bit.ly/…"},
{"id":"T7100","line":14628,"t":"링크를 눌러 주소를 고친다"},
{"id":"T7101","line":14628,"t":"이상한 앱이 깔렸다. 통신사에 전화하고 비밀번호를 전부 바꾸느라 반나절을 날렸다."},
{"id":"T7102","line":14629,"t":"택배사 공식 앱에서 직접 조회한다"},
{"id":"T7103","line":14629,"t":"보류된 택배는 없었다. 스미싱이었다."},
{"id":"T7104","line":14630,"t":"118에 신고하고 문자를 지운다"},
{"id":"T7105","line":14630,"t":"신고 완료. 같은 번호로 온 문자가 차단됐다."},
{"id":"T7106","line":14631,"t":"주소 확인, 택배 보류, 과태료 조회 문자에 달린 링크는 누르지 말게. 의심 문자는 118에 신고하면 되네."},
{"id":"T7107","line":14632,"t":"모르는 번호"},
{"id":"T7108","line":14632,"t":"\"서울중앙지검 수사관입니다. 고객님 명의 계좌가 범죄에 이용돼 안전계좌로 옮기셔야 합니다.\""},
{"id":"T7109","line":14633,"t":"시키는 대로 안전계좌로 옮긴다"},
{"id":"T7110","line":14633,"t":"전화가 끊기고 다시는 연결되지 않았다."},
{"id":"T7111","line":14634,"t":"전화를 끊고 대표번호로 확인한다"},
{"id":"T7112","line":14634,"t":"그런 수사는 없다고 했다."},
{"id":"T7113","line":14635,"t":"수사기관은 전화로 돈을 옮기라고 하지 않아. 이미 보냈다면 곧바로 112에 지급정지를 부탁하게."},
{"id":"T7114","line":14636,"t":"중고거래 채팅"},
{"id":"T7115","line":14636,"t":"\"직거래는 어렵고요, 여기 안전결제 링크로 결제해 주시면 바로 보낼게요~\""},
{"id":"T7116","line":14638,"t":"링크로 결제한다"},
{"id":"T7117","line":14638,"t":"결제 페이지가 가짜였다. 판매자는 사라졌다."},
{"id":"T7118","line":14639,"t":"앱 안 결제가 아니면 안 산다고 한다"},
{"id":"T7119","line":14639,"t":"판매자가 대화방을 나갔다."},
{"id":"T7120","line":14640,"t":"계좌번호를 경찰청 사이버범죄 신고시스템에서 조회한다"},
{"id":"T7121","line":14640,"t":"사기 신고가 세 건 있는 계좌였다."},
{"id":"T7122","line":14641,"t":"앱 밖으로 불러내서 안전결제 링크를 보내면 거의 사기라고 보면 되네."},
{"id":"T7123","line":14642,"t":"카드사 문자"},
{"id":"T7124","line":14642,"t":"\"이번 달 결제 부담되시죠? 리볼빙 신청하시면 최소 금액만 결제됩니다.\""},
{"id":"T7125","line":14644,"t":"편하니까 신청한다"},
{"id":"T7126","line":14644,"t":"다음 달 명세서에 수수료가 붙어 있었다."},
{"id":"T7127","line":14645,"t":"신청하지 않고 지출을 줄인다"},
{"id":"T7128","line":14645,"t":"한 달 동안 배달을 끊었다. 통장은 무사하다."},
{"id":"T7129","line":14646,"t":"리볼빙은 넘긴 금액에 높은 수수료가 붙는 빚이야. 한 번 빠지면 원금이 잘 안 줄어."},
{"id":"T7130","line":14647,"t":"앱 알림"},
{"id":"T7131","line":14647,"t":"\"무료 체험이 3일 뒤 끝납니다. 이후 월 13,900원이 결제됩니다.\""},
{"id":"T7132","line":14648,"t":"그냥 둔다"},
{"id":"T7133","line":14648,"t":"한 번도 안 봤는데 13,900원이 빠져나갔다."},
{"id":"T7134","line":14649,"t":"바로 해지한다"},
{"id":"T7135","line":14649,"t":"해지 완료. 한 달 커피값을 지켰다."},
{"id":"T7136","line":14650,"t":"무료 체험은 가입하자마자 해지 예약을 걸어 두는 게 제일이지."},
{"id":"T7137","line":14651,"t":"통장 알림"},
{"id":"T7138","line":14651,"t":"월급날인데 입금 알림이 오지 않는다. 팀장은 \"회사 사정이 좀…\"이라고만 한다."},
{"id":"T7139","line":14653,"t":"참고 기다린다"},
{"id":"T7140","line":14653,"t":"두 달째 소식이 없다."},
{"id":"T7141","line":14654,"t":"근로계약서와 급여명세서를 챙겨 노동청에 진정한다"},
{"id":"T7142","line":14654,"t":"근로감독관 조사 끝에 밀린 월급과 지연이자가 들어왔다."},
{"id":"T7143","line":14655,"t":"임금은 정해진 날 줘야 하네. 못 받으면 고용노동부에 진정을 넣을 수 있고, 지연이자도 붙어."},
{"id":"T7144","line":14656,"t":"편의점 점장"},
{"id":"T7145","line":14656,"t":"\"수습 3개월은 시급 9천원이야. 원래 다 그래.\""},
{"id":"T7146","line":14658,"t":"그런가 보다 하고 일한다"},
{"id":"T7147","line":14658,"t":"석 달 동안 최저임금보다 적게 받았다."},
{"id":"T7148","line":14659,"t":"단순노무 알바는 수습 감액이 안 된다고 말한다"},
{"id":"T7149","line":14659,"t":"점장이 알아보더니 시급을 고쳐 줬다."},
{"id":"T7150","line":14660,"t":"편의점 같은 단순노무 일은 수습이어도 최저임금을 깎을 수 없네. 2026년 최저시급은 10,320원이야."},
{"id":"T7151","line":14661,"t":"\"대출 때문에 그런데, 전입신고는 좀 나중에 해 주면 안 될까요?\""},
{"id":"T7152","line":14663,"t":"부탁이니 들어준다"},
{"id":"T7153","line":14663,"t":"며칠 뒤 등기부를 떼 보니 집에 근저당이 새로 잡혀 있었다."},
{"id":"T7154","line":14664,"t":"바로 전입신고하고 확정일자를 받는다"},
{"id":"T7155","line":14664,"t":"대항력과 우선변제권을 챙겼다."},
{"id":"T7156","line":14665,"t":"전입신고를 미뤄 달라는 집주인은 조심하게. 보증금을 지키는 힘이 전입신고와 확정일자에서 나와."},
{"id":"T7157","line":14666,"t":"길에서 만난 사람"},
{"id":"T7158","line":14666,"t":"\"설문 하나만 해 주시면 선물 드려요. 근처 사무실에서 잠깐이면 돼요.\""},
{"id":"T7159","line":14667,"t":"따라간다"},
{"id":"T7160","line":14667,"t":"두 시간 동안 \"부업 설명회\"를 들었다. 가입비 얘기가 나왔다."},
{"id":"T7161","line":14668,"t":"정중히 거절하고 지나간다"},
{"id":"T7162","line":14668,"t":"가던 길을 갔다."},
{"id":"T7163","line":14669,"t":"공짜 선물로 사무실까지 데려가는 건 다단계 권유인 경우가 많네."},
{"id":"T7164","line":14670,"t":"보험설계사 친구"},
{"id":"T7165","line":14670,"t":"\"실손 하나 더 들어 둬. 두 개면 병원비 두 배로 나와!\""},
{"id":"T7166","line":14672,"t":"친구니까 가입한다"},
{"id":"T7167","line":14672,"t":"나중에 청구해 보니 나눠서 나올 뿐이었다. 보험료만 두 번."},
{"id":"T7168","line":14673,"t":"실손은 실제로 낸 돈만 나온다며 거절한다"},
{"id":"T7169","line":14673,"t":"친구가 머쓱하게 웃었다."},
{"id":"T7170","line":14674,"t":"실손은 실제 손해만 보상해. 겹쳐 들면 보험료만 두 배지."},
{"id":"T7171","line":14675,"t":"휴대폰 달력"},
{"id":"T7172","line":14675,"t":"다음 달 해외여행. 여권을 꺼내 보니 유효기간이 4개월 남았다."},
{"id":"T7173","line":14677,"t":"아직 안 지났으니 그냥 간다"},
{"id":"T7174","line":14677,"t":"공항 카운터에서 탑승을 거절당했다."},
{"id":"T7175","line":14678,"t":"미리 재발급받는다"},
{"id":"T7176","line":14678,"t":"새 여권으로 무사히 출국했다."},
{"id":"T7177","line":14679,"t":"많은 나라가 여권 잔여기간 6개월 이상을 요구하네. 떠나기 전에 꼭 확인하게."},
{"id":"T7178","line":14680,"t":"회사 공지"},
{"id":"T7179","line":14680,"t":"\"연말정산 간소화 자료 제출 기한은 다음 주 금요일까지입니다.\""},
{"id":"T7180","line":14682,"t":"나중에 하지 뭐"},
{"id":"T7181","line":14682,"t":"기한이 지나 받을 수 있던 공제를 놓쳤다."},
{"id":"T7182","line":14683,"t":"간소화 자료와 빠진 영수증을 챙겨 낸다"},
{"id":"T7183","line":14683,"t":"2월 월급과 함께 환급금이 들어왔다."},
{"id":"T7184","line":14684,"t":"간소화 서비스에 안 잡히는 월세나 안경 구입비는 따로 챙겨서 내야 하네."},
{"id":"T7185","line":14685,"t":"공인중개사"},
{"id":"T7186","line":14685,"t":"\"등기부는 제가 봤는데 깨끗해요. 굳이 안 떼 보셔도 돼요. 계약금부터 넣으시죠.\""},
{"id":"T7187","line":14687,"t":"믿고 계약금을 보낸다"},
{"id":"T7188","line":14687,"t":"입주 전에 등기부를 떼 보니 근저당이 집값의 대부분이었다. 계약금을 돌려받는 데 한 달이 걸렸다."},
{"id":"T7189","line":14688,"t":"인터넷등기소에서 직접 등기부를 떼 본다"},
{"id":"T7190","line":14688,"t":"소유자 이름이 계약서와 같고 압류도 없었다. 안심하고 계약했다."},
{"id":"T7191","line":14689,"t":"등기부를 떼서 근저당 금액과 내 보증금을 더해 본다"},
{"id":"T7192","line":14689,"t":"합계가 집값에 바짝 붙어 있었다. 다른 집을 찾았고 큰 손해를 피했다."},
{"id":"T7193","line":14690,"t":"등기부등본은 인터넷등기소에서 누구나 직접 뗄 수 있네. 갑구에서 소유자와 압류를, 을구에서 근저당을 보게. 중개인 말만 믿고 넘어가면 안 되지."},
{"id":"T7194","line":14691,"t":"집주인 문자"},
{"id":"T7195","line":14691,"t":"\"관리비는 월 정액이에요. 뭐가 들었는지는 그냥 다 포함이에요.\""},
{"id":"T7196","line":14693,"t":"묻지 않고 그대로 계약한다"},
{"id":"T7197","line":14693,"t":"살아 보니 쓰지도 않는 청소비와 인터넷 요금까지 관리비에 들어 있었다."},
{"id":"T7198","line":14694,"t":"관리비에 뭐가 들었는지 계약서에 적어 달라고 한다"},
{"id":"T7199","line":14694,"t":"수도, 인터넷, 청소비가 나뉘어 적혔다. 다툼이 생겨도 근거가 있다."},
{"id":"T7200","line":14695,"t":"이전 세입자에게 실제 청구 내역을 물어본다"},
{"id":"T7201","line":14695,"t":"정액에 포함된 항목과 따로 내는 항목을 미리 알고 협상했다."},
{"id":"T7202","line":14696,"t":"관리비는 정액이라 해도 무엇이 포함인지 계약서에 적어 두게. 전기나 가스처럼 실제 쓴 만큼 내는 항목은 따로 나오는 경우가 많다네."},
{"id":"T7203","line":14697,"t":"\"다음 세입자가 아직 안 구해졌어요. 보증금은 두 달만 기다려 주세요. 이사는 먼저 가셔도 돼요.\""},
{"id":"T7204","line":14699,"t":"알겠다며 짐을 빼고 전입신고도 옮긴다"},
{"id":"T7205","line":14699,"t":"전입신고를 옮기자 대항력이 사라졌다. 그 사이 집이 경매에 넘어가 보증금이 위태로워졌다."},
{"id":"T7206","line":14700,"t":"내용증명을 보내고 기다린다"},
{"id":"T7207","line":14700,"t":"기록은 남겼지만 이사하면 지킬 권리가 약해지는 건 그대로였다."},
{"id":"T7208","line":14701,"t":"임차권등기명령을 신청하고 등기가 된 걸 확인한 뒤 이사한다"},
{"id":"T7209","line":14701,"t":"법원 등기가 끝난 걸 확인하고 이사했다. 보증금을 받을 권리는 그대로 남았다."},
{"id":"T7210","line":14702,"t":"보증금을 못 받은 채 이사해야 하면 법원에 임차권등기명령을 신청하게. 등기부에 임차권등기가 올라간 걸 확인한 뒤에 전입신고를 옮기고 이사하는 게 순서네."},
{"id":"T7211","line":14703,"t":"택배 앱"},
{"id":"T7212","line":14703,"t":"\"배송완료\" 알림이 떴는데 문 앞에 택배가 없다. 이번 달 큰맘 먹고 산 물건이다."},
{"id":"T7213","line":14704,"t":"그냥 포기한다"},
{"id":"T7214","line":14704,"t":"이웃에게 물어보지도 않고 넘겼다. 큰맘 먹고 산 물건은 그렇게 사라졌다."},
{"id":"T7215","line":14705,"t":"경비실과 이웃에게 먼저 물어본다"},
{"id":"T7216","line":14705,"t":"옆집이 잘못 받아 두고 있었다. 무사히 되찾았다."},
{"id":"T7217","line":14706,"t":"배송완료 사진, 운송장, 구매내역을 모아 택배사와 판매처에 접수한다"},
{"id":"T7218","line":14706,"t":"판매처가 물건을 다시 보내 줬다."},
{"id":"T7219","line":14707,"t":"택배는 운송장에 물품 가액을 적지 않으면 분실 배상 한도가 50만원이네. 비싼 물건은 가액을 적어서 보내게. 해결이 안 되면 1372 소비자상담센터에 물어볼 수 있어."},
{"id":"T7220","line":14708,"t":"휴대폰 매장"},
{"id":"T7221","line":14708,"t":"\"이 요금제 6개월만 쓰시면 최신폰이 사실상 공짜예요. 그 뒤엔 바꾸셔도 돼요.\""},
{"id":"T7222","line":14709,"t":"권하는 대로 서명한다"},
{"id":"T7223","line":14709,"t":"유지 기간과 부가서비스가 붙어 있었다. 한 달 요금이 훌쩍 뛰었다."},
{"id":"T7224","line":14710,"t":"유지 기간, 부가서비스, 총액을 물어본다"},
{"id":"T7225","line":14710,"t":"집에 와서 계산해 보니 공짜가 아니었다."},
{"id":"T7226","line":14711,"t":"자급제 폰을 사고 선택약정 요금할인과 총액을 비교한다"},
{"id":"T7227","line":14711,"t":"폰값과 요금을 합쳐 보니 이쪽이 더 쌌다."},
{"id":"T7228","line":14712,"t":"휴대폰은 지원금을 받고 요금제를 일정 기간 유지하는 방법과, 자급제로 사서 선택약정 요금할인을 받는 방법이 있네. 폰값과 요금을 합친 총액으로 비교하게."},
{"id":"T7229","line":14713,"t":"통신비 고지서"},
{"id":"T7230","line":14713,"t":"이번 달 통신비도 만만치 않다. 데이터는 절반도 못 썼는데."},
{"id":"T7231","line":14714,"t":"그냥 쓴다"},
{"id":"T7232","line":14714,"t":"다음 달에도 안 쓰는 데이터 요금을 냈다."},
{"id":"T7233","line":14715,"t":"알뜰폰 요금제를 찾아본다"},
{"id":"T7234","line":14715,"t":"같은 통신망을 쓰는데 요금이 눈에 띄게 줄었다."},
{"id":"T7235","line":14716,"t":"남은 약정과 위약금부터 확인한 뒤 알뜰폰으로 옮긴다"},
{"id":"T7236","line":14716,"t":"약정이 끝나는 달에 맞춰 옮겨 위약금 없이 갈아탔다."},
{"id":"T7237","line":14717,"t":"알뜰폰은 통신 3사의 망을 빌려 쓰니 통화 품질은 비슷하고 요금은 싼 편이네. 옮기기 전에 지금 약정이 남았는지 위약금부터 확인하게."},
{"id":"T7238","line":14718,"t":"카드 앱"},
{"id":"T7239","line":14718,"t":"\"연회비가 결제되었습니다.\" 이 카드는 지난 1년 동안 한두 번밖에 안 썼다."},
{"id":"T7240","line":14720,"t":"그냥 둔다"},
{"id":"T7241","line":14720,"t":"다음 해에도 연회비가 또 빠져나갔다."},
{"id":"T7242","line":14721,"t":"안 쓰는 카드는 해지하고 남은 기간의 연회비를 돌려받을 수 있는지 묻는다"},
{"id":"T7243","line":14721,"t":"카드사가 남은 기간분을 계산해서 돌려줬다."},
{"id":"T7244","line":14722,"t":"혜택이 연회비보다 큰지 따져 보고 쓸 카드 하나만 남긴다"},
{"id":"T7245","line":14722,"t":"전월실적 조건을 채우는 카드만 남기고 나머지는 정리했다."},
{"id":"T7246","line":14723,"t":"안 쓰는 카드는 연회비만 나가네. 혜택이 연회비보다 큰지 따져 보고, 해지할 때는 남은 기간의 연회비를 돌려받을 수 있는지 카드사에 물어보게."},
{"id":"T7247","line":14724,"t":"첫 급여명세서"},
{"id":"T7248","line":14724,"t":"월급이 계약한 금액보다 적게 들어왔다. 명세서에는 처음 보는 공제 항목이 줄줄이 적혀 있다."},
{"id":"T7249","line":14726,"t":"읽어 보지 않고 넘긴다"},
{"id":"T7250","line":14726,"t":"식대 항목이 빠져 있었지만 알아채지 못한 채 몇 달이 지났다."},
{"id":"T7251","line":14727,"t":"회사가 몰래 뗐다고 화내며 인사팀에 따진다"},
{"id":"T7252","line":14727,"t":"인사팀이 공제 항목을 하나씩 설명해 줬다. 얼굴이 뜨거워졌다."},
{"id":"T7253","line":14728,"t":"항목을 하나씩 읽고 모르는 것만 인사팀에 묻는다"},
{"id":"T7254","line":14728,"t":"공제는 맞았고, 빠진 수당 하나를 찾아 다음 달에 정정받았다."},
{"id":"T7255","line":14729,"t":"월급에서는 국민연금, 건강보험, 고용보험료와 소득세가 빠지네. 산재보험은 회사가 전부 내지. 회사는 임금명세서를 줘야 하니 항목을 꼭 읽어 보게."},
{"id":"T7256","line":14730,"t":"\"오늘도 좀 남아서 마무리하고 가자. 수당은 뭐, 다음에 챙겨 줄게.\""},
{"id":"T7257","line":14732,"t":"말없이 계속 남는다"},
{"id":"T7258","line":14732,"t":"한 달 내내 야근했는데 수당은 한 푼도 없었다."},
{"id":"T7259","line":14733,"t":"계약서에 포괄임금이 적혀 있는지부터 확인한다"},
{"id":"T7260","line":14733,"t":"포괄임금 문구가 없었다. 수당을 청구할 근거가 생겼다."},
{"id":"T7261","line":14734,"t":"퇴근 시간과 야근 시간을 기록해 두고 수당 처리 방법을 묻는다"},
{"id":"T7262","line":14734,"t":"기록 덕분에 연장근로수당을 계산해서 받았다."},
{"id":"T7263","line":14735,"t":"5인 이상 사업장은 연장근로에 통상임금의 1.5배를 줘야 하네. 연장근로는 주 12시간까지가 한도고. 출퇴근 시간은 꼭 기록해 두게."},
{"id":"T7264","line":14736,"t":"\"연차는 눈치 보여서 못 써. 다들 그냥 안 쓰고 넘기잖아.\""},
{"id":"T7265","line":14738,"t":"눈치 보며 안 쓴다"},
{"id":"T7266","line":14738,"t":"휴가 없이 반년을 버텼다. 몸이 먼저 지쳤다."},
{"id":"T7267","line":14739,"t":"미리 날짜를 잡아 연차를 신청한다"},
{"id":"T7268","line":14739,"t":"팀장이 일정만 조율해 줬다. 푹 쉬고 돌아왔다."},
{"id":"T7269","line":14740,"t":"입사 1년 미만이어도 한 달 개근할 때마다 연차가 하루씩 생기네. 5인 이상 사업장 기준이고, 쓸 날짜는 회사와 조율할 수 있어도 쓰는 건 자네 권리야."},
{"id":"T7270","line":14741,"t":"알바 사장님"},
{"id":"T7271","line":14741,"t":"\"4대보험은 안 들어 줄게. 대신 시급을 조금 올려 줄게. 세금 안 떼니까 너도 좋잖아.\""},
{"id":"T7272","line":14743,"t":"좋다며 받아들인다"},
{"id":"T7273","line":14743,"t":"일하다 손을 다쳤는데 산재 처리가 안 돼서 병원비를 직접 냈다."},
{"id":"T7274","line":14744,"t":"산재보험은 알바도 해당된다며 가입을 요청한다"},
{"id":"T7275","line":14744,"t":"사장님이 마지못해 산재보험 신고를 했다."},
{"id":"T7276","line":14745,"t":"근로시간과 임금을 서면으로 받아 두고 1350에 문의한다"},
{"id":"T7277","line":14745,"t":"상담원이 가입 대상 여부를 짚어 줬고, 사장님도 규정대로 처리했다."},
{"id":"T7278","line":14746,"t":"산재보험은 알바든 단시간이든 일하는 사람이면 모두 대상이네. 월 60시간 이상 일하면 건강보험과 국민연금도 들어야 하고. 헷갈리면 고용노동부 1350에 물어보게."},
{"id":"T7279","line":14747,"t":"중개사무소"},
{"id":"T7280","line":14747,"t":"\"이 집 전세가가 매매가랑 거의 같아요. 근데 집주인이 성실해서 걱정 없어요. 오늘 계약하면 깎아 드릴게요.\""},
{"id":"T7281","line":14749,"t":"싸다며 바로 계약한다"},
{"id":"T7282","line":14749,"t":"몇 달 뒤 집이 경매로 넘어갔다. 보증금은 앞선 빚에 밀려 돌려받지 못했다."},
{"id":"T7283","line":14750,"t":"실거래가와 등기부 근저당을 계산해 본다"},
{"id":"T7284","line":14750,"t":"전세가와 근저당을 더하니 집값을 넘었다. 계약을 접었다."},
{"id":"T7285","line":14751,"t":"계산한 뒤 전세보증보험 가입이 되는 집인지까지 확인한다"},
{"id":"T7286","line":14751,"t":"보증보험 가입이 안 된다는 답이 왔다. 미련 없이 다른 집을 찾았다."},
{"id":"T7287","line":14752,"t":"전세가가 매매가에 가까우면 경매로 넘어갈 때 보증금을 다 못 받을 수 있네. 실거래가, 근저당, 보증보험 가입 가능 여부를 계약 전에 확인하게. 서두르라는 말은 위험 신호야."},
{"id":"T7288","line":14753,"t":"중고차 사이트"},
{"id":"T7289","line":14753,"t":"\"시세보다 훨씬 싼 무사고 차량입니다. 딜러 수수료만 먼저 입금하시면 차를 가져다 드려요.\""},
{"id":"T7290","line":14755,"t":"수수료를 먼저 입금한다"},
{"id":"T7291","line":14755,"t":"차는 처음부터 없었다. 전화도 받지 않는다."},
{"id":"T7292","line":14756,"t":"직접 가서 차를 보고 판단한다"}]