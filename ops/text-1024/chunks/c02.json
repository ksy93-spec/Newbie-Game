[{"id":"T663","line":3099,"t":"서면 교부 의무 위반이라 신고할 수 있다"},
{"id":"T664","line":3099,"t":"구두 계약이라 효력이 없다"},
{"id":"T665","line":3099,"t":"수습 기간이니 문제없다"},
{"id":"T666","line":3100,"t":"교부하지 않은 것 자체가 위반이다. 계약이 무효가 되는 것은 아니므로 일한 임금은 그대로 청구할 수 있다."},
{"id":"T667","line":3101,"t":"연차는 언제 몇 개 생기나"},
{"id":"T668","line":3102,"t":"연차 며칠 있는지 알고 계세요?"},
{"id":"T669","line":3103,"t":"1년 미만 근로자의 연차는 어떻게 발생할까?"},
{"id":"T670","line":3103,"t":"1개월 개근하면 1일"},
{"id":"T671","line":3103,"t":"입사와 동시에 15일"},
{"id":"T672","line":3103,"t":"발생하지 않는다"},
{"id":"T673","line":3104,"t":"1개월 개근마다 1일씩 붙는다. 1년을 채우기 전에도 쓸 수 있는 휴가가 쌓이고 있다는 뜻이다."},
{"id":"T674","line":3105,"t":"1년간 80% 이상 출근한 근로자의 연차는?"},
{"id":"T675","line":3106,"t":"상시 5인 이상 사업장이면 15일이 기본이고, 근속 연수가 쌓이면 가산된다. 5인 미만 사업장은 연차 규정이 적용되지 않는다."},
{"id":"T676","line":3107,"t":"입사 8개월 동안 매달 개근했다면 쌓인 연차는 며칠일까?"},
{"id":"T677","line":3108,"t":"1개월 개근마다 1일이니 8일이다. 1년을 못 채우고 그만둬도 남은 연차는 수당으로 정산된다."},
{"id":"T678","line":3109,"t":"실업급여 기본 조건"},
{"id":"T679","line":3109,"t":"고용센터 상담원"},
{"id":"T680","line":3110,"t":"그만두기 전에 이거부터 확인하셔야 해요."},
{"id":"T681","line":3111,"t":"구직급여를 받으려면 이직 사유가 어때야 할까?"},
{"id":"T682","line":3112,"t":"원칙적으로 비자발적 이직이어야 한다"},
{"id":"T683","line":3112,"t":"자발적 퇴사여야 한다"},
{"id":"T684","line":3112,"t":"사유와 무관하다"},
{"id":"T685","line":3113,"t":"스스로 그만두면 원칙적으로 대상이 아니다. 다만 법이 정한 정당한 사유가 있으면 예외가 인정되는 경우가 있다."},
{"id":"T686","line":3114,"t":"피보험단위기간은 얼마 이상이어야 할까?"},
{"id":"T687","line":3114,"t":"이직 전 18개월 중 180일 이상"},
{"id":"T688","line":3114,"t":"3개월 이상"},
{"id":"T689","line":3114,"t":"12개월 이상"},
{"id":"T690","line":3115,"t":"일한 날을 세는 기준이라 근무 형태에 따라 달라진다. 퇴사 전에 본인 기간을 조회해 두는 편이 안전하다."},
{"id":"T691","line":3116,"t":"구직급여를 받는 동안 해야 하는 것은?"},
{"id":"T692","line":3116,"t":"정해진 주기마다 재취업 활동을 하고 신고한다"},
{"id":"T693","line":3116,"t":"아무것도 하지 않아도 된다"},
{"id":"T694","line":3116,"t":"매일 고용센터에 출석한다"},
{"id":"T695","line":3117,"t":"실업 인정을 받아야 그 회차 급여가 나간다. 조건 없이 나오는 돈이 아니라 구직 중임을 확인받는 돈이다."},
{"id":"T696","line":3118,"t":"이직확인서, 누가 내나"},
{"id":"T697","line":3118,"t":"고용센터 상담원"},
{"id":"T698","line":3119,"t":"급여 신청이 막히는 분들, 대부분 여기서 막혀요."},
{"id":"T699","line":3120,"t":"구직급여를 신청하려면 회사가 처리해 줘야 하는 것은?"},
{"id":"T700","line":3120,"t":"이직확인서와 피보험자격 상실신고"},
{"id":"T701","line":3120,"t":"재직증명서"},
{"id":"T702","line":3120,"t":"경력기술서"},
{"id":"T703","line":3121,"t":"이직 사유와 근무 기간, 임금이 적힌 이직확인서가 있어야 수급자격을 판단한다. 상실신고와 함께 사업주가 처리한다."},
{"id":"T704","line":3122,"t":"회사가 이직확인서를 안 내주고 있다면?"},
{"id":"T705","line":3122,"t":"발급을 요청할 수 있고, 처리됐는지는 고용보험에서 조회된다"},
{"id":"T706","line":3122,"t":"기다리는 것 말고는 방법이 없다"},
{"id":"T707","line":3122,"t":"노동청에 신고하는 방법뿐이다"},
{"id":"T708","line":3123,"t":"요청을 받으면 사업주는 정해진 기간 안에 발급해야 한다. 처리 여부는 본인이 직접 조회해 확인하는 편이 빠르다."},
{"id":"T709","line":3124,"t":"이직확인서에 적힌 이직 사유가 사실과 다르면?"},
{"id":"T710","line":3124,"t":"정정을 요청하고, 다투게 되면 증빙을 함께 낸다"},
{"id":"T711","line":3124,"t":"이미 제출됐으니 바꿀 수 없다"},
{"id":"T712","line":3124,"t":"새 회사에서 다시 쓰면 된다"},
{"id":"T713","line":3125,"t":"이직 사유는 수급자격을 가르는 항목이다. 사실과 다르면 정정을 요청할 수 있고, 최종 판단은 고용센터가 한다."},
{"id":"T714","line":3127,"t":"국민취업지원제도"},
{"id":"T715","line":3127,"t":"고용센터 상담원"},
{"id":"T716","line":3128,"t":"실업급여 대상이 아니어도 받을 수 있는 게 따로 있어요."},
{"id":"T717","line":3129,"t":"국민취업지원제도는 어디에 신청할까?"},
{"id":"T718","line":3129,"t":"고용노동부가 운영하는 고용센터·온라인 창구"},
{"id":"T719","line":3129,"t":"국민연금공단"},
{"id":"T720","line":3130,"t":"고용보험에서 나오는 실업급여와 달리 고용노동부가 운영하는 취업지원 사업이다. 거주지 고용센터나 고용24에서 신청한다."},
{"id":"T721","line":3131,"t":"이 제도가 실업급여와 다른 점은?"},
{"id":"T722","line":3131,"t":"고용보험 가입 이력이 없어도 요건을 채우면 신청할 수 있다"},
{"id":"T723","line":3131,"t":"실업급여와 같은 제도다"},
{"id":"T724","line":3131,"t":"퇴직자만 신청할 수 있다"},
{"id":"T725","line":3132,"t":"구직급여는 고용보험에서 나오는 보험금이고, 이쪽은 보험이 아니라 취업지원 사업이다. 그래서 대상이 다르다."},
{"id":"T726","line":3133,"t":"지원을 받는 동안 해야 하는 것은?"},
{"id":"T727","line":3133,"t":"취업활동계획을 세우고 정해진 구직활동을 이행한다"},
{"id":"T728","line":3133,"t":"아무 조건 없이 수당만 받는다"},
{"id":"T729","line":3133,"t":"매일 센터에 출석한다"},
{"id":"T730","line":3134,"t":"상담을 거쳐 취업활동계획을 세우고 이행을 확인받는다. 조건 없이 나오는 돈이 아니다."},
{"id":"T731","line":3136,"t":"공고와 계약서가 다르면"},
{"id":"T732","line":3137,"t":"공고에 적힌 조건은 계약서에서 한 번 더 보셔야 해요."},
{"id":"T733","line":3138,"t":"채용공고의 조건을 회사가 나중에 불리하게 바꾸면?"},
{"id":"T734","line":3138,"t":"정당한 사유 없이 구직자에게 불리하게 바꾸는 것은 금지돼 있다"},
{"id":"T735","line":3138,"t":"공고는 참고사항이라 문제되지 않는다"},
{"id":"T736","line":3138,"t":"입사하면 동의한 것이 된다"},
{"id":"T737","line":3139,"t":"채용절차의 공정화에 관한 법률은 채용광고의 내용을 정당한 사유 없이 불리하게 변경하는 행위를 금지한다."},
{"id":"T738","line":3140,"t":"내 근로조건을 최종적으로 정하는 문서는?"},
{"id":"T739","line":3140,"t":"근로계약서"},
{"id":"T740","line":3140,"t":"채용공고"},
{"id":"T741","line":3140,"t":"합격 통보 메일"},
{"id":"T742","line":3141,"t":"공고는 모집 조건이고, 지킬 의무가 생기는 것은 계약서에 적힌 내용이다. 서명 전에 읽어야 하는 이유다."},
{"id":"T743","line":3142,"t":"입사를 조건으로 교육비나 보증금을 요구한다면?"},
{"id":"T744","line":3142,"t":"채용을 대가로 금품을 요구하는 것은 금지된 행위다"},
{"id":"T745","line":3142,"t":"신입 교육비는 원래 본인 부담이다"},
{"id":"T746","line":3142,"t":"돌려받을 수 있으니 일단 낸다"},
{"id":"T747","line":3143,"t":"채용에 관해 금전·물품·향응을 요구하거나 받는 행위는 법으로 금지돼 있다. 그 말이 나온 시점에서 이미 정상적인 채용이 아니다."},
{"id":"T748","line":3145,"t":"실업인정과 재취업활동"},
{"id":"T749","line":3145,"t":"고용센터 상담원"},
{"id":"T750","line":3146,"t":"신청했다고 매달 자동으로 나오는 게 아니에요."},
{"id":"T751","line":3147,"t":"구직급여가 회차마다 나가려면 무엇이 필요할까?"},
{"id":"T752","line":3147,"t":"실업인정일마다 재취업활동을 신고하고 인정받아야 한다"},
{"id":"T753","line":3147,"t":"처음 신청 한 번이면 끝난다"},
{"id":"T754","line":3147,"t":"통장만 등록하면 된다"},
{"id":"T755","line":3148,"t":"실업 상태이고 구직 중임을 확인받는 절차다. 인정받지 못하면 그 회차분이 나가지 않는다."},
{"id":"T756","line":3149,"t":"받을 수 있는 기간(수급기간)의 기준은?"},
{"id":"T757","line":3149,"t":"이직일 다음 날부터 정해진 기간"},
{"id":"T758","line":3149,"t":"신청한 날부터 1년"},
{"id":"T759","line":3149,"t":"남은 일수를 다 받을 때까지"},
{"id":"T760","line":3150,"t":"그 기간이 지나면 남은 일수가 있어도 못 받는다. 퇴사하고 신청을 미룰 이유가 없는 이유다."},
{"id":"T761","line":3151,"t":"수급 중에 아르바이트로 소득이 생기면?"},
{"id":"T762","line":3151,"t":"신고해야 하고, 숨기면 부정수급이 된다"},
{"id":"T763","line":3151,"t":"소액이면 신고하지 않아도 된다"},
{"id":"T764","line":3151,"t":"자동으로 반영된다"},
{"id":"T765","line":3152,"t":"부정수급으로 확인되면 받은 돈을 반환하고 추가 징수까지 될 수 있다. 애매하면 미리 물어보는 편이 싸다."},
{"id":"T766","line":3155,"t":"기름값 아끼는 운전"},
{"id":"T767","line":3155,"t":"주유소 사장"},
{"id":"T768","line":3156,"t":"기름값 아까우면 운전 습관부터 봐. 한 달이면 차이가 꽤 나."},
{"id":"T769","line":3157,"t":"주유소 기름값을 미리 비교할 수 있는 공식 서비스는?"},
{"id":"T770","line":3157,"t":"하이패스"},
{"id":"T771","line":3157,"t":"도로 전광판"},
{"id":"T772","line":3158,"t":"한국석유공사 오피넷에서 지역별 주유소 가격을 비교할 수 있다. 알뜰주유소도 표시된다."},
{"id":"T773","line":3159,"t":"연비를 가장 많이 깎아 먹는 습관은?"},
{"id":"T774","line":3159,"t":"급가속과 급제동"},
{"id":"T775","line":3159,"t":"에어컨을 약하게 켜기"},
{"id":"T776","line":3159,"t":"라디오 듣기"},
{"id":"T777","line":3160,"t":"일정한 속도로 달리면 기름이 덜 든다. 트렁크 짐을 비우고 타이어 공기압을 맞춰 두는 것도 도움이 된다."},
{"id":"T778","line":3161,"t":"고속도로 휴게소 주유소 기름값은?"},
{"id":"T779","line":3161,"t":"휴게소마다 달라서 미리 비교하는 게 좋다"},
{"id":"T780","line":3161,"t":"전국 어디나 같다"},
{"id":"T781","line":3161,"t":"항상 시내보다 싸다"},
{"id":"T782","line":3162,"t":"휴게소 주유소도 가격이 제각각이다. 출발 전에 경로 위 가격을 확인해 두면 몇천 원은 아낀다."},
{"id":"T783","line":3164,"t":"장거리 운전 안전"},
{"id":"T784","line":3164,"t":"트럭 기사"},
{"id":"T785","line":3165,"t":"나는 하루에 몇백 킬로씩 달려. 초보들이 제일 모르는 게 쉬는 법이야."},
{"id":"T786","line":3166,"t":"장거리 운전할 때 흔히 권하는 휴식 간격은?"},
{"id":"T787","line":3166,"t":"2시간마다 한 번"},
{"id":"T788","line":3166,"t":"5시간마다 한 번"},
{"id":"T789","line":3166,"t":"졸릴 때만"},
{"id":"T790","line":3167,"t":"2시간마다 15분 정도 쉬는 게 권장된다. 졸음이 오면 가까운 졸음쉼터나 휴게소에 바로 들른다."},
{"id":"T791","line":3168,"t":"편도 2차로 이상 고속도로에서 1차로는?"},
{"id":"T792","line":3168,"t":"추월할 때 쓰는 차로"},
{"id":"T793","line":3168,"t":"느린 차 전용 차로"},
{"id":"T794","line":3168,"t":"화물차 전용 차로"},
{"id":"T795","line":3169,"t":"1차로는 추월차로다. 추월이 끝나면 오른쪽 차로로 돌아가야 한다. 계속 달리면 단속 대상이다."},
{"id":"T796","line":3170,"t":"고속도로에서 차가 고장 나 멈췄다면 사람은?"},
{"id":"T797","line":3170,"t":"비상등을 켜고 가드레일 밖으로 먼저 피한다"},
{"id":"T798","line":3170,"t":"차 안에서 기다린다"},
{"id":"T799","line":3170,"t":"차 뒤에 서서 손을 흔든다"},
{"id":"T800","line":3171,"t":"멈춘 차를 뒤차가 들이받는 2차 사고가 제일 위험하다. 몸부터 안전한 곳으로 옮기고 신고한다."},
{"id":"T801","line":3173,"t":"바가지 안 당하는 법"},
{"id":"T802","line":3173,"t":"관광안내소 직원"},
{"id":"T803","line":3174,"t":"성수기엔 가격이 들쭉날쭉해요. 몇 가지만 알면 덜 억울해요."},
{"id":"T804","line":3175,"t":"가게에 가격표가 안 보이면?"},
{"id":"T805","line":3175,"t":"주문 전에 가격을 물어보고 확인한다"},
{"id":"T806","line":3175,"t":"계산할 때 물어본다"},
{"id":"T807","line":3175,"t":"그냥 먹고 낸다"},
{"id":"T808","line":3176,"t":"음식점은 가격을 보이는 곳에 붙여야 한다. \"시가\"라고만 적혀 있으면 주문 전에 금액부터 확인한다."},
{"id":"T809","line":3177,"t":"카드를 냈더니 현금만 되거나 카드면 돈을 더 내라고 하면?"},
{"id":"T810","line":3177,"t":"카드 결제 거부와 수수료 떠넘기기는 신고할 수 있다"},
{"id":"T811","line":3177,"t":"원래 그런 거다"},
{"id":"T812","line":3177,"t":"카드사에 사과한다"},
{"id":"T813","line":3178,"t":"신용카드 가맹점은 카드 결제를 거부하거나 수수료를 손님에게 떠넘길 수 없다. 여신금융협회에 신고할 수 있다."},
{"id":"T814","line":3179,"t":"여행지에서 바가지를 당했다면 어디에 알리면 좋을까?"},
{"id":"T815","line":3179,"t":"관광불편신고(1330) 같은 관광 안내 창구"},
{"id":"T816","line":3179,"t":"아무 데도 없다"},
{"id":"T817","line":3179,"t":"다음 손님에게만 말한다"},
{"id":"T818","line":3180,"t":"한국관광공사 1330에서 관광 불편 신고를 받는다. 영수증이나 메뉴판 사진이 있으면 훨씬 수월하다."},
{"id":"T819","line":3182,"t":"물놀이 안전"},
{"id":"T820","line":3182,"t":"안전요원"},
{"id":"T821","line":3183,"t":"바다는 수영장이 아니에요. 딱 세 가지만 기억해요."},
{"id":"T822","line":3184,"t":"해안에서 바다 쪽으로 빠르게 끌려 나가는 흐름(이안류)에 휩쓸리면?"},
{"id":"T823","line":3184,"t":"해안과 나란히 옆으로 헤엄쳐 빠져나온다"},
{"id":"T824","line":3184,"t":"해안 쪽으로 곧장 힘껏 헤엄친다"},
{"id":"T825","line":3184,"t":"몸에 힘을 주고 버틴다"},
{"id":"T826","line":3185,"t":"흐름을 정면으로 거스르면 금방 지친다. 옆으로 벗어난 뒤 돌아오거나, 떠서 손을 들고 구조를 요청한다."},
{"id":"T827","line":3186,"t":"물놀이 전에 술을 마셨다면?"},
{"id":"T828","line":3186,"t":"물에 들어가지 않는다"},
{"id":"T829","line":3186,"t":"조금만 들어간다"},
{"id":"T830","line":3186,"t":"튜브만 있으면 괜찮다"},
{"id":"T831","line":3187,"t":"술은 판단력과 체온 조절을 떨어뜨린다. 물놀이 사고에서 음주가 자주 겹친다."},
{"id":"T832","line":3188,"t":"구명조끼는 언제 입을까?"},
{"id":"T833","line":3188,"t":"수영을 잘해도 입는다"},
{"id":"T834","line":3188,"t":"수영을 못할 때만"},
{"id":"T835","line":3188,"t":"깊은 곳에 갈 때만"},
{"id":"T836","line":3189,"t":"파도와 조류 앞에서는 수영 실력이 별 소용없다. 발이 닿는 곳이라도 입는 편이 낫다."},
{"id":"T837","line":3191,"t":"숙소 예약 사기 피하기"},
{"id":"T838","line":3191,"t":"게스트하우스 사장"},
{"id":"T839","line":3192,"t":"우리 집은 진짜예요. 근데 진짜처럼 보이는 가짜가 많아요."},
{"id":"T840","line":3193,"t":"숙소 주인이 \"앱 수수료 아끼게 계좌로 보내 달라\"고 하면?"},
{"id":"T841","line":3193,"t":"예약 플랫폼 안에서만 결제한다"},
{"id":"T842","line":3193,"t":"싸니까 보낸다"},
{"id":"T843","line":3193,"t":"반만 먼저 보낸다"},
{"id":"T844","line":3194,"t":"플랫폼 밖으로 보낸 돈은 문제가 생겨도 돌려받기 어렵다. 가장 흔한 숙소 사기 수법이다."},
{"id":"T845","line":3195,"t":"처음 보는 숙소가 진짜인지 확인하려면?"},
{"id":"T846","line":3195,"t":"주소와 사업자 정보, 다른 곳의 후기를 맞춰 본다"},
{"id":"T847","line":3195,"t":"사진이 예쁘면 믿는다"},
{"id":"T848","line":3195,"t":"싸면 믿는다"},
{"id":"T849","line":3196,"t":"지도에서 주소를 찾아보고, 여러 곳의 후기를 비교하면 가짜 숙소는 대부분 걸러진다."},
{"id":"T850","line":3197,"t":"결제 전에 꼭 확인할 것은?"},
{"id":"T851","line":3197,"t":"취소·환불 규정"},
{"id":"T852","line":3197,"t":"방 벽지 색"},
{"id":"T853","line":3197,"t":"주인 나이"},
{"id":"T854","line":3198,"t":"성수기에는 환불 불가 조건이 흔하다. 취소 기한과 수수료를 확인하고 화면을 캡처해 둔다."},
{"id":"T855","line":3200,"t":"렌터카와 택시"},
{"id":"T856","line":3200,"t":"렌터카 직원"},
{"id":"T857","line":3201,"t":"차 빌리실 때 이것만 하시면 반납할 때 싸울 일이 없어요."},
{"id":"T858","line":3202,"t":"렌터카를 받자마자 할 일은?"},
{"id":"T859","line":3202,"t":"차 외관과 계기판을 사진·영상으로 남긴다"},
{"id":"T860","line":3202,"t":"바로 출발한다"},
{"id":"T861","line":3202,"t":"키만 확인한다"},
{"id":"T862","line":3203,"t":"원래 있던 흠집으로 수리비를 물지 않으려면 받을 때 기록해 두는 게 제일 확실하다."},
{"id":"T863","line":3204,"t":"렌터카 자차보험(차량손해면책)에 대해 맞는 말은?"},
{"id":"T864","line":3204,"t":"가입해도 면책금이나 휴차료가 따로 있을 수 있어 조건을 본다"},
{"id":"T865","line":3204,"t":"가입하면 무조건 0원이다"},
{"id":"T866","line":3204,"t":"필요 없다"},
{"id":"T867","line":3205,"t":"상품마다 본인 부담금과 보상 한도가 다르다. 계약서의 면책 조건을 결제 전에 확인한다."},
{"id":"T868","line":3206,"t":"택시가 미터기를 안 켜고 요금을 부르면?"},
{"id":"T869","line":3206,"t":"미터기를 켜 달라고 하고, 안 되면 내려서 신고한다"},
{"id":"T870","line":3206,"t":"부르는 대로 낸다"},
{"id":"T871","line":3206,"t":"깎아 달라고 흥정한다"},
{"id":"T872","line":3207,"t":"택시는 미터기 요금이 원칙이다. 차량 번호를 기록해 두면 신고할 때 쓸 수 있다."},
{"id":"T873","line":3212,"t":"전세보증금 반환보증에 가입하면 무엇이 달라질까?"},
{"id":"T874","line":3213,"t":"집주인이 안 돌려줘도 보증기관이 대신 지급한다"},
{"id":"T875","line":3213,"t":"집주인이 보증금을 못 올린다"},
{"id":"T876","line":3213,"t":"세금이 줄어든다"},
{"id":"T877","line":3214,"t":"보증기관이 먼저 지급하고 집주인에게 구상한다. 가입 요건과 보증료는 기관마다 다르니 계약 전에 확인한다."},
{"id":"T878","line":3215,"t":"다가구주택에서 특히 중요한 선순위 보증금이란?"},
{"id":"T879","line":3216,"t":"나보다 먼저 들어온 세입자들의 보증금 합계"},
{"id":"T880","line":3216,"t":"집주인이 낸 취득세"},
{"id":"T881","line":3216,"t":"관리비 미납액"},
{"id":"T882","line":3217,"t":"경매 배당은 순위대로 간다. 선순위 보증금과 근저당의 합이 시세에 근접하면 내 몫이 남지 않는다."},
{"id":"T883","line":3218,"t":"계약 기간 중 집주인이 바뀌면 내 계약은?"},
{"id":"T884","line":3219,"t":"대항력이 있으면 새 집주인에게 그대로 승계된다"},
{"id":"T885","line":3219,"t":"자동으로 해지된다"},
{"id":"T886","line":3219,"t":"보증금을 다시 내야 한다"},
{"id":"T887","line":3220,"t":"임차주택의 양수인은 임대인의 지위를 승계한다. 그 전제가 대항력이라 전입신고가 다시 중요해진다."},
{"id":"T888","line":3221,"t":"시세보다 전세가가 유난히 높고 계약을 재촉한다면?"},
{"id":"T889","line":3222,"t":"깡통전세 신호로 보고 시세를 직접 확인한다"},
{"id":"T890","line":3222,"t":"좋은 매물이니 바로 계약한다"},
{"id":"T891","line":3222,"t":"중개사 말을 믿는다"},
{"id":"T892","line":3223,"t":"매매가에 근접하거나 넘는 전세가는 집값이 조금만 떨어져도 보증금이 깎인다. 실거래가를 직접 조회한다."},
{"id":"T893","line":3224,"t":"전입신고와 확정일자를 둘 다 받아야 하는 이유는?"},
{"id":"T894","line":3225,"t":"대항력과 우선변제권이 서로 다른 요건이라서"},
{"id":"T895","line":3225,"t":"두 번 신고해야 접수되어서"},
{"id":"T896","line":3225,"t":"수수료가 나뉘어 있어서"},
{"id":"T897","line":3226,"t":"전입신고와 실제 거주가 대항력을, 확정일자가 우선변제권을 만든다. 하나만으로는 보증금을 지키지 못한다."},
{"id":"T898","line":3227,"t":"계약이 끝났는데 집주인이 보증금을 안 준다. 이사부터 나가면?"},
{"id":"T899","line":3227,"t":"점유와 주민등록이 빠져 순위를 잃는다"},
{"id":"T900","line":3227,"t":"이사해도 순위는 그대로다"},
{"id":"T901","line":3227,"t":"오히려 우선순위가 올라간다"},
{"id":"T902","line":3228,"t":"대항력과 우선변제권은 살고 있고 전입돼 있다는 것이 전제다. 먼저 임차권등기명령을 받아 등기를 확인하고 나가야 한다."},
{"id":"T903","line":3229,"t":"집주인의 세금 체납은 계약 전에 확인할 수 있을까?"},
{"id":"T904","line":3229,"t":"미납국세 열람 제도로 확인할 수 있다"},
{"id":"T905","line":3229,"t":"확인할 방법이 없다"},
{"id":"T906","line":3229,"t":"중개사에게 물어보는 수밖에 없다"},
{"id":"T907","line":3230,"t":"국세가 보증금보다 먼저 배당되는 경우가 있어 체납 규모가 곧 위험이다. 열람 제도가 그래서 생겼다."},
{"id":"T908","line":3236,"t":"전세 먹튀 집주인"},
{"id":"T909","line":3237,"t":"찾기쉬운 생활법령정보"},
{"id":"T910","line":3238,"t":"보증금? 다음 세입자 들어오면 준다니까. 왜 그렇게 못 믿어?"},
{"id":"T911","line":3239,"t":"등기부등본과 선순위 보증금을 들이밀자, 말을 돌리던 쪽이 먼저 입을 닫았다."},
{"id":"T912","line":3240,"t":"다음에 오겠다는 말을 믿고 돌아섰습니다."},
{"id":"T913","line":3243,"t":"다단계 선배"},
{"id":"T914","line":3244,"t":"공정거래위원회"},
{"id":"T915","line":3245,"t":"너 요즘 힘들다며? 나 이거 하고 월 300 벌어. 설명회만 한 번 와 봐, 응?"},
{"id":"T916","line":3246,"t":"설명회 자료를 덮었다. 선배는 더 말을 잇지 못했다."},
{"id":"T917","line":3247,"t":"일단 한 번만, 하고 카드를 꺼냈다."},
{"id":"T918","line":3249,"t":"이 회사가 합법인지 확인하려면 어디를 봐야 할까?"},
{"id":"T919","line":3250,"t":"공정거래위원회에 등록된 다단계판매업자인지 조회한다"},
{"id":"T920","line":3250,"t":"사업설명회에서 직접 물어본다"},
{"id":"T921","line":3250,"t":"권유한 선배 말을 믿는다"},
{"id":"T922","line":3251,"t":"다단계판매업자는 공정거래위원회나 시·도에 등록해야 한다. 등록 여부는 공개돼 있어 이름만 넣으면 확인된다."},
{"id":"T923","line":3252,"t":"판매원으로 가입하려면 먼저 물건을 사야 한다고 한다면?"},
{"id":"T924","line":3253,"t":"가입 조건으로 상품 구입을 요구하는 것은 금지된 행위다"},
{"id":"T925","line":3253,"t":"원래 그런 절차다"},
{"id":"T926","line":3253,"t":"싸게 사는 기회다"},
{"id":"T927","line":3254,"t":"가입이나 등급 유지를 조건으로 상품 구입을 강요하는 행위는 방문판매법이 금지한다. 그 말이 나오는 순간 더 들을 것이 없다."},
{"id":"T928","line":3255,"t":"\"이 정도 하면 월 수백은 보장된다\"는 말을 들었다면?"},
{"id":"T929","line":3256,"t":"수익을 보장한다는 말 자체가 금지된 표현이다"},
{"id":"T930","line":3256,"t":"실적이 좋은 회사라는 뜻이다"},
{"id":"T931","line":3256,"t":"계약서에 적어달라고 하면 된다"},
{"id":"T932","line":3257,"t":"거짓이나 과장으로 유인하는 행위는 금지된다. 보장이라는 단어가 나오면 그 사업이 아니라 그 말이 문제다."},
{"id":"T933","line":3258,"t":"이미 물건을 샀는데 후회된다면?"},
{"id":"T934","line":3259,"t":"법으로 정해진 기간 안에 청약철회를 할 수 있다"},
{"id":"T935","line":3259,"t":"한 번 사면 되돌릴 수 없다"},
{"id":"T936","line":3259,"t":"다른 사람에게 넘겨야 한다"},
{"id":"T937","line":3260,"t":"방문판매법은 일정 기간 안의 청약철회를 보장한다. 기간과 조건은 계약서와 공정거래위원회 안내에서 확인한다."},
{"id":"T938","line":3261,"t":"\"돈이 없으면 대출을 받아서라도 시작하라\"고 한다면?"},
{"id":"T939","line":3262,"t":"그 자리에서 끊는다. 빚으로 시작하라는 순간 사업이 아니다"},
{"id":"T940","line":3262,"t":"투자니까 감수한다"},
{"id":"T941","line":3262,"t":"소액이면 괜찮다"},
{"id":"T942","line":3263,"t":"초기 비용을 빚으로 메우게 하는 구조는 손실을 개인에게 떠넘긴다. 남는 것은 재고와 이자다."},
{"id":"T943","line":3266,"t":"자칭 재무설계사"},
{"id":"T944","line":3267,"t":"금융감독원 파인"},
{"id":"T945","line":3268,"t":"무료로 재무설계 해드립니다. 요즘 이 상품이 예금보다 훨씬 낫거든요."},
{"id":"T946","line":3269,"t":"설계안을 돌려줬다. 그는 다음 약속이 있다며 일어섰다."},
{"id":"T947","line":3270,"t":"서명란에 이름을 적었다. 20년짜리였다."},
{"id":"T948","line":3272,"t":"무료 재무설계 뒤에 보통 따라오는 것은?"},
{"id":"T949","line":3273,"t":"특정 금융상품 가입 권유"},
{"id":"T950","line":3273,"t":"정말 아무것도 없다"},
{"id":"T951","line":3273,"t":"세무 대리 서비스"},
{"id":"T952","line":3274,"t":"상담이 공짜라면 수익은 상품 판매 수수료에서 나온다. 무엇을 파는 사람인지 먼저 확인하면 설명이 다르게 들린다."},
{"id":"T953","line":3275,"t":"\"원금은 보장되는데 수익률도 높다\"는 설명을 들었다면?"},
{"id":"T954","line":3276,"t":"둘 다 성립하는 상품은 없다고 보고 자료를 요구한다"},
{"id":"T955","line":3276,"t":"좋은 기회다"},
{"id":"T956","line":3276,"t":"계약서에 적어달라고 하면 된다"},
{"id":"T957","line":3277,"t":"수익이 높으면 위험이 따른다. 보장과 고수익을 함께 말하는 설명은 둘 중 하나가 사실이 아니다."},
{"id":"T958","line":3278,"t":"저축성보험을 예금처럼 권한다면 무엇을 확인해야 할까?"},
{"id":"T959","line":3279,"t":"사업비를 떼고 낸 돈에 도달하는 시점"},
{"id":"T960","line":3279,"t":"보험사 로고"},
{"id":"T961","line":3279,"t":"설계사 경력"},
{"id":"T962","line":3280,"t":"저축성보험은 초기에 사업비가 빠져나가 한동안 해지환급금이 낸 돈보다 적다. 몇 년을 유지해야 하는지가 핵심이다."},
{"id":"T963","line":3281,"t":"이 사람이 판매 자격이 있는지 확인하려면?"},
{"id":"T964","line":3282,"t":"금융소비자 정보포털에서 등록된 판매업자·모집인인지 조회한다"},
{"id":"T965","line":3282,"t":"명함을 본다"},
{"id":"T966","line":3282,"t":"사무실이 크면 믿는다"},
{"id":"T967","line":3283,"t":"등록 여부는 공개돼 있다. 조회 한 번이 가장 싼 검증이다."},
{"id":"T968","line":3284,"t":"이미 가입했는데 설명과 다르다면?"},
{"id":"T969","line":3285,"t":"정해진 기간 안에 청약을 철회하거나 불완전판매를 이유로 다툴 수 있다"},
{"id":"T970","line":3285,"t":"방법이 없다"},
{"id":"T971","line":3285,"t":"해지하면 낸 돈을 전부 돌려받는다"},
{"id":"T972","line":3286,"t":"청약철회 기간이 지나도 설명 의무를 지키지 않았다면 다툴 여지가 있다. 상담 내용과 자료를 남겨 두는 편이 안전하다."},
{"id":"T973","line":3304,"t":"연말정산, 카드는 이렇게"},
{"id":"T974","line":3305,"t":"연말정산 때 카드 공제 얼마 받았어? 대부분 그냥 쓰던 대로 써서 손해 봐."},
{"id":"T975","line":3306,"t":"신용카드 등 사용금액 소득공제는 어디서부터 시작될까?"},
{"id":"T976","line":3306,"t":"총급여의 25%를 넘게 쓴 금액부터"},
{"id":"T977","line":3306,"t":"첫 결제부터 전부"},
{"id":"T978","line":3306,"t":"총급여의 50%를 넘게 쓴 금액부터"},
{"id":"T979","line":3307,"t":"총급여의 25%까지는 어떤 수단으로 써도 공제가 없다. 그 위로 쓴 금액만 공제 대상이 된다."},
{"id":"T980","line":3308,"t":"25%를 넘긴 뒤 같은 돈을 쓸 때 공제율이 가장 높은 것은?"},
{"id":"T981","line":3308,"t":"전통시장·대중교통 40%"},
{"id":"T982","line":3308,"t":"신용카드 15%"},
{"id":"T983","line":3308,"t":"해외 결제"},
{"id":"T984","line":3309,"t":"신용카드 15%, 체크카드·현금영수증 30%, 전통시장·대중교통 40%. 25%를 넘긴 다음에는 체크카드 쪽으로 옮기는 게 이득이다."},
{"id":"T985","line":3310,"t":"총급여 3,000만원이면 얼마까지는 어떤 카드를 써도 공제가 없을까?"},
{"id":"T986","line":3310,"t":"750만원"},
{"id":"T987","line":3310,"t":"300만원"},
{"id":"T988","line":3310,"t":"1,500만원"},
{"id":"T989","line":3311,"t":"3,000만원 × 25% = 750만원. 여기까지는 혜택 많은 신용카드로, 넘는 부분은 체크카드로 쓰는 식으로 나눈다."},
{"id":"T990","line":3312,"t":"3.3% 떼고 들어온 돈"},
{"id":"T991","line":3312,"t":"프리랜서 선배"},
{"id":"T992","line":3313,"t":"외주비 받았는데 금액이 이상하지? 그거 누가 떼먹은 거 아니야."},
{"id":"T993","line":3314,"t":"용역비 100만원인데 96만 7천원이 들어왔다. 빠진 3만 3천원은?"},
{"id":"T994","line":3314,"t":"소득세 3%와 지방소득세 0.3%를 미리 뗀 것"},
{"id":"T995","line":3314,"t":"플랫폼 수수료"},
{"id":"T996","line":3314,"t":"은행 이체 수수료"},
{"id":"T997","line":3315,"t":"사업소득을 줄 때 주는 쪽이 3.3%를 원천징수해 대신 낸다. 내 세금을 미리 낸 것이라 나중에 정산된다."},
{"id":"T998","line":3316,"t":"3.3%를 떼인 소득은 언제 정산할까?"},
{"id":"T999","line":3316,"t":"다음 해 5월 종합소득세 신고"},
{"id":"T1000","line":3316,"t":"연말에 자동으로 끝난다"},
{"id":"T1001","line":3316,"t":"신고할 필요가 없다"},
{"id":"T1002","line":3317,"t":"5월에 1년 소득을 신고해 이미 낸 3.3%와 비교한다. 경비와 공제가 많으면 돌려받고, 모자라면 더 낸다."},
{"id":"T1003","line":3318,"t":"회사를 다니면서 3.3% 외주도 했다. 5월에 할 일은?"},
{"id":"T1004","line":3318,"t":"두 소득을 합쳐 종합소득세를 신고한다"},
{"id":"T1005","line":3318,"t":"회사 연말정산으로 끝난다"},
{"id":"T1006","line":3318,"t":"외주 소득은 신고하지 않는다"},
{"id":"T1007","line":3319,"t":"근로소득은 연말정산으로 끝나도 사업소득이 따로 있으면 5월에 합쳐 신고해야 한다. 안 하면 돌려받을 돈도 못 받는다."},
{"id":"T1008","line":3320,"t":"청년 적금, 지금 들 수 있는 것"},
{"id":"T1009","line":3320,"t":"청년센터 상담원"},
{"id":"T1010","line":3321,"t":"청년도약계좌 들려고 왔다고? 올해는 이름이 바뀌었어요."},
{"id":"T1011","line":3322,"t":"2026년에 청년도약계좌 신규 가입은?"},
{"id":"T1012","line":3322,"t":"2025년 말로 끝났고 청년미래적금이 뒤를 잇는다"},
{"id":"T1013","line":3322,"t":"여전히 가입할 수 있다"},
{"id":"T1014","line":3322,"t":"청년 정책 적금은 모두 없어졌다"},
{"id":"T1015","line":3323,"t":"청년도약계좌 신규 가입은 2025년 12월 31일로 끝났다. 2026년부터는 3년 만기 청년미래적금이 나왔다. 청년미래적금은 정해진 접수 기간에만 가입할 수 있어, 접수 일정은 금융위원회·가입 은행 공지에서 미리 확인한다."},
{"id":"T1016","line":3324,"t":"청년 정책 적금의 핵심 혜택은?"},
{"id":"T1017","line":3324,"t":"내가 넣은 돈에 정부 기여금이 붙고 이자에 세금이 붙지 않는다"},
{"id":"T1018","line":3324,"t":"원금이 두 배가 된다"},
{"id":"T1019","line":3324,"t":"이자를 매달 현금으로 준다"},
{"id":"T1020","line":3325,"t":"정부 기여금과 이자 비과세가 핵심이다. 기여금 비율과 요건은 해마다 바뀔 수 있으니 가입 전에 금융위원회 공고를 본다."},
{"id":"T1021","line":3326,"t":"가입 조건으로 따지지 않는 것은?"},
{"id":"T1022","line":3326,"t":"가지고 있는 신용카드 개수"},
{"id":"T1023","line":3326,"t":"개인·가구 소득"},
{"id":"T1024","line":3327,"t":"만 19~34세라는 나이와 개인·가구 소득 기준이 핵심이다. 카드 개수는 상관없다."},
{"id":"T1025","line":3328,"t":"청년월세지원 받는 법"},
{"id":"T1026","line":3328,"t":"주민센터 직원"},
{"id":"T1027","line":3329,"t":"월세 사는 청년이면 한 번 알아봐요. 매년 정해진 접수 기간이 있어서, 그때를 놓치면 안 돼요."},
{"id":"T1028","line":3330,"t":"2026년 청년월세지원은 한 달 최대 얼마를, 몇 개월까지 줄까?"},
{"id":"T1029","line":3330,"t":"월 20만원, 최대 24개월"},
{"id":"T1030","line":3330,"t":"월 50만원, 12개월"},
{"id":"T1031","line":3330,"t":"월 10만원, 6개월"},
{"id":"T1032","line":3331,"t":"월 최대 20만원씩 최대 24개월, 모두 480만원까지 받을 수 있다. 다만 상시 신청이 아니라 매년 정해진 접수 기간에 신청하는 사업이고, 생애 1회만 받는다. 2026년은 3월 30일부터 5월 29일까지였다. 올해 접수는 이미 닫혔을 수 있으니 다음 접수 일정은 복지로 공고에서 확인한다."},
{"id":"T1033","line":3332,"t":"신청하는 곳은?"},
{"id":"T1034","line":3332,"t":"복지로 또는 주소지 주민센터"},
{"id":"T1035","line":3332,"t":"은행 창구"},
{"id":"T1036","line":3333,"t":"온라인은 복지로, 오프라인은 주소지 행정복지센터에서 신청한다. 접수 기간 안에 해야 한다."},
{"id":"T1037","line":3334,"t":"따로 사는데도 부모님(원가구) 소득까지 보는 이유는?"},
{"id":"T1038","line":3334,"t":"청년 가구와 부모 가구 형편을 함께 보는 사업이라서"},
{"id":"T1039","line":3334,"t":"부모님 명의로 돈이 나가서"},
{"id":"T1040","line":3334,"t":"실제로는 보지 않는다"},
{"id":"T1041","line":3335,"t":"청년 가구는 기준 중위소득 60% 이하, 원가구는 100% 이하여야 한다. 재산 기준도 따로 있다."},
{"id":"T1042","line":3336,"t":"택배 문자와 검사님 전화"},
{"id":"T1043","line":3336,"t":"은행 창구 직원"},
{"id":"T1044","line":3337,"t":"요즘은 문자 하나, 전화 한 통으로 통장이 털려요. 이것만 기억해요."},
{"id":"T1045","line":3338,"t":"\"택배 주소를 확인하세요\"라는 문자에 링크가 달려 있다."},
{"id":"T1046","line":3338,"t":"링크는 누르지 않고 택배사 공식 앱에서 직접 조회한다"},
{"id":"T1047","line":3338,"t":"링크를 눌러 확인한다"},
{"id":"T1048","line":3338,"t":"답장으로 무슨 택배인지 묻는다"},
{"id":"T1049","line":3339,"t":"스미싱 링크는 악성 앱을 깔거나 개인정보를 빼 간다. 의심 문자는 118(한국인터넷진흥원)에 신고한다."},
{"id":"T1050","line":3340,"t":"\"검사인데 계좌가 범죄에 쓰였으니 안전계좌로 옮기세요.\""},
{"id":"T1051","line":3340,"t":"전화를 끊고 기관 대표번호로 직접 확인한다"},
{"id":"T1052","line":3340,"t":"안전계좌로 옮긴다"},
{"id":"T1053","line":3340,"t":"시키는 앱을 깔아 원격으로 확인받는다"},
{"id":"T1054","line":3341,"t":"수사기관은 전화로 돈을 옮기라고 하지 않는다. 안전계좌는 없다."},
{"id":"T1055","line":3342,"t":"이미 돈을 보냈다면 가장 먼저 할 일은?"},
{"id":"T1056","line":3342,"t":"112나 돈을 보낸 은행 콜센터에 지급정지를 요청한다"},
{"id":"T1057","line":3342,"t":"다음 날 은행에 간다"},
{"id":"T1058","line":3342,"t":"사기범에게 돌려 달라고 연락한다"},
{"id":"T1059","line":3343,"t":"지급정지는 빠를수록 돌려받을 가능성이 커진다. 112에 신고하면 지급정지까지 이어서 도와준다."},
{"id":"T1060","line":3344,"t":"중고거래, 입금 전에"},
{"id":"T1061","line":3345,"t":"나 중고로 아이패드 살 뻔했는데 사기였어. 이상한 링크를 보내더라."},
{"id":"T1062","line":3346,"t":"판매자가 앱 밖 메신저로 옮기자며 \"안전결제\" 링크를 보냈다."},
{"id":"T1063","line":3346,"t":"가짜 결제 페이지일 수 있어 앱 안 결제만 쓴다"},
{"id":"T1064","line":3346,"t":"링크로 결제한다"},
{"id":"T1065","line":3346,"t":"그냥 계좌로 보낸다"},
{"id":"T1066","line":3347,"t":"앱 밖으로 끌어낸 뒤 가짜 안전결제 페이지로 돈을 받는 수법이 흔하다. 대화와 결제는 앱 안에서만 한다."},
{"id":"T1067","line":3348,"t":"선입금하기 전에 해 볼 수 있는 확인은?"},
{"id":"T1068","line":3348,"t":"경찰청 사이버범죄 신고시스템에서 계좌·전화번호 사기 이력 조회"},
{"id":"T1069","line":3348,"t":"프로필 사진만 확인"},
{"id":"T1070","line":3348,"t":"확인할 방법이 없다"},
{"id":"T1071","line":3349,"t":"경찰청 사이버범죄 신고시스템(ECRM)에서 사기 신고가 들어온 번호와 계좌를 조회할 수 있다."},
{"id":"T1072","line":3350,"t":"사기를 당했다면?"},
{"id":"T1073","line":3350,"t":"대화와 입금 내역을 저장해 경찰에 신고한다"},
{"id":"T1074","line":3350,"t":"포기한다"},
{"id":"T1075","line":3350,"t":"판매자 집을 찾아간다"},
{"id":"T1076","line":3351,"t":"증거가 있어야 수사가 된다. 대화방이 지워지기 전에 캡처부터 남긴다."},
{"id":"T1077","line":3352,"t":"리볼빙이라는 늪"},
{"id":"T1078","line":3352,"t":"은행 창구 직원"},
{"id":"T1079","line":3353,"t":"카드값이 버거울 때 \"최소결제\"만 누르는 분들이 있어요. 그게 제일 비싸요."},
{"id":"T1080","line":3354,"t":"카드값을 일부만 내는 리볼빙을 쓰면?"},
{"id":"T1081","line":3354,"t":"남은 금액이 넘어가면서 높은 수수료가 붙는다"},
{"id":"T1082","line":3354,"t":"이자 없이 미뤄진다"},
{"id":"T1083","line":3354,"t":"결제가 취소된다"},
{"id":"T1084","line":3355,"t":"결제성 리볼빙은 넘긴 금액에 높은 수수료가 붙고, 다음 달 사용액이 그 위에 또 쌓인다."},
{"id":"T1085","line":3356,"t":"리볼빙이 무서운 이유는?"},
{"id":"T1086","line":3356,"t":"원금이 잘 줄지 않고 쌓이는 구조라서"},
{"id":"T1087","line":3356,"t":"신용점수가 반드시 오른다"},
{"id":"T1088","line":3356,"t":"카드가 바로 정지된다"},
{"id":"T1089","line":3357,"t":"매달 일부만 갚으면 남은 돈에 수수료가 붙어 원금이 줄지 않는다. 오래 쓰면 빚이 불어난다."},
{"id":"T1090","line":3358,"t":"카드를 만들 때 리볼빙이 같이 신청됐는지 확인하려면?"},
{"id":"T1091","line":3358,"t":"카드사 앱에서 결제 방식(일부결제금액이월약정)을 확인한다"},
{"id":"T1092","line":3358,"t":"확인할 수 없다"},
{"id":"T1093","line":3358,"t":"한 번 신청하면 끌 수 없다"},
{"id":"T1094","line":3359,"t":"카드사 앱이나 홈페이지에서 신청 여부를 보고 바로 해지할 수 있다."},
{"id":"T1095","line":3360,"t":"새는 구독 막기"},
{"id":"T1096","line":3360,"t":"자취 선배"},
{"id":"T1097","line":3361,"t":"통장에서 매달 몇천 원씩 빠져나가는 거, 다 합쳐 본 적 있어?"},
{"id":"T1098","line":3362,"t":"OTT 13,900원, 음악 10,900원, 클라우드 3,300원을 매달 낸다. 1년이면?"},
{"id":"T1099","line":3362,"t":"337,200원"},
{"id":"T1100","line":3362,"t":"28,100원"},
{"id":"T1101","line":3362,"t":"168,600원"},
{"id":"T1102","line":3363,"t":"13,900 + 10,900 + 3,300 = 28,100원. 12개월이면 337,200원이다."},
{"id":"T1103","line":3364,"t":"정기결제 구독료가 오르거나 유료 구독으로 바뀔 때 사업자는?"},
{"id":"T1104","line":3364,"t":"소비자에게 미리 알리고 동의를 받아야 한다"},
{"id":"T1105","line":3364,"t":"알림 없이 결제해도 된다"},
{"id":"T1106","line":3364,"t":"1년 뒤에 알리면 된다"},
{"id":"T1107","line":3365,"t":"정기결제 금액을 올리거나 유료로 전환할 때는 소비자 동의를 받도록 전자상거래법이 정하고 있고, 동의 기한은 30일 이내로 안내된다. 세부 시행 시점과 기준은 공정거래위원회·소비자원 공지를 확인한다."},
{"id":"T1108","line":3366,"t":"무료 체험 기간이 끝나 유료로 넘어가기 전에 사업자는?"},
{"id":"T1109","line":3366,"t":"종료 전에 유료로 바뀐다는 것을 미리 알려야 한다"},
{"id":"T1110","line":3366,"t":"알리지 않고 다음 날부터 결제해도 된다"},
{"id":"T1111","line":3366,"t":"체험이 끝난 뒤에 알리면 된다"},
{"id":"T1112","line":3367,"t":"무료 체험은 동의 절차와 별개로, 유료 전환 전에 미리 알려야 한다. 기준은 종료 14일 전 고지다. 체험을 시작할 때 종료일을 달력에 적어 두면 안전하다."},
{"id":"T1113","line":3368,"t":"안 쓰는 구독을 찾는 가장 빠른 방법은?"},
{"id":"T1114","line":3368,"t":"카드·통장 자동결제 내역을 한 번에 훑는다"},
{"id":"T1115","line":3368,"t":"앱을 전부 지운다"},
{"id":"T1116","line":3368,"t":"해지는 어려우니 둔다"},
{"id":"T1117","line":3369,"t":"앱을 지워도 결제는 계속된다. 카드사 앱과 계좌 자동이체 목록에서 정기결제를 찾아 해지한다."},
{"id":"T1118","line":3370,"t":"월급이 안 들어왔다"},
{"id":"T1119","line":3370,"t":"노무 상담원"},
{"id":"T1120","line":3371,"t":"\"다음 달에 같이 줄게\"라는 말, 몇 번째예요? 참을 일이 아니에요."},
{"id":"T1121","line":3372,"t":"월급날이 지났는데 회사가 계속 미룬다."},
{"id":"T1122","line":3372,"t":"고용노동부에 임금체불 진정을 낼 수 있다"},
{"id":"T1123","line":3372,"t":"참고 기다리는 수밖에 없다"},
{"id":"T1124","line":3372,"t":"바로 소송부터 해야 한다"},
{"id":"T1125","line":3373,"t":"진정을 내면 근로감독관이 조사하고, 체불이 확인되면 지급하라고 지시한다. 비용이 들지 않는다."},
{"id":"T1126","line":3374,"t":"진정을 내기 전에 챙겨 둘 것은?"},
{"id":"T1127","line":3374,"t":"근로계약서·급여명세서·출퇴근 기록·통장 내역"},
{"id":"T1128","line":3374,"t":"회사 로고"},
{"id":"T1129","line":3374,"t":"동료 연락처만"},
{"id":"T1130","line":3375,"t":"얼마를 못 받았는지 보여 줄 기록이 있어야 한다. 문자와 메신저 대화도 증거가 된다."},
{"id":"T1131","line":3376,"t":"정해진 날에 임금을 못 받으면 붙는 지연이자는?"},
{"id":"T1132","line":3376,"t":"연 20%"},
{"id":"T1133","line":3376,"t":"연 1%"},
{"id":"T1134","line":3376,"t":"붙지 않는다"},
{"id":"T1135","line":3377,"t":"지급일 다음 날부터 실제로 줄 때까지 연 20%의 지연이자가 붙는다. 재직 중인 사람에게도 적용되도록 법이 바뀌었다."},
{"id":"T1136","line":3378,"t":"퇴직금, 나도 받을까"},
{"id":"T1137","line":3378,"t":"노무 상담원"},
{"id":"T1138","line":3379,"t":"알바도 퇴직금 받냐고요? 조건만 맞으면 받아요."},
{"id":"T1139","line":3380,"t":"퇴직금을 받을 수 있는 최소 조건은?"},
{"id":"T1140","line":3380,"t":"1년 이상 일하고 4주 평균 주 15시간 이상"},
{"id":"T1141","line":3380,"t":"6개월 이상 일하면"},
{"id":"T1142","line":3380,"t":"정규직만"},
{"id":"T1143","line":3381,"t":"계속 근로 1년 이상, 4주 평균 1주 소정근로시간 15시간 이상이면 알바·계약직도 받는다."},
{"id":"T1144","line":3382,"t":"퇴직금은 대략 어떻게 계산할까?"},
{"id":"T1145","line":3382,"t":"30일분 평균임금 × 근속연수"},
{"id":"T1146","line":3382,"t":"마지막 달 월급의 절반"},
{"id":"T1147","line":3382,"t":"연봉의 10%"},
{"id":"T1148","line":3383,"t":"1년마다 30일분 평균임금. 평균임금은 퇴직 전 3개월 동안 받은 임금 총액을 그 기간 일수로 나눈 값이다."},
{"id":"T1149","line":3384,"t":"회사가 퇴직금을 줘야 하는 기한은?"},
{"id":"T1150","line":3384,"t":"퇴직 후 14일 이내, 합의하면 늦출 수 있다"},
{"id":"T1151","line":3384,"t":"퇴직 후 1년 이내"},
{"id":"T1152","line":3384,"t":"회사 마음대로"},
{"id":"T1153","line":3385,"t":"14일 안에 줘야 하고, 특별한 사정이 있으면 당사자 합의로 늦출 수 있다. 넘기면 지연이자가 붙는다."},
{"id":"T1154","line":3386,"t":"직장 내 괴롭힘"},
{"id":"T1155","line":3386,"t":"노무 상담원"},
{"id":"T1156","line":3387,"t":"그게 괴롭힘인지 아닌지 헷갈린다면 기준부터 봐요."},
{"id":"T1157","line":3388,"t":"직장 내 괴롭힘을 판단하는 요소가 아닌 것은?"},
{"id":"T1158","line":3388,"t":"가해자의 연봉"},
{"id":"T1159","line":3388,"t":"지위나 관계의 우위를 이용했는지"},
{"id":"T1160","line":3388,"t":"업무상 적정 범위를 넘었는지"},
{"id":"T1161","line":3389,"t":"근로기준법은 지위·관계의 우위를 이용해 업무상 적정 범위를 넘어 고통을 주거나 근무환경을 나쁘게 만드는 행위로 본다."},
{"id":"T1162","line":3390,"t":"괴롭힘을 신고하면 회사는?"},
{"id":"T1163","line":3390,"t":"지체 없이 조사하고 피해자를 보호해야 한다"},
{"id":"T1164","line":3390,"t":"신고자를 징계할 수 있다"},
{"id":"T1165","line":3390,"t":"아무 의무가 없다"},
{"id":"T1166","line":3391,"t":"사용자는 신고를 받으면 바로 조사하고, 피해자가 원하면 근무 장소를 바꾸는 등 조치해야 한다. 신고자에게 불리하게 대하면 처벌받는다."},
{"id":"T1167","line":3392,"t":"이 조항이 적용되지 않는 곳은?"},
{"id":"T1168","line":3392,"t":"상시 근로자 5인 미만 사업장"},
{"id":"T1169","line":3392,"t":"공공기관"},
{"id":"T1170","line":3393,"t":"직장 내 괴롭힘 금지 조항은 5인 이상 사업장에 적용된다. 5인 미만이면 노동청 상담으로 다른 방법을 찾는다."},
{"id":"T1171","line":3394,"t":"최저임금과 수습 기간"},
{"id":"T1172","line":3394,"t":"알바 선배"},
{"id":"T1173","line":3395,"t":"수습이라고 시급 깎는 데 있지? 되는 경우랑 안 되는 경우가 있어."},
{"id":"T1174","line":3396,"t":"2026년 최저임금 시간급은?"},
{"id":"T1175","line":3396,"t":"10,320원"},
{"id":"T1176","line":3396,"t":"10,030원"},
{"id":"T1177","line":3396,"t":"9,860원"},
{"id":"T1178","line":3397,"t":"2026년 적용 최저임금은 시간급 10,320원이다. 주 40시간이면 주휴를 포함해 월 2,156,880원."},
{"id":"T1179","line":3398,"t":"1년 이상 계약한 수습 3개월 동안 최저임금을 깎을 수 있는 한도는?"},
{"id":"T1180","line":3398,"t":"10%까지"},
{"id":"T1181","line":3398,"t":"30%까지"},
{"id":"T1182","line":3398,"t":"제한 없음"},
{"id":"T1183","line":3399,"t":"1년 이상 계약한 수습 근로자는 3개월까지 최저임금의 90%를 줄 수 있다. 계약 기간이 1년 미만이면 깎을 수 없다."},
{"id":"T1184","line":3400,"t":"편의점·패스트푸드 같은 단순노무 알바의 수습 감액은?"},
{"id":"T1185","line":3400,"t":"할 수 없다"},
{"id":"T1186","line":3400,"t":"3개월 동안 10%"},
{"id":"T1187","line":3400,"t":"6개월 동안 20%"},
{"id":"T1188","line":3401,"t":"고용노동부가 정한 단순노무 직종은 수습이어도 최저임금을 깎을 수 없다."},
{"id":"T1189","line":3402,"t":"13월의 월급, 연금계좌"},
{"id":"T1190","line":3403,"t":"연말정산에서 제일 크게 돌려받는 방법, 알려 줄까요?"},
{"id":"T1191","line":3404,"t":"연금저축과 IRP를 합쳐 세액공제 받을 수 있는 연간 납입 한도는?"},
{"id":"T1192","line":3404,"t":"900만원"},
{"id":"T1193","line":3404,"t":"300만원"},
{"id":"T1194","line":3404,"t":"제한 없음"},
{"id":"T1195","line":3405,"t":"연금저축만으로는 600만원, IRP를 더하면 합쳐서 900만원까지 공제 대상이다."},
{"id":"T1196","line":3406,"t":"총급여 5,500만원 이하 직장인이 900만원을 채우면 돌려받는 세금은?"},
{"id":"T1197","line":3406,"t":"약 148만원"},
{"id":"T1198","line":3406,"t":"약 9만원"},
{"id":"T1199","line":3406,"t":"900만원 전부"},
{"id":"T1200","line":3407,"t":"5,500만원 이하는 16.5%, 넘으면 13.2%. 900만원 × 16.5% = 148만 5천원."},
{"id":"T1201","line":3408,"t":"연금저축의 단점으로 맞는 것은?"},
{"id":"T1202","line":3408,"t":"중간에 깨면 공제받은 만큼 기타소득세를 낸다"},
{"id":"T1203","line":3408,"t":"언제 빼도 불이익이 없다"},
{"id":"T1204","line":3408,"t":"원금이 보장된다"},
{"id":"T1205","line":3409,"t":"연금으로 받지 않고 중도 해지하면 16.5% 기타소득세가 붙는다. 당장 쓸 돈은 넣지 않는다."},
{"id":"T1206","line":3410,"t":"실손보험 기본"},
{"id":"T1207","line":3410,"t":"3년차 선배"},
{"id":"T1208","line":3411,"t":"실손 두 개 들어 놨다고? 그거 돈 두 번 나가는 거야."},
{"id":"T1209","line":3412,"t":"실손보험을 두 개 들면 병원비를 두 번 받을까?"},
{"id":"T1210","line":3412,"t":"아니다. 실제 낸 돈 안에서 나눠 받는다"},
{"id":"T1211","line":3412,"t":"두 배로 받는다"},
{"id":"T1212","line":3412,"t":"먼저 청구한 곳만 준다"},
{"id":"T1213","line":3413,"t":"실손은 실제 손해만 보상한다. 겹쳐 들면 보험료만 두 번 낸다."},
{"id":"T1214","line":3414,"t":"회사 단체실손과 개인실손이 겹친다면?"},
{"id":"T1215","line":3414,"t":"개인실손을 잠시 멈추는 중지 제도를 쓸 수 있다"},
{"id":"T1216","line":3414,"t":"개인 것을 무조건 해지해야 한다"},
{"id":"T1217","line":3414,"t":"방법이 없다"},
{"id":"T1218","line":3415,"t":"개인실손 중지 제도로 단체보험이 있는 동안 개인실손을 멈췄다가 퇴사 후 다시 살릴 수 있다."},
{"id":"T1219","line":3416,"t":"보험금 청구를 미루면 안 되는 이유는?"},
{"id":"T1220","line":3416,"t":"청구권은 3년이 지나면 사라진다"},
{"id":"T1221","line":3416,"t":"10년까지는 괜찮다"},
{"id":"T1222","line":3416,"t":"기한이 없다"},
{"id":"T1223","line":3417,"t":"보험금 청구권의 소멸시효는 3년이다. 영수증과 진료비 세부내역서는 받자마자 청구한다."},
{"id":"T1224","line":3418,"t":"해외여행 가기 전에"},
{"id":"T1225","line":3418,"t":"관광안내소 직원"},
{"id":"T1226","line":3419,"t":"첫 해외여행이에요? 공항 가기 전에 이것만 챙겨요."},
{"id":"T1227","line":3420,"t":"여권 유효기간이 넉넉한지 볼 때 흔히 쓰는 기준은?"},
{"id":"T1228","line":3420,"t":"출국일 기준 6개월 이상 남았는지"},
{"id":"T1229","line":3420,"t":"1주일만 남아도 된다"},
{"id":"T1230","line":3420,"t":"기간은 상관없다"},
{"id":"T1231","line":3421,"t":"많은 나라가 입국할 때 여권 잔여기간 6개월 이상을 요구한다. 나라마다 다르니 외교부 해외안전여행에서 확인한다."},
{"id":"T1232","line":3422,"t":"해외에서 여권을 잃어버렸을 때 24시간 도움받는 곳은?"},
{"id":"T1233","line":3422,"t":"외교부 영사콜센터"},
{"id":"T1234","line":3422,"t":"항공사 마일리지 센터"},
{"id":"T1235","line":3422,"t":"동네 주민센터"},
{"id":"T1236","line":3423,"t":"영사콜센터(+82-2-3210-0404)는 24시간 운영하고 현지 대사관·영사관과 연결해 준다."},
{"id":"T1237","line":3424,"t":"출국 전에 해 두면 좋은 것은?"},
{"id":"T1238","line":3424,"t":"해외안전여행 앱으로 여행경보를 보고 여권 사본을 따로 챙긴다"},
{"id":"T1239","line":3424,"t":"여권 사본은 버린다"},
{"id":"T1240","line":3424,"t":"카드는 한 장만 챙긴다"},
{"id":"T1241","line":3425,"t":"여행경보와 현지 사건 소식을 받을 수 있다. 여권 사본이 있으면 분실했을 때 재발급이 빨라진다."},
{"id":"T1242","line":3429,"t":"찾기쉬운 생활법령정보"},
{"id":"T1243","line":3430,"t":"금융위원회"},
{"id":"T1244","line":3431,"t":"금융감독원 파인"},
{"id":"T1245","line":3431,"t":"경찰청 사이버범죄 신고시스템"},
{"id":"T1246","line":3432,"t":"금융감독원 파인"},
{"id":"T1247","line":3432,"t":"공정거래위원회"},
{"id":"T1248","line":3433,"t":"고용노동부 노동포털"},
{"id":"T1249","line":3433,"t":"최저임금위원회"},
{"id":"T1250","line":3434,"t":"금융감독원 통합연금포털"},
{"id":"T1251","line":3434,"t":"금융감독원 파인"},
{"id":"T1252","line":3435,"t":"외교부 해외안전여행"},
{"id":"T1253","line":3439,"t":"월급 명세서 한 줄씩"},
{"id":"T1254","line":3440,"t":"첫 월급 명세서 봤어요? 떼어 간 돈이 뭔지는 알아야죠."},
{"id":"T1255","line":3441,"t":"회사와 근로자가 보험료를 절반씩 나눠 내는 것은?"},
{"id":"T1256","line":3441,"t":"국민연금과 건강보험"},
{"id":"T1257","line":3441,"t":"산재보험"},
{"id":"T1258","line":3441,"t":"모든 4대보험이 똑같이 절반"},
{"id":"T1259","line":3442,"t":"국민연금과 건강보험은 회사와 근로자가 반씩 낸다. 고용보험은 실업급여 몫만 반씩이고, 산재보험은 회사가 전부 낸다. 국민연금공단·국민건강보험공단 안내 기준."},
{"id":"T1260","line":3443,"t":"명세서에 산재보험료가 없는 이유는?"},
{"id":"T1261","line":3443,"t":"산재보험료는 회사가 전액 내기 때문"},
{"id":"T1262","line":3443,"t":"산재보험에 가입이 안 돼서"},
{"id":"T1263","line":3443,"t":"다음 달에 몰아서 떼기 때문"},
{"id":"T1264","line":3444,"t":"산재보험료는 사업주가 전액 부담한다(근로복지공단). 명세서에 없다고 가입이 안 된 것은 아니다."},
{"id":"T1265","line":3445,"t":"내가 4대보험에 제대로 가입돼 있는지 확인하는 곳은?"},
{"id":"T1266","line":3445,"t":"4대사회보험 정보연계센터"},
{"id":"T1267","line":3445,"t":"회사 단톡방"},
{"id":"T1268","line":3445,"t":"은행 앱"},
{"id":"T1269","line":3446,"t":"4대사회보험 정보연계센터(4insure.or.kr)에서 가입 내역을 한 번에 본다. 공단별 누리집에서도 조회할 수 있다."},
{"id":"T1270","line":3447,"t":"월세도 연말정산이 된다"},
{"id":"T1271","line":3448,"t":"월세 사는데 연말정산에 월세 넣었어요? 많이들 빠뜨려요."},
{"id":"T1272","line":3449,"t":"월세 세액공제를 받으려면 기본으로 맞아야 하는 조건은?"},
{"id":"T1273","line":3449,"t":"무주택 세대이고 총급여가 기준 이하"},
{"id":"T1274","line":3449,"t":"집주인 동의서"},
{"id":"T1275","line":3449,"t":"월세 100만원 이상"},
{"id":"T1276","line":3450,"t":"무주택 세대의 세대주(요건에 맞는 세대원 포함)이고 총급여가 기준 이하여야 한다. 금액 기준과 공제율은 국세청 연말정산 안내에서 그해 기준을 확인한다."},
{"id":"T1277","line":3451,"t":"회사에 월세 공제를 못 넣고 연말정산이 끝났다면?"},
{"id":"T1278","line":3451,"t":"5월 종합소득세 신고나 경정청구로 받을 수 있다"},
{"id":"T1279","line":3451,"t":"다시는 받을 수 없다"},
{"id":"T1280","line":3451,"t":"다음 해에 두 배로 받는다"},
{"id":"T1281","line":3452,"t":"놓친 공제는 5월 종합소득세 신고 때 넣거나, 법정신고기한부터 5년 안에 경정청구할 수 있다. 국세청 홈택스에서 한다."},
{"id":"T1282","line":3453,"t":"월세 공제에서 자주 틀어지는 부분은?"},
{"id":"T1283","line":3453,"t":"계약서 주소와 주민등록 주소가 같아야 한다"},
{"id":"T1284","line":3453,"t":"집주인이 법인이어야 한다"},
{"id":"T1285","line":3453,"t":"현금으로 내야 한다"},
{"id":"T1286","line":3454,"t":"임대차계약서 주소지에 전입해 있어야 한다. 계약서 사본과 월세를 보낸 이체 내역을 챙겨 둔다. 국세청 안내."},
{"id":"T1287","line":3455,"t":"내일배움카드, 직장인도 된다"},
{"id":"T1288","line":3455,"t":"고용센터 상담원"},
{"id":"T1289","line":3456,"t":"회사 다니면서 자격증 따고 싶다고요? 카드부터 만들어요."},
{"id":"T1290","line":3457,"t":"국민내일배움카드를 재직자도 받을 수 있을까?"},
{"id":"T1291","line":3457,"t":"일부 예외를 빼면 재직자도 받을 수 있다"},
{"id":"T1292","line":3457,"t":"실업자만 받는다"},
{"id":"T1293","line":3457,"t":"대학생만 받는다"},
{"id":"T1294","line":3458,"t":"실업자와 재직자 모두 대상이다. 공무원 등 일부는 빠지니 고용노동부 고용24에서 내가 대상인지 먼저 본다."},
{"id":"T1295","line":3459,"t":"카드 신청과 과정 검색은 어디서 할까?"},
{"id":"T1296","line":3459,"t":"고용24"},
{"id":"T1297","line":3459,"t":"국세청 홈택스"},
{"id":"T1298","line":3459,"t":"정부24 민원 발급"},
{"id":"T1299","line":3460,"t":"고용노동부 고용24(work24.go.kr)에서 카드를 신청하고 훈련 과정을 찾는다. 예전 HRD-Net 기능이 이쪽으로 합쳐졌다."},
{"id":"T1300","line":3461,"t":"카드로 듣는 과정 비용으로 맞는 말은?"},
{"id":"T1301","line":3461,"t":"정부 지원과 별도로 내 부담금이 있을 수 있다"},
{"id":"T1302","line":3461,"t":"항상 전액 무료다"},
{"id":"T1303","line":3461,"t":"끝나면 수강료를 현금으로 돌려준다"},
{"id":"T1304","line":3462,"t":"과정마다 자부담 비율이 다르고, 지원 한도도 정해져 있다. 금액은 고용24 과정 상세에서 확인한다."},
{"id":"T1305","line":3463,"t":"관리비 고지서 읽기"},
{"id":"T1306","line":3463,"t":"자취 선배"},
{"id":"T1307","line":3464,"t":"관리비가 왜 이렇게 나왔는지 고지서 한 번 같이 보자."},
{"id":"T1308","line":3465,"t":"관리비 중 세입자가 아니라 집주인이 내야 하는 것은?"},
{"id":"T1309","line":3465,"t":"장기수선충당금"},
{"id":"T1310","line":3465,"t":"전기·수도 사용료"},
{"id":"T1311","line":3465,"t":"경비·청소비"},
{"id":"T1312","line":3466,"t":"장기수선충당금은 공동주택 소유자가 부담한다(공동주택관리법). 세입자가 냈다면 이사 나갈 때 관리사무소에서 납부 확인서를 떼 집주인에게 돌려받는다."},
{"id":"T1313","line":3467,"t":"우리 아파트 관리비가 비싼지 비교해 보는 곳은?"},
{"id":"T1314","line":3467,"t":"공동주택관리정보시스템(K-apt)"},
{"id":"T1315","line":3467,"t":"중고거래 앱"},
{"id":"T1316","line":3467,"t":"은행 앱"},
{"id":"T1317","line":3468,"t":"국토교통부가 운영하는 K-apt에서 비슷한 단지의 관리비를 항목별로 비교할 수 있다."},
{"id":"T1318","line":3469,"t":"고지서의 \"공용관리비\"와 \"개별사용료\"의 차이는?"},
{"id":"T1319","line":3469,"t":"공용은 단지 전체 비용을 나눈 것, 개별은 우리 집이 쓴 만큼"},
{"id":"T1320","line":3469,"t":"둘 다 같은 말이다"},
{"id":"T1321","line":3469,"t":"개별사용료는 집주인이 낸다"},
{"id":"T1322","line":3470,"t":"공용관리비는 경비·청소·승강기처럼 함께 쓰는 비용, 개별사용료는 전기·수도·난방처럼 쓴 만큼 낸다. 줄일 수 있는 것은 주로 개별사용료다."},
{"id":"T1323","line":3471,"t":"계약갱신요구권 한 번"},
{"id":"T1324","line":3471,"t":"부동산 사장"},
{"id":"T1325","line":3472,"t":"계약 끝나 간다고 무조건 나가야 하는 건 아니에요."}]