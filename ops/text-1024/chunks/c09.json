{"id":"T5739","line":11997,"t":"방에서 옮기기"},
{"id":"T5740","line":11997,"t":"방에 놓기"},
{"id":"T5741","line":11998,"t":"상점으로"},
{"id":"T5742","line":12007,"t":"세간 · 방에 들이면 공격·방어가 올라요"},
{"id":"T5743","line":12008,"t":" <span class=\"micro\">· 지금은 들어갈 방이 없어요</span>"},
{"id":"T5744","line":12034,"t":"<span class=\"d\">다 들음</span>"},
{"id":"T5745","line":12034,"t":"<span class=\"p\">남은 "},
{"id":"T5746","line":12034,"t":"눌러서 가기"},
{"id":"T5747","line":12034,"t":"자동차로 가는 곳"},
{"id":"T5748","line":12039,"t":"<b>사건</b><span>"},
{"id":"T5749","line":12039,"t":"최고 결말"},
{"id":"T5750","line":12040,"t":"<b>보스</b><span>"},
{"id":"T5751","line":12040,"t":"도전 가능"},
{"id":"T5752","line":12040,"t":"에 은행 골목에서"},
{"id":"T5753","line":12042,"t":"<b>복습</b><span>"},
{"id":"T5754","line":12042,"t":"문항 대기 · 내 방 책상"},
{"id":"T5755","line":12050,"t":"장비 도감 · "},
{"id":"T5756","line":12057,"t":" · 다 찾음"},
{"id":"T5757","line":12058,"t":"숨은 것들 · "},
{"id":"T5758","line":12064,"t":" 스탯 "},
{"id":"T5759","line":12067,"t":"6개월 미만"},
{"id":"T5760","line":12067,"t":"6개월~1년"},
{"id":"T5761","line":12067,"t":"1년 이상"},
{"id":"T5762","line":12068,"t":"1년 미만"},
{"id":"T5763","line":12068,"t":"1~3년차"},
{"id":"T5764","line":12068,"t":"4년차 이상"},
{"id":"T5765","line":12069,"t":"만 24세 이하"},
{"id":"T5766","line":12069,"t":"만 25~29세"},
{"id":"T5767","line":12069,"t":"만 30~34세"},
{"id":"T5768","line":12069,"t":"만 35세 이상"},
{"id":"T5769","line":12071,"t":"<b>신분</b><span>"},
{"id":"T5770","line":12071,"t":"</span><b>나이</b><span>"},
{"id":"T5771","line":12071,"t":"아직 안 받음"},
{"id":"T5772","line":12072,"t":"<b>상황</b><span>"},
{"id":"T5773","line":12072,"t":"</span><b>권역</b><span>"},
{"id":"T5774","line":12073,"t":"<b>연속</b><span>"},
{"id":"T5775","line":12073,"t":"일 · 최고 "},
{"id":"T5776","line":12073,"t":"일</span>"},
{"id":"T5777","line":12074,"t":"<b>레벨</b><span>Lv."},
{"id":"T5778","line":12074,"t":" XP</span><b>코인</b><span>￦"},
{"id":"T5779","line":12075,"t":"<b>거처</b><span>"},
{"id":"T5780","line":12075,"t":" (해금 "},
{"id":"T5781","line":12076,"t":"<b>전투</b><span>공격 "},
{"id":"T5782","line":12076,"t":" · 방어 "},
{"id":"T5783","line":12077,"t":"<b>보스</b><span>"},
{"id":"T5784","line":12080,"t":"개 중 이 조건으로 "},
{"id":"T5785","line":12080,"t":"개가 노출되고 있어요.<br>"},
{"id":"T5786","line":12081,"t":"숨긴 퀘스트: "},
{"id":"T5787","line":12081,"t":"숨긴 퀘스트 없음"},
{"id":"T5788","line":12082,"t":"<br><br>실제 앱에서는 권역별 시세, 지자체 청년 지원금, 학교·회사별 제도가 여기서 갈려요."},
{"id":"T5789","line":12093,"t":"전세·월세 계약"},
{"id":"T5790","line":12094,"t":"집 보는 날부터 보증금 돌려받는 날까지"},
{"id":"T5791","line":12095,"t":"찾기쉬운 생활법령정보"},
{"id":"T5792","line":12097,"t":"집 보기"},
{"id":"T5793","line":12097,"t":"계약 2~4주 전"},
{"id":"T5794","line":12098,"t":"실거래가로 시세를 먼저 잡는다. 전세가가 매매가에 근접하면 그 자체가 신호다."},
{"id":"T5795","line":12099,"t":"시세를 모르면 비싼 줄도 모르고 계약한다."},
{"id":"T5796","line":12100,"t":"등기부등본 확인"},
{"id":"T5797","line":12100,"t":"집을 정한 날"},
{"id":"T5798","line":12101,"t":"갑구에서 소유자와 압류를, 을구에서 근저당을 본다. 근저당 채권최고액과 전세가의 합을 시세와 비교한다."},
{"id":"T5799","line":12102,"t":"선순위 채권이 크면 경매에서 보증금 순위가 밀린다."},
{"id":"T5800","line":12103,"t":"가계약금"},
{"id":"T5801","line":12103,"t":"집을 잡을 때"},
{"id":"T5802","line":12104,"t":"금액·계약일·특약을 문자로 남기고 보낸다. 계좌는 반드시 등기부상 소유자 명의로."},
{"id":"T5803","line":12105,"t":"조건을 안 남기면 돌려받기 어려워진다."},
{"id":"T5804","line":12106,"t":"계약서 작성"},
{"id":"T5805","line":12107,"t":"임대인 신분증과 등기부상 소유자를 대조한다. 대리인이면 위임장과 인감증명서. 특약에 \"잔금일 다음 날까지 근저당을 설정하지 않는다\"를 넣는다."},
{"id":"T5806","line":12108,"t":"계약금만 낸 사이에 대출이 잡히면 순위가 밀린다."},
{"id":"T5807","line":12109,"t":"전세대출 신청"},
{"id":"T5808","line":12109,"t":"계약 직후"},
{"id":"T5809","line":12110,"t":"은행 심사와 보증기관 요건을 함께 본다. 대출이 안 나오면 계약금을 잃을 수 있어 특약으로 조건부 해제를 넣어 두기도 한다."},
{"id":"T5810","line":12111,"t":"심사 기간을 못 잡으면 잔금일을 못 맞춘다."},
{"id":"T5811","line":12112,"t":"잔금 · 이사"},
{"id":"T5812","line":12113,"t":"잔금 치르기 직전에 등기부등본을 한 번 더 뗀다. 계약일과 달라진 게 없는지 확인한다."},
{"id":"T5813","line":12114,"t":"계약 후 잔금 전에 설정된 근저당을 모르고 넘어간다."},
{"id":"T5814","line":12115,"t":"전입신고"},
{"id":"T5815","line":12115,"t":"이사 당일"},
{"id":"T5816","line":12116,"t":"주민센터나 정부24에서 신고한다. 대항력은 신고한 다음 날 0시에 생긴다."},
{"id":"T5817","line":12117,"t":"하루가 비면 그 사이 설정된 권리가 내 앞에 선다."},
{"id":"T5818","line":12118,"t":"확정일자"},
{"id":"T5819","line":12118,"t":"전입신고와 같은 날"},
{"id":"T5820","line":12119,"t":"계약서에 확정일자를 받으면 우선변제권이 생긴다. 대항력과 짝이다."},
{"id":"T5821","line":12120,"t":"하나만 있으면 보증금을 지키지 못한다."},
{"id":"T5822","line":12121,"t":"전월세 신고"},
{"id":"T5823","line":12121,"t":"계약일로부터 30일 안"},
{"id":"T5824","line":12122,"t":"보증금 6천만 원 초과 또는 월세 30만 원 초과면 대상. 신고하면 확정일자가 함께 부여된다."},
{"id":"T5825","line":12123,"t":"기한을 넘기면 과태료 대상이 된다."},
{"id":"T5826","line":12124,"t":"보증금 반환"},
{"id":"T5827","line":12124,"t":"계약 만료"},
{"id":"T5828","line":12125,"t":"만료 전에 갱신·퇴거 의사를 미리 알린다. 안 돌려주면 임차권등기명령을 받고 등기를 확인한 뒤 이사한다."},
{"id":"T5829","line":12126,"t":"먼저 이사를 나가면 점유와 주민등록이 빠져 순위를 잃는다."},
{"id":"T5830","line":12129,"t":"첫 직장 첫 달"},
{"id":"T5831","line":12130,"t":"계약서 받는 날부터 퇴사 뒤 실업급여까지"},
{"id":"T5832","line":12131,"t":"고용노동부"},
{"id":"T5833","line":12133,"t":"근로계약서"},
{"id":"T5834","line":12134,"t":"임금·소정근로시간 등이 적힌 서면을 받는다. 회사가 줘야 할 의무다."},
{"id":"T5835","line":12135,"t":"안 주는 것 자체가 위반이다. 조건을 나중에 다투기 어려워진다."},
{"id":"T5836","line":12136,"t":"연봉에 퇴직금이 있는지"},
{"id":"T5837","line":12136,"t":"계약서 볼 때"},
{"id":"T5838","line":12137,"t":"퇴직금을 월급에 얹어 주는 분할약정은 원칙적으로 무효로 본다. 총액에 섞여 있는지 확인한다."},
{"id":"T5839","line":12138,"t":"연봉이 높아 보이지만 실제로는 내 퇴직금을 미리 받은 것이다."},
{"id":"T5840","line":12139,"t":"4대보험 가입"},
{"id":"T5841","line":12139,"t":"입사 후 며칠 안"},
{"id":"T5842","line":12140,"t":"건강보험·국민연금·고용보험·산재보험. 건강보험료는 회사와 절반씩 낸다."},
{"id":"T5843","line":12141,"t":"가입이 누락되면 나중에 실업급여 기간이 모자란다."},
{"id":"T5844","line":12142,"t":"급여명세서 읽기"},
{"id":"T5845","line":12142,"t":"첫 급여일"},
{"id":"T5846","line":12143,"t":"공제 항목에 4대보험과 소득세가 있다. 실수령액과 계약 연봉의 차이가 여기서 난다."},
{"id":"T5847","line":12144,"t":"명세서를 안 보면 잘못된 공제를 그냥 넘긴다."},
{"id":"T5848","line":12145,"t":"주휴수당"},
{"id":"T5849","line":12146,"t":"주 15시간 이상 소정근로 + 그 주 개근이면 유급 주휴일이 생긴다. 알바도 같다."},
{"id":"T5850","line":12147,"t":"시급제라면 매주 하루치가 빠진다."},
{"id":"T5851","line":12148,"t":"1개월 뒤부터"},
{"id":"T5852","line":12149,"t":"1년 미만은 1개월 개근마다 1일. 1년간 80% 이상 출근하면 15일."},
{"id":"T5853","line":12150,"t":"회사가 사용을 권했는데도 안 쓰면 수당 없이 사라질 수 있다(연차 사용촉진)."},
{"id":"T5854","line":12151,"t":"퇴사와 실업급여"},
{"id":"T5855","line":12151,"t":"퇴사할 때"},
{"id":"T5856","line":12152,"t":"원칙적으로 비자발적 이직이고, 이직 전 18개월 중 피보험단위기간 180일 이상이어야 한다."},
{"id":"T5857","line":12153,"t":"자발적 퇴사로 처리되면 대상에서 빠진다. 퇴사 전에 기간을 조회해 둔다."},
{"id":"T5858","line":12156,"t":"졸업하면 생기는 일"},
{"id":"T5859","line":12157,"t":"학생 자격이 끝나는 순간 고지서가 붙기 시작한다"},
{"id":"T5860","line":12158,"t":"국민건강보험공단"},
{"id":"T5861","line":12160,"t":"건강보험 피부양자 탈락"},
{"id":"T5862","line":12160,"t":"졸업 · 소득 발생"},
{"id":"T5863","line":12161,"t":"소득·재산 요건을 벗어나면 지역가입자로 바뀐다. 취업 전이라도 고지서가 나온다."},
{"id":"T5864","line":12162,"t":"모르고 있다가 몇 달치가 한꺼번에 온다."},
{"id":"T5865","line":12163,"t":"지역가입자 보험료 조정"},
{"id":"T5866","line":12163,"t":"고지서를 받은 뒤"},
{"id":"T5867","line":12164,"t":"지역가입자 보험료는 소득과 재산을 함께 본다. 소득이 없으면 조정 신청으로 줄일 수 있는 경우가 있다."},
{"id":"T5868","line":12165,"t":"소득이 없는데도 그대로 낸다."},
{"id":"T5869","line":12166,"t":"국민연금 납부예외"},
{"id":"T5870","line":12166,"t":"소득이 끊긴 달"},
{"id":"T5871","line":12167,"t":"신청해야 적용된다. 방치하면 체납으로 남는다."},
{"id":"T5872","line":12168,"t":"연체금이 붙고 가입 이력이 지저분해진다."},
{"id":"T5873","line":12169,"t":"학자금 대출 상환 방식 확인"},
{"id":"T5874","line":12169,"t":"졸업 직후"},
{"id":"T5875","line":12170,"t":"취업 후 상환은 소득이 기준을 넘은 다음 해부터, 일반 상환은 거치 뒤 정해진 일정대로."},
{"id":"T5876","line":12171,"t":"유예 중에도 이자는 쌓인다는 걸 놓친다."},
{"id":"T5877","line":12172,"t":"청약통장 만들기"},
{"id":"T5878","line":12172,"t":"빠를수록 좋다"},
{"id":"T5879","line":12173,"t":"가입기간이 가점 항목이라 시간이 곧 점수다. 나이·주택 소유와 관계없이 가입할 수 있다."},
{"id":"T5880","line":12174,"t":"늦게 만든 기간은 되돌릴 수 없다."},
{"id":"T5881","line":12175,"t":"신용점수 쌓기"},
{"id":"T5882","line":12175,"t":"첫 카드부터"},
{"id":"T5883","line":12176,"t":"통신요금·건강보험료 성실납부 실적을 직접 제출하면 가점이 된다. 카드 사용률은 낮게 유지한다."},
{"id":"T5884","line":12177,"t":"금융 이력이 없으면 첫 대출에서 불리해진다."},
{"id":"T5885","line":12178,"t":"추후납부"},
{"id":"T5886","line":12178,"t":"여유가 생겼을 때"},
{"id":"T5887","line":12179,"t":"납부예외 기간은 가입기간에서 빠지므로 나중에 추납으로 메울 수 있다."},
{"id":"T5888","line":12180,"t":"안 메우면 연금액이 그만큼 줄어든다."},
{"id":"T5889","line":12183,"t":"자취 시작할 때 드는 돈"},
{"id":"T5890","line":12184,"t":"월세만 보고 계산하면 매달 20~30%가 더 나간다"},
{"id":"T5891","line":12185,"t":"찾기쉬운 생활법령정보"},
{"id":"T5892","line":12187,"t":"초기 목돈"},
{"id":"T5893","line":12187,"t":"계약할 때"},
{"id":"T5894","line":12188,"t":"보증금 + 중개보수 + 이사비. 중개보수는 거래금액 구간별 상한요율 안에서 협의한다."},
{"id":"T5895","line":12189,"t":"계약 뒤에 중개보수를 꺼내면 흥정할 자리가 없다."},
{"id":"T5896","line":12190,"t":"보증금의 기회비용"},
{"id":"T5897","line":12190,"t":"계약 기간 내내"},
{"id":"T5898","line":12191,"t":"돌려받지만 그동안 묶인다. 기숙사와 비교할 때 예금 이자만큼은 비용으로 넣는다."},
{"id":"T5899","line":12192,"t":"월세만 비교하면 자취가 더 싸 보인다."},
{"id":"T5900","line":12193,"t":"매달 고정비 잡기"},
{"id":"T5901","line":12194,"t":"월세 + 관리비 + 공과금 + 인터넷. 관리비에 무엇이 포함되는지 계약서에서 확인한다."},
{"id":"T5902","line":12195,"t":"관리비와 공과금이 예산 밖에 있으면 매달 적자가 난다."},
{"id":"T5903","line":12196,"t":"식비 한도 정하기"},
{"id":"T5904","line":12197,"t":"주 단위 한도를 먼저 정하고 식비 전용 계좌나 카드를 따로 둔다. 잔액이 줄어드는 것 자체가 신호다."},
{"id":"T5905","line":12198,"t":"변동비를 그냥 변동비로 두면 다 쓰고 나서야 알게 된다."},
{"id":"T5906","line":12199,"t":"배달비 계산"},
{"id":"T5907","line":12199,"t":"시킬 때마다"},
{"id":"T5908","line":12200,"t":"메뉴 가격 + 배달비 + 최소주문 금액을 맞추려고 더 담은 돈이 실제 지출이다."},
{"id":"T5909","line":12201,"t":"주 3회를 1회로 줄이면 한 달 14만 원이 남는다."},
{"id":"T5910","line":12202,"t":"옷·세탁 회당 비용"},
{"id":"T5911","line":12202,"t":"살 때와 맡길 때"},
{"id":"T5912","line":12203,"t":"가격을 착용 횟수로 나눠 본다. 세탁은 라벨을 먼저 보고 시즌당 횟수를 정한다."},
