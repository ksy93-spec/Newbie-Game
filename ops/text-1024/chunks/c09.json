{"id":"T5422","line":11309,"t":" · 보너스 2배 시작"},
{"id":"T5423","line":11309,"t":" · 보너스 3배 시작"},
{"id":"T5424","line":11346,"t":"전세 계약 하루"},
{"id":"T5425","line":11346,"t":"부동산 사장"},
{"id":"T5426","line":11347,"t":"집을 보고 잔금을 치르기까지, 손해는 순서에서 난다."},
{"id":"T5427","line":11348,"t":"찾기쉬운 생활법령정보"},
{"id":"T5428","line":11350,"t":"오늘 아니면 다른 사람한테 넘어가요. 가계약금 300만 원만 지금 넣으시죠."},
{"id":"T5429","line":11352,"t":"등기부등본부터 떼어 보겠다고 한다"},
{"id":"T5430","line":11353,"t":"계약 전에 등기부등본으로 소유자와 근저당을 본다. 가계약금은 계약이 깨져도 돌려받기 어려운 돈이라, 순서가 뒤집히면 확인할 힘을 먼저 잃는다."},
{"id":"T5431","line":11354,"t":"놓칠까 봐 가계약금을 먼저 넣는다"},
{"id":"T5432","line":11355,"t":"급하다는 말은 조건이 아니라 압박이다. 돈이 먼저 들어가면 그 뒤로는 확인이 아니라 설득하게 된다."},
{"id":"T5433","line":11356,"t":"오늘은 보기만 하고 나온다"},
{"id":"T5434","line":11357,"t":"하루 늦는 대신 확인할 시간을 샀다. 놓쳐도 되는 매물이었다면 원래 놓쳐도 되는 매물이다."},
{"id":"T5435","line":11358,"t":"등기부등본을 뗐다. 갑구에 소유자, 을구에 근저당권이 하나 잡혀 있다."},
{"id":"T5436","line":11358,"t":"등기부등본"},
{"id":"T5437","line":11360,"t":"선순위 채권액과 내 보증금을 합쳐 집값과 비교한다"},
{"id":"T5438","line":11361,"t":"경매로 넘어가면 앞선 권리부터 가져간다. 선순위 채권 + 내 보증금이 시세에 가까울수록 남는 돈이 없다."},
{"id":"T5439","line":11362,"t":"은행 대출이니 괜찮다고 본다"},
{"id":"T5440","line":11363,"t":"은행이든 개인이든 순위가 앞서면 먼저 가져간다. 채권자가 누구인지가 아니라 얼마가 앞서 있는지가 문제다."},
{"id":"T5441","line":11364,"t":"집주인에게 말로 물어보고 넘어간다"},
{"id":"T5442","line":11365,"t":"말은 등기에 안 남는다. 확인은 서류로 하고, 서류에 없는 약속은 특약으로 남긴다."},
{"id":"T5443","line":11366,"t":"계약서를 쓴다. 특약 칸이 비어 있다."},
{"id":"T5444","line":11368,"t":"잔금일 다음 날까지 근저당을 새로 잡지 않는다는 특약을 넣는다"},
{"id":"T5445","line":11369,"t":"계약일과 잔금일 사이에 대출이 새로 잡히면 내 순위가 뒤로 밀린다. 그 사이를 막는 문장이 특약이다."},
{"id":"T5446","line":11370,"t":"표준 계약서 그대로 간다"},
{"id":"T5447","line":11371,"t":"표준 계약서는 최소한이다. 이 집에만 있는 위험은 특약에만 적힌다."},
{"id":"T5448","line":11372,"t":"집주인이 기분 상할까 봐 말하지 않는다"},
{"id":"T5449","line":11373,"t":"계약서에서 불편한 말을 못 하면, 사고가 난 뒤에는 할 수 있는 말이 없다."},
{"id":"T5450","line":11374,"t":"잔금일 아침이다. 오후에 잔금을 보내고 열쇠를 받기로 했다."},
{"id":"T5451","line":11376,"t":"잔금을 보내기 직전에 등기부등본을 다시 뗀다"},
{"id":"T5452","line":11377,"t":"계약일 이후에 근저당이 새로 잡혔는지는 잔금 직전에만 확인할 수 있다. 보내고 나면 되돌릴 방법이 없다."},
{"id":"T5453","line":11378,"t":"계약할 때 봤으니 그대로 보낸다"},
{"id":"T5454","line":11379,"t":"등기는 계약 다음 날에도 바뀔 수 있다. 확인은 돈이 나가기 전에만 의미가 있다."},
{"id":"T5455","line":11380,"t":"이사를 마쳤다. 짐은 다 들어왔고 주민센터는 아직 문을 닫지 않았다."},
{"id":"T5456","line":11382,"t":"그날 바로 전입신고와 확정일자를 함께 처리한다"},
{"id":"T5457","line":11383,"t":"대항력은 전입신고한 다음 날 0시부터 생긴다. 하루를 미루면 그 하루에 잡힌 권리가 나보다 앞선다."},
{"id":"T5458","line":11384,"t":"전입신고만 하고 확정일자는 나중에 받는다"},
{"id":"T5459","line":11385,"t":"전입신고로 대항력은 생겨도, 확정일자가 없으면 배당에서 순위를 주장할 우선변제권이 없다."},
{"id":"T5460","line":11386,"t":"바빠서 주말에 몰아서 하기로 한다"},
{"id":"T5461","line":11387,"t":"이 며칠이 통째로 빈다. 전세사기 사건들이 파고드는 자리가 바로 이 틈이다."},
{"id":"T5462","line":11388,"t":"두 달 뒤, 집주인이 바뀌었다는 연락을 받았다. 새 주인이 계약서를 다시 쓰자고 한다."},
{"id":"T5463","line":11390,"t":"임대인 지위가 승계되므로 기존 계약대로 가겠다고 한다"},
{"id":"T5464","line":11391,"t":"대항력을 갖춘 임차인은 집이 팔려도 남은 계약을 그대로 주장할 수 있다. 새 주인이 임대인 자리를 이어받는다."},
{"id":"T5465","line":11392,"t":"새 주인이 원하는 대로 계약서를 다시 쓴다"},
{"id":"T5466","line":11393,"t":"다시 쓰면 날짜가 새로 시작된다. 어렵게 쌓은 순위를 스스로 내려놓는 셈이다."},
{"id":"T5467","line":11394,"t":"무서워서 일단 나가겠다고 한다"},
{"id":"T5468","line":11395,"t":"나가는 순간 점유가 끊기고 대항력도 함께 사라진다. 보증금을 받기 전에는 짐을 빼지 않는다."},
{"id":"T5469","line":11397,"t":"보증금을 지켰다"},
{"id":"T5470","line":11397,"t":"2년 뒤 계약이 끝났고, 보증금은 그대로 돌아왔다."},
{"id":"T5471","line":11398,"t":"아슬아슬하게 넘겼다"},
{"id":"T5472","line":11398,"t":"큰일은 없었지만 몇 달을 조마조마하게 보냈다. 운이 좋았다는 말은 칭찬이 아니다."},
{"id":"T5473","line":11399,"t":"보증금이 묶였다"},
{"id":"T5474","line":11399,"t":"집이 경매로 넘어갔고, 앞선 권리들이 먼저 가져갔다. 순서 하나가 결과를 바꿨다."},
{"id":"T5475","line":11401,"t":"첫 알바 한 달"},
{"id":"T5476","line":11401,"t":"알바 선배"},
{"id":"T5477","line":11402,"t":"근로계약서 한 장에서 시작해서, 마지막 급여에서 끝난다."},
{"id":"T5478","line":11403,"t":"고용노동부"},
{"id":"T5479","line":11405,"t":"첫 출근이다. 사장님이 \"계약서는 나중에 쓰자\"고 한다."},
{"id":"T5480","line":11407,"t":"오늘 쓰고 한 부 받아 가겠다고 한다"},
{"id":"T5481","line":11408,"t":"근로계약서는 근로를 시작할 때 서면으로 쓰고 근로자에게 한 부를 준다. 시급·근로시간·휴일이 적힌 종이가 나중의 유일한 증거다."},
{"id":"T5482","line":11409,"t":"첫날부터 까다롭게 굴기 싫어 넘어간다"},
{"id":"T5483","line":11410,"t":"계약서가 없으면 다툼이 생겼을 때 말과 말이 부딪친다. 처음에 한 번 어색한 편이 싸다."},
{"id":"T5484","line":11411,"t":"문자로라도 조건을 남겨 달라고 한다"},
{"id":"T5485","line":11412,"t":"없는 것보다는 낫다. 다만 서면 교부는 의무이고, 문자는 그 의무를 대신하지 못한다."},
{"id":"T5486","line":11413,"t":"주 5일, 하루 4시간으로 한 달을 채웠다. 급여에 주휴수당이 안 보인다."},
{"id":"T5487","line":11415,"t":"주 15시간 이상이면 주휴수당 대상이라고 말한다"},
{"id":"T5488","line":11416,"t":"한 주 소정근로시간이 15시간 이상이고 정해진 날을 다 나오면 유급 주휴일이 생긴다. 주 20시간이면 대상이다."},
{"id":"T5489","line":11417,"t":"알바는 원래 없는 줄 알고 넘어간다"},
{"id":"T5490","line":11418,"t":"고용 형태가 아니라 시간이 기준이다. 모르면 안 받는 돈이라 매달 조용히 사라진다."},
{"id":"T5491","line":11419,"t":"다음 달부터 챙겨 달라고만 한다"},
{"id":"T5492","line":11420,"t":"이번 달 몫도 임금이다. 지나간 달을 스스로 포기할 이유가 없다."},
{"id":"T5493","line":11421,"t":"\"수습이라 3개월은 최저임금보다 조금 적게 줄게.\" 사장님이 말한다."},
{"id":"T5494","line":11423,"t":"감액이 가능한 경우인지 확인하고 답하겠다고 한다"},
{"id":"T5495","line":11424,"t":"수습이라고 언제나 깎을 수 있는 것이 아니다. 계약 기간과 업무 종류에 따라 다르고, 조건을 벗어나면 최저임금 위반이다."},
{"id":"T5496","line":11425,"t":"수습이니 당연하다고 받아들인다"},
{"id":"T5497","line":11426,"t":"\"수습이라서\"는 설명이지 근거가 아니다. 근거는 계약서와 최저임금법에 있다."},
{"id":"T5498","line":11427,"t":"그만두겠다고 한다"},
{"id":"T5499","line":11428,"t":"확인하기 전에 그만두면 확인할 기회도 같이 사라진다. 먼저 묻고 나서 결정해도 늦지 않다."},
{"id":"T5500","line":11429,"t":"마감 정리 때문에 매일 15분씩 더 남는다. 급여에는 안 잡힌다."},
{"id":"T5501","line":11431,"t":"출퇴근 기록을 매일 남기고 연장근로를 청구한다"},
{"id":"T5502","line":11432,"t":"15분씩 한 달이면 하루치가 넘는다. 기록이 있으면 청구할 수 있고, 없으면 기억끼리 다투게 된다."},
{"id":"T5503","line":11433,"t":"그 정도는 서비스라고 생각한다"},
{"id":"T5504","line":11434,"t":"일한 시간은 임금이다. 관행이라는 말이 법을 바꾸지는 않는다."},
{"id":"T5505","line":11435,"t":"말없이 15분 전에 퇴근한다"},
{"id":"T5506","line":11436,"t":"마찰은 줄지만 문제는 남는다. 정리 시간이 근무라면 근무로 정해 두는 편이 서로 낫다."},
{"id":"T5507","line":11437,"t":"그만두고 2주가 지났는데 마지막 급여가 안 들어왔다."},
{"id":"T5508","line":11439,"t":"내역을 정리해 고용노동부에 진정을 넣는다"},
{"id":"T5509","line":11440,"t":"임금은 퇴직일로부터 정해진 기간 안에 지급해야 한다. 계약서·근무기록·급여 내역을 모아 관할 노동청에 진정할 수 있다."},
{"id":"T5510","line":11441,"t":"연락이 올 때까지 기다린다"},
{"id":"T5511","line":11442,"t":"기다리는 동안 증거가 흩어지고 청구할 수 있는 기간도 줄어든다."},
{"id":"T5512","line":11443,"t":"단톡방에 올려 망신을 준다"},
{"id":"T5513","line":11444,"t":"속은 풀려도 돈은 안 들어온다. 오히려 다툼이 다른 문제로 번질 수 있다."},
{"id":"T5514","line":11446,"t":"받을 것을 다 받았다"},
{"id":"T5515","line":11446,"t":"마지막 급여까지 정산이 끝났다. 다툴 때 필요한 근거는 전부 종이에 있었다."},
{"id":"T5516","line":11447,"t":"절반은 받았다"},
{"id":"T5517","line":11447,"t":"받은 것도 있고 놓친 것도 있다. 다음에는 첫날부터 챙기기로 했다."},
{"id":"T5518","line":11448,"t":"그냥 떼였다"},
{"id":"T5519","line":11448,"t":"한 달 일하고 받을 돈을 제대로 못 받았다. 억울한 마음만으로는 청구할 수 없다."},
{"id":"T5520","line":11450,"t":"첫 월급 세 달"},
{"id":"T5521","line":11450,"t":"은행 창구 직원"},
{"id":"T5522","line":11451,"t":"통장에 찍힌 금액과 계약서의 연봉은 원래 다르다."},
{"id":"T5523","line":11452,"t":"금융감독원 파인"},
{"id":"T5524","line":11454,"t":"첫 월급이 들어왔다. 계약서에 적힌 금액보다 적다."},
{"id":"T5525","line":11456,"t":"급여명세서에서 공제 항목을 하나씩 확인한다"},
{"id":"T5526","line":11457,"t":"4대보험과 소득세가 먼저 빠진다. 명세서를 읽으면 내 돈이 어디로 갔는지가 아니라 무엇을 사고 있는지가 보인다."},
{"id":"T5527","line":11458,"t":"회사가 잘못 넣은 줄 알고 넘어간다"},
{"id":"T5528","line":11459,"t":"공제는 정상이지만, 확인해 보지 않으면 진짜 오류가 섞여 있어도 모른다."},
{"id":"T5529","line":11460,"t":"실수령액만 보고 신경 쓰지 않는다"},
{"id":"T5530","line":11461,"t":"연말정산과 건강보험 정산은 여기 적힌 숫자에서 시작한다. 한 번은 읽어 둬야 한다."},
{"id":"T5531","line":11462,"t":"카드사에서 첫 직장인 대상 신용카드를 권한다. 한도가 꽤 높다."},
{"id":"T5532","line":11464,"t":"고정지출부터 정리하고 한도를 낮춰 만든다"},
{"id":"T5533","line":11465,"t":"한도는 쓸 수 있는 돈이 아니라 빌릴 수 있는 돈이다. 먼저 쓰는 습관이 붙으면 다음 달 월급이 이미 줄어든 채로 들어온다."},
{"id":"T5534","line":11466,"t":"한도가 높을수록 좋다고 생각해 그대로 만든다"},
{"id":"T5535","line":11467,"t":"리볼빙과 할부가 얹히면 이자가 붙는다. 신용점수도 한도 대비 사용액에 영향을 받는다."},
{"id":"T5536","line":11468,"t":"무서워서 카드를 아예 안 만든다"},
{"id":"T5537","line":11469,"t":"거래 기록이 없으면 신용 이력도 안 쌓인다. 적게 쓰고 제때 갚는 편이 안 쓰는 것보다 낫다."},
{"id":"T5538","line":11470,"t":"월급의 얼마를 남길지 정해야 한다."},
{"id":"T5539","line":11472,"t":"월급날 자동이체로 먼저 떼고 나머지로 산다"},
{"id":"T5540","line":11473,"t":"쓰고 남기려 하면 남지 않는다. 순서를 바꾸는 것만으로 저축률이 달라진다."},
{"id":"T5541","line":11474,"t":"쓰고 남는 만큼 저축한다"},
{"id":"T5542","line":11475,"t":"남는 달과 안 남는 달이 반복된다. 금액보다 순서가 문제다."},
{"id":"T5543","line":11476,"t":"첫 몇 달은 쓰고 싶은 대로 쓴다"},
{"id":"T5544","line":11477,"t":"첫 습관이 기준선이 된다. 올리기는 쉽고 내리기는 어렵다."},
{"id":"T5545","line":11478,"t":"선배가 청약통장을 만들라고 한다. \"언제 쓸지도 모르는데?\""},
{"id":"T5546","line":11480,"t":"가입 기간과 납입 횟수가 쌓이는 상품이라 일찍 연다"},
{"id":"T5547","line":11481,"t":"청약 순위는 가입 기간과 납입 횟수로 쌓인다. 필요해진 다음에 만들면 그때부터 세기 시작한다."},
{"id":"T5548","line":11482,"t":"집 살 때 만들면 된다고 미룬다"},
{"id":"T5549","line":11483,"t":"그 시점에는 이미 순위 경쟁에서 몇 년이 밀려 있다."},
{"id":"T5550","line":11484,"t":"유행하는 상품으로 대신한다"},
{"id":"T5551","line":11485,"t":"제도마다 쓰이는 자리가 다르다. 다른 상품으로 대신할 수 있는지부터 확인하고 고른다."},
{"id":"T5552","line":11486,"t":"연말이다. 회사에서 연말정산 서류를 내라고 한다. 지금은 월세로 살고 있다."},
{"id":"T5553","line":11488,"t":"월세액 세액공제 요건에 해당하는지 확인하고 서류를 챙긴다"},
{"id":"T5554","line":11489,"t":"요건을 채우면 낸 월세의 일부를 세액에서 돌려받는다. 임대차계약서와 이체 내역이 근거가 된다."},
{"id":"T5555","line":11490,"t":"회사가 알아서 해 주겠거니 하고 낸다"},
{"id":"T5556","line":11491,"t":"회사는 낸 서류만 처리한다. 안 낸 공제는 없는 공제가 된다."},
{"id":"T5557","line":11492,"t":"집주인이 싫어할까 봐 신청하지 않는다"},
{"id":"T5558","line":11493,"t":"세액공제는 임차인이 신청하는 것이고, 요건을 갖췄다면 신청할 수 있는 권리다."},
{"id":"T5559","line":11495,"t":"세 달 만에 자리를 잡았다"},
{"id":"T5560","line":11495,"t":"큰돈을 번 것은 아니지만, 세 달 만에 새는 곳 없이 자리를 잡았다."},
{"id":"T5561","line":11496,"t":"절반만 챙겼다"},
{"id":"T5562","line":11496,"t":"시작은 했지만 챙기지 못한 것이 남았다. 내년에는 먼저 챙기기로 했다."},
{"id":"T5563","line":11497,"t":"세 달이 그냥 지나갔다"},
{"id":"T5564","line":11497,"t":"세 달이 지나도 통장에 남은 것이 없다. 첫 습관이 기준선이 된다."},
{"id":"T5565","line":11499,"t":"면접 다니는 달"},
{"id":"T5566","line":11499,"t":"고용센터 상담원"},
{"id":"T5567","line":11500,"t":"퇴사한 다음 날부터 시계가 돈다. 늦게 알면 늦은 만큼 못 받는다."},
{"id":"T5568","line":11501,"t":"고용노동부"},
{"id":"T5569","line":11503,"t":"퇴사한 다음 날이다. 당분간은 쉬면서 천천히 알아볼 생각이다."},
{"id":"T5570","line":11505,"t":"일단 고용센터에 가서 수급자격부터 확인한다"},
{"id":"T5571","line":11506,"t":"받을 수 있는 기간은 이직일 다음 날부터 센다. 늦게 신청하면 남은 일수가 있어도 그 기간이 끝나는 순간 사라진다."},
{"id":"T5572","line":11507,"t":"취업이 안 되면 그때 신청한다"},
{"id":"T5573","line":11508,"t":"미룬 만큼 그대로 날아간다. 신청을 미뤄서 얻는 것은 없다."},
{"id":"T5574","line":11509,"t":"자발적 퇴사라 안 될 것 같아 포기한다"},
{"id":"T5575","line":11510,"t":"원칙은 비자발적 이직이지만 법이 정한 정당한 사유는 예외로 인정되는 경우가 있다. 되는지 안 되는지는 고용센터가 판단한다."},
{"id":"T5576","line":11511,"t":"신청하러 갔더니 회사가 이직확인서를 아직 안 냈다고 한다."},
{"id":"T5577","line":11513,"t":"회사에 발급을 요청하고 처리됐는지 직접 조회한다"},
{"id":"T5578","line":11514,"t":"요청을 받으면 사업주는 정해진 기간 안에 발급해야 한다. 처리 여부는 본인이 조회할 수 있으니 기다리지 말고 확인한다."},
{"id":"T5579","line":11515,"t":"센터에서 알아서 받아 주겠거니 기다린다"},
{"id":"T5580","line":11516,"t":"서류가 안 들어오면 심사가 시작되지 않는다. 기다린 날짜만큼 수급기간이 줄어든다."},
{"id":"T5581","line":11517,"t":"회사와 얼굴 붉히기 싫어 포기한다"},
{"id":"T5582","line":11518,"t":"포기하면 그걸로 끝이다. 요청은 권리이고, 발급은 의무다."},
{"id":"T5583","line":11519,"t":"상담원이 \"국민취업지원제도도 한번 보시죠\"라고 한다."},
{"id":"T5584","line":11521,"t":"실업급여와 다른 제도라 요건을 따로 확인하고 신청한다"},
{"id":"T5585","line":11522,"t":"구직급여는 고용보험에서 나오고, 국민취업지원제도는 보험이 아니라 취업지원 사업이다. 대상이 달라서 둘 다 볼 값어치가 있다."},
{"id":"T5586","line":11523,"t":"실업급여랑 같은 거라고 생각하고 넘긴다"},
{"id":"T5587","line":11524,"t":"같은 제도가 아니다. 한쪽이 안 되는 사람이 다른 쪽은 되는 경우가 있다."},
{"id":"T5588","line":11525,"t":"서류가 귀찮아 안 한다"},
{"id":"T5589","line":11526,"t":"한 번 내는 서류와 몇 달치 지원을 저울에 올려 보면 답이 이미 나와 있다."},
{"id":"T5590","line":11527,"t":"지방 면접이 세 개 잡혔다. 왕복 교통비만 24만 원이다."},
{"id":"T5591","line":11529,"t":"회당 비용을 계산하고 면접 비용을 지원하는 제도가 있는지 먼저 찾는다"},
{"id":"T5592","line":11530,"t":"교통비·정장 대여까지 합치면 회당 비용이 나온다. 그 숫자가 있어야 어디까지 지원할지 기준이 생긴다. 지자체·정부 지원 제도가 있는지도 같이 본다."},
{"id":"T5593","line":11531,"t":"일단 다 간다"},
{"id":"T5594","line":11532,"t":"가는 것 자체가 나쁘지는 않다. 다만 기준 없이 쓰면 다음 달 카드값이 구직 기간을 줄인다."},
{"id":"T5595","line":11533,"t":"돈이 아까워 전부 포기한다"},
{"id":"T5596","line":11534,"t":"비용은 줄지만 기회도 같이 줄어든다. 줄여야 할 것은 횟수가 아니라 회당 비용이다."},
{"id":"T5597","line":11535,"t":"한 곳에서 합격 통보가 왔다. 그런데 제시된 연봉이 공고보다 낮다."},
{"id":"T5598","line":11537,"t":"근로계약서를 쓰기 전에 이유를 묻고, 합의한 조건을 계약서에 적는다"},
{"id":"T5599","line":11538,"t":"채용광고의 내용을 정당한 사유 없이 불리하게 바꾸는 것은 채용절차법이 금지한다. 그리고 실제로 지켜야 하는 것은 계약서에 적힌 조건이다."},
{"id":"T5600","line":11539,"t":"이미 그만뒀으니 아쉬운 쪽은 나라고 생각하고 사인한다"},
{"id":"T5601","line":11540,"t":"서명하는 순간 그 조건이 내 조건이 된다. 아쉬움은 계약서에 안 적힌다."},
{"id":"T5602","line":11541,"t":"말없이 입사를 포기한다"},
{"id":"T5603","line":11542,"t":"물어보지도 않고 접으면 착오였을 가능성까지 같이 버린다. 확인은 공짜다."},
{"id":"T5604","line":11543,"t":"입사 전에 교육비 명목으로 30만 원을 입금하라고 한다."},
{"id":"T5605","line":11545,"t":"채용을 대가로 금품을 요구하는 것은 금지라 거절하고 신고처를 알아본다"},
{"id":"T5606","line":11546,"t":"채용에 관해 금전·물품·향응을 요구하거나 받는 행위는 법으로 금지돼 있다. 그 말이 나온 시점에서 이미 정상적인 채용이 아니다."},
{"id":"T5607","line":11547,"t":"취업하려면 어쩔 수 없다고 생각하고 낸다"},
{"id":"T5608","line":11548,"t":"낸 돈은 대개 돌아오지 않고, 그렇게 시작한 자리는 다음 요구도 받아들일 자리가 된다."},
{"id":"T5609","line":11549,"t":"절반만 내고 나머지는 나중에 주겠다고 한다"},
{"id":"T5610","line":11550,"t":"금액을 깎는 문제가 아니라 요구 자체가 문제다. 절반을 내면 절반만큼 엮인다."},
{"id":"T5611","line":11552,"t":"제때 받고, 제대로 들어갔다"},
{"id":"T5612","line":11552,"t":"받을 것은 제때 받고, 조건은 계약서를 쓰기 전에 바로잡았다."},
{"id":"T5613","line":11553,"t":"절반은 챙겼다"},
{"id":"T5614","line":11553,"t":"받은 것도 있지만 흘려보낸 것이 있다. 다음에는 하루라도 먼저 움직이기로 했다."},
{"id":"T5615","line":11554,"t":"놓치고 밀리고 냈다"},
{"id":"T5616","line":11554,"t":"놓치고, 밀리고, 돈까지 냈다. 하루 이틀 안에 확인할 수 있던 것들이었다."},
{"id":"T5617","line":11559,"t":"아슬아슬"},
{"id":"T5618","line":11605,"t":"대가가 남는다"},
{"id":"T5619","line":11605,"t":"좋은 판단"},
{"id":"T5620","line":11609,"t":"결말 보기"},
{"id":"T5621","line":11645,"t":" · 걸린 날 "},
{"id":"T5622","line":11645,"t":" · 쓴 돈 "},
{"id":"T5623","line":11649,"t":" 스탯 +"},
{"id":"T5624","line":11650,"t":"이 사건의 첫 기록이에요. 더 나은 결말을 내면 차액이 더 들어와요."},
{"id":"T5625","line":11650,"t":"이 사건의 최고 기록을 새로 세웠어요."},
{"id":"T5626","line":11651,"t":"<span class=\"lbold\">이번 판은 보상이 없어요</span>"},
{"id":"T5627","line":11652,"t":"<span class=\"micro\" style=\"display:block;margin-top:4px\">이미 「"},
{"id":"T5628","line":11652,"t":"」까지 가 봤어요. 더 나은 결말을 내면 그 차액만 들어와요.</span>"},
