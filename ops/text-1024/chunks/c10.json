[
{"id": "T5829", "t": "먼저 이사를 나가면 점유와 주민등록이 빠져 순위를 잃는다."},
{"id": "T5831", "t": "계약서 받는 날부터 퇴사 뒤 실업급여까지"},
{"id": "T5834", "t": "임금·소정근로시간 등이 적힌 서면을 받는다. 사용자의 교부 의무다."},
{"id": "T5835", "t": "안 주는 것 자체가 위반이다. 조건을 나중에 다투기 어려워진다."},
{"id": "T5836", "t": "연봉에 퇴직금이 있는지"},
{"id": "T5838", "t": "퇴직금을 월급에 얹어 주는 분할약정은 원칙적으로 무효로 본다. 총액에 섞여 있는지 확인한다."},
{"id": "T5839", "t": "연봉이 높아 보이지만 실제로는 내 퇴직금을 미리 받은 것이다."},
{"id": "T5842", "t": "건강보험·국민연금·고용보험·산재보험. 건강보험료는 회사와 절반씩 낸다."},
{"id": "T5843", "t": "가입이 누락되면 나중에 실업급여 기간이 모자란다."},
{"id": "T5846", "t": "공제 항목에 4대보험과 소득세가 있다. 실수령액과 계약 연봉의 차이가 여기서 난다."},
{"id": "T5847", "t": "명세서를 안 보면 잘못된 공제를 그냥 넘긴다."},
{"id": "T5849", "t": "주 15시간 이상 소정근로 + 그 주 개근이면 유급 주휴일이 생긴다. 알바도 같다."},
{"id": "T5850", "t": "시급제라면 매주 하루치가 빠진다."},
{"id": "T5852", "t": "1년 미만은 1개월 개근마다 1일. 1년간 80% 이상 출근하면 15일."},
{"id": "T5853", "t": "회사가 사용을 권했는데도 안 쓰면 수당 없이 사라질 수 있다(연차 사용촉진)."},
{"id": "T5856", "t": "원칙적으로 비자발적 이직이고, 이직 전 18개월 중 피보험단위기간 180일 이상이어야 한다."},
{"id": "T5857", "t": "자발적 퇴사로 처리되면 대상에서 빠진다. 퇴사 전에 기간을 조회해 둔다."},
{"id": "T5858", "t": "졸업하면 생기는 일"},
{"id": "T5859", "t": "학생 자격이 끝나는 순간 고지서가 붙기 시작한다"},
{"id": "T5861", "t": "건강보험 피부양자 탈락"},
{"id": "T5862", "t": "졸업 · 소득 발생"},
{"id": "T5863", "t": "소득·재산 요건을 벗어나면 지역가입자로 바뀐다. 취업 전이라도 고지서가 나온다."},
{"id": "T5864", "t": "모르고 있다가 몇 달치가 한꺼번에 온다."},
{"id": "T5865", "t": "지역가입자 보험료 조정"},
{"id": "T5867", "t": "지역가입자 보험료는 소득과 재산을 함께 본다. 소득이 없으면 조정 신청으로 줄일 수 있는 경우가 있다."},
{"id": "T5868", "t": "소득이 없는데도 그대로 낸다."},
{"id": "T5871", "t": "신청해야 적용된다. 방치하면 체납으로 남는다."},
{"id": "T5872", "t": "연체금이 붙고 가입 이력이 지저분해진다."},
{"id": "T5873", "t": "학자금 대출 상환 방식 확인"},
{"id": "T5875", "t": "취업 후 상환은 소득이 기준을 넘은 다음 해부터, 일반 상환은 거치 뒤 정해진 일정대로."},
{"id": "T5876", "t": "유예 중에도 이자는 쌓인다는 걸 놓친다."},
{"id": "T5879", "t": "가입기간이 가점 항목이라 시간이 곧 점수다. 나이·주택 소유와 관계없이 가입할 수 있다."},
{"id": "T5880", "t": "늦게 만든 기간은 되돌릴 수 없다."},
{"id": "T5883", "t": "통신요금·건강보험료 성실납부 실적을 직접 제출하면 가점이 된다. 카드 사용률은 낮게 유지한다."},
{"id": "T5884", "t": "금융 이력이 없으면 첫 대출에서 불리해진다."},
{"id": "T5887", "t": "납부예외 기간은 가입기간에서 빠지므로 나중에 추납으로 메울 수 있다."},
{"id": "T5888", "t": "안 메우면 연금액이 그만큼 줄어든다."},
{"id": "T5889", "t": "자취 시작할 때 드는 돈"},
{"id": "T5890", "t": "월세만 보고 계산하면 매달 20~30%가 더 나간다"},
{"id": "T5891", "t": "찾기쉬운 생활법령정보"},
{"id": "T5894", "t": "보증금 + 중개보수 + 이사비. 중개보수는 거래금액 구간별 상한요율 안에서 협의한다."},
{"id": "T5895", "t": "중개보수를 계약 후에 말하면 협상력이 없다."},
{"id": "T5898", "t": "돌려받지만 그동안 묶인다. 기숙사와 비교할 때 예금 이자만큼은 비용으로 넣는다."},
{"id": "T5899", "t": "월세만 비교하면 자취가 더 싸 보인다."},
{"id": "T5901", "t": "월세 + 관리비 + 공과금 + 인터넷. 관리비에 무엇이 포함되는지 계약서에서 확인한다."},
{"id": "T5902", "t": "관리비와 공과금이 예산 밖에 있으면 매달 적자가 난다."},
{"id": "T5904", "t": "주 단위 한도를 먼저 정하고 식비 전용 계좌나 카드를 따로 둔다. 잔액 자체가 신호가 된다."},
{"id": "T5905", "t": "변동비를 변동비로 두면 사후에만 알 수 있다."},
{"id": "T5908", "t": "메뉴값 + 배달비 + 최소주문 맞추려 담은 금액이 실제 지출이다."},
{"id": "T5909", "t": "주 3회를 1회로 줄이면 한 달 14만원이 남는다."},
{"id": "T5910", "t": "옷·세탁 회당 비용"},
{"id": "T5912", "t": "가격을 착용 횟수로 나눠 본다. 세탁은 라벨을 먼저 보고 시즌당 횟수를 정한다."},
{"id": "T5913", "t": "싸게 사서 몇 번 못 입는 옷이 회당 비용은 더 높다."},
{"id": "T5924", "t": "<br>제도는 바뀌어요. 실제 결정 전에 원문을 확인하세요."},
{"id": "T5929", "t": "<b>막기!</b> 방어로 버텨서 목숨은 그대로예요 (막기 "},
{"id": "T5931", "t": "<span class=\"src\">전체 점검일 "},
{"id": "T5933", "t": "<br>제도는 바뀌어요. 실제 결정 전에 원문을 확인하세요.</span>"},
{"id": "T5942", "t": "보상 없음 · 틀린 문항은 복습에 담았어요"},
{"id": "T5947", "t": "청결이 낮아 코인 -20%"},
{"id": "T5948", "t": "기분이 처져 경험치 -20%"},
{"id": "T5949", "t": "</span><b>집에서 채워요</b>"},
{"id": "T5950", "t": "<span>오늘 완주 보너스</span><b>￦"},
{"id": "T5956", "t": "보증금 없이 옮겼어요"},
{"id": "T5957", "t": "전세 계약을 먼저 해요. 동네 부동산에서 매물 고르기부터 시작하세요."},
{"id": "T5959", "t": "이 모자라 아직 못 옮겼어요. 코인을 모아 캐릭터 탭의 거처에서 옮기세요."},
{"id": "T5961", "t": " 더 받기 (오늘 "},
{"id": "T5965", "t": "을 받았어요 · 합계 ￦"},
{"id": "T5970", "t": "<span class=\"src\">전체 점검일 "},
{"id": "T5973", "t": "전세 계약부터 해요 · 동네 부동산으로 가 보세요"},
{"id": "T5975", "t": "이 모자라 아직 못 옮겼어요"},
{"id": "T5978", "t": "오늘 다시 이긴 상은 이미 받았어요"},
{"id": "T5982", "t": "보증금 없이 옮겼어요"},
{"id": "T5983", "t": "전세는 계약부터 해요. 동네 부동산에서 중개사에게 말을 걸어 보세요."},
{"id": "T5985", "t": "이 모자라 아직 못 옮겼어요. 캐릭터 탭의 거처에서 옮기세요."},
{"id": "T5987", "t": "<br>틀린 문항의 해설을 다시 읽어보세요. 지금 공격이면 "},
{"id": "T5988", "t": "개를 맞혀야 이겨요."},
{"id": "T5989", "t": "<div class=\"ih\"><div><span class=\"inm\">처음부터 할까요?</span></div></div><hr>"},
{"id": "T5990", "t": "<div class=\"il warn\"><i>◆</i>레벨, 코인, 거처, 메인 퀘스트 진행이 모두 지워지고 되돌릴 수 없어요.</div>"},
{"id": "T5994", "t": "시연 모드 · 모든 장비·탈것·세간·거처를 열었어요."},
{"id": "T5995", "t": "시연 모드를 껐어요. \"처음부터 다시\"를 하면 실제 경제로 시작해요."},
{"id": "T5996", "t": "모든 장비·탈것·세간·거처 해금, 코인 5000"},
{"id": "T5997", "t": "이 기기는 진동을 지원하지 않아요"},
{"id": "T5999", "t": "이 브라우저는 알림을 지원하지 않아요"},
{"id": "T6000", "t": "브라우저에서 알림이 차단되어 있어요"},
{"id": "T6001", "t": "아직 출석하지 않았으면 정한 시각 이후에 한 번 알려요"},
{"id": "T6006", "t": "웹 데모에서는 앱이 열려 있는 동안에만 떠요. 앱으로 빌드하면 꺼져 있어도 예약 발송돼요."},
{"id": "T6008", "t": "<b>전체 점검일</b><span>"},
{"id": "T6010", "t": " · 원격 갱신 켜짐"},
{"id": "T6011", "t": " · 원격 갱신 꺼짐"},
{"id": "T6025", "t": "<b>온보딩 완료</b><span>"},
{"id": "T6026", "t": "<b>퀘스트 시작 → 완료</b><span>"},
{"id": "T6030", "t": "<b>보스 도전 → 승</b><span>"},
{"id": "T6031", "t": "<b>이벤트 총계</b><span>"},
{"id": "T6035", "t": "새 거처 해금 · "},
{"id": "T6036", "t": " · 캐릭터 탭에서 옮길 수 있어요"},
{"id": "T6037", "t": " · 입주 보증금 ￦"},
{"id": "T6038", "t": " · 부동산에서 전세 계약부터 해요"},
{"id": "T6039", "t": " · 월세 계약부터 해요"},
{"id": "T6041", "t": "이 모자라 아직 못 옮겼어요"},
{"id": "T6043", "t": "월세, 계약서, 4대보험, 연말정산."},
{"id": "T6044", "t": "학교에서는 아무도 알려주지 않았다."},
{"id": "T6045", "t": "이제 스스로 깨우칠 차례다."},
{"id": "T6047", "t": "사회초년생 생존 RPG"},
{"id": "T6048", "t": "사회초년생 생존 RPG"},
{"id": "T6055", "t": "인생 모드 (추천)"},
{"id": "T6056", "t": "스무 살 카드 한 장으로 예순까지"},
{"id": "T6059", "t": "일반 기록을 지우고 새로 시작"},
{"id": "T6060", "t": "하루 한 장, 천천히"},
{"id": "T6063", "t": "프롤로그 다시 보기"},
{"id": "T6064", "t": "<b>새로 태어날까요?</b><span>지금 인생("},
{"id": "T6065", "t": "살)은 앨범에 \"중간에 멈춘 인생\"으로 남아요.</span>"},
{"id": "T6069", "t": "<b>처음부터 할까요?</b><span>레벨, 코인, 거처, 메인 퀘스트 진행이 모두 지워지고 되돌릴 수 없어요.</span>"},
{"id": "T6073", "t": "산 너머 버스가 하루 네 번 서는 마을."},
{"id": "T6074", "t": "나는 오늘, 그 마을을 떠난다."},
{"id": "T6075", "t": "서울. 보증금이 뭔지도 모르고"},
{"id": "T6076", "t": "일단 원룸 계약서에 도장부터 찍었다."},
{"id": "T6077", "t": "월세 계약은? 4대보험은? 연말정산은...?"},
{"id": "T6079", "t": "어디에 뭘 물어봐야 할지도 모르겠다."},
{"id": "T6080", "t": "학교에선 왜 이런 걸"},
{"id": "T6081", "t": "하나도 안 가르쳐 줬을까..."},
{"id": "T6082", "t": "허허, 그 얼굴 보니 딱 옛날 생각이 나는구먼."},
{"id": "T6083", "t": "걱정 말게. 내가 하나씩 알려 주지."},
{"id": "T6085", "t": "동네 사람들 말을 잘 들어 보게."},
{"id": "T6086", "t": "느낌표(!)가 뜬 사람이 할 얘기가 있는 사람이야."},
{"id": "T6089", "t": "허허, 드디어 여기까지 왔구먼."},
{"id": "T6090", "t": "계약서도, 세금도, 사기꾼도 이제 안 무섭지?"},
{"id": "T6092", "t": "사실 자네한테 숨긴 게 하나 있네."},
{"id": "T6094", "t": "나는... 마흔 해 뒤의 자네라네."},
{"id": "T6095", "t": "그때 아무도 안 알려 줘서 참 많이 잃었거든."},
{"id": "T6096", "t": "...그럼 할아버지가 알려 준 건 전부,"},
{"id": "T6097", "t": "내가 겪을 뻔한 일들이었어요?"},
{"id": "T6099", "t": "이제 자네 차례일세."},
{"id": "T6100", "t": "언젠가 막 상경한 누군가를 만나면,"},
{"id": "T6101", "t": "그 사람의 귀인이 되어 주게."},
{"id": "T6102", "t": "뉴비 퀘스트를 모두 깼어요."},
{"id": "T6103", "t": "그리고 오늘도, 누군가의 귀인이 된다."},
{"id": "T6107", "t": "합격 문자부터 첫 월급까지"},
{"id": "T6108", "t": "고용노동부 · 최저임금 고시"},
{"id": "T6109", "t": "고용노동부 · 근로계약서"},
{"id": "T6110", "t": "찾기쉬운 생활법령정보 · 근로계약"},
{"id": "T6111", "t": "보건복지부 · 2026 보험료율"},
{"id": "T6114", "t": "4대사회보험 정보연계센터"},
{"id": "T6115", "t": "[문자] 최종 합격을"},
{"id": "T6117", "t": "월요일 9시 출근 바랍니다."},
{"id": "T6119", "t": "허허, 합격이라고?"},
{"id": "T6121", "t": "진짜 시험은 이제부터야."},
{"id": "T6123", "t": "첫 달엔 종이 몇 장이"},
{"id": "T6124", "t": "오갈 걸세. 계약서,"},
{"id": "T6125", "t": "명세서. 꼭 챙기게."},
{"id": "T6136", "t": "여기 서명하시면 돼요."},
{"id": "T6137", "t": "사본은 나중에 드릴게요."},
{"id": "T6138", "t": "다 읽고 한 부를 받아 간다"},
{"id": "T6139", "t": "근로계약서는 서면으로 쓰고 한 부를 근로자에게 줘야 한다. 임금, 근로시간, 휴일, 연차가 적혔는지 본다."},
{"id": "T6140", "t": "나중에 준다니 서명만 한다"},
{"id": "T6141", "t": "회사는 계약서를 내줄 의무가 있다. \"나중에\"는 잊히기 쉽다. 적힌 조건이 훗날 유일한 증거다."},
{"id": "T6143", "t": "계약은 1년 이상이고,"},
{"id": "T6144", "t": "수습 3개월은 월급의"},
{"id": "T6146", "t": "최저임금보다 많은지 따진다"},
{"id": "T6147", "t": "수습이라도 최저임금의 90% 밑으론 못 준다. 1년 이상 계약, 수습 3개월 안, 단순노무가 아닐 때만 그만큼 깎을 수 있다."},
{"id": "T6148", "t": "수습이면 얼마든 깎는 줄 안다"},
{"id": "T6149", "t": "수습 감액에는 한도가 있다. 최저임금의 90%가 바닥이고, 단순노무 직종은 수습이어도 깎을 수 없다."},
{"id": "T6150", "t": "수습 월급 따져 보기"},
{"id": "T6153", "t": "월 환산(209시간)"},
{"id": "T6159", "t": "수습 월급이 최저임금"},
{"id": "T6161", "t": "이 조건은 문제없다."},
{"id": "T6163", "t": "점심 같이 먹어요!"},
{"id": "T6165", "t": "연차가 언제 생겨요?"},
{"id": "T6167", "t": "첫해엔 한 달 개근하면"},
{"id": "T6169", "t": "첫해 최대 11일이죠."},
{"id": "T6171", "t": "1년 동안 80% 넘게"},
{"id": "T6172", "t": "나오면, 다음 해엔"},
{"id": "T6175", "t": "생각보다 적다...?"},
{"id": "T6177", "t": "명세서를 주는 사람이"},
{"id": "T6179", "t": "임금명세서를 달라고 한다"},
{"id": "T6180", "t": "회사는 월급을 줄 때 임금명세서를 서면이나 전자문서로 줘야 한다. 항목별 금액과 공제 내역이 들어간다."},
{"id": "T6181", "t": "통장에 찍혔으니 됐다"},
{"id": "T6182", "t": "명세서가 없으면 무엇이 얼마나 빠졌는지 알 길이 없다. 명세서는 달라고 하기 전에 받아야 하는 서류다."},
{"id": "T6183", "t": "임금명세서 · 공제"},
{"id": "T6189", "t": "4대보험, 내 몫이"},
{"id": "T6190", "t": "빠진 거다. 회사도"},
{"id": "T6191", "t": "제 몫을 따로 낸다."},
{"id": "T6194", "t": "신고를 안 하는 데도"},
{"id": "T6195", "t": "있대요. 진짜예요?"},
{"id": "T6196", "t": "가입 내역을 직접 조회한다"},
{"id": "T6197", "t": "4대사회보험 정보연계센터에서 내 가입 내역을 한 번에 볼 수 있다. 입사하고 한두 달 뒤에 한 번 보면 된다."},
{"id": "T6199", "t": "월급에서 뗐다고 신고까지 됐다는 뜻은 아니다. 조회는 몇 분이면 끝난다. 내 기록은 내가 본다."},
{"id": "T6201", "t": "허허, 첫 월급이구먼."},
{"id": "T6205", "t": "숫자는 해마다 바뀌네."},
{"id": "T6206", "t": "최저임금, 보험료율."},
{"id": "T6207", "t": "해마다 한 번은 보게."},
{"id": "T6208", "t": "계약서 한 장, 명세서 한 장."},
{"id": "T6209", "t": "첫 월급을 제대로 받았다."},
{"id": "T6211", "t": "몇 가지는 다음 달에 챙기자."},
{"id": "T6212", "t": "모르고 넘어간 것들이"},
{"id": "T6213", "t": "월급에서 조용히 빠져나갔다."},
{"id": "T6215", "t": "매물 고르기부터 전입신고까지"},
{"id": "T6216", "t": "찾기쉬운 생활법령정보 · 주택임대차"},
{"id": "T6218", "t": "국토교통부 실거래가 공개시스템"},
{"id": "T6219", "t": "주택도시보증공사 전세보증금반환보증"},
{"id": "T6221", "t": "원룸 전세가 열렸다고?"},
{"id": "T6222", "t": "허허, 큰 날이 왔구먼."},
{"id": "T6224", "t": "월세는 매달 조금씩"},
{"id": "T6226", "t": "한 번에 다 거는 거야."},
{"id": "T6228", "t": "보증금은 자네가 모은"},
{"id": "T6229", "t": "돈 거의 전부일 걸세."},
{"id": "T6230", "t": "돌려받아야 끝나지."},
{"id": "T6235", "t": "부동산, 매물 집,"},
{"id": "T6236", "t": "다시 부동산, 그리고"},
{"id": "T6239", "t": "벽지 말고 서류를 보게."},
{"id": "T6240", "t": "등기부, 실거래가."},
{"id": "T6241", "t": "돈은 소유자 계좌로."},
{"id": "T6243", "t": "중간에 나가도 되네."},
{"id": "T6244", "t": "그 자리에서 이어서"},
{"id": "T6245", "t": "하면 돼. 가 보세."},
{"id": "T6246", "t": "새 집 열쇠를 받았다."},
{"id": "T6250", "t": "허허, 도장 몇 번에"},
{"id": "T6258", "t": "종이는 버리지 말고"},
{"id": "T6259", "t": "한곳에 모아 두자."},
{"id": "T6261", "t": "전세는 들어갈 때보다"},
{"id": "T6262", "t": "나올 때 돈이 돌아와야"},
{"id": "T6265", "t": "방이 좀 넓어졌으니"},
{"id": "T6267", "t": "들일 수 있겠구먼."},
{"id": "T6268", "t": "보증금이 제 발로 돌아왔네."},
{"id": "T6269", "t": "그게 제일 좋은 계약이야."},
{"id": "T6270", "t": "집이 버텨 줬구먼."},
{"id": "T6271", "t": "다음엔 확인 몇 개만 더."},
{"id": "T6272", "t": "숫자를 먼저 봤으면"},
{"id": "T6273", "t": "달랐을 걸세. 다음엔 꼭."},
{"id": "T6275", "t": "자네는 전세 계약을"},
{"id": "T6282", "t": "서류 보고, 계좌 보고,"},
{"id": "T6286", "t": "다음 계약도 순서는"},
{"id": "T6287", "t": "똑같네. 서류부터."},
{"id": "T6288", "t": "그 버릇 잊지 말게."},
{"id": "T6290", "t": "신청서 한 장부터 연말정산까지"},
{"id": "T6294", "t": "여신금융협회 소비자지원센터"},
{"id": "T6295", "t": "찾기쉬운 생활법령정보 신용카드 이용자"},
{"id": "T6296", "t": "한국신용정보원 크레딧포유"},
{"id": "T6298", "t": "[광고] 사회초년생 전용 카드"},
{"id": "T6299", "t": "첫해 연회비 면제! 지금 신청"},
{"id": "T6301", "t": "허허, 전셋집 정리는 끝났나?"},
{"id": "T6302", "t": "이번엔 카드 차례일세."},
{"id": "T6303", "t": "잘 쓰면 신용, 잘못 쓰면 빚."},
{"id": "T6305", "t": "체크카드는 통장 잔액만큼,"},
{"id": "T6306", "t": "신용카드는 먼저 쓰고"},
{"id": "T6307", "t": "다음 달에 갚는 거예요."},
{"id": "T6308", "t": "신용카드 발급 기준"},
{"id": "T6315", "t": "발급은 나이, 결제능력,"},
{"id": "T6316", "t": "신용평점을 보고 정해요."},
{"id": "T6318", "t": "신용점수는 1~1000점이에요."},
{"id": "T6319", "t": "조회만 해서는 안 떨어지고"},
{"id": "T6320", "t": "제때 갚은 기록이 쌓여요."},
{"id": "T6325", "t": "일부결제금액이월약정"},
{"id": "T6328", "t": "여기 체크하실 칸이"},
{"id": "T6329", "t": "몇 개 더 있어요."},
{"id": "T6330", "t": "리볼빙 칸은 비워 둔다"},
{"id": "T6331", "t": "일부결제금액이월약정이 리볼빙이다. 필요 없으면 신청하지 않는다. 가입했는지는 카드사 앱에서 확인할 수 있다."},
{"id": "T6332", "t": "빨리 끝내려고 다 체크한다"},
{"id": "T6333", "t": "다 체크하면 리볼빙이 같이 걸릴 수 있다. 칸 이름이 길고 어려울수록 한 번 더 읽는다."},
{"id": "T6335", "t": "이 카드 봐, 카페 50% 할인!"},
{"id": "T6336", "t": "너도 이걸로 만들어."},
{"id": "T6339", "t": "전월 실적 40만 원"},
{"id": "T6343", "t": "작은 글씨를 읽어 보니"},
{"id": "T6344", "t": "조건이 줄줄이 붙어 있다."},
{"id": "T6345", "t": "내 한 달 소비와 맞춰 본다"},
{"id": "T6346", "t": "혜택은 전월 실적을 채워야 나오고 월 한도도 있다. 실적에서 빠지는 결제도 있으니 설명서를 보고 연회비와 견준다."},
{"id": "T6347", "t": "할인율이 높으니 바로 만든다"},
{"id": "T6348", "t": "50% 할인도 월 한도가 5천 원이면 한 달 5천 원이다. 실적을 채우려고 더 쓰면 오히려 손해다."},
{"id": "T6350", "t": "노트북이요? 지금 사시면"},
{"id": "T6351", "t": "3개월 무이자 돼요!"},
{"id": "T6352", "t": "12개월로 하셔도 되고요."},
{"id": "T6358", "t": "무이자 개월을 넘기면"},
{"id": "T6359", "t": "할부 수수료가 붙는다."},
{"id": "T6360", "t": "3개월로 나눠 샀다."},
{"id": "T6362", "t": "20만 원 이상, 3개월 이상"},
{"id": "T6363", "t": "할부는 7일 안에 철회를"},
{"id": "T6364", "t": "요청할 수 있다네."},
{"id": "T6365", "t": "[카드] 이번 달 결제 예정"},
{"id": "T6366", "t": "142만 원. 통장엔 110만."},
{"id": "T6367", "t": "분명 조금씩 썼는데..."},
{"id": "T6370", "t": "비상금을 헐어 전액 낸다"},
{"id": "T6371", "t": "결제일에 전액을 내면 이자가 없다. 모자란 달은 비상금으로 막고, 다음 달 지출을 줄여 다시 채운다."},
{"id": "T6372", "t": "현금서비스로 메운다"},
{"id": "T6373", "t": "현금서비스는 단기카드대출, 카드론은 장기카드대출이다. 둘 다 이자가 높은 빚이라 신용점수에도 불리할 수 있다."},
{"id": "T6374", "t": "최소 금액만 내고 넘긴다"},
{"id": "T6375", "t": "일부만 내고 나머지를 넘기면 리볼빙이다. 넘긴 돈에 수수료가 붙고 매달 다시 쌓여 원금이 잘 줄지 않는다."},
{"id": "T6377", "t": "10만 원·5영업일"},
{"id": "T6384", "t": "작은 돈도 늦으면 연체예요."},
{"id": "T6385", "t": "월급날 뒤로 결제일을"},
{"id": "T6386", "t": "옮겨 두면 편해요."},
{"id": "T6387", "t": "회식 끝나고 집에 오니"},
{"id": "T6389", "t": "카드가 세 장 들어 있었다."},
{"id": "T6390", "t": "시계는 새벽 한 시."},
{"id": "T6392", "t": "바로 카드사에 분실 신고"},
{"id": "T6393", "t": "신고한 날부터 60일 전까지 생긴 부정사용은 카드사가 책임진다. 한 곳에 신고하면 다른 카드도 함께 신고할 수 있다."},
{"id": "T6394", "t": "내일 가게에 가 보고 정한다"},
{"id": "T6395", "t": "신고가 늦으면 피해가 커진다. 카드 뒷면에 서명을 안 했거나 비밀번호를 적어 뒀다면 내 책임도 생길 수 있다."},
{"id": "T6396", "t": "신용카드 등 소득공제"},
{"id": "T6397", "t": "총급여 25% 초과분"},
{"id": "T6402", "t": "연말정산 카드 공제는"},
{"id": "T6403", "t": "25%를 넘긴 뒤부터래."},
{"id": "T6404", "t": "그 뒤엔 체크카드가 유리해."},
{"id": "T6406", "t": "허허, 카드는 칼 같은 걸세."},
{"id": "T6407", "t": "손잡이를 쥐면 도구고,"},
{"id": "T6408", "t": "날을 쥐면 상처지."},
{"id": "T6409", "t": "리볼빙 없이, 연체 없이."},
{"id": "T6410", "t": "첫 카드로 신용을 쌓았다."},
{"id": "T6411", "t": "큰 사고는 없었지만"},
{"id": "T6412", "t": "명세서가 가끔 무섭다."},
{"id": "T6413", "t": "넘긴 카드값에 수수료가 붙고"},
{"id": "T6414", "t": "다음 달 명세서가 또 무거워졌다."},
{"id": "T6415", "t": "광고 한 장부터 첫 드라이브까지"},
{"id": "T6416", "t": "국토교통부 자동차365"},
{"id": "T6417", "t": "찾기쉬운 생활법령정보 · 자동차"},
{"id": "T6418", "t": "여신금융협회 자동차 할부 비교공시"},
{"id": "T6420", "t": "손해보험협회 소비자포털"},
{"id": "T6423", "t": "막차를 또 놓쳤다고?"},
{"id": "T6424", "t": "허허, 이제 차 얘기를"},
{"id": "T6428", "t": "타는 동안 돈이 더 드네."},
{"id": "T6429", "t": "값, 세금, 보험, 기름."},
{"id": "T6431", "t": "인기 차종, 무사고."},
{"id": "T6432", "t": "시세의 절반! 오늘만."},
{"id": "T6434", "t": "아, 그 차요? 방금"},
{"id": "T6435", "t": "팔렸어요. 대신 이 차"},
{"id": "T6436", "t": "보세요. 더 좋아요."},
{"id": "T6437", "t": "광고한 차가 없으면 나온다"},
{"id": "T6438", "t": "시세보다 한참 싼 광고로 부르고, 오면 다른 차를 권하는 것이 미끼 매물의 흔한 수법이다. 그 차가 없으면 거래할 이유도 없다."},
{"id": "T6439", "t": "온 김에 권하는 차를 본다"},
{"id": "T6440", "t": "미끼로 부른 곳에서 권하는 차는 대개 광고보다 조건이 나쁘다. 발을 들인 순간부터 흥정은 저쪽이 쥔다."},
{"id": "T6442", "t": "중고 경차를 찾았다."},
{"id": "T6445", "t": "성능·상태점검기록부"},
{"id": "T6452", "t": "사고 없고 깨끗해요."},
{"id": "T6453", "t": "차량번호로 자동차365를 본다"},
{"id": "T6454", "t": "기록부는 계약 전에 받는 서류다. 자동차365에서 차량번호로 사고·정비·침수 이력을 조회해 기록부와 맞는지 대조한다."},
{"id": "T6455", "t": "기록부에 없음이니 믿는다"},
{"id": "T6456", "t": "기록부는 점검 한 번의 결과다. 정비·보험 수리·침수 이력은 따로 조회해야 보인다. 대조는 몇 분이면 된다."},
{"id": "T6465", "t": "앞문 교환이 나온다."},
{"id": "T6466", "t": "기록부와 다른 점을"},
{"id": "T6477", "t": "다른 점은 글로 남겼다."},
{"id": "T6478", "t": "보증 기간 안에 문제가"},
{"id": "T6479", "t": "생기면 이 종이가 말한다."},
{"id": "T6482", "t": "해 드려요. 월 31만 원,"},
{"id": "T6483", "t": "36개월이면 끝나요."},
{"id": "T6484", "t": "금리·수수료·총액을 비교한다"},
{"id": "T6485", "t": "월 납입금은 기간을 늘리면 작아 보인다. 여신금융협회 할부 비교공시에서 금리와 수수료를 보고 총액으로 견준다."},
{"id": "T6486", "t": "월 납입금이 괜찮으니 한다"},
{"id": "T6487", "t": "같은 차값이라도 금리와 기간에 따라 이자가 수십만 원에서 백만 원 넘게 달라진다. 총액을 봐야 보인다."},
{"id": "T6488", "t": "할부 총비용 (예시)"},
{"id": "T6497", "t": "100만 원이 된다."},
{"id": "T6504", "t": "신고가·시가표준 큰 쪽"},
{"id": "T6507", "t": "차값 말고도 세금이"},
{"id": "T6508", "t": "붙는다. 경차 감면은"},
{"id": "T6509", "t": "기한이 있으니 확인하자."},
{"id": "T6510", "t": "자동차보험 첫 가입"},
{"id": "T6513", "t": "2천만 원 이상 의무"},
{"id": "T6517", "t": "보험 비교 사이트에서"},
{"id": "T6518", "t": "견적을 봤다. 처음이라"},
{"id": "T6519", "t": "보험료가 높게 나온다."},
{"id": "T6523", "t": "범위 밖이라 안 된다고 한다"},
{"id": "T6524", "t": "운전자 범위 밖의 사람이 사고를 내면 의무 담보 일부만 보상되고 내가 고른 나머지 담보는 안 된다."},
{"id": "T6526", "t": "그 잠깐에 사고가 나면 상대 차와 내 차 수리비를 보험 없이 물 수 있다. 범위는 운전할 사람을 기준으로 정한다."},
{"id": "T6527", "t": "1년 유지비 (예시)"},
{"id": "T6535", "t": "세금은 배기량 따라"},
{"id": "T6537", "t": "해마다 다시 본다."},
{"id": "T6539", "t": "보인다. 이제 어디든"},
{"id": "T6544", "t": "무겁지? 그게 차라네."},
{"id": "T6545", "t": "광고, 이력, 할부, 보험."},
{"id": "T6546", "t": "다 따져 보고 산 첫 차다."},
{"id": "T6548", "t": "놓친 것은 다음 갱신 때."},
{"id": "T6549", "t": "싸게 산 줄 알았던 차가"},
{"id": "T6550", "t": "다달이 돈을 달라고 한다."},
{"id": "T6552", "t": "식장 계약서부터 혼인신고까지"},
{"id": "T6553", "t": "공정거래위원회 소비자분쟁해결기준(예식업)"},
{"id": "T6555", "t": "찾기쉬운 생활법령정보 결혼준비자"},
{"id": "T6556", "t": "참가격 결혼서비스 가격정보"},
{"id": "T6557", "t": "국세청 결혼 세액공제"},
{"id": "T6558", "t": "청약홈 신혼부부 특별공급"},
{"id": "T6559", "t": "주택도시기금 신혼부부 전세자금"},
{"id": "T6561", "t": "허허, 차도 뽑았겠다."},
{"id": "T6562", "t": "이제 혼자 할 일이 아니라"},
{"id": "T6563", "t": "둘이 할 일이 생겼구먼?"},
{"id": "T6564", "t": "우리 진짜 하는 거지?"},
{"id": "T6565", "t": "근데 뭐부터 해야 돼?"},
{"id": "T6566", "t": "식장, 스드메, 신혼집..."},
{"id": "T6567", "t": "검색하면 광고만 잔뜩이야."},
{"id": "T6569", "t": "그 날짜, 딱 하나 남았어요."},
{"id": "T6570", "t": "오늘 계약하시면 식대 할인!"},
{"id": "T6579", "t": "여기 서명만 하시면 돼요."},
{"id": "T6580", "t": "취소 조항부터 묻고 따진다"},
{"id": "T6581", "t": "분쟁해결기준에선 예식 150일 전까지 해제를 알리면 계약금 환급이 원칙이다. 조항을 먼저 읽는다."},
{"id": "T6582", "t": "오늘만 할인이니 바로 쓴다"},
{"id": "T6583", "t": "\"오늘만\"은 조건이 아니라 재촉이다. 날짜가 아까워도 환불 조항은 읽고 쓴다."},
{"id": "T6584", "t": "150일 전까지 알리면"},
{"id": "T6585", "t": "계약금은 돌려받는 게 기준이래요."},
{"id": "T6586", "t": "그 줄은 고쳐 주세요."},
{"id": "T6588", "t": "스드메 패키지 280만 원!"},
{"id": "T6589", "t": "기본만 해도 충분해요~"},
{"id": "T6596", "t": "근데 이 \"별도\"는"},
{"id": "T6598", "t": "별도 항목 값을 다 받아 적는다"},
{"id": "T6599", "t": "결혼서비스 업체는 기본·선택품목 가격과 위약금 기준을 공개해야 한다. 참가격에서도 볼 수 있다."},
{"id": "T6600", "t": "기본만 하면 되겠지 하고 넘긴다"},
{"id": "T6601", "t": "추가금은 계약 뒤에 붙는다. 선택품목 값을 모르면 예산표는 반쪽짜리다."},
{"id": "T6603", "t": "\"별도\"라는 두 글자가"},
{"id": "T6604", "t": "이렇게 비싼 글자였다니."},
{"id": "T6605", "t": "그날 밤, 거실 바닥에 앉았다."},
{"id": "T6606", "t": "예산표 한 장, 펜 두 자루."},
{"id": "T6607", "t": "근데... 우리 돈 얘기"},
{"id": "T6608", "t": "제대로 해 본 적 있었나?"},
{"id": "T6609", "t": "모은 돈·빚·수입을 다 펼친다"},
{"id": "T6610", "t": "누가 얼마 내느냐보다 둘의 돈을 한 표에 올리는 게 먼저다. 빚도 숨기지 않는다."},
{"id": "T6611", "t": "관례대로 한쪽은 집, 한쪽은 혼수"},
{"id": "T6612", "t": "정해진 공식은 없다. 둘의 형편과 우선순위로 나눈다. \"원래 그래\"는 기준이 아니다."},
{"id": "T6613", "t": "돈 얘기는 어색하니 나중에"},
{"id": "T6614", "t": "말 안 한 돈은 결혼 뒤에 더 큰 얘기가 된다. 어색해도 지금 꺼내는 게 싸다."},
{"id": "T6615", "t": "사실 나, 학자금 대출이"},
{"id": "T6616", "t": "아직 조금 남았어."},
{"id": "T6617", "t": "말해 줘서 고마워."},
{"id": "T6618", "t": "나는 카드 할부가 좀 있어."},
{"id": "T6619", "t": "같이 갚자. 표에 적어 둘게."},
{"id": "T6621", "t": "혼인신고는 언제 하세요?"},
{"id": "T6622", "t": "신고 날짜가 기준인 제도가"},
{"id": "T6623", "t": "생각보다 많거든요."},
{"id": "T6624", "t": "혼인신고 날짜로 보는 것"},
{"id": "T6626", "t": "신고한 해 1인 50만"},
{"id": "T6630", "t": "7년 내·예정 3개월"},
{"id": "T6632", "t": "세액공제는 2026년"},
{"id": "T6634", "t": "제도별 날짜 기준을 같이 본다"},
{"id": "T6635", "t": "세액공제는 신고한 해에, 특공은 신고일부터 7년을 센다. 공고마다 조건이 달라 청약홈에서 확인한다."},
{"id": "T6636", "t": "남들이 미루라니 일단 미룬다"},
{"id": "T6637", "t": "미뤄서 득인 제도도 손해인 제도도 있다. 남의 말보다 우리 계획에 맞는 날짜를 고른다."},
{"id": "T6639", "t": "우리 둘 이름 다 쓸까?"},
{"id": "T6641", "t": "공동명의는 장단이 다 있네."},
{"id": "T6642", "t": "그 얘긴 집 살 때"},
{"id": "T6643", "t": "다시 하세나. 허허."},
{"id": "T6644", "t": "식장도, 스드메도, 돈 얘기도."},
{"id": "T6645", "t": "둘이 같이 정했다."},
{"id": "T6646", "t": "계약서는 읽고, 추가금은 적고,"},
{"id": "T6647", "t": "돈 얘기는 둘이 먼저 했다."},
{"id": "T6648", "t": "새는 돈이 몇 군데 있었지만"},
{"id": "T6649", "t": "둘이 같이 메웠다."},
{"id": "T6650", "t": "\"별도\"와 \"원래 그래\"가"},
{"id": "T6651", "t": "예산을 조금씩 갉아먹었다."},
{"id": "T6653", "t": "청약 당첨부터 등기부의 내 이름까지"},
{"id": "T6654", "t": "찾기쉬운 생활법령정보 · 아파트 분양받기"},
{"id": "T6655", "t": "청약홈 · 특별공급"},
{"id": "T6656", "t": "금융위원회 · DSR 문답"},
{"id": "T6658", "t": "정책브리핑 · 생애최초 취득세 감면"}
]
