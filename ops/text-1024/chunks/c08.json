{"id":"T4999","line":9484,"t":"천도복숭아"},
{"id":"T5000","line":9485,"t":"세상에서 가장 쉬운 숫자는?"},
{"id":"T5001","line":9486,"t":"아몬드가 죽으면?"},
{"id":"T5002","line":9486,"t":"다이아몬드"},
{"id":"T5003","line":9486,"t":"아몬드빼빼로"},
{"id":"T5004","line":9487,"t":"세상에서 가장 빠른 닭은?"},
{"id":"T5005","line":9488,"t":"병아리가 제일 잘 먹는 약은?"},
{"id":"T5006","line":9489,"t":"개가 사람을 가르치면?"},
{"id":"T5007","line":9489,"t":"개인지도"},
{"id":"T5008","line":9492,"t":"어서 오세요~ 뭐 필요하세요?"},
{"id":"T5009","line":9493,"t":"어서 오세요~ 야간 알바 3개월째예요."},
{"id":"T5010","line":9493,"t":"손님 없을 때 심심해서요. 넌센스 퀴즈 하나 풀어 볼래요? 다 맞히면 상품 있어요."},
{"id":"T5011","line":9494,"t":"퀴즈왕 등장이다. 황금 볼펜 잘 쓰고 있죠?"},
{"id":"T5012","line":9494,"t":"참, 알바도 주 15시간 넘으면 주휴수당 받아요. 저는 사장님께 말해서 받았어요."},
{"id":"T5013","line":9496,"t":"쉿, 도서관에서는 조용히."},
{"id":"T5014","line":9496,"t":"...근데 시험 기간이 아니라 한가하네. 넌센스 세 문제, 다 맞히면 선물 줄게."},
{"id":"T5015","line":9497,"t":"그 티셔츠, 입고 다니는 사람 처음 봐."},
{"id":"T5016","line":9497,"t":"국가장학금은 학기마다 신청해야 해. 한 번 했다고 계속 나오는 게 아니야."},
{"id":"T5017","line":9499,"t":"출입증은 목에 거세요."},
{"id":"T5018","line":9499,"t":"허허, 신입인가 보네. 아저씨가 퀴즈 좀 내 볼까? 다 맞히면 행운의 바지를 주지."},
{"id":"T5019","line":9500,"t":"그 바지 입은 날은 부장님 기분도 좋더라고."},
{"id":"T5020","line":9500,"t":"근로계약서는 꼭 한 부 받아서 집에 둬요. 나중에 찾을 일이 생겨요."},
{"id":"T5021","line":9501,"t":"어서 오세요. 휴게소 대표 메뉴 있어요!"},
{"id":"T5022","line":9501,"t":"장거리 운전하면 배가 금방 꺼져요. 든든히 드세요."},
{"id":"T5023","line":9502,"t":"우리도 강릉 가는 길이에요."},
{"id":"T5024","line":9502,"t":"졸릴 땐 참지 말고 졸음쉼터에 들러요. 10분만 자도 달라요."},
{"id":"T5025","line":9502,"t":"그리고 출발 전에 경로 위 주유소 가격을 한 번 봐 두면 좋아요."},
{"id":"T5026","line":9503,"t":"초당순두부 드시고 가요!"},
{"id":"T5027","line":9503,"t":"메뉴판에 가격 다 붙어 있죠? 안 붙어 있는 집은 먼저 물어보고 들어가요."},
{"id":"T5028","line":9504,"t":"전주 왔으면 비빔밥이지!"},
{"id":"T5029","line":9504,"t":"한옥마을 안쪽이 바깥보다 비싸요. 가격표 보고 골라요."},
{"id":"T5030","line":9505,"t":"한복 빌려 가세요~ 두 시간에 이만 원."},
{"id":"T5031","line":9505,"t":"대여 전에 시간과 추가 요금 기준을 꼭 물어보세요. 늦게 오면 붙는 가게가 있어요."},
{"id":"T5032","line":9506,"t":"돼지국밥 한 그릇 하고 가이소!"},
{"id":"T5033","line":9506,"t":"부산 택시는 대부분 카드 돼요. 미터기 안 켜면 켜 달라 하이소."},
{"id":"T5034","line":9507,"t":"해운대는 여름에 사람이 진짜 많아요."},
{"id":"T5035","line":9507,"t":"수영은 해수욕장이 문을 연 기간에, 안전요원이 지키는 구역 안에서만 해요."},
{"id":"T5036","line":9508,"t":"어, 왔어? 동네 건물마다 간판이 붙어 있지. 문 위에 느낌표가 뜬 곳에 볼일이 있다는 뜻이야."},
{"id":"T5037","line":9508,"t":"집 얘기는 오른쪽 끝 부동산, 신고는 주민센터, 배고프면 편의점."},
{"id":"T5038","line":9508,"t":"포만감이 떨어지면 공부가 안 돼. 먹고 다녀."},
{"id":"T5039","line":9509,"t":"야, 너도 수업 끝났어?"},
{"id":"T5040","line":9509,"t":"장학금이랑 기숙사는 학생지원센터 창구에서 물어봐. 카페 동기 테이블에 앉아 있으면 나도 거기 있을게."},
{"id":"T5041","line":9510,"t":"어서 와요. 뭐 마실래요?"},
{"id":"T5042","line":9510,"t":"어서 와요. 오늘의 커피는 아메리카노."},
{"id":"T5043","line":9510,"t":"우리 가게 알바는 주휴수당 다 줘요. 주 15시간 넘게 일하면 원래 받는 거예요."},
{"id":"T5044","line":9510,"t":"시급만 보지 말고, 주휴까지 합쳐서 계산해 봐요."},
{"id":"T5045","line":9511,"t":"나도 번호표 뽑고 기다리는 중이야."},
{"id":"T5046","line":9511,"t":"실업급여는 그냥 쉬면 나오는 게 아니더라. 구직 활동을 해서 증명해야 돼."},
{"id":"T5047","line":9511,"t":"이력서는 회사마다 조금씩 고쳐서 내. 같은 걸 뿌리면 티 나."},
{"id":"T5048","line":9512,"t":"번호표 뽑고 기다리시면 됩니다."},
{"id":"T5049","line":9512,"t":"예금은 한 은행에 1인당 1억 원까지 보호돼요. 2025년 9월부터 늘었어요."},
{"id":"T5050","line":9512,"t":"그리고 누가 통장이나 체크카드를 빌려 달라고 하면 무조건 거절하세요. 빌려준 사람도 처벌받아요."},
{"id":"T5051","line":9513,"t":"아이고, 젊은이. 산책 나왔어?"},
{"id":"T5052","line":9513,"t":"집 구할 때 관리비에 뭐가 들어가는지 꼭 물어봐. 우리 손주는 그거 안 물어보고 매달 3만 원씩 더 냈어."},
{"id":"T5053","line":9514,"t":"게임 동아리 부스야! 도장 찍기 한 판 할래?"},
{"id":"T5054","line":9514,"t":"동아리 들어올래? 회비는 한 학기 2만 원!"},
{"id":"T5055","line":9514,"t":"학자금 대출은 한국장학재단에서 알아봐. 이자 없는 것도 있어."},
{"id":"T5056","line":9514,"t":"아, 그리고 교내 근로장학도 있어. 도서관이나 학과 사무실 일."},
{"id":"T5057","line":9515,"t":"연못 좋지? 나도 젊을 땐 바빠서 이런 데를 몰랐어."},
{"id":"T5058","line":9515,"t":"월급 받으면 반은 먼저 떼어 놓고 나머지로 살아. 거꾸로 하면 안 모여."},
{"id":"T5059","line":9516,"t":"오늘은 떡볶이랑 어묵! 뭐 줄까?"},
{"id":"T5060","line":9516,"t":"오늘은 떡볶이랑 어묵! 점심 한 끼 오천 원."},
{"id":"T5061","line":9516,"t":"점심값만 아껴도 한 달에 십만 원은 모여. 도시락 싸는 날을 정해 봐."},
{"id":"T5062","line":9517,"t":"이 동네는 새로 지은 빌라가 많아요."},
{"id":"T5063","line":9517,"t":"\"입주금 0원, 이사비 지원\" 현수막 붙은 집은 꼭 매매가랑 전세가를 같이 봐요. 전세가가 집값과 거의 같은 집이 많거든요."},
{"id":"T5064","line":9518,"t":"반찬 사 가요, 떨이 해 줄게!"},
{"id":"T5065","line":9518,"t":"우리 시장은 카드도 되고 원산지도 다 붙여 놨어. 연말정산 때 전통시장에서 카드 쓴 건 공제율이 더 높대."},
{"id":"T5066","line":9519,"t":"자취하면 마트보다 시장이 쌀 때가 많아요. 떨이 시간엔 더 싸고요."},
{"id":"T5067","line":9519,"t":"근데 가격표 없는 집은 먼저 물어보고 사요. 원산지 팻말도 보고."},
{"id":"T5068","line":9520,"t":"어서 와요, 오늘 고등어 좋아요."},
{"id":"T5069","line":9520,"t":"저울은 손님 앞에서 0부터 달아 드려요. 다른 데서도 영점부터 보세요."},
{"id":"T5070","line":9521,"t":"칼국수 한 그릇 하고 가요!"},
{"id":"T5071","line":9521,"t":"손칼국수 한 그릇에 반찬은 셀프."},
{"id":"T5072","line":9522,"t":"여기서 30년 장사했어요."},
{"id":"T5073","line":9522,"t":"요즘 젊은 사람들은 원산지 표시 꼼꼼히 보더라. 좋은 습관이야."},
{"id":"T5074","line":9523,"t":"아침마다 이 역에서 지하철 타요."},
{"id":"T5075","line":9523,"t":"대중교통을 자주 타면 K-패스(모두의 카드) 환급을 꼭 신청해요. 청년은 환급률이 더 높아요."},
{"id":"T5076","line":9524,"t":"퇴근길에 한 곡 듣고 가요."},
{"id":"T5077","line":9524,"t":"역 앞 버스킹은 구청에 신청해서 하는 거예요. 저도 허가받았어요."},
{"id":"T5078","line":9525,"t":"어디 가세요? 노선도는 저쪽에 있어요."},
{"id":"T5079","line":9525,"t":"지하철에 물건 두고 내리면 유실물 센터나 경찰청 LOST112에서 찾아보세요."},
{"id":"T5080","line":9525,"t":"교통비 환급은 K-패스 카드로 쓰고 누리집에서 회원가입까지 해야 받을 수 있어요."},
{"id":"T5081","line":9526,"t":"오죽헌 뒤뜰의 까만 대나무를 오죽이라고 해요. 이름이 거기서 왔어요."},
{"id":"T5082","line":9526,"t":"매월 마지막 수요일, 문화가 있는 날엔 관람료가 반값이에요. 여행 날짜를 맞춰 보면 좋죠."},
{"id":"T5083","line":9527,"t":"바다 보면서 한 잔 하세요."},
{"id":"T5084","line":9527,"t":"안목 커피거리는 해변 바로 앞이라 창가 자리가 먼저 차요."},
{"id":"T5085","line":9527,"t":"가격은 카운터 위 메뉴판에 다 적혀 있어요."},
{"id":"T5086","line":9528,"t":"숙소는 환불 규정부터 봤어요."},
{"id":"T5087","line":9528,"t":"성수기엔 이용일이 가까워질수록 떼는 돈이 커지더라고요. 예약할 때 캡처해 두는 게 좋아요."},
{"id":"T5088","line":9529,"t":"야시장 왔으면 하나씩 맛봐요!"},
{"id":"T5089","line":9529,"t":"판매대마다 가격표 붙어 있어요. 없으면 물어보고 사요."},
{"id":"T5090","line":9530,"t":"야시장은 금·토·일 저녁에만 열어요. 평일에 오면 조용해요."},
{"id":"T5091","line":9530,"t":"운영 시간이 철마다 달라서 전주시 공지를 보고 왔어요."},
{"id":"T5092","line":9531,"t":"어서 와요. 골목 사진은 괜찮은데 창문 안은 찍지 말아 줘요."},
{"id":"T5093","line":9531,"t":"밤늦게 떠들면 다들 잠을 못 자요. 여기 진짜 사람 사는 동네예요."},
{"id":"T5094","line":9532,"t":"싱싱한 거 골라 봐요!"},
{"id":"T5095","line":9532,"t":"저울은 바늘이 0에 있는지부터 보는 거 맞아요. 봉지에 물 채워서 다는 집은 피하세요."},
{"id":"T5096","line":9533,"t":"회 한 접시 하고 가요!"},
{"id":"T5097","line":9533,"t":"회는 무게로 파는 곳이 많아요. 몇 g인지, 손질비나 상차림비가 따로인지 먼저 물어봐요."},
{"id":"T5098","line":9534,"t":"갓 구운 경주빵 있어요!"},
{"id":"T5099","line":9534,"t":"선물용 상자는 개수랑 가격을 보고 골라요. 상자마다 달라요."},
{"id":"T5100","line":9535,"t":"황리단길은 입장료가 없어요. 대신 카페 줄이 길어요."},
{"id":"T5101","line":9535,"t":"대릉원은 들어가는 건 무료인데, 천마총 안은 관람료가 따로 있어요."},
{"id":"T5102","line":9536,"t":"동궁과 월지는 해 지고 가야 예뻐요."},
{"id":"T5103","line":9536,"t":"근데 매표가 21시 30분에 끝나요. 늦게 오면 문 앞에서 돌아가요."},
{"id":"T5104","line":9537,"t":"한옥은 방음이 약해요. 밤엔 조용히 부탁해요."},
{"id":"T5105","line":9537,"t":"예약 취소는 환불 규정부터 보세요. 소비자분쟁해결기준에선 성수기에 이용일이 가까울수록 떼는 돈이 커져요. 권고 기준이라 업체 규정도 같이 봐야 하고요."},
{"id":"T5106","line":9538,"t":"납작만두 한 접시 줄까?"},
{"id":"T5107","line":9538,"t":"대구 10미 들어 봤어? 납작만두도 그중 하나야."},
{"id":"T5108","line":9538,"t":"막창도 대구 10미야. 연탄불에 구워 먹지."},
{"id":"T5109","line":9539,"t":"동성로는 대구 한가운데예요. 옷가게, 분식집 다 여기 있어요."},
{"id":"T5110","line":9539,"t":"택시 탈 땐 차 번호랑 영수증 챙겨요. 요금이 이상하면 시청에 신고할 때 필요해요."},
{"id":"T5111","line":9540,"t":"야시장 먹거리 골라 봐요!"},
{"id":"T5112","line":9540,"t":"2026년 서문 야시장은 3월부터 12월까지 금·토·일에 열어요."},
{"id":"T5113","line":9541,"t":"칼국수 골목은 낮에 와도 맛있어."},
{"id":"T5114","line":9541,"t":"가격은 벽에 다 붙어 있어. 붙어 있는 집이 마음 편하지."},
{"id":"T5115","line":9542,"t":"여기도 사람 사는 골목이에요. 밤엔 조용히 부탁해요."},
{"id":"T5116","line":9542,"t":"벽화 앞 줄이 길면 사진은 한두 장만 찍고 비켜 줘요."},
{"id":"T5117","line":9543,"t":"구경만 해도 돼요~"},
{"id":"T5118","line":9543,"t":"중고거래는 직접 만나서 하거나 안전결제로 해요. 돈부터 보내라는 사람은 거의 사기예요."},
{"id":"T5119","line":9543,"t":"택배 거래면 송장 번호 확인하고, 가짜 결제 링크 조심하고요."},
{"id":"T5120","line":9546,"t":"[졸음쉼터 안내]"},
{"id":"T5121","line":9546,"t":"\"졸음운전은 음주운전만큼 위험합니다.\""},
{"id":"T5122","line":9546,"t":"고속도로 곳곳에 졸음쉼터가 있다. 졸리면 참지 말고 들르자."},
{"id":"T5123","line":9547,"t":"[고속도로 안내판]"},
{"id":"T5124","line":9547,"t":"→ 본선 진입 · 전국 방면"},
{"id":"T5125","line":9547,"t":"차로 오른쪽 찻길 끝까지 가면 전국 지도로 나간다."},
{"id":"T5126","line":9548,"t":"[파라솔 대여]"},
{"id":"T5127","line":9548,"t":"\"1일 이용료는 안내소 게시 금액만 받습니다.\""},
{"id":"T5128","line":9548,"t":"가격표가 붙어 있는지 먼저 보자. 없으면 안내소에 물어본다."},
{"id":"T5129","line":9549,"t":"[기념품 좌판]"},
{"id":"T5130","line":9549,"t":"\"전부 만 원\"이라고 적혀 있는데, 어떤 건 가격표가 없다."},
{"id":"T5131","line":9549,"t":"가격표 없는 물건은 계산 전에 먼저 물어보자."},
{"id":"T5132","line":9550,"t":"[포장마차 메뉴판]"},
{"id":"T5133","line":9550,"t":"꼼장어 · 어묵 · 떡볶이"},
{"id":"T5134","line":9550,"t":"가격이 적혀 있다. 이런 집이 마음 편하다."},
{"id":"T5135","line":9551,"t":"[분양 현수막]"},
{"id":"T5136","line":9551,"t":"\"신축 빌라 전세 입주 · 입주금 0원 · 이사비 지원!\""},
{"id":"T5137","line":9551,"t":"이사비까지 준다는 집일수록 전세가와 매매가를 나란히 놓고 본다."},
{"id":"T5138","line":9552,"t":"[아파트 게시판]"},
{"id":"T5139","line":9552,"t":"\"관리비 내역은 공동주택관리정보시스템(K-apt)에서 볼 수 있습니다.\""},
{"id":"T5140","line":9552,"t":"관리비에 무엇이 들었는지 계약 전에 물어보자."},
{"id":"T5141","line":9553,"t":"[옵션 안내문]"},
{"id":"T5142","line":9553,"t":"에어컨 · 세탁기 · 냉장고 · 인덕션 풀옵션!"},
{"id":"T5143","line":9553,"t":"옵션이 좋다고 보증금이 안전해지지는 않는다."},
{"id":"T5144","line":9554,"t":"오래된 보일러다. \"2019년 교체\" 스티커가 붙어 있다."},
{"id":"T5145","line":9554,"t":"살다가 보일러 같은 큰 설비가 고장 나면 고쳐 줄 책임은 대개 집주인에게 있다. 특약으로 적어 두면 더 확실하다."},
{"id":"T5146","line":9555,"t":"[원산지 표시판]"},
{"id":"T5147","line":9555,"t":"배추 국내산 · 고춧가루 국내산 · 조기 중국산"},
{"id":"T5148","line":9555,"t":"팻말이 없으면 물어본다. 원산지를 속인 건 신고할 수 있다."},
{"id":"T5149","line":9556,"t":"[정육점 가격표]"},
{"id":"T5150","line":9556,"t":"한우 등심 100g · 돼지 앞다리 100g"},
{"id":"T5151","line":9556,"t":"무게 단위(100g)를 확인하고, 저울 눈금이 0에서 시작하는지 본다."},
{"id":"T5152","line":9557,"t":"가게 저울 눈금이 0을 가리킨다."},
{"id":"T5153","line":9557,"t":"수산시장에서는 저울을 먼저 0으로 맞추고, 봉지에 물을 채워 무게를 늘리는 \"물치기\"를 조심하라고 한다. 경험치 +15"},
{"id":"T5154","line":9558,"t":"[버스 노선도]"},
{"id":"T5155","line":9558,"t":"막차 시간은 정류장마다 다르다. 앱보다 여기 적힌 시간이 정확할 때도 있다."},
{"id":"T5156","line":9559,"t":"[유실물 센터 안내]"},
{"id":"T5157","line":9559,"t":"\"잃어버린 물건은 경찰청 유실물 통합포털 LOST112에서도 찾을 수 있습니다.\""},
{"id":"T5158","line":9560,"t":"교통카드를 충전했다."},
{"id":"T5159","line":9560,"t":"충전하면서 이번 달 교통비를 계산해 봤다. 경험치 +10"},
{"id":"T5160","line":9561,"t":"[안내판]"},
{"id":"T5161","line":9561,"t":"↓ 주택가 · 빌라촌"},
{"id":"T5162","line":9561,"t":"찻길 옆 보도를 따라 아래로 내려가면 된다."},
{"id":"T5163","line":9562,"t":"[안내판]"},
{"id":"T5164","line":9562,"t":"↓ 전통시장"},
{"id":"T5165","line":9562,"t":"찻길 옆 보도를 따라 아래로 내려가면 시장 입구다."},
{"id":"T5166","line":9563,"t":"[안내판]"},
{"id":"T5167","line":9563,"t":"↑ 뉴비역 · 이 골목으로"},
{"id":"T5168","line":9563,"t":"회사 건물 옆 골목으로 올라가면 역 앞 광장이다."},
{"id":"T5169","line":9564,"t":"[해수욕장 안내판]"},
{"id":"T5170","line":9564,"t":"\"2026년 안목해변 개장 7월 10일 ~ 8월 23일 · 경포는 7월 4일부터\""},
{"id":"T5171","line":9564,"t":"수영은 개장 기간에, 안전요원이 지키는 구역 안에서만."},
{"id":"T5172","line":9565,"t":"[오죽헌 안내판]"},
{"id":"T5173","line":9565,"t":"신사임당과 율곡 이이가 태어난 집."},
{"id":"T5174","line":9565,"t":"관람료 어른 3,000원 · 65세 이상 무료 · 매월 마지막 수요일 반값. 요금은 매표소 게시를 확인하자."},
{"id":"T5175","line":9566,"t":"줄기가 까만 대나무, 오죽이다."},
{"id":"T5176","line":9566,"t":"\"오죽헌\"이라는 이름이 여기서 왔다. 경험치 +15"},
{"id":"T5177","line":9567,"t":"[경기전 안내판]"},
{"id":"T5178","line":9567,"t":"조선 태조의 어진(초상화)을 모신 곳."},
{"id":"T5179","line":9567,"t":"관람료 어른 3,000원 · 매월 마지막 수요일 무료. 한옥마을 자체는 입장료가 없다."},
{"id":"T5180","line":9568,"t":"[야시장 안내]"},
{"id":"T5181","line":9568,"t":"\"매주 금·토요일 · 운영 시간은 계절마다 다릅니다\""},
{"id":"T5182","line":9568,"t":"이동 판매대 40여 곳이 250m 남짓한 통로에 늘어선다."},
{"id":"T5183","line":9569,"t":"[주민 생활 공간입니다]"},
{"id":"T5184","line":9569,"t":"\"조용히 둘러봐 주세요. 집 안이 보이는 사진과 드론 촬영은 삼가 주세요.\""},
{"id":"T5185","line":9569,"t":"안내센터는 3~10월 09:00~18:00, 11~2월 09:00~17:00."},
{"id":"T5186","line":9570,"t":"어린 왕자와 사막여우가 마을을 내려다보는 조형물."},
{"id":"T5187","line":9570,"t":"줄 서서 사진을 한 장 찍었다. 경험치 +15"},
{"id":"T5188","line":9571,"t":"시장 저울. 바늘이 0에 있는지부터 봤다."},
{"id":"T5189","line":9571,"t":"무게를 부풀려 재는 \"저울치기\"를 조심하자. 경험치 +15"},
{"id":"T5190","line":9572,"t":"[원산지 팻말]"},
{"id":"T5191","line":9572,"t":"고등어 국내산 · 오징어 원양산 · 새우 수입산"},
{"id":"T5192","line":9572,"t":"원산지를 속인 건 관세청 125로 신고할 수 있다."},
{"id":"T5193","line":9573,"t":"[불국사 가는 버스 안내]"},
{"id":"T5194","line":9573,"t":"불국사·석굴암은 2023년 5월 4일부터 문화재 관람료를 받지 않는다."},
{"id":"T5195","line":9573,"t":"버스 시간표는 정류장 게시를 확인하자."},
