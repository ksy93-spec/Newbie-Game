[{"id":"T1326","line":3473,"t":"세입자가 쓸 수 있는 계약갱신요구권은?"},
{"id":"T1327","line":3473,"t":"한 번 써서 2년 더 살 수 있다"},
{"id":"T1328","line":3473,"t":"횟수 제한 없이 쓴다"},
{"id":"T1329","line":3473,"t":"집주인이 허락할 때만 생긴다"},
{"id":"T1330","line":3474,"t":"주택임대차보호법상 세입자는 계약갱신요구권을 1회 쓸 수 있고, 갱신된 계약은 2년으로 본다. 찾기쉬운 생활법령정보 기준."},
{"id":"T1331","line":3475,"t":"갱신요구권을 써서 계약을 늘릴 때 보증금·월세 인상은?"},
{"id":"T1332","line":3475,"t":"5% 안에서만 올릴 수 있다"},
{"id":"T1333","line":3475,"t":"집주인 마음대로 올린다"},
{"id":"T1334","line":3475,"t":"절대 못 올린다"},
{"id":"T1335","line":3476,"t":"갱신 때 차임·보증금 증액은 5%를 넘지 못한다. 지자체가 조례로 더 낮게 정했는지도 본다."},
{"id":"T1336","line":3477,"t":"아무 말 없이 계약 기간이 지나 자동으로 이어졌다면(묵시적 갱신)?"},
{"id":"T1337","line":3477,"t":"세입자는 언제든 해지를 알릴 수 있고 3개월 뒤 효력이 생긴다"},
{"id":"T1338","line":3477,"t":"2년을 꼭 채워야 한다"},
{"id":"T1339","line":3477,"t":"바로 나가야 한다"},
{"id":"T1340","line":3478,"t":"묵시적 갱신이면 세입자는 언제든 해지를 통지할 수 있고, 집주인이 통지를 받은 날부터 3개월이 지나면 효력이 생긴다. 주택임대차보호법."},
{"id":"T1341","line":3479,"t":"신용점수, 안 쓰고도 올리기"},
{"id":"T1342","line":3479,"t":"은행 창구 직원"},
{"id":"T1343","line":3480,"t":"카드 많이 써야 신용점수 오르는 줄 알죠? 다른 길도 있어요."},
{"id":"T1344","line":3481,"t":"카드 실적이 거의 없을 때 신용점수에 보탬이 될 수 있는 것은?"},
{"id":"T1345","line":3481,"t":"통신비·건강보험료 납부 내역 제출"},
{"id":"T1346","line":3481,"t":"신용조회를 여러 번 하기"},
{"id":"T1347","line":3481,"t":"현금서비스 자주 받기"},
{"id":"T1348","line":3482,"t":"신용평가사 앱이나 누리집에서 통신비·공공요금·건강보험료 성실 납부 내역을 내면 가점을 받을 수 있다. 금융감독원 파인 안내."},
{"id":"T1349","line":3483,"t":"내 신용점수를 자주 조회하면?"},
{"id":"T1350","line":3483,"t":"조회만으로는 점수가 떨어지지 않는다"},
{"id":"T1351","line":3483,"t":"조회할 때마다 깎인다"},
{"id":"T1352","line":3483,"t":"한 달에 한 번만 볼 수 있다"},
{"id":"T1353","line":3484,"t":"본인 신용조회는 점수에 영향을 주지 않는다. 자주 확인해서 이상한 대출이나 연체가 없는지 보는 편이 낫다."},
{"id":"T1354","line":3485,"t":"점수를 크게 깎는 행동은?"},
{"id":"T1355","line":3485,"t":"적은 돈이라도 연체를 오래 두는 것"},
{"id":"T1356","line":3485,"t":"체크카드 사용"},
{"id":"T1357","line":3485,"t":"적금 가입"},
{"id":"T1358","line":3486,"t":"금액보다 연체 기간이 중요하다. 소액이라도 오래 밀리면 기록이 남는다. 자동이체 날짜를 월급날 뒤로 맞춰 둔다."},
{"id":"T1359","line":3487,"t":"첫 차, 자동차보험 고르기"},
{"id":"T1360","line":3487,"t":"3년차 선배"},
{"id":"T1361","line":3488,"t":"차 샀다며? 보험은 딜러가 권하는 대로 들었어?"},
{"id":"T1362","line":3489,"t":"여러 회사 자동차보험료를 한 번에 비교하는 곳은?"},
{"id":"T1363","line":3489,"t":"보험다모아"},
{"id":"T1364","line":3489,"t":"중고차 앱"},
{"id":"T1365","line":3489,"t":"카드사 앱"},
{"id":"T1366","line":3490,"t":"손해보험협회 등이 운영하는 보험다모아(e-insmarket.or.kr)에서 다이렉트 보험료를 비교한다."},
{"id":"T1367","line":3491,"t":"운전을 많이 안 한다면 살펴볼 특약은?"},
{"id":"T1368","line":3491,"t":"주행거리(마일리지) 특약"},
{"id":"T1369","line":3491,"t":"운전자 범위 누구나"},
{"id":"T1370","line":3491,"t":"긴급출동 무제한"},
{"id":"T1371","line":3492,"t":"주행거리가 적으면 보험료 일부를 돌려받는 특약이 있다. 계기판 사진 제출 같은 조건은 회사마다 다르다."},
{"id":"T1372","line":3493,"t":"운전자 범위를 넓게 잡으면?"},
{"id":"T1373","line":3493,"t":"보험료가 올라간다"},
{"id":"T1374","line":3493,"t":"보험료가 내려간다"},
{"id":"T1375","line":3493,"t":"상관없다"},
{"id":"T1376","line":3494,"t":"운전자를 본인 한정, 부부 한정처럼 좁힐수록 보험료가 낮아진다. 대신 범위 밖 사람이 몰다 사고 나면 보상이 안 될 수 있다. 금융감독원 파인 안내."},
{"id":"T1377","line":3495,"t":"첫 건강검진 날짜"},
{"id":"T1378","line":3495,"t":"공단 상담원"},
{"id":"T1379","line":3496,"t":"건강검진 대상자라고 문자 왔죠? 미루면 그냥 지나가요."},
{"id":"T1380","line":3497,"t":"사무직 직장인의 일반건강검진 주기는?"},
{"id":"T1381","line":3497,"t":"2년에 한 번"},
{"id":"T1382","line":3497,"t":"5년에 한 번"},
{"id":"T1383","line":3497,"t":"10년에 한 번"},
{"id":"T1384","line":3498,"t":"사무직은 2년에 1회, 비사무직은 매년 받는다. 국민건강보험공단 건강검진 안내."},
{"id":"T1385","line":3499,"t":"내가 이번 해 검진 대상인지 확인하는 곳은?"},
{"id":"T1386","line":3499,"t":"국민건강보험공단 누리집이나 앱(The건강보험)"},
{"id":"T1387","line":3499,"t":"동네 약국"},
{"id":"T1388","line":3499,"t":"회사 단톡방"},
{"id":"T1389","line":3500,"t":"공단 누리집이나 The건강보험 앱에서 대상 여부와 가까운 검진기관을 찾는다."},
{"id":"T1390","line":3501,"t":"회사 다니지 않는 20~30대 세대원·피부양자는?"},
{"id":"T1391","line":3501,"t":"일반건강검진 대상에 들어갈 수 있다"},
{"id":"T1392","line":3501,"t":"검진 대상이 아니다"},
{"id":"T1393","line":3501,"t":"전액 자기 돈으로만 받는다"},
{"id":"T1394","line":3502,"t":"20~30대 피부양자와 지역가입자 세대원도 일반건강검진 대상이 됐다. 대상 연도는 공단에서 확인한다."},
{"id":"T1395","line":3505,"t":"퇴직연금 DB와 DC"},
{"id":"T1396","line":3506,"t":"퇴직연금 유형을 고르라는데 DB랑 DC가 뭐가 달라요?"},
{"id":"T1397","line":3507,"t":"DB형(확정급여형)의 특징은?"},
{"id":"T1398","line":3507,"t":"퇴직할 때 받을 돈이 정해져 있고 회사가 운용한다"},
{"id":"T1399","line":3507,"t":"내가 직접 운용한다"},
{"id":"T1400","line":3507,"t":"회사가 매년 주는 돈이 정해져 있다"},
{"id":"T1401","line":3508,"t":"DB형은 퇴직 직전 평균임금과 근속연수로 받을 돈이 정해지고, 운용 책임은 회사에 있다. 고용노동부 퇴직연금 안내."},
{"id":"T1402","line":3509,"t":"DC형(확정기여형)의 특징은?"},
{"id":"T1403","line":3509,"t":"회사가 해마다 일정액을 넣고 내가 운용한다"},
{"id":"T1404","line":3509,"t":"퇴직할 때 받을 돈이 정해져 있다"},
{"id":"T1405","line":3509,"t":"근로자가 혼자 돈을 넣는다"},
{"id":"T1406","line":3510,"t":"DC형은 회사가 매년 연간 임금총액의 12분의 1 이상을 넣고, 운용 결과는 근로자 몫이다. 근로자퇴직급여 보장법."},
{"id":"T1407","line":3511,"t":"월급이 앞으로 꾸준히 크게 오를 것 같다면 보통 유리한 쪽은?"},
{"id":"T1408","line":3511,"t":"차이가 없다"},
{"id":"T1409","line":3512,"t":"DB형은 마지막 평균임금을 기준으로 하므로 임금 상승률이 높을수록 유리하다. 임금이 정체되거나 줄 것 같으면 DC형을 따져 본다."},
{"id":"T1410","line":3513,"t":"IRP로 받는 퇴직금"},
{"id":"T1411","line":3514,"t":"이직하면 퇴직금이 IRP 계좌로 들어온대요. 그냥 빼서 쓰면 안 돼요?"},
{"id":"T1412","line":3515,"t":"55세 전에 퇴직하면 퇴직급여는 원칙적으로 어디로 들어갈까?"},
{"id":"T1413","line":3515,"t":"개인형퇴직연금(IRP) 계좌"},
{"id":"T1414","line":3515,"t":"월급 통장"},
{"id":"T1415","line":3515,"t":"회사 금고"},
{"id":"T1416","line":3516,"t":"55세 전에 퇴직하면 퇴직급여는 원칙적으로 IRP로 옮겨진다. 소액 등 예외는 있다. 고용노동부 안내."},
{"id":"T1417","line":3517,"t":"IRP의 퇴직금을 55세 이후 연금으로 나눠 받으면?"},
{"id":"T1418","line":3517,"t":"일시금보다 퇴직소득세가 줄어든다"},
{"id":"T1419","line":3517,"t":"세금이 두 배가 된다"},
{"id":"T1420","line":3517,"t":"받을 수 없다"},
{"id":"T1421","line":3518,"t":"연금으로 받으면 퇴직소득세를 30% 덜 낸다(연금 수령 10년 차부터는 40%). 국세청·금융감독원 통합연금포털 안내."},
{"id":"T1422","line":3519,"t":"연금저축과 IRP에 따로 넣는 돈의 세액공제 한도는?"},
{"id":"T1423","line":3519,"t":"둘을 합쳐 연 900만원까지"},
{"id":"T1424","line":3519,"t":"한도 없이 전부"},
{"id":"T1425","line":3519,"t":"연금저축만 공제된다"},
{"id":"T1426","line":3520,"t":"연금저축은 연 600만원, IRP를 합치면 연 900만원까지 세액공제 대상이다. 국세청 기준."},
{"id":"T1427","line":3521,"t":"내 발로 나가도 실업급여?"},
{"id":"T1428","line":3521,"t":"고용센터 상담원"},
{"id":"T1429","line":3522,"t":"그만두고 싶은데, 자진 퇴사면 실업급여는 없는 거죠?"},
{"id":"T1430","line":3523,"t":"스스로 그만둔 경우 실업급여는?"},
{"id":"T1431","line":3523,"t":"원칙적으로 안 되지만 정당한 이직 사유가 있으면 받을 수 있다"},
{"id":"T1432","line":3523,"t":"무조건 받는다"},
{"id":"T1433","line":3523,"t":"절대 못 받는다"},
{"id":"T1434","line":3524,"t":"자발적으로 그만두면 원칙적으로 수급이 제한되지만, 고용보험법 시행규칙에 정한 사유(임금체불, 회사 이전으로 통근이 어려워짐, 직장 내 괴롭힘 등)는 예외다. 고용노동부."},
{"id":"T1435","line":3525,"t":"임금이 밀려서 그만둘 생각이라면 먼저 챙길 것은?"},
{"id":"T1436","line":3525,"t":"체불 사실을 보여 줄 기록(급여 명세, 통장 내역, 진정 접수)"},
{"id":"T1437","line":3525,"t":"퇴사 인사말"},
{"id":"T1438","line":3525,"t":"회사 비품"},
{"id":"T1439","line":3526,"t":"예외 사유는 직접 증명해야 인정받는다. 고용노동부에 낸 체불 진정 기록 등이 근거가 된다."},
{"id":"T1440","line":3527,"t":"실업급여를 받을 수 있는 수급기간은?"},
{"id":"T1441","line":3527,"t":"이직한 다음 날부터 12개월 안"},
{"id":"T1442","line":3527,"t":"퇴사 후 5년 안"},
{"id":"T1443","line":3528,"t":"수급기간이 12개월이라 늦게 신청하면 받을 날을 다 못 채운다. 퇴사하면 바로 고용24에서 구직 등록부터 한다."},
{"id":"T1444","line":3529,"t":"육아휴직, 아이 없어도 알아 둘 것"},
{"id":"T1445","line":3529,"t":"노무 상담원"},
{"id":"T1446","line":3530,"t":"옆자리 동료가 육아휴직 간대요. 나도 나중에 쓸 수 있는 거죠?"},
{"id":"T1447","line":3531,"t":"육아휴직을 쓸 수 있는 자녀 나이는?"},
{"id":"T1448","line":3531,"t":"만 8세 이하 또는 초등학교 2학년 이하"},
{"id":"T1449","line":3531,"t":"만 3세 이하만"},
{"id":"T1450","line":3531,"t":"나이 상관없이"},
{"id":"T1451","line":3532,"t":"남녀고용평등법상 만 8세 이하 또는 초등학교 2학년 이하 자녀가 있으면 쓸 수 있다. 엄마·아빠 각각 쓸 수 있다. 고용노동부."},
{"id":"T1452","line":3533,"t":"육아휴직을 썼다는 이유로 회사가 불이익을 주면?"},
{"id":"T1453","line":3533,"t":"법으로 금지돼 있어 신고할 수 있다"},
{"id":"T1454","line":3533,"t":"회사 재량이다"},
{"id":"T1455","line":3533,"t":"휴직을 쓴 사람이 감수한다"},
{"id":"T1456","line":3534,"t":"육아휴직을 이유로 해고나 불리한 처우를 하면 안 되고, 복귀하면 같은 일이나 같은 수준의 일로 돌아가야 한다. 고용노동부 신고 가능."},
{"id":"T1457","line":3535,"t":"아이가 없는 사람이 가족 돌봄 때문에 쓸 수 있는 제도는?"},
{"id":"T1458","line":3535,"t":"가족돌봄휴가·가족돌봄휴직"},
{"id":"T1459","line":3535,"t":"육아휴직"},
{"id":"T1460","line":3535,"t":"출산휴가"},
{"id":"T1461","line":3536,"t":"부모님·배우자 등 가족이 아프거나 돌볼 일이 생기면 가족돌봄휴가와 휴직을 쓸 수 있다. 아이가 없어도 해당된다. 남녀고용평등법."},
{"id":"T1462","line":3537,"t":"아이가 태어나면 받는 돈"},
{"id":"T1463","line":3537,"t":"주민센터 직원"},
{"id":"T1464","line":3538,"t":"출산하면 신청할 게 한두 개가 아니에요. 한 번에 하는 법 알려 줄게요."},
{"id":"T1465","line":3539,"t":"출생신고 때 여러 출산 지원을 한 번에 신청하는 서비스는?"},
{"id":"T1466","line":3539,"t":"행복출산 원스톱 서비스"},
{"id":"T1467","line":3539,"t":"안심상속 원스톱 서비스"},
{"id":"T1468","line":3539,"t":"정부24 민원 발급"},
{"id":"T1469","line":3540,"t":"주민센터나 정부24에서 출생신고를 하면서 부모급여, 아동수당, 첫만남이용권 등을 한꺼번에 신청할 수 있다. 복지로 안내."},
{"id":"T1470","line":3541,"t":"첫만남이용권은 어떤 형태로 받을까?"},
{"id":"T1471","line":3541,"t":"국민행복카드 바우처"},
{"id":"T1472","line":3541,"t":"현금 입금"},
{"id":"T1473","line":3541,"t":"상품권 우편 발송"},
{"id":"T1474","line":3542,"t":"국민행복카드 바우처로 지급된다. 금액과 쓸 수 있는 기간은 복지로에서 그해 기준을 확인한다."},
{"id":"T1475","line":3543,"t":"부모급여에 대해 맞는 말은?"},
{"id":"T1476","line":3543,"t":"만 0~1세 아이를 키우는 가정에 매달 지급된다"},
{"id":"T1477","line":3543,"t":"소득이 높으면 아예 없다"},
{"id":"T1478","line":3543,"t":"한 번만 받는다"},
{"id":"T1479","line":3544,"t":"부모급여는 0세와 1세 아동에게 매달 나온다. 어린이집을 다니면 보육료로 바뀌는 부분이 있다. 금액은 복지로에서 확인."},
{"id":"T1480","line":3545,"t":"주택담보대출, LTV와 DSR"},
{"id":"T1481","line":3545,"t":"은행 창구 직원"},
{"id":"T1482","line":3546,"t":"집값의 몇 %까지 빌릴 수 있는지만 보면 안 돼요. 소득도 봐요."},
{"id":"T1483","line":3547,"t":"LTV(주택담보인정비율)는 무엇을 기준으로 할까?"},
{"id":"T1484","line":3547,"t":"집값 대비 빌리는 돈의 비율"},
{"id":"T1485","line":3547,"t":"소득 대비 갚는 돈의 비율"},
{"id":"T1486","line":3547,"t":"신용점수"},
{"id":"T1487","line":3548,"t":"LTV는 담보 가치 대비 대출 비율이다. 지역과 주택 수에 따라 한도가 다르다. 금융위원회 안내."},
{"id":"T1488","line":3549,"t":"DSR(총부채원리금상환비율)에 들어가는 것은?"},
{"id":"T1489","line":3549,"t":"주담대뿐 아니라 신용대출·자동차 할부 등 모든 대출의 한 해 원리금"},
{"id":"T1490","line":3549,"t":"주담대 이자만"},
{"id":"T1491","line":3549,"t":"카드 사용액만"},
{"id":"T1492","line":3550,"t":"DSR은 모든 가계대출의 연간 원리금 상환액을 연소득으로 나눈 값이다. 다른 빚이 많으면 집값과 상관없이 주담대 한도가 줄어든다."},
{"id":"T1493","line":3551,"t":"주담대 신청 전 한도를 늘리는 데 가장 직접적인 방법은?"},
{"id":"T1494","line":3551,"t":"다른 대출(특히 신용대출)을 먼저 줄이기"},
{"id":"T1495","line":3551,"t":"신용카드 새로 만들기"},
{"id":"T1496","line":3551,"t":"청약통장 해지"},
{"id":"T1497","line":3552,"t":"DSR 계산에 다른 대출 원리금이 들어가므로, 남은 신용대출을 줄이면 한도가 늘어난다. 금리 상승을 가정해 더 깎는 스트레스 DSR도 적용되니 은행에서 미리 계산해 본다."},
{"id":"T1498","line":3553,"t":"청약 가점 계산해 보기"},
{"id":"T1499","line":3553,"t":"은행 창구 직원"},
{"id":"T1500","line":3554,"t":"청약 가점이 몇 점인지 알아요? 생각보다 쉽게 셀 수 있어요."},
{"id":"T1501","line":3555,"t":"민영주택 청약 가점은 세 가지 항목으로 매긴다. 아닌 것은?"},
{"id":"T1502","line":3555,"t":"무주택 기간"},
{"id":"T1503","line":3555,"t":"부양가족 수"},
{"id":"T1504","line":3556,"t":"무주택 기간(32점), 부양가족 수(35점), 청약통장 가입 기간(17점), 합 84점 만점이다. 소득은 가점 항목이 아니다. 청약홈(한국부동산원)."},
{"id":"T1505","line":3557,"t":"미혼이라면 무주택 기간은 보통 언제부터 셀까?"},
{"id":"T1506","line":3557,"t":"만 30세부터"},
{"id":"T1507","line":3557,"t":"태어날 때부터"},
{"id":"T1508","line":3557,"t":"통장 만든 날부터"},
{"id":"T1509","line":3558,"t":"무주택 기간은 만 30세부터 센다. 그 전에 혼인했다면 혼인신고일부터 센다. 주택공급에 관한 규칙."},
{"id":"T1510","line":3559,"t":"내 가점을 정확히 계산해 보는 곳은?"},
{"id":"T1511","line":3559,"t":"청약홈 가점 계산기"},
{"id":"T1512","line":3559,"t":"부동산 커뮤니티"},
{"id":"T1513","line":3559,"t":"건설사 광고"},
{"id":"T1514","line":3560,"t":"한국부동산원 청약홈에서 가점을 계산하고 공고를 본다. 잘못 넣으면 당첨이 취소될 수 있어 직접 확인해야 한다."},
{"id":"T1515","line":3561,"t":"신혼·생애최초 특별공급"},
{"id":"T1516","line":3561,"t":"공인중개사"},
{"id":"T1517","line":3562,"t":"가점이 낮으면 특별공급 쪽을 봐요. 대신 한 번뿐이에요."},
{"id":"T1518","line":3563,"t":"특별공급은 몇 번 당첨될 수 있을까?"},
{"id":"T1519","line":3563,"t":"원칙적으로 한 세대에 한 번"},
{"id":"T1520","line":3563,"t":"해마다 한 번"},
{"id":"T1521","line":3563,"t":"제한 없이"},
{"id":"T1522","line":3564,"t":"특별공급은 원칙적으로 평생 한 번이다(세대 기준). 신중하게 고른다. 청약홈 안내."},
{"id":"T1523","line":3565,"t":"생애최초 특별공급의 기본 조건은?"},
{"id":"T1524","line":3565,"t":"세대 구성원 모두 주택을 가진 적이 없어야 한다"},
{"id":"T1525","line":3565,"t":"본인만 집이 없으면 된다"},
{"id":"T1526","line":3565,"t":"집이 한 채까지는 괜찮다"},
{"id":"T1527","line":3566,"t":"세대원 전원이 과거 주택 소유 이력이 없어야 한다. 소득·자산 기준도 따로 있으니 공고문에서 본다."},
{"id":"T1528","line":3567,"t":"특별공급 소득 기준을 확인하는 가장 정확한 곳은?"},
{"id":"T1529","line":3567,"t":"해당 단지의 입주자모집공고문"},
{"id":"T1530","line":3567,"t":"친구 말"},
{"id":"T1531","line":3567,"t":"지난해 다른 단지 공고"},
{"id":"T1532","line":3568,"t":"기준은 해마다, 단지마다 다를 수 있다. 신청하려는 단지의 모집공고문이 기준이다. 국토교통부·청약홈."},
{"id":"T1533","line":3569,"t":"집 살 때 집값 말고 드는 돈"},
{"id":"T1534","line":3569,"t":"공인중개사"},
{"id":"T1535","line":3570,"t":"집값만 모아 두면 잔금 날 당황해요. 따로 드는 돈이 있어요."},
{"id":"T1536","line":3571,"t":"집을 사면 내야 하는 지방세는?"},
{"id":"T1537","line":3571,"t":"종합소득세"},
{"id":"T1538","line":3571,"t":"부가가치세"},
{"id":"T1539","line":3572,"t":"주택을 사면 취득세(지방교육세 등 포함)를 낸다. 세율은 집값·주택 수에 따라 다르다. 위택스·행정안전부."},
{"id":"T1540","line":3573,"t":"취득세 신고·납부 기한은?"},
{"id":"T1541","line":3573,"t":"취득한 날부터 60일 안"},
{"id":"T1542","line":3573,"t":"5년 안"},
{"id":"T1543","line":3573,"t":"다음 해 5월"},
{"id":"T1544","line":3574,"t":"취득일(보통 잔금일)부터 60일 안에 신고·납부한다. 늦으면 가산세가 붙는다. 위택스."},
{"id":"T1545","line":3575,"t":"처음 집을 사는 사람이 확인할 것은?"},
{"id":"T1546","line":3575,"t":"생애최초 취득세 감면 요건"},
{"id":"T1547","line":3575,"t":"청약통장 해지"},
{"id":"T1548","line":3575,"t":"전입신고 미루기"},
{"id":"T1549","line":3576,"t":"생애최초 주택 취득에 취득세 감면 제도가 있다. 요건과 기한이 바뀌니 위택스나 구청 세무과에서 확인한다."},
{"id":"T1550","line":3577,"t":"실손보험 두 개면 두 배?"},
{"id":"T1551","line":3577,"t":"3년차 선배"},
{"id":"T1552","line":3578,"t":"실손보험 두 개 들어 두면 병원비 두 번 받는 거 아니야?"},
{"id":"T1553","line":3579,"t":"실손보험을 두 군데 들었을 때 병원비 보상은?"},
{"id":"T1554","line":3579,"t":"실제 낸 돈 안에서 나눠서 준다"},
{"id":"T1555","line":3579,"t":"두 배로 준다"},
{"id":"T1556","line":3579,"t":"먼저 청구한 곳만 준다"},
{"id":"T1557","line":3580,"t":"실손은 실제 쓴 의료비만 보상하는 상품이라 중복 가입해도 비례로 나눠 줄 뿐 더 받지 못한다. 금융감독원 파인."},
{"id":"T1558","line":3581,"t":"내가 어떤 보험에 들어 있는지 한 번에 보는 곳은?"},
{"id":"T1559","line":3581,"t":"내보험찾아줌"},
{"id":"T1560","line":3581,"t":"은행 앱 첫 화면"},
{"id":"T1561","line":3581,"t":"통신사 앱"},
{"id":"T1562","line":3582,"t":"생명·손해보험협회의 내보험찾아줌(cont.insure.or.kr)에서 가입 보험과 숨은 보험금을 조회한다."},
{"id":"T1563","line":3583,"t":"병원에서 실손 청구 서류를 따로 떼지 않아도 되는 방법은?"},
{"id":"T1564","line":3583,"t":"실손24 같은 청구 전산화 서비스"},
{"id":"T1565","line":3583,"t":"팩스로만 가능"},
{"id":"T1566","line":3583,"t":"보험설계사만 가능"},
{"id":"T1567","line":3584,"t":"병원이 보험사로 서류를 바로 보내는 청구 전산화가 단계적으로 시행 중이다. 참여 병원·약국은 실손24에서 확인한다."},
{"id":"T1568","line":3585,"t":"자동차보험 갱신과 사고 처리"},
{"id":"T1569","line":3586,"t":"접촉 사고 났는데 보험 처리할까 그냥 내 돈으로 할까 고민돼."},
{"id":"T1570","line":3587,"t":"과실 비율이 납득되지 않을 때 기댈 수 있는 곳은?"},
{"id":"T1571","line":3587,"t":"손해보험협회 과실비율 분쟁심의"},
{"id":"T1572","line":3587,"t":"경찰서 민원실"},
{"id":"T1573","line":3587,"t":"동네 정비소"},
{"id":"T1574","line":3588,"t":"보험사끼리 과실 비율을 두고 다투면 손해보험협회 과실비율분쟁심의위원회에 심의를 청구할 수 있다."},
{"id":"T1575","line":3589,"t":"작은 사고를 보험으로 처리하기 전에 따져 볼 것은?"},
{"id":"T1576","line":3589,"t":"다음 갱신 보험료가 얼마나 오르는지"},
{"id":"T1577","line":3589,"t":"차 색깔"},
{"id":"T1578","line":3589,"t":"보험사 광고"},
{"id":"T1579","line":3590,"t":"보험 처리 이력은 갱신 보험료에 반영된다. 수리비와 오를 보험료를 비교해 본다. 금융감독원 파인 안내."},
{"id":"T1580","line":3591,"t":"갱신 때 가장 먼저 할 일은?"},
{"id":"T1581","line":3591,"t":"특약과 운전자 범위가 지금 생활에 맞는지 보고 다른 회사와 비교"},
{"id":"T1582","line":3591,"t":"자동 갱신 그대로 두기"},
{"id":"T1583","line":3591,"t":"보장을 다 빼기"},
{"id":"T1584","line":3592,"t":"결혼, 이사, 출퇴근 방식이 바뀌면 운전자 범위와 특약도 바뀐다. 보험다모아에서 비교한다."},
{"id":"T1585","line":3593,"t":"월급 말고 번 돈, 5월 신고"},
{"id":"T1586","line":3593,"t":"세무서 직원"},
{"id":"T1587","line":3594,"t":"회사 다니면서 부업으로 번 돈, 연말정산으로 끝난 줄 알았죠?"},
{"id":"T1588","line":3595,"t":"근로소득 말고 사업소득이 있으면 언제 신고할까?"},
{"id":"T1589","line":3595,"t":"다음 해 5월 종합소득세 신고"},
{"id":"T1590","line":3595,"t":"연말정산 때 회사가 알아서"},
{"id":"T1591","line":3595,"t":"신고할 필요 없다"},
{"id":"T1592","line":3596,"t":"근로소득과 다른 종합소득을 합쳐 5월에 종합소득세를 신고한다. 국세청 홈택스."},
{"id":"T1593","line":3597,"t":"부업에서 3.3%를 떼고 받았다면?"},
{"id":"T1594","line":3597,"t":"미리 낸 세금이라 신고 때 정산된다"},
{"id":"T1595","line":3597,"t":"세금을 다 낸 것이다"},
{"id":"T1596","line":3597,"t":"그 돈은 세금과 상관없다"},
{"id":"T1597","line":3598,"t":"3.3%는 미리 떼는 원천징수다. 5월 신고로 실제 세금과 비교해 더 내거나 돌려받는다. 국세청."},
{"id":"T1598","line":3599,"t":"신고를 빠뜨리면?"},
{"id":"T1599","line":3599,"t":"무신고·납부지연 가산세가 붙을 수 있다"},
{"id":"T1600","line":3599,"t":"아무 일 없다"},
{"id":"T1601","line":3599,"t":"다음 해에 자동으로 정리된다"},
{"id":"T1602","line":3600,"t":"신고 대상인데 안 하면 가산세가 붙는다. 국세청에서 보내는 신고 안내문을 확인한다."},
{"id":"T1603","line":3601,"t":"할부로 산 가전, 물릴 수 있나"},
{"id":"T1604","line":3601,"t":"자취 선배"},
{"id":"T1605","line":3602,"t":"이사하면서 가전을 할부로 질렀는데, 일주일 만에 후회돼."},
{"id":"T1606","line":3603,"t":"할부로 산 물건의 청약철회 기간은 기본적으로?"},
{"id":"T1607","line":3603,"t":"계약서를 받은 날부터 7일"},
{"id":"T1608","line":3603,"t":"철회 불가"},
{"id":"T1609","line":3604,"t":"할부거래법상 할부계약은 계약서를 받은 날부터 7일 안에 철회할 수 있다. 예외 품목이 있다. 한국소비자원."},
{"id":"T1610","line":3605,"t":"집에 찾아온 판매원에게 산 물건(방문판매)의 철회 기간은?"},
{"id":"T1611","line":3605,"t":"철회 불가"},
{"id":"T1612","line":3606,"t":"방문판매법상 방문판매는 14일 안에 철회할 수 있다. 공정거래위원회."},
{"id":"T1613","line":3607,"t":"판매자가 철회를 안 받아 줄 때 상담할 곳은?"},
{"id":"T1614","line":3607,"t":"1372 소비자상담센터"},
{"id":"T1615","line":3607,"t":"구청 민원실"},
{"id":"T1616","line":3608,"t":"1372 소비자상담센터에서 상담하고, 필요하면 한국소비자원 피해구제를 신청한다."},
{"id":"T1617","line":3611,"t":"국민연금, 몇 살부터 받나"},
{"id":"T1618","line":3611,"t":"공단 상담원"},
{"id":"T1619","line":3612,"t":"국민연금 받는 나이, 태어난 해마다 달라요. 확인해 봤어요?"},
{"id":"T1620","line":3613,"t":"1969년 이후 태어난 사람의 노령연금 수령 나이는?"},
{"id":"T1621","line":3614,"t":"수령 나이는 출생연도에 따라 단계적으로 늦춰졌고 1969년생부터 65세다. 국민연금공단."},
{"id":"T1622","line":3615,"t":"노령연금을 받으려면 가입 기간이 최소 얼마 필요할까?"},
{"id":"T1623","line":3616,"t":"가입 기간 10년 이상이어야 노령연금을 받는다. 모자라면 반환일시금이 되거나 추납·임의계속가입으로 채운다."},
{"id":"T1624","line":3617,"t":"일찍 받는 조기노령연금을 고르면?"},
{"id":"T1625","line":3617,"t":"당겨 받는 해마다 연금액이 줄어든다"},
{"id":"T1626","line":3617,"t":"금액이 늘어난다"},
{"id":"T1627","line":3617,"t":"차이가 없다"},
{"id":"T1628","line":3618,"t":"최대 5년 당길 수 있고 1년당 6%씩 줄어든다. 반대로 늦추면 1년당 7.2%씩 늘어난다. 국민연금공단."},
{"id":"T1629","line":3619,"t":"빈 연금 기간 메우기"},
{"id":"T1630","line":3619,"t":"공단 상담원"},
{"id":"T1631","line":3620,"t":"예전에 일 쉬던 기간, 연금 가입 기간에서 비어 있을 거예요."},
{"id":"T1632","line":3621,"t":"납부예외나 경력단절로 못 낸 기간을 나중에 내는 제도는?"},
{"id":"T1633","line":3621,"t":"추후납부(추납)"},
{"id":"T1634","line":3621,"t":"반환일시금"},
{"id":"T1635","line":3621,"t":"조기노령연금"},
{"id":"T1636","line":3622,"t":"추납으로 빈 기간 보험료를 내면 가입 기간이 늘어 연금액이 커진다. 나눠 낼 수도 있다. 국민연금공단."},
{"id":"T1637","line":3623,"t":"60세가 됐는데 가입 기간이 10년이 안 되면?"},
{"id":"T1638","line":3623,"t":"임의계속가입으로 더 낼 수 있다"},
{"id":"T1639","line":3623,"t":"연금을 바로 받는다"},
{"id":"T1640","line":3623,"t":"아무 방법이 없다"},
{"id":"T1641","line":3624,"t":"60세 이후에도 신청하면 65세 전까지 계속 가입해 10년을 채울 수 있다. 국민연금공단."},
{"id":"T1642","line":3625,"t":"내 예상 연금액을 확인하는 곳은?"},
{"id":"T1643","line":3625,"t":"국민연금공단 누리집이나 내 곁에 국민연금 앱"},
{"id":"T1644","line":3625,"t":"은행 ATM"},
{"id":"T1645","line":3625,"t":"건강보험 고지서"},
{"id":"T1646","line":3626,"t":"공단 앱과 누리집에서 가입 내역과 예상 연금을 본다. 퇴직·개인연금까지는 금융감독원 통합연금포털에서 함께 본다."},
{"id":"T1647","line":3627,"t":"부모님 장기요양 등급"},
{"id":"T1648","line":3627,"t":"공단 상담원"},
{"id":"T1649","line":3628,"t":"부모님 혼자 지내시기 힘들어지셨다고요? 장기요양부터 신청해 봐요."},
{"id":"T1650","line":3629,"t":"노인장기요양보험 신청은 어디에 할까?"},
{"id":"T1651","line":3629,"t":"국민건강보험공단"},
{"id":"T1652","line":3629,"t":"국민연금공단"},
{"id":"T1653","line":3629,"t":"주민센터 전입 창구"},
{"id":"T1654","line":3630,"t":"국민건강보험공단에 신청하면 방문 조사와 의사소견서를 거쳐 등급이 나온다. 노인장기요양보험 누리집."},
{"id":"T1655","line":3631,"t":"신청할 수 있는 사람은?"},
{"id":"T1656","line":3631,"t":"65세 이상이거나, 65세 미만이라도 치매 등 노인성 질병이 있는 사람"},
{"id":"T1657","line":3631,"t":"70세 이상만"},
{"id":"T1658","line":3631,"t":"소득이 없는 사람만"},
{"id":"T1659","line":3632,"t":"65세 이상 또는 노인성 질병이 있는 65세 미만이 대상이다. 6개월 이상 혼자 일상생활이 어려운지를 본다."},
{"id":"T1660","line":3633,"t":"집에서 지내시며 받는 서비스는?"},
{"id":"T1661","line":3633,"t":"방문요양·주야간보호 같은 재가급여"},
{"id":"T1662","line":3633,"t":"요양원 입소만 가능"},
{"id":"T1663","line":3633,"t":"서비스 없음"},
{"id":"T1664","line":3634,"t":"재가급여(방문요양, 방문목욕, 주야간보호 등)와 시설급여(요양원)가 있다. 본인부담률이 서로 다르다. 국민건강보험공단."},
{"id":"T1665","line":3635,"t":"부모님 돌볼 때 쓰는 휴가"},
{"id":"T1666","line":3635,"t":"노무 상담원"},
{"id":"T1667","line":3636,"t":"아버님 수술하시는데 연차가 모자라다고요? 쓸 수 있는 게 더 있어요."},
{"id":"T1668","line":3637,"t":"가족 간병을 위해 길게 쉴 수 있는 가족돌봄휴직은 1년에 최대?"},
{"id":"T1669","line":3638,"t":"가족돌봄휴직은 연간 최대 90일이고 나눠 쓸 수 있다. 남녀고용평등법·고용노동부."},
{"id":"T1670","line":3639,"t":"하루 단위로 쓰는 가족돌봄휴가는 1년에 최대?"},
{"id":"T1671","line":3640,"t":"가족돌봄휴가는 연간 최대 10일이며, 휴직 90일 안에 포함된다. 고용노동부."},
{"id":"T1672","line":3641,"t":"회사가 가족돌봄휴직 신청을 거부하면?"},
{"id":"T1673","line":3641,"t":"대체인력을 못 구하는 등 법에서 정한 경우가 아니면 거부할 수 없다"},
{"id":"T1674","line":3641,"t":"회사 마음이다"},
{"id":"T1675","line":3641,"t":"연차를 다 쓴 뒤에만 신청할 수 있다"},
{"id":"T1676","line":3642,"t":"법에서 정한 예외가 아니면 허용해야 한다. 거부되면 고용노동부에 상담·신고할 수 있다."},
{"id":"T1677","line":3643,"t":"부모님도 연말정산에"},
{"id":"T1678","line":3644,"t":"부모님 모시고 산다면서요? 연말정산에 넣었어요?"},
{"id":"T1679","line":3645,"t":"부모님을 기본공제 대상으로 넣으려면 나이 요건은?"},
{"id":"T1680","line":3645,"t":"60세 이상"},
{"id":"T1681","line":3645,"t":"50세 이상"},
{"id":"T1682","line":3645,"t":"70세 이상"},
{"id":"T1683","line":3646,"t":"직계존속은 60세 이상이고 연간 소득금액이 100만원 이하(근로소득만 있으면 총급여 500만원 이하)여야 한다. 국세청."},
{"id":"T1684","line":3647,"t":"형제가 둘 다 부모님을 공제받으려 하면?"},
{"id":"T1685","line":3647,"t":"한 사람만 받을 수 있다"},
{"id":"T1686","line":3647,"t":"둘 다 받는다"},
{"id":"T1687","line":3647,"t":"반씩 나눈다"},
{"id":"T1688","line":3648,"t":"같은 사람을 두 명이 동시에 공제받을 수 없다. 중복이면 나중에 가산세가 붙을 수 있으니 미리 정한다."},
{"id":"T1689","line":3649,"t":"부모님이 소득 요건을 넘어도 내가 낸 부모님 병원비는?"},
{"id":"T1690","line":3649,"t":"의료비 세액공제를 받을 수 있다"},
{"id":"T1691","line":3649,"t":"전혀 안 된다"},
{"id":"T1692","line":3649,"t":"부모님만 받을 수 있다"},
{"id":"T1693","line":3650,"t":"의료비 공제는 부양가족의 나이·소득 요건을 따지지 않는다. 내가 실제로 낸 돈이어야 한다. 국세청 연말정산 안내."},
{"id":"T1694","line":3651,"t":"40살부터 받는 암검진"},
{"id":"T1695","line":3651,"t":"공단 상담원"},
{"id":"T1696","line":3652,"t":"40살 됐죠? 국가암검진 항목이 늘어나요."},
{"id":"T1697","line":3653,"t":"위암 검진은 몇 살부터, 얼마마다?"},
{"id":"T1698","line":3653,"t":"40세 이상, 2년마다"},
{"id":"T1699","line":3653,"t":"20세 이상, 매년"},
{"id":"T1700","line":3653,"t":"60세 이상, 5년마다"},
{"id":"T1701","line":3654,"t":"위암 검진은 40세 이상 2년마다 받는다. 국민건강보험공단 국가암검진 안내."},
{"id":"T1702","line":3655,"t":"40세 이상 여성에게 2년마다 있는 검진은?"},
{"id":"T1703","line":3655,"t":"유방암 검진"},
{"id":"T1704","line":3655,"t":"대장내시경"},
{"id":"T1705","line":3655,"t":"폐 CT"},
{"id":"T1706","line":3656,"t":"유방암 검진은 40세 이상 여성이 2년마다 받는다. 간암은 40세 이상 고위험군이 6개월마다 받는다."},
{"id":"T1707","line":3657,"t":"암검진 비용은?"},
{"id":"T1708","line":3657,"t":"대부분 공단 부담이고 본인부담이 적거나 없다"},
{"id":"T1709","line":3657,"t":"전액 내 돈"},
{"id":"T1710","line":3657,"t":"회사가 모두 낸다"},
{"id":"T1711","line":3658,"t":"국가암검진은 공단이 대부분 부담한다. 대상 여부와 본인부담은 공단 누리집에서 확인한다."},
{"id":"T1712","line":3659,"t":"재건축, 순서부터"},
{"id":"T1713","line":3659,"t":"공인중개사"},
{"id":"T1714","line":3660,"t":"우리 아파트 재건축한다고 현수막 붙었어요. 언제 새집 되냐고요?"},
{"id":"T1715","line":3661,"t":"재건축이 시작되면 가장 먼저 거치는 단계는?"},
{"id":"T1716","line":3661,"t":"안전진단(재건축진단)"},
{"id":"T1717","line":3661,"t":"관리처분인가"},
{"id":"T1718","line":3662,"t":"진단 → 정비구역 지정 → 조합 설립 → 사업시행인가 → 관리처분인가 → 이주·철거 → 착공 순이다. 현수막이 붙었다고 곧 짓는 것이 아니다. 국토교통부."},
{"id":"T1719","line":3663,"t":"조합원이 새 아파트를 받을 때 따로 낼 수 있는 돈은?"},
{"id":"T1720","line":3663,"t":"취득세 면제분"},
{"id":"T1721","line":3664,"t":"새 집 가치와 내 기존 자산 평가액의 차이만큼 분담금을 낸다. 관리처분계획에서 정해진다."},
{"id":"T1722","line":3665,"t":"재건축으로 오른 이익 일부를 환수하는 제도는?"},
{"id":"T1723","line":3665,"t":"재건축초과이익환수제"},
{"id":"T1724","line":3665,"t":"청약 가점제"},
{"id":"T1725","line":3665,"t":"전월세 신고제"},
{"id":"T1726","line":3666,"t":"정해진 기준을 넘는 이익에 부담금을 매긴다. 기준은 법 개정이 잦아 국토교통부 공지를 확인한다."},
{"id":"T1727","line":3667,"t":"집 팔 때 세금, 1세대 1주택"},
{"id":"T1728","line":3667,"t":"세무서 직원"},
{"id":"T1729","line":3668,"t":"이사 가려고 집 내놨다고요? 양도세 계산은 해 봤어요?"},
{"id":"T1730","line":3669,"t":"1세대 1주택 양도세 비과세의 기본 보유 요건은?"},
{"id":"T1731","line":3669,"t":"2년 이상 보유"},
{"id":"T1732","line":3669,"t":"6개월 보유"},
{"id":"T1733","line":3669,"t":"10년 보유"},
{"id":"T1734","line":3670,"t":"2년 이상 보유해야 한다. 조정대상지역에서 취득했다면 2년 거주 요건도 있다. 국세청."},
{"id":"T1735","line":3671,"t":"비과세 요건을 채워도 세금이 생기는 경우는?"},
{"id":"T1736","line":3671,"t":"양도가액이 고가주택 기준(12억원)을 넘는 부분"},
{"id":"T1737","line":3671,"t":"집이 오래된 경우"},
{"id":"T1738","line":3671,"t":"대출이 있는 경우"},
{"id":"T1739","line":3672,"t":"실거래가 12억원을 넘는 부분은 과세된다. 국세청 양도소득세 안내."},
{"id":"T1740","line":3673,"t":"양도세 예정신고 기한은?"},
{"id":"T1741","line":3673,"t":"양도일이 속한 달 말일부터 2개월 안"},
{"id":"T1742","line":3673,"t":"다음 해 12월"},
{"id":"T1743","line":3673,"t":"신고 없음"},
{"id":"T1744","line":3674,"t":"비과세가 아니면 예정신고를 해야 한다. 이사로 잠시 두 채가 되면 일시적 2주택 특례가 있으니 기한을 국세청 홈택스에서 확인한다."},
{"id":"T1745","line":3675,"t":"재산세와 종부세 고지서"},
{"id":"T1746","line":3675,"t":"주민센터 직원"},
{"id":"T1747","line":3676,"t":"7월에 재산세 고지서 오죠? 9월에 또 와요."},
{"id":"T1748","line":3677,"t":"재산세를 누가 낼지 정하는 기준일은?"},
{"id":"T1749","line":3677,"t":"매년 6월 1일 소유자"},
{"id":"T1750","line":3677,"t":"1월 1일 소유자"},
{"id":"T1751","line":3677,"t":"고지서 받는 날 소유자"},
{"id":"T1752","line":3678,"t":"6월 1일 현재 소유자가 그해 재산세를 낸다. 잔금일이 6월 1일 전후인지에 따라 사는 사람·파는 사람이 갈린다. 행정안전부·위택스."},
{"id":"T1753","line":3679,"t":"주택 재산세는 보통 어떻게 나눠 낼까?"},
{"id":"T1754","line":3679,"t":"7월과 9월에 반씩"},
{"id":"T1755","line":3679,"t":"12월에 한 번"},
{"id":"T1756","line":3680,"t":"주택분은 세액을 7월과 9월에 절반씩 나눠 고지하는 경우가 많다(금액이 적으면 7월에 한 번). 위택스."},
{"id":"T1757","line":3681,"t":"종합부동산세 납부 시기는?"},
{"id":"T1758","line":3682,"t":"종부세는 공시가격 합계가 기준을 넘는 사람에게 12월에 고지된다. 국세청 홈택스."},
{"id":"T1759","line":3683,"t":"\"엄마 나 폰 깨졌어\""},
{"id":"T1760","line":3683,"t":"은행 창구 직원"},
{"id":"T1761","line":3684,"t":"부모님 폰으로 자식 사칭 문자 오는 거 알죠? 이제 우리가 지켜 드려야 해요."},
{"id":"T1762","line":3685,"t":"가족이라며 문자로 송금이나 앱 설치를 부탁하면?"},
{"id":"T1763","line":3685,"t":"보내기 전에 꼭 원래 번호로 전화해 확인한다"},
{"id":"T1764","line":3685,"t":"급하니 바로 보낸다"},
{"id":"T1765","line":3685,"t":"문자로만 확인한다"},
{"id":"T1766","line":3686,"t":"메신저피싱은 가족·지인을 사칭해 원격제어 앱을 깔게 한다. 직접 통화로 확인한다. 금융감독원."},
{"id":"T1767","line":3687,"t":"이미 송금했다면 가장 먼저 할 일은?"},
{"id":"T1768","line":3687,"t":"112나 송금한 은행에 바로 지급정지 요청"},
{"id":"T1769","line":3687,"t":"다음 날 은행 방문"},
{"id":"T1770","line":3687,"t":"상대에게 돌려 달라고 문자"},
{"id":"T1771","line":3688,"t":"빨리 지급정지해야 돈을 묶을 수 있다. 112(경찰) 또는 금융회사 콜센터에 바로 신고한다. 금융감독원 파인."},
{"id":"T1772","line":3689,"t":"내 명의로 몰래 휴대폰이 개통됐는지 확인하는 서비스는?"},
{"id":"T1773","line":3689,"t":"명의도용방지서비스(엠세이퍼)"},
{"id":"T1774","line":3689,"t":"내보험찾아줌"},
{"id":"T1775","line":3690,"t":"한국정보통신진흥협회의 엠세이퍼에서 내 명의 개통 내역을 조회하고 신규 개통을 막을 수 있다."},
{"id":"T1776","line":3691,"t":"40대 이직과 재취업"},
{"id":"T1777","line":3691,"t":"고용센터 상담원"},
{"id":"T1778","line":3692,"t":"회사 사정이 안 좋다는 말이 돌아요? 미리 준비해 두면 덜 불안해요."},
{"id":"T1779","line":3693,"t":"40세 이상 재직자·구직자의 전직과 재취업을 돕는 곳은?"},
{"id":"T1780","line":3693,"t":"중장년내일센터"},
{"id":"T1781","line":3693,"t":"청년센터"},
{"id":"T1782","line":3693,"t":"대학 취업지원실"},
{"id":"T1783","line":3694,"t":"고용노동부 중장년내일센터에서 생애경력설계와 재취업 상담을 받는다. 가까운 센터는 고용24에서 찾는다."},
{"id":"T1784","line":3695,"t":"실업급여를 받는 기간(소정급여일수)을 정할 때 함께 보는 것은?"},
{"id":"T1785","line":3695,"t":"나이와 고용보험 가입 기간"},
{"id":"T1786","line":3695,"t":"회사 크기"},
{"id":"T1787","line":3696,"t":"이직 당시 나이와 가입 기간에 따라 달라지고, 50세 이상은 같은 가입 기간이어도 더 길다. 고용노동부."},
{"id":"T1788","line":3697,"t":"재직 중에 미리 할 수 있는 준비는?"},
{"id":"T1789","line":3697,"t":"내일배움카드로 새 기술 배우기"},
{"id":"T1790","line":3697,"t":"퇴사 후에만 준비할 수 있다"},
{"id":"T1791","line":3697,"t":"아무것도 없다"},
{"id":"T1792","line":3698,"t":"재직자도 국민내일배움카드로 훈련을 받을 수 있다. 고용24."},
{"id":"T1793","line":3699,"t":"건강기능식품 고르는 법"},
{"id":"T1794","line":3700,"t":"요즘 영양제 몇 개 먹어? 광고 보고 산 거 아니지?"},
{"id":"T1795","line":3701,"t":"식약처가 기능성을 인정한 제품을 알아보는 표시는?"},
{"id":"T1796","line":3701,"t":"\"건강기능식품\" 문구와 인증 도안"},
{"id":"T1797","line":3701,"t":"\"건강식품\"이라는 말"},
{"id":"T1798","line":3701,"t":"\"천연\"이라는 말"},
{"id":"T1799","line":3702,"t":"건강기능식품은 식품의약품안전처가 기능성을 인정한 제품만 표시할 수 있다. 일반 \"건강식품\"과 다르다."},
{"id":"T1800","line":3703,"t":"\"이것만 먹으면 병이 낫는다\"는 광고는?"},
{"id":"T1801","line":3703,"t":"질병 치료 효능 표방은 허위·과대광고다"},
{"id":"T1802","line":3703,"t":"믿을 만하다"},
{"id":"T1803","line":3703,"t":"의사가 추천한 것이다"},
{"id":"T1804","line":3704,"t":"식품은 질병 예방·치료 효능을 광고할 수 없다. 식품안전나라에서 신고할 수 있다. 식품의약품안전처."},
{"id":"T1805","line":3705,"t":"영양제를 여러 개 먹을 때 조심할 것은?"},
{"id":"T1806","line":3705,"t":"같은 성분이 겹쳐 하루 섭취량을 넘는지"},
{"id":"T1807","line":3705,"t":"포장 색"},
{"id":"T1808","line":3706,"t":"비타민·미네랄은 겹치면 과다 섭취가 된다. 성분표의 일일 섭취량을 더해 본다. 식품의약품안전처."},
{"id":"T1809","line":3709,"t":"내 연금 세 층 한 번에 보기"},
{"id":"T1810","line":3709,"t":"3년차 선배"},
{"id":"T1811","line":3710,"t":"선배님, 은퇴하면 한 달에 얼마 들어오는지 아세요?"},
{"id":"T1812","line":3711,"t":"국민연금·퇴직연금·개인연금을 한 번에 조회하는 곳은?"},
{"id":"T1813","line":3711,"t":"금융감독원 통합연금포털"},
{"id":"T1814","line":3711,"t":"국세청 홈택스"},
{"id":"T1815","line":3711,"t":"정부24"},
{"id":"T1816","line":3712,"t":"통합연금포털(100lifeplan.fss.or.kr)에서 가입한 연금과 예상 수령액을 모아 본다."},
{"id":"T1817","line":3713,"t":"연금저축·IRP를 연금으로 받으려면 기본 조건은?"},
{"id":"T1818","line":3713,"t":"55세 이후, 가입 5년 이상"},
{"id":"T1819","line":3713,"t":"60세 이후, 가입 1년 이상"},
{"id":"T1820","line":3713,"t":"나이 상관없이"},
{"id":"T1821","line":3714,"t":"55세 이후이고 가입 5년이 지나야 연금 수령을 시작할 수 있다. 금융감독원."},
{"id":"T1822","line":3715,"t":"정년 퇴직(60세)과 국민연금 수령(65세) 사이 빈 기간을 준비하는 방법은?"},
{"id":"T1823","line":3715,"t":"퇴직·개인연금 수령 시기를 이 구간에 맞춰 둔다"},
{"id":"T1824","line":3715,"t":"신용대출로 버틴다"},
{"id":"T1825","line":3715,"t":"준비할 필요 없다"},
{"id":"T1826","line":3716,"t":"이 소득 공백을 흔히 크레바스라고 부른다. 퇴직연금·연금저축을 먼저 받고 국민연금을 뒤에 받도록 짜는 방법이 있다. 통합연금포털."},
{"id":"T1827","line":3717,"t":"집으로 받는 연금, 주택연금"},
{"id":"T1828","line":3717,"t":"은행 창구 직원"},
{"id":"T1829","line":3718,"t":"집 한 채가 전부라면, 집에 살면서 연금을 받는 방법이 있어요."},
{"id":"T1830","line":3719,"t":"주택연금을 운영하는 곳은?"},
{"id":"T1831","line":3719,"t":"한국주택금융공사"},
{"id":"T1832","line":3719,"t":"국민연금공단"},
{"id":"T1833","line":3719,"t":"국민건강보험공단"},
{"id":"T1834","line":3720,"t":"한국주택금융공사가 보증하고 은행에서 받는다. 집에 계속 살면서 매달 연금을 받는다."},
{"id":"T1835","line":3721,"t":"가입 나이 조건은?"},
{"id":"T1836","line":3721,"t":"부부 중 한 명이 만 55세 이상"},
{"id":"T1837","line":3721,"t":"둘 다 70세 이상"},
{"id":"T1838","line":3721,"t":"나이 제한 없음"},
{"id":"T1839","line":3722,"t":"부부 중 한 명이 만 55세 이상이면 된다. 주택 가격 기준도 있으니 한국주택금융공사에서 확인한다."},
{"id":"T1840","line":3723,"t":"나중에 집값보다 받은 연금이 더 많아지면?"},
{"id":"T1841","line":3723,"t":"넘는 부분을 상속인에게 청구하지 않는다"},
{"id":"T1842","line":3723,"t":"자녀가 다 갚아야 한다"},
{"id":"T1843","line":3723,"t":"연금이 끊긴다"},
{"id":"T1844","line":3724,"t":"받은 돈이 집값보다 많아도 더 청구하지 않고, 집값이 남으면 상속인에게 돌아간다. 한국주택금융공사."},
{"id":"T1845","line":3725,"t":"상속, 빚도 물려받는다"},
{"id":"T1846","line":3725,"t":"주민센터 직원"},
{"id":"T1847","line":3726,"t":"부모님이 돌아가시면 재산뿐 아니라 빚도 같이 넘어와요."},
{"id":"T1848","line":3727,"t":"돌아가신 분의 재산과 빚을 한 번에 조회하는 서비스는?"},
{"id":"T1849","line":3727,"t":"안심상속 원스톱 서비스"},
{"id":"T1850","line":3727,"t":"행복출산 원스톱 서비스"},
{"id":"T1851","line":3727,"t":"내보험찾아줌"},
{"id":"T1852","line":3728,"t":"사망신고 때 주민센터나 정부24에서 함께 신청하면 금융·토지·세금 등을 한 번에 조회한다. 정부24."},
{"id":"T1853","line":3729,"t":"빚이 더 많을 때 상속포기나 한정승인을 하는 기한은?"},
{"id":"T1854","line":3729,"t":"상속이 시작된 것을 안 날부터 3개월 안"},
{"id":"T1855","line":3729,"t":"1년 안"},
{"id":"T1856","line":3729,"t":"기한 없음"},
{"id":"T1857","line":3730,"t":"민법상 3개월 안에 가정법원에 신고해야 한다. 지나면 빚까지 그대로 물려받는다. 찾기쉬운 생활법령정보."},
{"id":"T1858","line":3731,"t":"상속세 신고 기한은?"},
{"id":"T1859","line":3731,"t":"상속개시일이 속한 달 말일부터 6개월 안"},
{"id":"T1860","line":3731,"t":"다음 해 5월"},
{"id":"T1861","line":3731,"t":"기한 없음"},
{"id":"T1862","line":3732,"t":"국내 거주자 기준 6개월 안에 신고한다. 낼 세금이 없어 보여도 국세청은 신고 여부를 확인한다."},
{"id":"T1863","line":3733,"t":"부모님 집을 물려받으면"},
{"id":"T1864","line":3733,"t":"공인중개사"},
{"id":"T1865","line":3734,"t":"나중에 부모님 집을 물려받으면 내 집까지 두 채가 돼요. 미리 알아 둬요."},
{"id":"T1866","line":3735,"t":"상속받은 집의 소유권을 내 이름으로 옮기는 절차는?"},
{"id":"T1867","line":3735,"t":"상속 등기"},
{"id":"T1868","line":3735,"t":"전입신고"},
{"id":"T1869","line":3735,"t":"확정일자"},
{"id":"T1870","line":3736,"t":"등기소에서 상속을 원인으로 소유권이전등기를 한다. 대법원 인터넷등기소에서 안내를 본다."},
{"id":"T1871","line":3737,"t":"상속으로 받은 집의 취득세 신고 기한은?"},
{"id":"T1872","line":3737,"t":"상속개시일이 속한 달 말일부터 6개월 안"},
{"id":"T1873","line":3737,"t":"60일 안"},
{"id":"T1874","line":3737,"t":"기한 없음"},
{"id":"T1875","line":3738,"t":"상속 취득세는 6개월 안에 신고·납부한다(해외 거주 등은 다름). 위택스."},
{"id":"T1876","line":3739,"t":"내 집 한 채가 있는데 집을 상속받으면 양도세에서는?"},
{"id":"T1877","line":3739,"t":"상속주택 특례 요건을 따져 봐야 한다"},
{"id":"T1878","line":3739,"t":"무조건 다주택 중과"},
{"id":"T1879","line":3739,"t":"세금과 상관없다"},
{"id":"T1880","line":3740,"t":"요건에 맞으면 원래 내 집을 팔 때 1세대 1주택처럼 볼 수 있는 특례가 있다. 요건이 까다로워 국세청 상담을 받는다."},
{"id":"T1881","line":3741,"t":"50대 검진, 대장암"},
{"id":"T1882","line":3741,"t":"공단 상담원"},
{"id":"T1883","line":3742,"t":"50살 넘으면 대장암 검진을 매년 받아요. 안 받으면 아까워요."},
{"id":"T1884","line":3743,"t":"국가 대장암 검진은 어떻게 시작할까?"},
{"id":"T1885","line":3743,"t":"50세 이상 매년 분변잠혈검사"},
{"id":"T1886","line":3743,"t":"40세 이상 5년마다 내시경"},
{"id":"T1887","line":3743,"t":"60세부터 CT"},
{"id":"T1888","line":3744,"t":"50세 이상은 매년 분변잠혈검사를 받고, 이상이 있으면 대장내시경으로 이어진다. 국민건강보험공단."},
{"id":"T1889","line":3745,"t":"오래 담배를 피운 54~74세가 받을 수 있는 검진은?"},
{"id":"T1890","line":3745,"t":"폐암 검진(저선량 CT)"},
{"id":"T1891","line":3745,"t":"치과 검진"},
{"id":"T1892","line":3745,"t":"시력 검사"},
{"id":"T1893","line":3746,"t":"흡연력이 기준 이상인 고위험군은 2년마다 폐암 검진을 받는다. 기준은 공단에서 확인한다."},
{"id":"T1894","line":3747,"t":"검진에서 이상 소견이 나오면?"},
{"id":"T1895","line":3747,"t":"미루지 말고 정밀검사를 받는다"},
{"id":"T1896","line":3747,"t":"다음 검진까지 기다린다"},
{"id":"T1897","line":3747,"t":"무시해도 된다"},
{"id":"T1898","line":3748,"t":"검진은 찾는 것까지다. 확진 검사와 치료는 결과를 받은 뒤 바로 이어 가야 한다. 국립암센터·국민건강보험공단."},
{"id":"T1899","line":3749,"t":"정년과 임금피크제"},
{"id":"T1900","line":3750,"t":"내년부터 임금피크라던데, 퇴직금 줄어드는 거 아니에요?"},
{"id":"T1901","line":3751,"t":"법으로 정한 정년은?"},
{"id":"T1902","line":3751,"t":"60세 이상"},
{"id":"T1903","line":3751,"t":"65세 의무"},
{"id":"T1904","line":3752,"t":"고령자고용법상 사업주는 정년을 60세 이상으로 정해야 한다. 고용노동부."},
{"id":"T1905","line":3753,"t":"임금피크제로 월급이 줄어들 때 퇴직금 중간정산은?"},
{"id":"T1906","line":3753,"t":"법에서 정한 중간정산 사유에 해당한다"},
{"id":"T1907","line":3753,"t":"절대 못 한다"},
{"id":"T1908","line":3753,"t":"회사가 거부할 수 없는 의무다"},
{"id":"T1909","line":3754,"t":"임금피크제로 임금이 줄면 근로자퇴직급여 보장법 시행령의 중간정산 사유에 해당한다. 회사와 협의한다."},
{"id":"T1910","line":3755,"t":"DB형 퇴직연금인데 곧 임금이 줄어든다면 따져 볼 것은?"},
{"id":"T1911","line":3755,"t":"임금이 줄기 전에 DC형 전환이 가능한지"},
{"id":"T1912","line":3755,"t":"아무것도 없다"},
{"id":"T1913","line":3755,"t":"연차를 모두 쓰기"},
{"id":"T1914","line":3756,"t":"DB형은 마지막 평균임금 기준이라 임금이 줄면 불리하다. 회사 규약에 DC 전환이 있는지 인사팀에 묻는다. 고용노동부."},
{"id":"T1915","line":3757,"t":"상조 가입 전에"},
{"id":"T1916","line":3757,"t":"주민센터 직원"},
{"id":"T1917","line":3758,"t":"상조 하나 들어 두라는 전화가 자꾸 와요. 어떻게 봐야 해요?"},
{"id":"T1918","line":3759,"t":"상조회사는 받은 돈(선수금)을 어떻게 보호해야 할까?"},
{"id":"T1919","line":3759,"t":"절반을 은행 예치나 공제조합으로 보전해야 한다"},
{"id":"T1920","line":3759,"t":"회사 마음대로 쓴다"},
{"id":"T1921","line":3759,"t":"전액 주식에 투자한다"},
{"id":"T1922","line":3760,"t":"할부거래법상 상조회사는 선수금의 50%를 보전해야 한다. 공정거래위원회."},
{"id":"T1923","line":3761,"t":"부모님이 어디 상조에 가입했는지 모를 때 찾는 곳은?"},
{"id":"T1924","line":3761,"t":"내상조 찾아줘"},
{"id":"T1925","line":3761,"t":"엠세이퍼"},
{"id":"T1926","line":3762,"t":"공정거래위원회가 운영하는 내상조 찾아줘에서 가입 내역과 선수금 보전 여부를 조회한다."},
{"id":"T1927","line":3763,"t":"중간에 해약하면?"},
{"id":"T1928","line":3763,"t":"약관과 고시 기준에 따라 해약환급금을 받는다"},
{"id":"T1929","line":3763,"t":"한 푼도 못 받는다"},
{"id":"T1930","line":3763,"t":"낸 돈 두 배를 받는다"},
