[{"id":"T7293","line":14756,"t":"광고와 다른 차가 나왔다. 그 자리에서 접었다."},
{"id":"T7294","line":14757,"t":"차량번호로 자동차365에서 이력을 조회하고 성능·상태점검기록부를 받는다"},
{"id":"T7295","line":14757,"t":"조회가 안 되는 번호였다. 허위매물을 미리 걸러냈다."},
{"id":"T7296","line":14758,"t":"시세보다 확 싼 차에 미리 돈부터 받는 건 허위매물의 전형이네. 계약 전에 성능·상태점검기록부를 받고 자동차365에서 차의 이력을 조회하게."},
{"id":"T7297","line":14759,"t":"모르는 번호"},
{"id":"T7298","line":14759,"t":"\"엄마야. 폰이 고장 나서 친구 폰으로 문자해. 급하게 결제할 게 있는데 이 계좌로 먼저 보내 줄래?\""},
{"id":"T7299","line":14760,"t":"급하다니 바로 송금한다"},
{"id":"T7300","line":14760,"t":"엄마는 멀쩡했다. 돈은 이미 빠져나간 뒤였다."},
{"id":"T7301","line":14761,"t":"원래 알던 엄마 번호로 전화해 확인한다"},
{"id":"T7302","line":14761,"t":"엄마가 바로 받았다. 사칭 문자였다."},
{"id":"T7303","line":14762,"t":"확인 뒤 118에 신고하고 문자를 지운다"},
{"id":"T7304","line":14762,"t":"신고가 접수됐고 같은 번호가 차단됐다."},
{"id":"T7305","line":14763,"t":"가족이라며 폰이 고장 났다는 문자는 보이스피싱 수법이네. 원래 알던 번호로 전화부터 하게. 이미 보냈다면 곧바로 112나 은행에 지급정지를 부탁하고."},
{"id":"T7306","line":14764,"t":"은행 앱"},
{"id":"T7307","line":14764,"t":"\"주택청약, 아직 없으세요? 지금 만들어 두면 가입 기간이 쌓여요.\""},
{"id":"T7308","line":14765,"t":"어차피 당첨 안 된다며 안 만든다"},
{"id":"T7309","line":14765,"t":"나중에 청약 자격을 따져 보니 가입 기간이 모자랐다."},
{"id":"T7310","line":14766,"t":"주택청약종합저축을 만들고 매달 자동이체를 건다"},
{"id":"T7311","line":14766,"t":"잊고 지내는 사이 가입 기간이 쌓이고 있다."},
{"id":"T7312","line":14767,"t":"청년 주택드림 청약통장 가입 자격부터 확인한다"},
{"id":"T7313","line":14767,"t":"자격이 되는지 알아본 뒤 더 유리한 쪽으로 가입했다."},
{"id":"T7314","line":14768,"t":"청약통장은 일찍 만들수록 가입 기간이 쌓이네. 월 납입 인정 한도는 25만원이고, 청년 주택드림 청약통장 같은 청년 전용 상품도 있으니 자격을 알아보게."},
{"id":"T7315","line":14769,"t":"건강보험 우편물"},
{"id":"T7316","line":14769,"t":"\"국가건강검진 대상자입니다. 올해 안에 검진을 받으세요.\""},
{"id":"T7317","line":14770,"t":"바빠서 미룬다"},
{"id":"T7318","line":14770,"t":"연말에 예약이 몰려 올해를 넘기고 개인 검진비를 냈다."},
{"id":"T7319","line":14771,"t":"검진기관을 예약하고 받는다"},
{"id":"T7320","line":14771,"t":"수치가 조금 나빴지만 일찍 알았다. 생활 습관을 손봤다."},
{"id":"T7321","line":14772,"t":"검진 대상이면 국민건강보험공단에서 안내가 오네. 대상 여부와 검진기관은 공단에서 확인할 수 있고, 직장인이라면 회사 인사팀에도 물어보게."},
{"id":"T7322","line":14773,"t":"중고차 딜러"},
{"id":"T7323","line":14773,"t":"\"보험은 제일 싼 걸로 넣어 드릴게요. 책임보험만 들어도 되죠?\""},
{"id":"T7324","line":14775,"t":"책임보험만 든다"},
{"id":"T7325","line":14775,"t":"접촉사고가 났다. 내 차 수리비에 상대 쪽 피해 일부까지, 전부 내 돈으로 물었다."},
{"id":"T7326","line":14776,"t":"보장 항목을 하나씩 묻고 대인Ⅱ와 대물 한도를 넉넉히 넣는다"},
{"id":"T7327","line":14776,"t":"보험료는 조금 올랐지만 사고 때 마음이 편했다."},
{"id":"T7328","line":14777,"t":"여러 보험사의 견적을 비교하고 보장을 맞춘다"},
{"id":"T7329","line":14777,"t":"같은 보장으로 가장 싼 곳을 골랐다."},
{"id":"T7330","line":14778,"t":"책임보험은 법에서 정한 최소 보장이라 큰 사고를 감당하기 어렵네. 대인Ⅱ와 대물 한도를 넉넉히 넣고, 견적은 여러 곳에서 비교하게."},
{"id":"T7331","line":14779,"t":"이삿짐센터"},
{"id":"T7332","line":14779,"t":"이사를 마쳤다. 짐 정리하느라 정신이 없다. 전입신고는 나중에 해도 되겠지?"},
{"id":"T7333","line":14781,"t":"바쁘니 몇 주 뒤로 미룬다"},
{"id":"T7334","line":14781,"t":"과태료 고지서가 날아왔고, 그 사이 보증금은 보호받지 못했다."},
{"id":"T7335","line":14782,"t":"이사한 날 전입신고와 확정일자를 함께 받는다"},
{"id":"T7336","line":14782,"t":"대항력과 우선변제권을 하루 만에 챙겼다."},
{"id":"T7337","line":14783,"t":"전입신고는 이사한 날부터 14일 안에 해야 하네. 늦으면 과태료가 붙고 보증금을 지키는 힘도 늦게 생겨. 정부24나 주민센터에서 하고 확정일자도 같이 받게."},
{"id":"T7338","line":14784,"t":"아파트 게시판"},
{"id":"T7339","line":14784,"t":"\"종량제 봉투 없이 배출된 쓰레기가 적발되었습니다. 과태료가 부과될 수 있습니다.\""},
{"id":"T7340","line":14786,"t":"밤에 몰래 다른 건물 앞에 버린다"},
{"id":"T7341","line":14786,"t":"CCTV에 찍혀 과태료 고지서를 받았다."},
{"id":"T7342","line":14787,"t":"우리 동네 배출 요일과 방법을 확인해 규정대로 버린다"},
{"id":"T7343","line":14787,"t":"분리배출 안내 사진을 찍어 냉장고에 붙여 뒀다."},
{"id":"T7344","line":14788,"t":"큰 물건은 주민센터에 신고하고 스티커를 붙여 내놓는다"},
{"id":"T7345","line":14788,"t":"수수료를 내고 깔끔하게 처리했다."},
{"id":"T7346","line":14789,"t":"쓰레기 배출 방법은 지자체마다 다르니 종량제 봉투 사용이 기본이네. 규정을 어기면 과태료가 붙고, 가구 같은 큰 물건은 지자체 안내에 따라 신고하고 스티커를 붙여 내놓게."},
{"id":"T7347","line":14790,"t":"헬스장 상담실"},
{"id":"T7348","line":14790,"t":"\"1년 등록하시면 반값이에요. 오늘까지만 이 가격이에요. 아, 환불은 안 되는 조건이에요.\""},
{"id":"T7349","line":14791,"t":"서명하고 1년치를 결제한다"},
{"id":"T7350","line":14791,"t":"석 달 뒤 이사를 가서 못 다니게 됐는데 환불을 거절당했다."},
{"id":"T7351","line":14792,"t":"짧게 1~3개월만 끊는다"},
{"id":"T7352","line":14792,"t":"다니는 만큼만 냈다. 다음에 연장해도 늦지 않다."},
{"id":"T7353","line":14793,"t":"중도해지 때 정산 기준을 계약서에서 확인하고 묻는다"},
{"id":"T7354","line":14793,"t":"안 쓴 기간은 정산해 준다는 문구를 넣고 등록했다."},
{"id":"T7355","line":14794,"t":"헬스장 같은 계속거래는 내 사정으로 해지해도 안 쓴 기간의 대금을 돌려받을 수 있네. 다만 계약대금의 10% 정도는 위약금으로 뗄 수 있고. 환불 불가라는 말만 믿지 말고 안 되면 1372에 문의하게."},
{"id":"T7356","line":14795,"t":"연체 안내"},
{"id":"T7357","line":14795,"t":"\"전기요금 납부 기한이 지났습니다. 연체 가산금이 붙습니다.\""},
{"id":"T7358","line":14797,"t":"나중에 낸다"},
{"id":"T7359","line":14797,"t":"가산금이 붙었고 다른 공과금도 줄줄이 밀렸다."},
{"id":"T7360","line":14798,"t":"공과금을 자동이체로 돌리고 통장에 잔액을 남겨 둔다"},
{"id":"T7361","line":14798,"t":"그날 이후 연체 걱정이 사라졌다."},
{"id":"T7362","line":14799,"t":"자동이체로 돌리고 성실납부 실적을 신용관리에 쓴다"},
{"id":"T7363","line":14799,"t":"통신비와 공과금을 제때 낸 기록이 차곡차곡 쌓인다."},
{"id":"T7364","line":14800,"t":"공과금은 자동이체로 걸어 두면 깜빡해도 연체가 안 나네. 통신비와 공과금을 제때 낸 기록은 신용점수에 보탬이 될 수 있어."},
{"id":"T7365","line":14801,"t":"한전 알림"},
{"id":"T7366","line":14801,"t":"\"이번 달 전기 사용량이 크게 늘었습니다.\" 요 며칠 에어컨을 종일 틀어 놨다."},
{"id":"T7367","line":14802,"t":"더우니까 계속 종일 켠다"},
{"id":"T7368","line":14802,"t":"다음 달 고지서를 열어 보니 요금이 훌쩍 뛰어 있었다."},
{"id":"T7369","line":14803,"t":"선풍기와 함께 쓰고 필요한 시간에만 켠다"},
{"id":"T7370","line":14803,"t":"덥지만 참을 만했고 요금도 크게 안 늘었다."},
{"id":"T7371","line":14804,"t":"한국전력 홈페이지의 요금 계산기로 예상 요금을 미리 본다"},
{"id":"T7372","line":14804,"t":"어느 구간까지 쓸지 정해 두고 에어컨을 틀었다."},
{"id":"T7373","line":14805,"t":"주택용 전기는 쓸수록 kWh당 단가가 계단식으로 오르는 누진제네. 7~8월엔 구간이 넓어지긴 해도 에어컨을 종일 틀면 높은 구간에 걸리기 쉬우니, 요금 계산기로 미리 보게."},
{"id":"T7374","line":14806,"t":"[모바일 상품권] 명절 감사 선물이 도착했습니다. 확인: http://…"},
{"id":"T7375","line":14807,"t":"링크를 눌러 확인한다"},
{"id":"T7376","line":14807,"t":"악성 앱이 깔려 소액결제가 몇 번 나갔다. 통신사에 전화하느라 반나절을 썼다."},
{"id":"T7377","line":14808,"t":"보낸 사람에게 다른 방법으로 연락해 본다"},
{"id":"T7378","line":14808,"t":"보낸 적 없다는 답이 왔다. 스미싱이었다."},
{"id":"T7379","line":14809,"t":"문자를 지우고 118에 신고한다"},
{"id":"T7380","line":14809,"t":"신고가 접수됐다. 같은 번호의 문자가 차단됐다."},
{"id":"T7381","line":14810,"t":"명절엔 택배, 상품권, 청첩장을 흉내 낸 스미싱이 늘어나네. 출처가 확실하지 않은 링크는 열지 말고 의심 문자는 118에 신고하게."},
{"id":"T7382","line":14811,"t":"\"입사 서류는 내일까지 내 주세요. 근로계약서는 저희가 나중에 따로 드릴게요.\""},
{"id":"T7383","line":14813,"t":"일단 다니면서 기다린다"},
{"id":"T7384","line":14813,"t":"두 달 뒤 연봉과 근무시간 얘기가 서로 달랐다. 증거가 없었다."},
{"id":"T7385","line":14814,"t":"첫 출근 날 서면 근로계약서를 달라고 하고 사본을 챙긴다"},
{"id":"T7386","line":14814,"t":"서명한 계약서를 받아 사진까지 찍어 뒀다."},
{"id":"T7387","line":14815,"t":"계약서에 임금, 근로시간, 휴일, 연차가 적혔는지 하나씩 확인한다"},
{"id":"T7388","line":14815,"t":"빠진 항목을 짚어서 고쳐 받았다."},
{"id":"T7389","line":14816,"t":"근로계약을 맺을 때는 임금, 근로시간, 휴일, 연차가 적힌 서면을 줘야 하네. 못 받았다면 회사에 요구하고, 그래도 안 되면 고용노동부에 물어보게."},
{"id":"T7390","line":14817,"t":"이삿짐센터"},
{"id":"T7391","line":14817,"t":"\"견적은 전화로 말씀드린 금액이에요. 당일에 짐이 많으면 추가 비용은 좀 붙어요.\""},
{"id":"T7392","line":14819,"t":"전화 견적만 믿고 계약한다"},
{"id":"T7393","line":14819,"t":"당일에 사다리차와 거리 추가금이 붙어 금액이 두 배가 됐다."},
{"id":"T7394","line":14820,"t":"방문이나 영상 견적을 받고 총액을 계약서에 적는다"},
{"id":"T7395","line":14820,"t":"추가금 조건까지 적어 둬서 당일에 실랑이가 없었다."},
{"id":"T7396","line":14821,"t":"여러 곳을 비교하고 평일로 날짜를 잡는다"},
{"id":"T7397","line":14821,"t":"성수기를 피해 처음 견적보다 싸게 했다."},
{"id":"T7398","line":14822,"t":"이사는 전화 견적만 믿지 말고 방문이나 영상 견적을 받아 총액을 계약서에 적어 두게. 이사철에는 값이 오르니 여러 곳을 비교하게."},
{"id":"T7399","line":14859,"t":"생활 이벤트 · "},
{"id":"T7400","line":14859,"t":"어떻게 할까?"},
{"id":"T7401","line":14863,"t":"경험치 +"},
{"id":"T7402","line":14866,"t":"귀인 할배: \""},
{"id":"T7403","line":14877,"t":"사회초년생 생활 RPG, 뉴비 퀘스트"},
{"id":"T7404","line":14879,"t":"전세·월세 계약"},
{"id":"T7405","line":14879,"t":"집 보는 날부터 보증보험 가입까지"},
{"id":"T7406","line":14879,"t":"잔금·입주일"},
{"id":"T7407","line":14880,"t":"찾기쉬운 생활법령정보"},
{"id":"T7408","line":14881,"t":"집 보기 · 계약 전"},
{"id":"T7409","line":14882,"t":"실거래가로 시세를 확인했다"},
{"id":"T7410","line":14882,"t":"국토교통부 실거래가 공개시스템에서 같은 단지·동네 거래가를 본다. 전세가가 매매가에 가까울수록 깡통전세 위험이 크다."},
{"id":"T7411","line":14883,"t":"등기부등본을 떼서 소유자·압류·근저당을 봤다"},
{"id":"T7412","line":14883,"t":"갑구에서 소유자와 압류·가압류를, 을구에서 근저당 채권최고액을 본다."},
{"id":"T7413","line":14884,"t":"선순위 채권 + 내 보증금이 집값보다 적다"},
{"id":"T7414","line":14884,"t":"경매로 넘어가면 앞 순위 빚부터 가져간다. 합이 집값을 넘으면 보증금을 다 못 돌려받을 수 있다."},
{"id":"T7415","line":14885,"t":"집주인 세금 체납 여부를 확인할 방법을 챙겼다"},
{"id":"T7416","line":14885,"t":"체납 세금은 보증금보다 먼저 가져갈 수 있다. 계약 전 납세증명서를 요청하거나, 계약 뒤 입주 전까지 세무서에서 미납 국세를 열람한다."},
{"id":"T7417","line":14886,"t":"전세보증보험에 가입할 수 있는 집인지 봤다"},
{"id":"T7418","line":14886,"t":"선순위 채권이 집값의 60%를 넘거나, 보증금과 선순위 채권의 합이 주택가격의 90%를 넘으면 가입이 어렵다(다가구 등은 80%). 주택가격은 공시가격 126%나 KB시세 등 보증기관이 정한 기준이라 실제 한도는 더 낮을 수 있으니 HUG 1566-9009에 확인한다."},
{"id":"T7419","line":14887,"t":"계약 당일"},
{"id":"T7420","line":14888,"t":"집주인 신분증과 등기부 소유자가 같다"},
{"id":"T7421","line":14888,"t":"대리인이면 위임장과 인감증명서를 받는다. 소유자 아닌 사람과 계약하면 보증금을 돌려받을 상대가 사라진다."},
{"id":"T7422","line":14889,"t":"계약금은 등기부상 소유자 명의 계좌로 보냈다"},
{"id":"T7423","line":14889,"t":"다른 사람 계좌로 보내 달라고 하면 멈춘다."},
{"id":"T7424","line":14890,"t":"특약을 넣었다 (잔금 다음 날까지 근저당 금지 등)"},
{"id":"T7425","line":14890,"t":"\"잔금일 다음 날까지 저당권 등 권리 변동을 하지 않는다. 어기면 계약 해제와 손해배상\", \"보증보험 가입이 안 되면 계약 무효\" 같은 문장을 넣는다."},
{"id":"T7426","line":14891,"t":"공인중개사 등록 여부를 확인하고 확인설명서를 받았다"},
{"id":"T7427","line":14891,"t":"등록된 중개사무소인지 보고, 중개대상물 확인·설명서를 꼭 받는다."},
{"id":"T7428","line":14892,"t":"잔금 · 입주 날"},
{"id":"T7429","line":14893,"t":"잔금 전에 등기부등본을 한 번 더 뗐다"},
{"id":"T7430","line":14893,"t":"계약 뒤 잔금 전까지 근저당이 새로 잡히는 경우가 있다."},
{"id":"T7431","line":14894,"t":"전입신고를 했다 (이사 당일, 늦어도 14일 안)"},
{"id":"T7432","line":14894,"t":"전입신고와 실제 거주로 대항력이 생긴다. 대항력은 전입신고 다음 날 0시부터다."},
{"id":"T7433","line":14895,"t":"확정일자를 받았다"},
{"id":"T7434","line":14895,"t":"확정일자가 있어야 경매·공매 때 순위에 따라 보증금을 먼저 받을 수 있다. 전월세 신고를 하면 함께 부여된다."},
{"id":"T7435","line":14896,"t":"전월세 신고를 했다 (계약 후 30일 이내)"},
{"id":"T7436","line":14896,"t":"보증금 6천만원 초과 또는 월세 30만원 초과면 신고 대상이다."},
{"id":"T7437","line":14897,"t":"관리비·공과금을 정산하고 계량기 사진을 찍었다"},
{"id":"T7438","line":14897,"t":"이전 사람이 쓴 요금을 내가 내지 않게 입주 날 숫자를 남긴다."},
{"id":"T7439","line":14898,"t":"입주 후"},
{"id":"T7440","line":14899,"t":"전세보증보험에 가입했다"},
{"id":"T7441","line":14899,"t":"신규 계약은 잔금일과 전입신고일 중 늦은 날부터 계약기간의 절반이 지나기 전까지 가입할 수 있다. 전입신고와 확정일자가 먼저 있어야 한다."},
{"id":"T7442","line":14900,"t":"만료 전 연락 시기를 달력에 적었다"},
{"id":"T7443","line":14900,"t":"세입자의 갱신요구는 만료 6~2개월 전에, 집주인의 갱신거절 통지도 만료 6~2개월 전에 해야 한다. 이 기간을 놓치면 같은 조건으로 자동 갱신될 수 있다."},
{"id":"T7444","line":14901,"t":"(월세) 계약서와 이체 내역을 모아 둔다"},
{"id":"T7445","line":14901,"t":"무주택 세대주이고 총급여 8천만원 이하면 연말정산 월세 세액공제를 받을 수 있다."},
{"id":"T7446","line":14902,"t":"첫 출근"},
{"id":"T7447","line":14902,"t":"근로계약서부터 첫 월급 명세서까지"},
{"id":"T7448","line":14903,"t":"고용노동부"},
{"id":"T7449","line":14904,"t":"입사 전 · 첫날"},
{"id":"T7450","line":14905,"t":"근로계약서를 서면으로 받았다"},
{"id":"T7451","line":14905,"t":"임금·근로시간·휴일·연차가 적힌 계약서를 받아야 한다. 안 주면 회사가 처벌받는다."},
{"id":"T7452","line":14906,"t":"수습 기간과 그동안의 급여를 확인했다"},
{"id":"T7453","line":14906,"t":"1년 이상 계약한 수습 3개월까지만 최저임금의 90%를 줄 수 있다. 단순노무 직종은 깎을 수 없다."},
{"id":"T7454","line":14907,"t":"급여 계좌와 비상연락처를 냈다"},
{"id":"T7455","line":14907,"t":"첫 급여가 늦어지는 흔한 이유다."},
{"id":"T7456","line":14908,"t":"(중소기업 청년) 소득세 감면 신청서를 냈다"},
{"id":"T7457","line":14908,"t":"중소기업에 취업한 만 15~34세 청년(병역 이행 기간은 나이에서 뺀다)은 5년간 소득세 90%를 감면받을 수 있고, 연 200만원 한도가 있다. 비수도권 등으로 확대하는 세제개편안이 논의 중이라 연말에 다시 확인한다. 회사에 신청해야 적용된다."},
{"id":"T7458","line":14910,"t":"4대보험에 가입됐는지 확인했다"},
{"id":"T7459","line":14910,"t":"건강보험 자격득실 확인서나 4대사회보험 정보연계센터에서 볼 수 있다."},
{"id":"T7460","line":14911,"t":"첫 급여명세서를 받았다"},
{"id":"T7461","line":14911,"t":"회사는 임금을 줄 때 항목과 계산 방법이 적힌 명세서를 줘야 한다."},
{"id":"T7462","line":14912,"t":"연차 규정을 확인했다"},
{"id":"T7463","line":14912,"t":"입사 1년 미만은 1개월 개근마다 연차 1일이 생긴다."},
{"id":"T7464","line":14913,"t":"부양가족·주소 등 인사 정보를 정리했다"},
{"id":"T7465","line":14913,"t":"연말정산 때 다시 쓰인다."},
{"id":"T7466","line":14914,"t":"첫 석 달"},
{"id":"T7467","line":14915,"t":"수습이 끝나는 날과 급여 변화를 확인했다"},
{"id":"T7468","line":14915,"t":"수습이 끝났는데도 감액이 계속되면 바로 말한다."},
{"id":"T7469","line":14916,"t":"청년 적금·연금계좌를 알아봤다"},
{"id":"T7470","line":14916,"t":"정부 기여금이 붙는 청년 적금, 세액공제가 되는 연금계좌는 일찍 시작할수록 유리하다."},
{"id":"T7471","line":14917,"t":"신용점수 관리를 시작했다"},
{"id":"T7472","line":14917,"t":"통신비·공과금 성실납부 실적을 신용평가사에 내면 가점을 받을 수 있다."},
{"id":"T7473","line":14918,"t":"퇴사 · 실업급여"},
{"id":"T7474","line":14918,"t":"사직서부터 건강보험 정리까지"},
{"id":"T7475","line":14919,"t":"고용노동부"},
{"id":"T7476","line":14920,"t":"퇴사 전"},
{"id":"T7477","line":14921,"t":"퇴사 날짜를 정해 서면(메일)으로 알렸다"},
{"id":"T7478","line":14921,"t":"말로만 하면 날짜가 흐려진다. 회사 규정의 통보 기간도 확인한다."},
{"id":"T7479","line":14922,"t":"남은 연차를 쓰거나 수당 정산을 확인했다"},
{"id":"T7480","line":14922,"t":"쓰지 못한 연차는 퇴사할 때 수당으로 정산된다."},
{"id":"T7481","line":14923,"t":"실업급여 대상인지 확인했다"},
{"id":"T7482","line":14923,"t":"원칙적으로 비자발적 퇴사여야 하고, 이직 전 18개월 중 고용보험 가입(피보험단위)기간이 180일 이상이어야 한다."},
{"id":"T7483","line":14924,"t":"회사에 이직확인서 제출을 부탁했다"},
{"id":"T7484","line":14924,"t":"회사가 고용보험에 이직확인서를 내야 실업급여 신청이 진행된다."},
{"id":"T7485","line":14925,"t":"퇴사 후 2주"},
{"id":"T7486","line":14926,"t":"퇴직금이 14일 안에 들어왔다"},
{"id":"T7487","line":14926,"t":"1년 이상, 주 15시간 이상 일했다면 받는다. 특별한 사정이 있으면 합의로 늦출 수 있다. 55세 전이면 IRP 계좌로 받는 게 원칙이다."},
{"id":"T7488","line":14927,"t":"경력증명서와 원천징수영수증을 받았다"},
{"id":"T7489","line":14927,"t":"다음 회사 입사와 연말정산에 필요하다."},
{"id":"T7490","line":14928,"t":"실업급여를 신청했다"},
{"id":"T7491","line":14928,"t":"고용24에서 구직 등록과 온라인 교육을 마치고 고용센터에서 수급자격을 신청한다. 받을 수 있는 기간은 이직 다음 날부터 12개월이다."},
{"id":"T7492","line":14929,"t":"퇴사 후 첫 달"},
{"id":"T7493","line":14930,"t":"건강보험을 정리했다 (임의계속가입·피부양자 비교)"},
{"id":"T7494","line":14930,"t":"퇴직 전 18개월 중 직장가입자 기간이 1년 이상이면 임의계속가입으로 최대 36개월 직장 때 보험료를 유지할 수 있다. 첫 지역보험료 납부기한에서 2개월 안에 신청한다."},
{"id":"T7495","line":14931,"t":"국민연금 납부예외나 실업크레딧을 알아봤다"},
{"id":"T7496","line":14931,"t":"소득이 없으면 납부예외를 신청할 수 있고, 구직급여를 받는 동안은 실업크레딧으로 보험료 일부를 지원받는다."},
{"id":"T7497","line":14932,"t":"실업인정일마다 재취업 활동을 했다"},
{"id":"T7498","line":14932,"t":"활동 증빙이 없으면 그 차수 급여가 나오지 않는다."},
{"id":"T7499","line":14933,"t":"연말정산"},
{"id":"T7500","line":14933,"t":"12월 카드 점검부터 2월 환급까지"},
{"id":"T7501","line":14933,"t":"간소화 개통일(1월 15일)"},
{"id":"T7502","line":14935,"t":"12월까지"},
{"id":"T7503","line":14936,"t":"카드 사용액이 총급여의 25%를 넘었는지 봤다"},
{"id":"T7504","line":14936,"t":"넘은 부분부터 공제된다. 넘었다면 남은 기간은 체크카드·현금영수증(30%)으로 쓴다."},
{"id":"T7505","line":14937,"t":"연금저축·IRP 납입을 12월 31일까지 마쳤다"},
{"id":"T7506","line":14937,"t":"합쳐서 900만원까지 세액공제. 총급여 5,500만원 이하면 16.5%를 돌려받는다."},
{"id":"T7507","line":14938,"t":"부양가족 공제를 누가 받을지 가족과 정했다"},
{"id":"T7508","line":14938,"t":"한 사람을 두 명이 공제받으면 나중에 가산세와 함께 토해 낸다."},
{"id":"T7509","line":14939,"t":"1월 15일 이후"},
{"id":"T7510","line":14940,"t":"홈택스 간소화 자료를 내려받았다"},
{"id":"T7511","line":14940,"t":"국세청 연말정산 간소화 서비스는 1월 15일에 열린다."},
{"id":"T7512","line":14941,"t":"간소화에 안 잡히는 것을 챙겼다 (월세·안경 등)"},
{"id":"T7513","line":14941,"t":"월세 세액공제(무주택 세대주), 안경·렌즈 구입비(1인 50만원까지), 일부 기부금은 영수증을 따로 낸다."},
{"id":"T7514","line":14942,"t":"회사 제출 기한을 지켰다"},
{"id":"T7515","line":14942,"t":"늦으면 회사 정산에서 빠진다."},
{"id":"T7516","line":14943,"t":"2월 이후"},
{"id":"T7517","line":14944,"t":"2월 급여명세서에서 환급·추가 납부를 확인했다"},
{"id":"T7518","line":14944,"t":"결과가 이상하면 원천징수영수증을 받아 항목을 대조한다."},
{"id":"T7519","line":14945,"t":"놓친 공제는 5월 신고나 경정청구로 챙긴다"},
{"id":"T7520","line":14945,"t":"5월 종합소득세 신고 때 넣거나, 5년 안에 경정청구로 돌려받을 수 있다."},
{"id":"T7521","line":14946,"t":"(외주 소득 있음) 5월에 합산 신고한다"},
{"id":"T7522","line":14946,"t":"3.3% 떼인 사업소득은 연말정산과 별개로 5월에 합쳐 신고한다."},
{"id":"T7523","line":14947,"t":"중고거래 · 스미싱 대응"},
{"id":"T7524","line":14947,"t":"거래 전 확인부터 당했을 때 할 일까지"},
{"id":"T7525","line":14948,"t":"금융감독원 파인"},
{"id":"T7526","line":14949,"t":"거래하기 전"},
{"id":"T7527","line":14950,"t":"판매자 계좌·전화번호를 사기 조회했다"},
{"id":"T7528","line":14950,"t":"경찰청 사이버범죄 신고시스템에서 사기 신고된 번호와 계좌를 조회할 수 있다."},
{"id":"T7529","line":14951,"t":"대화와 결제는 앱 안에서만 한다"},
{"id":"T7530","line":14951,"t":"앱 밖 메신저로 옮기자며 보내는 안전결제 링크는 가짜인 경우가 많다."},
{"id":"T7531","line":14952,"t":"비싼 물건은 사람 많은 곳에서 직거래한다"},
{"id":"T7532","line":14952,"t":"물건을 확인하고 돈을 주는 게 가장 안전하다."},
{"id":"T7533","line":14953,"t":"수상한 문자를 받았을 때"},
{"id":"T7534","line":14954,"t":"링크는 누르지 않고 공식 앱·대표번호로 확인했다"},
{"id":"T7535","line":14954,"t":"택배·과태료·청첩장 문자 링크는 악성 앱 설치로 이어진다."},
{"id":"T7536","line":14955,"t":"118에 신고했다"},
{"id":"T7537","line":14955,"t":"한국인터넷진흥원이 스미싱 번호와 주소를 차단한다."},
{"id":"T7538","line":14956,"t":"\"폰 고장\" 가족 문자는 전화로 확인했다"},
{"id":"T7539","line":14956,"t":"가족·지인 사칭은 새 번호에서 급한 송금을 부탁한다."},
{"id":"T7540","line":14957,"t":"눌렀거나 돈을 보냈다면"},
{"id":"T7541","line":14958,"t":"112나 은행 콜센터에 지급정지를 요청했다"},
{"id":"T7542","line":14958,"t":"빠를수록 돌려받을 가능성이 커진다."},
{"id":"T7543","line":14959,"t":"휴대폰을 검사하고 통신사 소액결제를 막았다"},
{"id":"T7544","line":14959,"t":"악성 앱이 깔렸으면 백신으로 지우거나 초기화한다."},
{"id":"T7545","line":14960,"t":"엠세이퍼로 내 명의 휴대폰 개통을 막았다"},
{"id":"T7546","line":14960,"t":"명의도용 방지 서비스에서 새 휴대폰 가입을 제한할 수 있다."},
{"id":"T7547","line":14961,"t":"금감원 개인정보노출자 사고예방시스템에 등록했다"},
