{"id":"T2795","line":4688,"t":"남은 사람이 할 일"},
{"id":"T2796","line":4689,"t":"정부24 · 안심상속 원스톱서비스"},
{"id":"T2797","line":4689,"t":"찾기쉬운 생활법령정보 · 상속"},
{"id":"T2798","line":4689,"t":"국세청 · 상속세"},
{"id":"T2799","line":4692,"t":"겨울 새벽,"},
{"id":"T2800","line":4692,"t":"전화가 울렸다."},
{"id":"T2801","line":4694,"t":"아버지가"},
{"id":"T2802","line":4694,"t":"돌아가셨다."},
{"id":"T2803","line":4696,"t":"할배는 아무 말 없이"},
{"id":"T2804","line":4696,"t":"옆에 서 있었다."},
{"id":"T2805","line":4697,"t":"주민센터 직원"},
{"id":"T2806","line":4698,"t":"안심상속 원스톱 (요약)"},
{"id":"T2807","line":4698,"t":"한 번에"},
{"id":"T2808","line":4698,"t":"예금·대출·땅·차·세금"},
{"id":"T2809","line":4698,"t":"주민센터 · 정부24"},
{"id":"T2810","line":4698,"t":"사망신고 때 같이"},
{"id":"T2811","line":4699,"t":"사망신고 하실 때"},
{"id":"T2812","line":4699,"t":"재산 조회도"},
{"id":"T2813","line":4699,"t":"같이 하세요."},
{"id":"T2814","line":4701,"t":"안심상속 원스톱서비스로 재산과 빚을 한 번에 조회한다"},
{"id":"T2815","line":4702,"t":"사망신고를 하면서 안심상속 원스톱서비스를 신청하면 예금, 대출, 토지, 자동차, 세금을 한 번에 조회할 수 있다(행정안전부, 정부24)."},
{"id":"T2816","line":4703,"t":"집이랑 통장만 알면 된다"},
{"id":"T2817","line":4704,"t":"빚과 보증, 남은 세금은 서랍에 없을 수 있다. 조회부터 한다."},
{"id":"T2818","line":4706,"t":"조회 결과 (예시)"},
{"id":"T2819","line":4706,"t":"시골 집 한 채"},
{"id":"T2820","line":4706,"t":"지인 대출 보증"},
{"id":"T2821","line":4707,"t":"보증을 서 주신 게"},
{"id":"T2822","line":4707,"t":"있었구나..."},
{"id":"T2823","line":4709,"t":"빚이 더 클 수 있으니 3개월 안에 한정승인이나 상속포기를 알아본다"},
{"id":"T2824","line":4710,"t":"상속은 재산뿐 아니라 빚도 물려받는다. 상속이 시작된 걸 안 날부터 3개월 안에 가정법원에 한정승인이나 상속포기를 신청할 수 있다(민법, 찾기쉬운 생활법령정보). 기한을 넘기면 빚까지 그대로 받는다."},
{"id":"T2825","line":4711,"t":"일단 집부터 팔아 정리한다"},
{"id":"T2826","line":4712,"t":"상속 재산을 먼저 팔거나 쓰면 그대로 받기로 한 것으로 볼 수 있고, 그러면 한정승인이나 포기를 못 할 수 있다. 처분 전에 전문가와 상의한다."},
{"id":"T2827","line":4714,"t":"상속세 (요약)"},
{"id":"T2828","line":4714,"t":"신고 기한"},
{"id":"T2829","line":4714,"t":"사망한 달 말일+6개월"},
{"id":"T2830","line":4714,"t":"국세청 홈택스"},
{"id":"T2831","line":4714,"t":"낼 세금"},
{"id":"T2832","line":4714,"t":"공제 뒤 계산"},
{"id":"T2833","line":4715,"t":"세금 신고는"},
{"id":"T2834","line":4715,"t":"언제까지지?"},
{"id":"T2835","line":4717,"t":"형제와 같이 세무 상담을 받고, 기한 안에 신고할지 정한다"},
{"id":"T2836","line":4718,"t":"상속세는 상속이 시작된 달의 말일부터 6개월 안에 신고한다(국세청). 공제가 커서 낼 세금이 없을 수도 있지만 그 판단도 기한 안에 한다."},
{"id":"T2837","line":4719,"t":"집 한 채뿐이니 신경 안 쓴다"},
{"id":"T2838","line":4720,"t":"낼 세금이 없을지는 계산해 봐야 안다. 기한을 넘기면 가산세가 붙을 수 있다."},
{"id":"T2839","line":4721,"t":"귀인 할배"},
{"id":"T2840","line":4722,"t":"허허..."},
{"id":"T2841","line":4722,"t":"아버님 서랍은"},
{"id":"T2842","line":4722,"t":"자네가 닫아 드리게."},
{"id":"T2843","line":4723,"t":"슬픔은 길었고,"},
{"id":"T2844","line":4723,"t":"서류는 제때 닫았다."},
{"id":"T2845","line":4723,"t":"정리는 했지만"},
{"id":"T2846","line":4723,"t":"몇 날을 놓쳤다."},
{"id":"T2847","line":4723,"t":"슬픔 위에"},
{"id":"T2848","line":4723,"t":"빚 걱정이 얹혔다."},
{"id":"T2849","line":4727,"t":"그 전화"},
{"id":"T2850","line":4727,"t":"기관은 돈을 옮기라고 하지 않는다"},
{"id":"T2851","line":4728,"t":"금융감독원 · 보이스피싱 지킴이"},
{"id":"T2852","line":4728,"t":"경찰청 112"},
{"id":"T2853","line":4731,"t":"[국외발신]"},
{"id":"T2854","line":4731,"t":"해외 결제 승인."},
{"id":"T2855","line":4731,"t":"본인 아니면 연락."},
{"id":"T2856","line":4733,"t":"해외에서"},
{"id":"T2857","line":4733,"t":"산 거 없는데?"},
{"id":"T2858","line":4734,"t":"전화 속 목소리"},
{"id":"T2859","line":4735,"t":"카드사입니다."},
{"id":"T2860","line":4735,"t":"명의가 도용됐어요."},
{"id":"T2861","line":4735,"t":"검찰로 연결할게요."},
{"id":"T2862","line":4737,"t":"전화를 끊고 카드 뒷면 번호로 내가 다시 건다"},
{"id":"T2863","line":4738,"t":"문자 속 번호는 사기범에게 걸린다. 카드사나 은행은 내가 아는 공식 번호로 다시 걸어 확인한다(금융감독원)."},
{"id":"T2864","line":4739,"t":"연결해 주는 검사에게 사정을 듣는다"},
{"id":"T2865","line":4740,"t":"카드사가 검찰로 돌려주는 일은 없다. 기관을 바꿔 가며 믿게 만드는 게 흔한 수법이다."},
{"id":"T2866","line":4741,"t":"전화 속 검사"},
{"id":"T2867","line":4742,"t":"전화로 들은 것"},
{"id":"T2868","line":4742,"t":"보낸 곳"},
{"id":"T2869","line":4742,"t":"○○지검이라고 함"},
{"id":"T2870","line":4742,"t":"안전계좌로 이체"},
{"id":"T2871","line":4742,"t":"보안앱 설치"},
{"id":"T2872","line":4743,"t":"자산 보호를 위해"},
{"id":"T2873","line":4743,"t":"안전계좌로"},
{"id":"T2874","line":4743,"t":"옮기셔야 합니다."},
{"id":"T2875","line":4745,"t":"수사기관은 돈을 옮기라고 하지 않는다. 끊고 112에 묻는다"},
{"id":"T2876","line":4746,"t":"검찰, 경찰, 금융감독원은 전화로 돈을 옮기라거나 앱을 깔라고 하지 않는다(금융감독원). 의심되면 끊고 112나 금융감독원 1332에 묻는다."},
{"id":"T2877","line":4747,"t":"보안앱부터 깔아 둔다"},
{"id":"T2878","line":4748,"t":"보안앱이라며 깔라고 하는 건 대개 원격 조종 앱이다. 깔리면 문자, 인증서, 계좌까지 넘어간다."},
{"id":"T2879","line":4750,"t":"그 주말."},
{"id":"T2880","line":4750,"t":"울면서 전화했다."},
{"id":"T2881","line":4752,"t":"방금 천만 원을"},
{"id":"T2882","line":4752,"t":"보냈어."},
{"id":"T2883","line":4752,"t":"어떡하지?"},
{"id":"T2884","line":4754,"t":"바로 112나 보낸 은행 콜센터에 전화해 지급정지를 요청하게 한다"},
{"id":"T2885","line":4755,"t":"보낸 계좌와 받은 계좌의 금융회사에 바로 지급정지를 요청한다. 빠를수록 돌려받을 가능성이 크다(금융감독원). 그다음 피해구제 신청서를 낸다."},
{"id":"T2886","line":4756,"t":"내일 아침 은행 문 열면 가 보라고 한다"},
{"id":"T2887","line":4757,"t":"그사이 돈은 여러 계좌로 쪼개져 빠져나간다. 112와 금융회사 콜센터는 밤에도 받는다."},
{"id":"T2888","line":4758,"t":"귀인 할배"},
{"id":"T2889","line":4759,"t":"허허, 서두르라는"},
{"id":"T2890","line":4759,"t":"말이 나오면"},
{"id":"T2891","line":4759,"t":"그게 신호일세."},
{"id":"T2892","line":4760,"t":"그 전화는"},
{"id":"T2893","line":4760,"t":"그냥 끊긴 전화가 됐다."},
{"id":"T2894","line":4760,"t":"나는 지켰지만"},
{"id":"T2895","line":4760,"t":"사촌은 늦었다."},
{"id":"T2896","line":4760,"t":"목소리 큰 쪽에"},
{"id":"T2897","line":4760,"t":"끌려갔다."},
