[{"id":"T3978","line":5995,"t":"오랜만이다."},
{"id":"T3979","line":5997,"t":"그때 우리"},
{"id":"T3980","line":5997,"t":"왜 그렇게"},
{"id":"T3981","line":5997,"t":"조급했을까."},
{"id":"T3982","line":5999,"t":"다시 만나 보자고 말한다"},
{"id":"T3983","line":6000,"t":"연락하며 지내자고 한다"},
{"id":"T3984","line":6001,"t":"단톡방 대신 둘만의 대화방이 하나 생겼다. 생일마다 커피 쿠폰이 오갔다."},
{"id":"T3985","line":6004,"t":"동네 러닝"},
{"id":"T3986","line":6004,"t":"마흔의 만남"},
{"id":"T3987","line":6008,"t":"검진 받은 뒤로"},
{"id":"T3988","line":6008,"t":"아침마다 뛴다."},
{"id":"T3989","line":6010,"t":"처음 오셨죠?"},
{"id":"T3990","line":6010,"t":"천천히 뛰어요."},
{"id":"T3991","line":6010,"t":"저도 느려요."},
{"id":"T3992","line":6012,"t":"저 중학생"},
{"id":"T3993","line":6012,"t":"아이가 하나 있어요."},
{"id":"T3994","line":6012,"t":"혼자 키워요."},
{"id":"T3995","line":6014,"t":"아이 얘기를 더 듣고 싶다고 한다"},
{"id":"T3996","line":6015,"t":"{c.은} 아이 학교 얘기를 한참 했다. 커피가 식는 줄 몰랐다."},
{"id":"T3997","line":6016,"t":"저는 혼자가 편한 사람이라고 먼저 말한다"},
{"id":"T3998","line":6017,"t":"{c.은} \"저도 그래서 뛰어요\" 했다. 좋은 러닝 친구가 생겼다."},
{"id":"T3999","line":6018,"t":"다음 주에 또 뛰자고 한다"},
{"id":"T4000","line":6019,"t":"토요일 아침 일곱 시. 둘 다 늦지 않았다."},
{"id":"T4001","line":6021,"t":"두 집의 셈"},
{"id":"T4002","line":6021,"t":"같이 산다는 것"},
{"id":"T4003","line":6025,"t":"같이 살면"},
{"id":"T4004","line":6025,"t":"뭐가 바뀔까?"},
{"id":"T4005","line":6027,"t":"둘이 정할 것"},
{"id":"T4006","line":6027,"t":"각자 재산"},
{"id":"T4007","line":6027,"t":"어떻게 둘까"},
{"id":"T4008","line":6027,"t":"아이 학비"},
{"id":"T4009","line":6027,"t":"{c} 몫·같이"},
{"id":"T4010","line":6027,"t":"혼인신고"},
{"id":"T4011","line":6027,"t":"할까 말까"},
{"id":"T4012","line":6027,"t":"보험·연금"},
{"id":"T4013","line":6027,"t":"수익자 확인"},
{"id":"T4014","line":6028,"t":"혼인신고를"},
{"id":"T4015","line":6028,"t":"해야 할까?"},
{"id":"T4016","line":6030,"t":"혼인신고를 하면 법률상 배우자가 된다. 아이와 같이 얘기하고 정하자"},
{"id":"T4017","line":6031,"t":"혼인신고를 해야 법률상 배우자로 상속과 세금 공제를 받는다. 신고 없이 함께 살면 보호가 일부에 그친다(민법, 찾기쉬운 생활법령정보, 확인 권장). {c.은} 아이에게 먼저 묻겠다고 했다."},
{"id":"T4018","line":6032,"t":"각자 집에 살며 지금처럼 만난다"},
{"id":"T4019","line":6033,"t":"열쇠는 두 개, 주말은 함께. 보험 수익자와 비상 연락처에는 서로의 이름을 적었다."},
{"id":"T4020","line":6034,"t":"좋은 친구로 남자고 한다"},
{"id":"T4021","line":6035,"t":"토요일 러닝은 그대로 했다. 둘 다 그게 좋았다."},
{"id":"T4022","line":6038,"t":"우리 식대로"},
{"id":"T4023","line":6038,"t":"작은 결혼식과 혼인신고"},
{"id":"T4024","line":6042,"t":"작은 식장을"},
{"id":"T4025","line":6042,"t":"반나절 빌렸다."},
{"id":"T4026","line":6043,"t":"예식장 실장"},
{"id":"T4027","line":6044,"t":"예식장 계약서"},
{"id":"T4028","line":6044,"t":"보증인원"},
{"id":"T4029","line":6044,"t":"취소 시"},
{"id":"T4030","line":6044,"t":"계약금 환불 불가"},
{"id":"T4031","line":6044,"t":"꽃 장식"},
{"id":"T4032","line":6044,"t":"1인 기준"},
{"id":"T4033","line":6045,"t":"오늘 계약하시면"},
{"id":"T4034","line":6045,"t":"식대 할인돼요."},
{"id":"T4035","line":6047,"t":"취소 조항과 별도 항목 값을 먼저 묻는다"},
{"id":"T4036","line":6048,"t":"예식업은 공정거래위원회 소비자분쟁해결기준이 있어 해제 시기에 따라 환급 기준이 다르다. 계약 전에 조항과 \"별도\" 값을 다 받아 적는다(한국소비자원)."},
{"id":"T4037","line":6049,"t":"작은 식이니 바로 쓴다"},
{"id":"T4038","line":6050,"t":"작은 식도 계약은 계약이다. 취소 조항은 식 크기와 상관없이 읽는다."},
{"id":"T4039","line":6052,"t":"혼인신고"},
{"id":"T4040","line":6052,"t":"시·구·읍·면 사무소"},
{"id":"T4041","line":6052,"t":"둘 + 증인 두 명"},
{"id":"T4042","line":6052,"t":"신고일 기준"},
{"id":"T4043","line":6052,"t":"신혼 특공·대출"},
{"id":"T4044","line":6052,"t":"결혼 세액공제"},
{"id":"T4045","line":6052,"t":"대상 연도 확인"},
{"id":"T4046","line":6053,"t":"혼인신고는"},
{"id":"T4047","line":6053,"t":"언제 하지?"},
{"id":"T4048","line":6055,"t":"제도마다 날짜 기준을 보고 날을 정한다"},
{"id":"T4049","line":6056,"t":"혼인신고서에는 성년 증인 두 사람이 서명한다(민법). 신혼부부 특별공급과 신혼 대출은 혼인신고일부터 햇수를 센다. 결혼 세액공제는 대상 연도가 정해져 있으니 국세청에서 확인한다."},
{"id":"T4050","line":6057,"t":"식 끝나고 생각나면 한다"},
{"id":"T4051","line":6058,"t":"신고일이 기준인 제도가 많다. 미루는 게 득인지 손해인지 먼저 따져 본다."},
{"id":"T4052","line":6059,"t":"귀인 할배"},
{"id":"T4053","line":6060,"t":"허허, 늦은 게"},
{"id":"T4054","line":6060,"t":"자네 때였네."},
{"id":"T4055","line":6063,"t":"아이 이야기"},
{"id":"T4056","line":6063,"t":"낳을까, 언제"},
{"id":"T4057","line":6067,"t":"조카 돌잔치에서"},
{"id":"T4058","line":6067,"t":"돌아오는 길."},
{"id":"T4059","line":6069,"t":"아이 어떻게"},
{"id":"T4060","line":6071,"t":"아이가 오면 (요약)"},
{"id":"T4061","line":6071,"t":"임신·출산"},
{"id":"T4062","line":6071,"t":"국민행복카드 바우처"},
{"id":"T4063","line":6071,"t":"출생 뒤"},
{"id":"T4064","line":6071,"t":"첫만남이용권·부모급여"},
{"id":"T4065","line":6071,"t":"출산휴가·육아휴직"},
{"id":"T4066","line":6071,"t":"금액·기간"},
{"id":"T4067","line":6071,"t":"해마다 확인"},
{"id":"T4068","line":6072,"t":"돈만으로"},
{"id":"T4069","line":6072,"t":"정할 일은"},
{"id":"T4070","line":6072,"t":"아니지만."},
{"id":"T4071","line":6074,"t":"곧 낳자. 육아휴직은 둘이 나눠 쓰자"},
{"id":"T4072","line":6075,"t":"둘이 휴직 순서를 달력에 적었다. 부모가 같이 쓰면 늘어나는 지원이 있다(고용노동부, 기준 확인 필요)."},
{"id":"T4073","line":6076,"t":"몇 해 뒤에. 그 전에 집과 통장부터"},
{"id":"T4074","line":6077,"t":"아이 통장 대신 우리 통장 이름을 \"언젠가\"로 바꿨다."},
{"id":"T4075","line":6078,"t":"아이 없이 둘이 살자"},
{"id":"T4076","line":6079,"t":"둘이 사는 삶도 가족이다. 그날 둘의 노후 표를 처음 같이 썼다."},
{"id":"T4077","line":6080,"t":"귀인 할배"},
{"id":"T4078","line":6081,"t":"허허, 남의 시계"},
{"id":"T4079","line":6081,"t":"말고 자네 둘"},
{"id":"T4080","line":6081,"t":"시계를 보게."},
{"id":"T4081","line":6083,"t":"서류도 같이 태어난다"},
{"id":"T4082","line":6087,"t":"{ageKo}, 새벽."},
{"id":"T4083","line":6087,"t":"작은 울음소리가"},
{"id":"T4084","line":6087,"t":"방을 채웠다."},
{"id":"T4085","line":6089,"t":"출생 뒤 신청 (요약)"},
{"id":"T4086","line":6089,"t":"출생신고"},
{"id":"T4087","line":6089,"t":"한 달 안"},
{"id":"T4088","line":6089,"t":"부모급여·아동수당"},
{"id":"T4089","line":6089,"t":"주민센터·복지로"},
{"id":"T4090","line":6089,"t":"첫만남이용권"},
{"id":"T4091","line":6089,"t":"복지로 확인"},
{"id":"T4092","line":6090,"t":"출생신고 하면서"},
{"id":"T4093","line":6090,"t":"같이 신청하는 게"},
{"id":"T4094","line":6092,"t":"출생신고 때 여러 지원을 한 번에 신청한다"},
{"id":"T4095","line":6093,"t":"출생신고는 한 달 안에 한다(가족관계등록법). 이때 주민센터나 정부24에서 출산 지원 여러 가지를 한꺼번에 신청할 수 있다(행정안전부·보건복지부, 서비스 이름과 대상 확인 필요)."},
{"id":"T4096","line":6094,"t":"정신없으니 나중에 하나씩"},
{"id":"T4097","line":6095,"t":"신청해야 나오는 돈이 많다. 늦게 내면 지난달 몫을 못 받는 것도 있다(복지로에서 확인)."},
{"id":"T4098","line":6097,"t":"육아휴직,"},
{"id":"T4099","line":6097,"t":"팀장님께"},
{"id":"T4100","line":6097,"t":"언제 말하지?"},
{"id":"T4101","line":6099,"t":"미리 말하고 신청서를 낸다. 휴직했다고 불이익을 주면 안 된다"},
{"id":"T4102","line":6100,"t":"육아휴직은 법에 있는 권리이고, 이를 이유로 해고나 불리한 처우를 하면 안 된다(남녀고용평등법, 고용노동부). 급여는 고용24에서 신청한다. 기간과 금액은 해마다 확인한다."},
{"id":"T4103","line":6101,"t":"눈치 보여서 연차로 버틴다"},
{"id":"T4104","line":6102,"t":"연차는 금방 바닥난다. 쓸 수 있는 제도를 안 쓰면 몸과 마음이 먼저 닳는다. 고용노동부 1350에 물을 수 있다."},
{"id":"T4105","line":6104,"t":"우리 집 서랍에"},
{"id":"T4106","line":6104,"t":"종이가 한 장"},
{"id":"T4107","line":6104,"t":"더 늘었다."},
{"id":"T4108","line":6106,"t":"둘이 정한 만큼"},
{"id":"T4109","line":6110,"t":"기다리는 소식이"},
{"id":"T4110","line":6110,"t":"오지 않았다."},
{"id":"T4111","line":6112,"t":"병원 가 볼래?"},
{"id":"T4112","line":6112,"t":"둘 다."},
{"id":"T4113","line":6114,"t":"알아본 것"},
{"id":"T4114","line":6114,"t":"둘이 같이"},
{"id":"T4115","line":6114,"t":"시술비 지원"},
{"id":"T4116","line":6114,"t":"보건소·정부24"},
{"id":"T4117","line":6114,"t":"난임치료휴가"},
{"id":"T4118","line":6114,"t":"회사에 신청"},
{"id":"T4119","line":6114,"t":"대상·횟수"},
{"id":"T4120","line":6114,"t":"확인 필요"},
{"id":"T4121","line":6115,"t":"누구 탓도"},
{"id":"T4122","line":6115,"t":"아니래."},
{"id":"T4123","line":6117,"t":"둘이 정한 만큼만 해 보자. 지원은 보건소에서 알아본다"},
{"id":"T4124","line":6118,"t":"난임 시술비 지원은 보건소와 정부24에서 신청한다(보건복지부, 대상·횟수 확인 필요). 회사에는 난임치료휴가가 있다(고용노동부). 지칠 때 멈출 날도 같이 정했다."},
{"id":"T4125","line":6119,"t":"지금은 쉬어 가자"},
{"id":"T4126","line":6120,"t":"달력에서 병원 일정을 지웠다. 그 주말엔 오랜만에 바다를 보러 갔다."},
{"id":"T4127","line":6121,"t":"둘이서 사는 삶을 고른다"},
{"id":"T4128","line":6122,"t":"오래 이야기했다. 둘이 사는 삶도 가족이라는 데서 대화가 끝났다."},
{"id":"T4129","line":6124,"t":"할배는 말없이"},
{"id":"T4130","line":6124,"t":"차를 한 잔"},
{"id":"T4131","line":6124,"t":"따라 줬다."},
{"id":"T4132","line":6126,"t":"다시 달력"},
{"id":"T4133","line":6126,"t":"한 번 더, 또는 둘이서"},
{"id":"T4134","line":6130,"t":"달력을 다시"},
{"id":"T4135","line":6130,"t":"꺼내 봤어."},
{"id":"T4136","line":6132,"t":"한 번 더 해 보자. 이번에도 멈출 날을 같이 정하고"},
{"id":"T4137","line":6133,"t":"둘이 정한 만큼만. 그 약속이 서로를 지켰다."},
{"id":"T4138","line":6134,"t":"이제 둘이서 살자"},
{"id":"T4139","line":6135,"t":"그날 저녁, 둘이 가고 싶던 곳 목록을 다시 썼다."},
{"id":"T4140","line":6137,"t":"하나, 둘"},
{"id":"T4141","line":6141,"t":"동생을 그렸다."},
{"id":"T4142","line":6143,"t":"둘째가 오면 (요약)"},
{"id":"T4143","line":6143,"t":"하나 더"},
{"id":"T4144","line":6143,"t":"육아휴직"},
{"id":"T4145","line":6143,"t":"아이마다"},
{"id":"T4146","line":6143,"t":"다자녀 혜택"},
{"id":"T4147","line":6143,"t":"지자체마다"},
{"id":"T4148","line":6143,"t":"우리 노후"},
{"id":"T4149","line":6143,"t":"같이 줄어듦"},
{"id":"T4150","line":6144,"t":"어떻게 생각해?"},
{"id":"T4151","line":6146,"t":"둘째를 낳자. 대신 노후 저축 금액은 지킨다"},
{"id":"T4152","line":6147,"t":"아이 둘 몫의 표 아래에 노후 저축 줄을 먼저 적었다."},
{"id":"T4153","line":6148,"t":"우리는 하나로 충분하다"},
{"id":"T4154","line":6149,"t":"셋이 사는 집. 주말마다 셋이 같이 걸었다."},
{"id":"T4155","line":6150,"t":"귀인 할배"},
{"id":"T4156","line":6151,"t":"허허, 몇 명이든"},
{"id":"T4157","line":6151,"t":"아이 몫 말고"},
{"id":"T4158","line":6151,"t":"자네 몫도 남기게."},
{"id":"T4159","line":6153,"t":"익숙해도 기한은 같다"},
{"id":"T4160","line":6157,"t":"{ageKo}, 봄."},
{"id":"T4161","line":6157,"t":"둘째가 왔다."},
{"id":"T4162","line":6159,"t":"내가 먼저"},
{"id":"T4163","line":6159,"t":"안아 볼래."},
{"id":"T4164","line":6161,"t":"둘째 서류"},
{"id":"T4165","line":6161,"t":"출생신고"},
{"id":"T4166","line":6161,"t":"한 달 안"},
{"id":"T4167","line":6161,"t":"육아휴직"},
{"id":"T4168","line":6161,"t":"아이마다 따로"},
{"id":"T4169","line":6161,"t":"지자체 확인"},
{"id":"T4170","line":6161,"t":"연말정산"},
{"id":"T4171","line":6161,"t":"자녀 공제 확인"},
{"id":"T4172","line":6162,"t":"둘째 서류도"},
{"id":"T4173","line":6162,"t":"첫째 때"},
{"id":"T4174","line":6162,"t":"목록 그대로."},
{"id":"T4175","line":6164,"t":"첫째 때 쓴 목록대로 한 번에 신청한다"},
{"id":"T4176","line":6165,"t":"출생 지원은 아이마다 따로 신청한다. 자녀 세액공제와 출산·입양 공제는 국세청 안내로 확인한다."},
{"id":"T4177","line":6166,"t":"둘째는 익숙하니 천천히"},
{"id":"T4178","line":6167,"t":"익숙해도 기한은 같다. 출생신고는 한 달 안이다."},
{"id":"T4179","line":6177,"t":"고마워."},
{"id":"T4180","line":6177,"t":"근데 지금은"},
{"id":"T4181","line":6177,"t":"아닌 것 같아."},
{"id":"T4182","line":6178,"t":"돌아오는 길이"},
{"id":"T4183","line":6178,"t":"유난히 길었다."},
{"id":"T4184","line":6179,"t":"그 표, 내가"},
{"id":"T4185","line":6179,"t":"코팅해 둘게."},
