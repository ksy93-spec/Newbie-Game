{"id":"T390","line":2951,"t":"보험료가 면제된다"},
{"id":"T391","line":2952,"t":"피부양자 인정 요건(소득·재산)을 벗어나면 지역가입자가 된다. 취업 전이라도 고지서가 나온다."},
{"id":"T392","line":2953,"t":"소득이 없는데도 지역가입자 보험료가 나오는 이유는?"},
{"id":"T393","line":2954,"t":"재산도 부과 기준에 포함되기 때문"},
{"id":"T394","line":2954,"t":"계산 오류이기 때문"},
{"id":"T395","line":2954,"t":"졸업생에게 일괄 부과되기 때문"},
{"id":"T396","line":2955,"t":"지역가입자 보험료는 소득과 재산을 함께 본다. 소득이 없으면 조정 신청으로 줄일 수 있는 경우가 있다."},
{"id":"T397","line":2956,"t":"졸업하고 취업하면 건강보험은 어떻게 될까?"},
{"id":"T398","line":2956,"t":"직장가입자가 되어 회사와 절반씩 부담한다"},
{"id":"T399","line":2956,"t":"지역가입자로 계속 남는다"},
{"id":"T400","line":2956,"t":"보험료가 없어진다"},
{"id":"T401","line":2957,"t":"직장가입자 보험료는 사업주와 근로자가 절반씩 낸다. 입사하면 지역가입자 자격은 정리된다."},
{"id":"T402","line":2958,"t":"국민연금 납부예외"},
{"id":"T403","line":2958,"t":"공단 상담원"},
{"id":"T404","line":2959,"t":"소득이 없는데 연금 고지서가 오면, 그냥 두면 안 돼요."},
{"id":"T405","line":2960,"t":"소득이 없을 때 국민연금은 어떻게 할 수 있을까?"},
{"id":"T406","line":2960,"t":"납부예외를 신청할 수 있다"},
{"id":"T407","line":2960,"t":"자동으로 면제된다"},
{"id":"T408","line":2960,"t":"탈퇴해야 한다"},
{"id":"T409","line":2961,"t":"신청하지 않고 방치하면 체납으로 남는다. 납부예외는 신청해야 적용된다."},
{"id":"T410","line":2962,"t":"납부예외 기간은 나중에 어떻게 될까?"},
{"id":"T411","line":2963,"t":"가입기간에 포함되지 않아 연금액이 줄어든다"},
{"id":"T412","line":2963,"t":"그대로 가입기간으로 인정된다"},
{"id":"T413","line":2963,"t":"두 배로 인정된다"},
{"id":"T414","line":2964,"t":"가입기간에서 빠지므로 나중에 추후납부로 메울 수 있다. 당장은 예외 신청, 여유가 생기면 추납이 순서다."},
{"id":"T415","line":2965,"t":"납부예외를 신청하지 않고 그냥 두면 어떻게 될까?"},
{"id":"T416","line":2965,"t":"체납으로 남아 연체금이 붙을 수 있다"},
{"id":"T417","line":2965,"t":"자동으로 예외 처리된다"},
{"id":"T418","line":2965,"t":"가입 자격이 사라진다"},
{"id":"T419","line":2966,"t":"예외는 신청해야 생긴다. 소득이 없다는 사실만으로 저절로 처리되지 않는다."},
{"id":"T420","line":2967,"t":"면접 비용 손익분기"},
{"id":"T421","line":2968,"t":"면접 볼 때마다 돈 나가는 거, 한 번 세어 볼래?"},
{"id":"T422","line":2969,"t":"지방 면접 왕복 교통비 8만원짜리를 6번 보면?"},
{"id":"T423","line":2969,"t":"48만원"},
{"id":"T424","line":2969,"t":"24만원"},
{"id":"T425","line":2969,"t":"80만원"},
{"id":"T426","line":2970,"t":"8만 × 6 = 48만원. 지자체 면접 교통비 지원 제도가 있는지 먼저 확인할 값어치가 있다."},
{"id":"T427","line":2971,"t":"정장 대여가 1회 5만원, 구매가 25만원이면 몇 번부터 구매가 유리할까?"},
{"id":"T428","line":2972,"t":"25만 ÷ 5만 = 5회. 면접을 5번 넘게 볼 것 같으면 사는 쪽이 싸다. 회당 비용으로 따지는 습관이다."},
{"id":"T429","line":2973,"t":"면접 한 번에 교통비 8만원, 식비 1만원, 정장 대여 5만원이 든다면 1회 비용은?"},
{"id":"T430","line":2973,"t":"14만원"},
{"id":"T431","line":2974,"t":"8 + 1 + 5 = 14만원. 회당 비용을 알아야 어디까지 지원할지 기준이 생긴다."},
{"id":"T432","line":2975,"t":"등기부등본 5분 만에 읽기"},
{"id":"T433","line":2975,"t":"3년차 선배"},
{"id":"T434","line":2976,"t":"계약 전에 뭘 확인해야 하는지 알고 있어?"},
{"id":"T435","line":2977,"t":"집주인이 이 집을 담보로 빌린 돈을 확인하려면 등기부등본의 어디를 봐야 할까?"},
{"id":"T436","line":2978,"t":"을구에 근저당권 같은 소유권 외 권리가 적힌다. 갑구는 소유권, 표제부는 건물 자체 정보."},
{"id":"T437","line":2979,"t":"근저당 채권최고액이 집값의 70%인 집에 전세로 들어가면?"},
{"id":"T438","line":2980,"t":"경매로 넘어가면 보증금을 못 받을 위험이 크다"},
{"id":"T439","line":2980,"t":"집주인이 재력가라는 뜻이라 안전하다"},
{"id":"T440","line":2980,"t":"보증금이 그만큼 싸진다"},
{"id":"T441","line":2981,"t":"선순위 채권이 크면 경매 배당에서 보증금 순위가 밀린다. 전세가와 근저당의 합이 시세에 근접하면 위험 신호."},
{"id":"T442","line":2982,"t":"등기부등본 갑구에서 확인하는 것은?"},
{"id":"T443","line":2982,"t":"소유권과 압류·가압류 같은 소유권 관련 사항"},
{"id":"T444","line":2982,"t":"근저당권과 전세권"},
{"id":"T445","line":2982,"t":"건물 면적과 구조"},
{"id":"T446","line":2983,"t":"갑구는 소유권, 을구는 소유권 외 권리, 표제부는 건물 자체다. 압류가 걸린 집은 갑구에서 드러난다."},
{"id":"T447","line":2984,"t":"전입신고와 확정일자"},
{"id":"T448","line":2984,"t":"3년차 선배"},
{"id":"T449","line":2985,"t":"이사하고 주민센터 갔어? 하루 미루면 큰일 나는데."},
{"id":"T450","line":2986,"t":"전입신고로 생기는 대항력은 언제부터 효력이 있을까?"},
{"id":"T451","line":2986,"t":"신고한 다음 날 0시부터"},
{"id":"T452","line":2986,"t":"신고 즉시"},
{"id":"T453","line":2986,"t":"계약서를 쓴 날부터"},
{"id":"T454","line":2987,"t":"주택임대차보호법상 대항력은 주택 인도와 전입신고를 마친 다음 날 0시에 생긴다. 이사 당일 집주인이 대출을 받으면 그 대출이 앞선다."},
{"id":"T455","line":2988,"t":"확정일자는 무엇을 해주는 장치일까?"},
{"id":"T456","line":2989,"t":"보증금을 다른 채권자보다 먼저 받을 순위를 준다"},
{"id":"T457","line":2989,"t":"계약을 법적으로 유효하게 만든다"},
{"id":"T458","line":2989,"t":"집주인의 세금을 깎아준다"},
{"id":"T459","line":2990,"t":"확정일자는 우선변제권을 준다. 대항력과 확정일자가 둘 다 있어야 보증금을 지킬 수 있다."},
{"id":"T460","line":2991,"t":"이사 당일에 전입신고를 했는데 그날 집주인이 대출을 받았다면?"},
{"id":"T461","line":2991,"t":"그 대출이 내 대항력보다 앞선다"},
{"id":"T462","line":2991,"t":"내 대항력이 앞선다"},
{"id":"T463","line":2991,"t":"같은 순위로 나눠 받는다"},
{"id":"T464","line":2992,"t":"대항력은 다음 날 0시에 생긴다. 하루의 틈이 순위를 바꾼다. 잔금일 다음 날까지 근저당을 설정하지 않는다는 특약이 필요한 이유다."},
{"id":"T465","line":2993,"t":"월세 계약서에서 꼭 볼 세 곳"},
{"id":"T466","line":2993,"t":"부동산 사장"},
{"id":"T467","line":2994,"t":"도장 찍기 전에, 세 군데만 다시 봐요."},
{"id":"T468","line":2995,"t":"계약서의 임대인 이름과 반드시 대조해야 하는 것은?"},
{"id":"T469","line":2995,"t":"등기부등본상 소유자와 신분증"},
{"id":"T470","line":2995,"t":"공인중개사 명함"},
{"id":"T471","line":2995,"t":"관리사무소 연락처"},
{"id":"T472","line":2996,"t":"소유자가 아닌 사람과 계약하면 보증금을 돌려받을 상대가 사라진다. 대리인이면 위임장과 인감증명을 확인한다."},
{"id":"T473","line":2997,"t":"특약에 넣어두면 좋은 것은?"},
{"id":"T474","line":2998,"t":"잔금일 다음 날까지 근저당을 설정하지 않는다는 조항"},
{"id":"T475","line":2998,"t":"벽지 색을 바꿔도 된다는 조항"},
{"id":"T476","line":2998,"t":"월세를 현금으로 낸다는 조항"},
{"id":"T477","line":2999,"t":"계약금만 낸 상태에서 집주인이 대출을 받으면 순위가 밀린다. 이 조항 한 줄이 그 구간을 막는다."},
{"id":"T478","line":3000,"t":"집주인 본인이 아니라 대리인이 나왔다면 무엇을 확인해야 할까?"},
{"id":"T479","line":3000,"t":"위임장과 인감증명서"},
{"id":"T480","line":3000,"t":"대리인의 명함"},
{"id":"T481","line":3000,"t":"구두로 확인하면 충분하다"},
{"id":"T482","line":3001,"t":"위임 사실이 서류로 남아야 한다. 확인하지 않으면 계약 상대가 누구인지부터 흔들린다."},
{"id":"T483","line":3002,"t":"전월세 신고제"},
{"id":"T484","line":3002,"t":"주민센터 직원"},
{"id":"T485","line":3003,"t":"계약하고 나서 신고 안 하신 분들 많던데요."},
{"id":"T486","line":3004,"t":"전월세 신고 대상이 되는 기준은?"},
{"id":"T487","line":3005,"t":"보증금 6천만원 초과 또는 월세 30만원 초과"},
{"id":"T488","line":3005,"t":"모든 임대차 계약"},
{"id":"T489","line":3005,"t":"전세 계약만"},
{"id":"T490","line":3006,"t":"둘 중 하나만 넘어도 대상이다. 계약일로부터 30일 안에 신고한다."},
{"id":"T491","line":3007,"t":"전월세 신고를 하면 따라오는 이점은?"},
{"id":"T492","line":3008,"t":"확정일자가 자동으로 부여된다"},
{"id":"T493","line":3008,"t":"월세가 깎인다"},
{"id":"T494","line":3008,"t":"중개보수가 면제된다"},
{"id":"T495","line":3009,"t":"신고를 접수하면 확정일자가 함께 부여된다. 우선변제권을 챙기는 가장 간단한 경로다."},
{"id":"T496","line":3010,"t":"전월세 신고 기한은 계약일로부터 며칠일까?"},
{"id":"T497","line":3011,"t":"30일 안에 신고한다. 신고와 함께 확정일자가 부여되므로 미루면 우선변제권도 함께 미뤄진다."},
{"id":"T498","line":3012,"t":"중개보수, 깎을 수 있나"},
{"id":"T499","line":3012,"t":"부동산 사장"},
{"id":"T500","line":3013,"t":"중개보수요? 그거 정해진 거 아니에요. 상한만 있지."},
{"id":"T501","line":3014,"t":"중개보수의 성격은?"},
{"id":"T502","line":3014,"t":"거래금액 구간별 상한요율 안에서 협의"},
{"id":"T503","line":3014,"t":"법으로 고정된 금액"},
{"id":"T504","line":3014,"t":"중개사가 자유롭게 결정"},
{"id":"T505","line":3015,"t":"상한요율이 정해져 있고 그 안에서 협의한다. 계약 전에 미리 말을 꺼내는 편이 편하다."},
{"id":"T506","line":3016,"t":"중개보수를 언제 협의하는 게 좋을까?"},
{"id":"T507","line":3016,"t":"계약서 작성 전"},
{"id":"T508","line":3016,"t":"잔금 치를 때"},
{"id":"T509","line":3016,"t":"계약이 끝난 뒤"},
{"id":"T510","line":3017,"t":"계약이 진행된 뒤에는 협상력이 사라진다. 물건을 보기 시작할 때 요율을 확인해 둔다."},
{"id":"T511","line":3018,"t":"중개보수 상한을 정하는 기준은?"},
{"id":"T512","line":3018,"t":"거래금액 구간"},
{"id":"T513","line":3018,"t":"집의 면적"},
{"id":"T514","line":3018,"t":"중개사의 경력"},
{"id":"T515","line":3019,"t":"거래금액 구간마다 상한요율이 다르다. 내 계약이 어느 구간인지 먼저 알아야 협의가 된다."},
{"id":"T516","line":3020,"t":"청약통장, 지금 만드는 이유"},
{"id":"T517","line":3020,"t":"은행 창구 직원"},
{"id":"T518","line":3021,"t":"청약은 나중 일이라고요? 통장은 오늘 만드는 게 맞아요."},
{"id":"T519","line":3022,"t":"주택청약종합저축 가입 기간이 길면 뭐가 유리할까?"},
{"id":"T520","line":3023,"t":"청약 가점에서 가입기간 점수가 올라간다"},
{"id":"T521","line":3023,"t":"예금 이자율이 올라간다"},
{"id":"T522","line":3023,"t":"대출 한도가 늘어난다"},
{"id":"T523","line":3024,"t":"가점제에서 청약통장 가입기간은 따로 점수가 매겨진다. 늦게 만들수록 되돌릴 수 없는 손해다."},
{"id":"T524","line":3025,"t":"주택청약종합저축은 누가 가입할 수 있을까?"},
{"id":"T525","line":3025,"t":"나이나 주택 소유와 관계없이 누구나"},
{"id":"T526","line":3025,"t":"만 19세 이상만"},
{"id":"T527","line":3025,"t":"무주택자만"},
{"id":"T528","line":3026,"t":"가입 자체는 제한이 없다. 청약 신청 단계에서 무주택 여부와 지역 요건을 따진다."},
{"id":"T529","line":3027,"t":"청약 가점 항목에 들어가지 않는 것은?"},
{"id":"T530","line":3027,"t":"청약통장 잔액"},
{"id":"T531","line":3027,"t":"무주택 기간"},
{"id":"T532","line":3027,"t":"청약통장 가입기간"},
{"id":"T533","line":3028,"t":"가점은 무주택 기간, 부양가족 수, 청약통장 가입기간으로 매긴다. 돈이 아니라 시간이 점수가 된다."},
{"id":"T534","line":3029,"t":"앱테크 현실 수익 계산"},
{"id":"T535","line":3030,"t":"나 앱테크로 돈 번다. 한 달에 얼마 버는지 계산해 봤어?"},
{"id":"T536","line":3031,"t":"만보기 앱으로 하루 100원씩 1년을 모으면?"},
{"id":"T537","line":3031,"t":"약 3만 6천원"},
{"id":"T538","line":3031,"t":"약 12만원"},
{"id":"T539","line":3031,"t":"약 36만원"},
{"id":"T540","line":3032,"t":"100원 × 365일 = 36,500원. 하루 10분을 쓴다면 시급 600원꼴이다. 기대치를 용돈 수준으로 잡아야 실망하지 않는다."},
{"id":"T541","line":3033,"t":"앱테크 가입에서 가장 조심할 것은?"},
{"id":"T542","line":3033,"t":"과도한 개인정보 제공과 마케팅 수신 동의"},
{"id":"T543","line":3033,"t":"앱 용량"},
{"id":"T544","line":3033,"t":"앱 아이콘 디자인"},
{"id":"T545","line":3034,"t":"적립금 몇 천원을 받고 전화번호가 여러 업체로 넘어가는 구조가 흔하다. 선택 동의 항목은 해제하고 가입한다."},
{"id":"T546","line":3035,"t":"하루 10분을 써서 한 달에 3,000원을 모았다면 시급은 대략 얼마일까?"},
{"id":"T547","line":3035,"t":"약 600원"},
{"id":"T548","line":3035,"t":"약 6,000원"},
{"id":"T549","line":3035,"t":"약 3,000원"},
{"id":"T550","line":3036,"t":"10분 × 30일 = 5시간. 3,000 ÷ 5 = 600원. 앱테크를 부업으로 보면 실망하고, 용돈으로 보면 괜찮다."},
{"id":"T551","line":3037,"t":"신용점수 올리는 법"},
{"id":"T552","line":3037,"t":"은행 창구 직원"},
{"id":"T553","line":3038,"t":"전세대출 받으려면 지금부터 관리해야 해요."},
{"id":"T554","line":3039,"t":"신용평가사에 제출하면 가점을 받을 수 있는 자료는?"},
{"id":"T555","line":3040,"t":"통신요금·건강보험료 성실납부 실적"},
{"id":"T556","line":3040,"t":"카드 사용 내역 전부"},
{"id":"T557","line":3040,"t":"예금 잔액"},
{"id":"T558","line":3041,"t":"비금융 납부 실적을 직접 제출하면 반영된다. 사회초년생처럼 금융 이력이 짧을수록 효과가 크다."},
{"id":"T559","line":3042,"t":"신용카드를 쓸 때 점수에 불리한 습관은?"},
{"id":"T560","line":3043,"t":"한도 대비 사용액 비율을 높게 유지"},
{"id":"T561","line":3043,"t":"소액을 꾸준히 결제"},
{"id":"T562","line":3043,"t":"자동이체로 전액 상환"},
{"id":"T563","line":3044,"t":"한도를 거의 다 쓰는 상태가 이어지면 상환 부담이 큰 것으로 본다. 사용률은 낮게 유지하는 편이 낫다."},
{"id":"T564","line":3045,"t":"카드 한도가 300만원인데 매달 270만원씩 쓴다면?"},
{"id":"T565","line":3045,"t":"사용률 90%라 점수에 불리하다"},
{"id":"T566","line":3045,"t":"많이 써서 점수가 오른다"},
{"id":"T567","line":3045,"t":"점수와 상관없다"},
{"id":"T568","line":3046,"t":"한도를 거의 다 쓰는 상태가 이어지면 상환 부담이 큰 것으로 본다. 한도를 올리거나 사용액을 나누면 비율이 내려간다."},
{"id":"T569","line":3047,"t":"첫 투자, ETF부터"},
{"id":"T570","line":3048,"t":"주식 시작한다며. 개별 종목부터 사려고?"},
{"id":"T571","line":3049,"t":"분산 투자가 줄여주는 위험은?"},
{"id":"T572","line":3049,"t":"특정 기업 하나가 무너질 위험"},
{"id":"T573","line":3049,"t":"시장 전체가 하락할 위험"},
{"id":"T574","line":3049,"t":"환율 위험 전부"},
{"id":"T575","line":3050,"t":"분산은 개별 기업 위험을 줄인다. 시장 전체가 떨어지는 위험은 분산으로 막을 수 없어서, 투자 기간을 길게 잡아 함께 대비한다."},
{"id":"T576","line":3051,"t":"장기 수익률에서 생각보다 크게 작용하는 것은?"},
{"id":"T577","line":3051,"t":"매년 빠져나가는 수수료와 보수"},
{"id":"T578","line":3051,"t":"종목 이름"},
{"id":"T579","line":3051,"t":"매수 시각"},
{"id":"T580","line":3052,"t":"연 1%의 보수 차이도 20년이면 큰 금액이 된다. 같은 지수를 따라가는 상품이라면 보수를 먼저 비교한다."},
{"id":"T581","line":3053,"t":"연 보수 0.1%와 1.0%의 차이가 가장 크게 벌어지는 조건은?"},
{"id":"T582","line":3053,"t":"오래 들고 있을수록"},
{"id":"T583","line":3053,"t":"짧게 사고팔수록"},
{"id":"T584","line":3053,"t":"금액이 작을수록"},
{"id":"T585","line":3054,"t":"보수는 매년 빠져나가므로 기간이 길수록 복리로 벌어진다. 장기 투자일수록 보수를 먼저 본다."},
{"id":"T586","line":3055,"t":"배달비의 진짜 비용"},
{"id":"T587","line":3056,"t":"오늘도 배달 시켰지. 한 번에 얼마 나가는지 세어 봤어?"},
{"id":"T588","line":3057,"t":"12,000원 메뉴에 배달비 3,000원, 최소주문을 맞추려 3,000원을 더 담았다. 총 지출은?"},
{"id":"T589","line":3058,"t":"18,000원"},
{"id":"T590","line":3058,"t":"15,000원"},
{"id":"T591","line":3058,"t":"12,000원"},
{"id":"T592","line":3059,"t":"12,000 + 3,000 + 3,000 = 18,000원. 최소주문 조건 때문에 먹지 않아도 될 것을 담는 금액이 숨은 비용이다."},
{"id":"T593","line":3060,"t":"주 3회 배달을 주 1회로 줄이면 한 달에 얼마가 남을까? (회당 18,000원, 월 4주)"},
{"id":"T594","line":3061,"t":"약 14만 4천원"},
{"id":"T595","line":3061,"t":"약 7만 2천원"},
{"id":"T596","line":3061,"t":"약 3만 6천원"},
{"id":"T597","line":3062,"t":"주 2회 × 4주 × 18,000원 = 144,000원. 1년이면 172만원으로, 웬만한 이사 비용이다."},
{"id":"T598","line":3063,"t":"배달 앱의 최소주문금액이 만드는 숨은 비용은?"},
{"id":"T599","line":3063,"t":"먹지 않아도 될 메뉴를 더 담게 되는 금액"},
{"id":"T600","line":3063,"t":"배달 기사 팁"},
{"id":"T601","line":3063,"t":"포장 용기값"},
{"id":"T602","line":3064,"t":"금액을 맞추려고 담은 사이드가 매번 3천원이면 한 달에 3만 6천원이다. 메뉴판에 없는 비용이다."},
{"id":"T603","line":3065,"t":"식비를 고정비로 만들기"},
{"id":"T604","line":3065,"t":"자취 선배"},
{"id":"T605","line":3066,"t":"식비가 매달 널뛰지? 그거 관리가 안 되는 이유가 있어."},
{"id":"T606","line":3067,"t":"식비가 통제되지 않는 가장 큰 이유는?"},
{"id":"T607","line":3067,"t":"한도를 정하지 않아서"},
{"id":"T608","line":3067,"t":"물가가 올라서"},
{"id":"T609","line":3067,"t":"요리를 못해서"},
{"id":"T610","line":3068,"t":"변동비로 두면 다 쓰고 나서야 알 수 있다. 주 단위 한도를 먼저 정하면 돈 쓰는 결정을 미리 하게 된다."},
{"id":"T611","line":3069,"t":"주간 식비 한도를 관리하는 가장 단순한 방법은?"},
{"id":"T612","line":3070,"t":"식비 전용 계좌나 카드를 따로 두기"},
{"id":"T613","line":3070,"t":"매 끼니 가계부에 적기"},
{"id":"T614","line":3070,"t":"월말에 합산해서 반성하기"},
{"id":"T615","line":3071,"t":"분리해 두면 잔액 자체가 신호가 된다. 기록보다 구조를 바꾸는 쪽이 오래간다."},
{"id":"T616","line":3072,"t":"주 7만원으로 한도를 정했는데 수요일에 이미 6만원을 썼다면?"},
{"id":"T617","line":3072,"t":"남은 1만원이 신호가 돼서 남은 날들의 선택이 달라진다"},
{"id":"T618","line":3072,"t":"한도를 늘린다"},
{"id":"T619","line":3072,"t":"다음 주에서 당겨 쓴다"},
{"id":"T620","line":3073,"t":"한도는 참으라고 두는 게 아니라 결정을 미리 하게 해 주는 장치다. 잔액이 보이면 금요일 약속을 옮길지 수요일에 고민하게 된다."},
{"id":"T621","line":3074,"t":"옷값을 회당 비용으로 보기"},
{"id":"T622","line":3075,"t":"정장 살까 말까 고민된다며. 계산법 하나만 알려줄게."},
{"id":"T623","line":3076,"t":"20만원짜리 코트를 3년간 겨울마다 40번 입으면 1회당 얼마일까?"},
{"id":"T624","line":3076,"t":"약 1,667원"},
{"id":"T625","line":3076,"t":"약 5,000원"},
{"id":"T626","line":3076,"t":"약 200원"},
{"id":"T627","line":3077,"t":"200,000 ÷ 120회 = 약 1,667원. 싸게 사서 몇 번 못 입는 옷은 회당 비용이 오히려 높은 경우가 많다."},
{"id":"T628","line":3078,"t":"회당 비용이 가장 낮아지는 선택은?"},
{"id":"T629","line":3079,"t":"자주 입을 기본 아이템에 예산을 몰아준다"},
{"id":"T630","line":3079,"t":"유행 아이템을 여러 개 산다"},
{"id":"T631","line":3079,"t":"가장 싼 것만 산다"},
{"id":"T632","line":3080,"t":"착용 횟수가 분모다. 분모가 큰 옷에 돈을 쓰는 것이 회당 비용을 낮춘다."},
{"id":"T633","line":3081,"t":"5만원짜리 유행 옷을 다섯 번 입고 안 입게 됐다면 회당 얼마일까?"},
{"id":"T634","line":3082,"t":"50,000 ÷ 5 = 10,000원. 20만원 코트의 회당 1,667원보다 여섯 배 비싸다. 가격표가 아니라 착용 횟수가 비용을 정한다."},
{"id":"T635","line":3083,"t":"세탁비를 줄이는 기준"},
{"id":"T636","line":3083,"t":"세탁소 사장"},
{"id":"T637","line":3084,"t":"이거 굳이 드라이 안 맡겨도 되는 건데."},
{"id":"T638","line":3085,"t":"세탁 방법을 정할 때 가장 먼저 봐야 할 것은?"},
{"id":"T639","line":3085,"t":"옷 안쪽 취급 표시 라벨"},
{"id":"T640","line":3085,"t":"옷의 가격"},
{"id":"T641","line":3085,"t":"옷의 색"},
{"id":"T642","line":3086,"t":"라벨의 기호가 물세탁 가능 여부와 온도를 정해 준다. 라벨을 무시한 세탁이 옷을 가장 빨리 버린다."},
{"id":"T643","line":3087,"t":"롱패딩 같은 큰 옷의 세탁 비용을 줄이는 방법은?"},
{"id":"T644","line":3088,"t":"시즌당 횟수를 정해두고 부분 오염은 즉시 처리"},
{"id":"T645","line":3088,"t":"매달 드라이"},
{"id":"T646","line":3088,"t":"세탁하지 않기"},
{"id":"T647","line":3089,"t":"전체 세탁 횟수를 줄이는 것이 핵심이다. 얼룩은 생겼을 때 바로 지우면 전체 세탁이 미뤄진다."},
{"id":"T648","line":3090,"t":"취급 표시 라벨에서 확인할 수 없는 것은?"},
{"id":"T649","line":3090,"t":"옷의 원래 판매가"},
{"id":"T650","line":3090,"t":"물세탁 가능 여부"},
{"id":"T651","line":3090,"t":"다림질 온도"},
{"id":"T652","line":3091,"t":"라벨은 세탁·표백·건조·다림질·드라이 기호를 담는다. 값은 안 적혀 있지만 옷 수명은 여기서 갈린다."},
{"id":"T653","line":3092,"t":"근로계약서에서 확인할 것"},
{"id":"T654","line":3093,"t":"계약서 다시 꺼내 볼까요. 세 줄만 봐요."},
{"id":"T655","line":3094,"t":"근로계약서는 언제 받아야 할까?"},
{"id":"T656","line":3095,"t":"근로계약을 맺을 때 서면으로 받아야 한다"},
{"id":"T657","line":3095,"t":"수습이 끝나면 받는다"},
{"id":"T658","line":3095,"t":"요청할 때만 준다"},
{"id":"T659","line":3096,"t":"근로기준법상 사용자는 임금과 소정근로시간 등이 적힌 서면을 교부할 의무가 있다. 안 주면 그 자체가 위반이다."},
{"id":"T660","line":3097,"t":"연봉에 포함되어 있으면 따져봐야 하는 항목은?"},
{"id":"T661","line":3098,"t":"퇴직금을 월급에 얹어 지급하는 이른바 퇴직금 분할약정은 원칙적으로 무효로 본다. 연봉 총액에 퇴직금이 들어가 있는지 확인한다."},
{"id":"T662","line":3099,"t":"입사했는데 근로계약서를 끝내 받지 못했다면?"}]