{"id":"T63","line":2508,"t":"입사 첫날 지급. 검정 파랑 빨강."},
{"id":"T64","line":2509,"t":"무소음 마우스"},
{"id":"T65","line":2509,"t":"옆자리에 민폐 안 끼치는 배려."},
{"id":"T66","line":2510,"t":"대용량 텀블러"},
{"id":"T67","line":2510,"t":"카페인은 곧 지구력."},
{"id":"T68","line":2511,"t":"기계식 키보드"},
{"id":"T69","line":2511,"t":"청축. 사무실 전체가 당신의 타건을 듣는다."},
{"id":"T70","line":2512,"t":"들고만 있어도 바빠 보인다."},
{"id":"T71","line":2513,"t":"어디서든 일할 수 있다는 축복이자 저주."},
{"id":"T72","line":2514,"t":"법인카드"},
{"id":"T73","line":2514,"t":"한도가 곧 권력."},
{"id":"T74","line":2515,"t":"네이비 재킷"},
{"id":"T75","line":2515,"t":"면접부터 결혼식까지 이 한 벌."},
{"id":"T76","line":2516,"t":"차콜 정장"},
{"id":"T77","line":2516,"t":"한 벌로 3년을 버틴다."},
{"id":"T78","line":2517,"t":"사원증 목걸이"},
{"id":"T79","line":2517,"t":"소속이 곧 방패. 셔츠 차림에 사원증만."},
{"id":"T80","line":2518,"t":"후드집업"},
{"id":"T81","line":2518,"t":"재택의 제복. 목 뒤에 후드가 접혀 있다."},
{"id":"T82","line":2519,"t":"필살기 정장"},
{"id":"T83","line":2519,"t":"금장 라펠. 중요한 날에만 꺼낸다."},
{"id":"T84","line":2520,"t":"출근용 롱패딩"},
{"id":"T85","line":2520,"t":"무릎까지 오는 12월의 갑옷."},
{"id":"T86","line":2521,"t":"맨머리."},
{"id":"T87","line":2522,"t":"블루라이트 안경"},
{"id":"T88","line":2522,"t":"눈과 평판을 동시에 지킨다."},
{"id":"T89","line":2523,"t":"회식용 넥타이 머리띠"},
{"id":"T90","line":2523,"t":"분위기는 살리는데 다음 날 기억이 없다."},
{"id":"T91","line":2524,"t":"머리 감을 시간을 벌어준다."},
{"id":"T92","line":2525,"t":"베이지 슬랙스"},
{"id":"T93","line":2525,"t":"무채색 상의에 뭘 입어도 맞는다."},
{"id":"T94","line":2526,"t":"금요일의 자유. 앞선이 살아 있다."},
{"id":"T95","line":2527,"t":"검정 슬랙스"},
{"id":"T96","line":2527,"t":"무난함이 곧 생존."},
{"id":"T97","line":2528,"t":"기모 트레이닝복"},
{"id":"T98","line":2528,"t":"옆선 두 줄. 재택의 승리."},
{"id":"T99","line":2529,"t":"스키니진 빌런"},
{"id":"T100","line":2529,"t":"통이 한 뼘 좁다. 공격은 오르고 방어는 깎인다."},
{"id":"T101","line":2532,"t":"혼자 다녀요."},
{"id":"T102","line":2533,"t":"출근 참새"},
{"id":"T103","line":2533,"t":"알람보다 먼저 깨운다."},
{"id":"T104","line":2534,"t":"퇴근길 강아지"},
{"id":"T105","line":2534,"t":"집에 갈 이유가 하나 생긴다."},
{"id":"T106","line":2535,"t":"스테이플러 거북"},
{"id":"T107","line":2535,"t":"느리지만 서류를 절대 놓치지 않는다."},
{"id":"T108","line":2538,"t":"두 발로 다녀요."},
{"id":"T109","line":2539,"t":"전동 킥보드"},
{"id":"T110","line":2539,"t":"헬멧은 쓰고 타세요."},
{"id":"T111","line":2540,"t":"연간권이 제일 싸다."},
{"id":"T112","line":2541,"t":"중고 경차"},
{"id":"T113","line":2541,"t":"유지비가 곧 월세다."},
{"id":"T114","line":2542,"t":"전기자전거"},
{"id":"T115","line":2543,"t":"오르막에서 친구를 앞지른다. 배터리는 매일 충전."},
{"id":"T116","line":2544,"t":"중형 세단"},
{"id":"T117","line":2545,"t":"할부가 끝나기 전까지는 은행 차다."},
{"id":"T118","line":2549,"t":"연말정산 영수증 파일"},
{"id":"T119","line":2549,"t":"1년치 영수증이 들어 있다. 13월의 월급이 여기서 나온다."},
{"id":"T120","line":2550,"t":"OTP 카드"},
{"id":"T121","line":2550,"t":"숫자 여섯 자리가 계좌를 지킨다."},
{"id":"T122","line":2551,"t":"보온 도시락통"},
{"id":"T123","line":2551,"t":"점심값이 한 달에 십만 원 넘게 줄어든다."},
{"id":"T124","line":2552,"t":"노무사 정장"},
{"id":"T125","line":2552,"t":"근로계약서를 펼치면 눈빛이 달라진다."},
{"id":"T126","line":2553,"t":"바람막이"},
{"id":"T127","line":2553,"t":"공항에서도 산에서도 한 벌."},
{"id":"T128","line":2554,"t":"니트 조끼"},
{"id":"T129","line":2554,"t":"셔츠 위에 걸치면 사무실 3년 차처럼 보인다."},
{"id":"T130","line":2555,"t":"카고 팬츠"},
{"id":"T131","line":2555,"t":"주머니가 여섯 개. 영수증을 잃어버리지 않는다."},
{"id":"T132","line":2556,"t":"린넨 바지"},
{"id":"T133","line":2556,"t":"여름 출근의 구세주."},
{"id":"T134","line":2557,"t":"주황 비니"},
{"id":"T135","line":2557,"t":"멀리서도 보인다. 약속 장소에서 찾기 쉽다."},
{"id":"T136","line":2558,"t":"선글라스"},
{"id":"T137","line":2558,"t":"보이스피싱 전화를 받을 때도 쓰고 있으면 침착해진다."},
{"id":"T138","line":2559,"t":"황금 볼펜"},
{"id":"T139","line":2560,"t":"동네 편의점 알바생의 넌센스 퀴즈"},
{"id":"T140","line":2560,"t":"편의점 퀴즈왕 상품. 사인할 일이 기다려진다."},
{"id":"T141","line":2561,"t":"고양이 머그"},
{"id":"T142","line":2562,"t":"은행 골목 세탁소 분실물함"},
{"id":"T143","line":2562,"t":"주인을 찾습니다. 한 달이 지나면 당신 것."},
{"id":"T144","line":2563,"t":"넌센스 왕 티셔츠"},
{"id":"T145","line":2564,"t":"학교 앞 도서관 사서의 넌센스 퀴즈"},
{"id":"T146","line":2564,"t":"가슴에 \"쉽구만\"이라고 쓰여 있다."},
{"id":"T147","line":2565,"t":"황금 인감도장"},
{"id":"T148","line":2566,"t":"학교 앞 게임 동아리 · 지옥 난이도"},
{"id":"T149","line":2566,"t":"이걸 꺼내면 계약서가 떤다."},
{"id":"T150","line":2567,"t":"행운의 체크 바지"},
{"id":"T151","line":2568,"t":"회사 앞 로비 경비 아저씨의 넌센스 퀴즈"},
{"id":"T152","line":2568,"t":"입은 날은 이상하게 결재가 잘 난다."},
{"id":"T153","line":2570,"t":"정규직 사원증"},
{"id":"T154","line":2571,"t":"메인 퀘스트 1장 · 첫 취업"},
{"id":"T155","line":2571,"t":"수습이 끝난 날 새로 받은 목걸이. 근로계약서는 서랍에 한 부 있다."},
{"id":"T156","line":2572,"t":"확정일자 받은 계약서"},
{"id":"T157","line":2573,"t":"메인 퀘스트 2장 · 첫 전세 계약"},
{"id":"T158","line":2573,"t":"도장 옆에 확정일자 도장이 하나 더 있다. 이게 보증금 순서를 정한다."},
{"id":"T159","line":2574,"t":"한도 낮춘 첫 카드"},
{"id":"T160","line":2575,"t":"메인 퀘스트 3장 · 첫 신용카드"},
{"id":"T161","line":2575,"t":"한도는 내가 정했다. 결제일 전날 알림도 켜 뒀다."},
{"id":"T162","line":2576,"t":"초보운전 선글라스"},
{"id":"T163","line":2577,"t":"메인 퀘스트 4장 · 첫 차"},
{"id":"T164","line":2577,"t":"역광에도 앞차 브레이크등이 보인다. 뒷유리엔 초보운전 스티커."},
{"id":"T165","line":2578,"t":"상견례 정장"},
{"id":"T166","line":2579,"t":"메인 퀘스트 5장 · 결혼 준비"},
{"id":"T167","line":2579,"t":"양가 어른 앞에서 한 번 입었다. 예산표는 안주머니에."},
{"id":"T168","line":2580,"t":"집들이 실내복"},
{"id":"T169","line":2581,"t":"메인 퀘스트 6장 · 첫 내 집 마련"},
{"id":"T170","line":2581,"t":"등기부 갑구에 내 이름이 오른 날 처음 입었다."},
{"id":"T171","line":2582,"t":"옥스퍼드 셔츠"},
{"id":"T172","line":2582,"t":"다림질 없이 입어도 구김이 덜하다. 월요일 아침의 친구."},
{"id":"T173","line":2583,"t":"사무실 가디건"},
{"id":"T174","line":2583,"t":"에어컨 바람 아래 자리에 앉았다면 필수."},
{"id":"T175","line":2584,"t":"와이드 슬랙스"},
{"id":"T176","line":2584,"t":"앉아 있는 여덟 시간이 편하다."},
{"id":"T177","line":2585,"t":"카드지갑"},
{"id":"T178","line":2585,"t":"카드는 두 장만. 쓰는 카드를 줄이면 명세서가 읽힌다."},
{"id":"T179","line":2588,"t":"소형 전기차"},
{"id":"T180","line":2589,"t":"충전소 위치부터 외웠다. 기름값 대신 충전비."},
{"id":"T181","line":2591,"t":"자동차 스마트키"},
{"id":"T182","line":2592,"t":"주머니에 넣은 채로 문이 열린다. 잃어버리면 새로 맞추는 값이 꽤 나온다."},
{"id":"T183","line":2593,"t":"분유 보온병"},
{"id":"T184","line":2594,"t":"새벽 세 시에도 물 온도가 딱 맞다."},
{"id":"T185","line":2596,"t":"전자책, 회의 자료, 아이 동영상까지. 충전기는 늘 모자란다."},
{"id":"T186","line":2597,"t":"주담대 상환표"},
{"id":"T187","line":2598,"t":"원금이 줄어드는 줄을 매달 형광펜으로 긋는다."},
{"id":"T188","line":2599,"t":"가족카드"},
{"id":"T189","line":2600,"t":"둘이 한 명세서를 같이 본다. 장보기가 한 줄로 모인다."},
{"id":"T190","line":2601,"t":"승진 기념 만년필"},
{"id":"T191","line":2602,"t":"결재란에 이름 쓸 일이 많아졌다."},
{"id":"T192","line":2603,"t":"연금저축 통장"},
{"id":"T193","line":2604,"t":"쉰다섯이 넘어야 연금으로 꺼낸다. 중간에 깨면 세금을 돌려 낸다."},
{"id":"T194","line":2605,"t":"명절 한복"},
{"id":"T195","line":2606,"t":"명절과 돌잔치에 한 번씩. 빌리는 값보다 사는 게 싸질 때쯤 샀다."},
{"id":"T196","line":2607,"t":"팀장 정장"},
{"id":"T197","line":2608,"t":"회의 끝에 \"그럼 정리하면\"을 말하는 사람이 됐다."},
{"id":"T198","line":2609,"t":"등산 재킷"},
{"id":"T199","line":2610,"t":"주말 새벽 산 입구 주차장에서 같은 옷을 열 번 본다."},
{"id":"T200","line":2611,"t":"경량 패딩 조끼"},
{"id":"T201","line":2612,"t":"셔츠 위에 하나. 마흔 넘은 사무실의 교복."},
{"id":"T202","line":2613,"t":"등산 바지"},
{"id":"T203","line":2614,"t":"무릎이 늘어나도 다시 돌아온다. 허리 고무줄이 고맙다."},
{"id":"T204","line":2615,"t":"팀장 정장 바지"},
{"id":"T205","line":2616,"t":"윗옷과 같은 날 샀다. 따로 입어도 아무도 모른다."},
{"id":"T206","line":2617,"t":"산책 조거 팬츠"},
{"id":"T207","line":2618,"t":"저녁 먹고 동네 한 바퀴. 발목이 조여서 바람이 안 든다."},
{"id":"T208","line":2619,"t":"다초점 안경"},
{"id":"T209","line":2620,"t":"마흔 넘어 처음 맞췄다. 약관 작은 글씨가 다시 보인다."},
